---
/*
 * ============================================================
 * HABITAT IAS
 * RESET PASSWORD PAGE
 * ============================================================
 *
 * FLOW:
 *
 * /forgot-password
 *        ↓
 * Supabase sends recovery email
 *        ↓
 * Student clicks email
 *        ↓
 * /reset-password
 *        ↓
 * Student enters new password
 *        ↓
 * supabase.auth.updateUser()
 *        ↓
 * Password changed
 *        ↓
 * /login
 *
 * ============================================================
 */
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Habitat IAS Reset Password"
  />

  <title>Reset Password | Habitat IAS</title>


  <style>

    /* ========================================================
       RESET
    ======================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {

      min-height: 100vh;

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #eef5ff 0%,
          #f7faff 45%,
          #edf7ff 100%
        );

      color: #102a43;

      -webkit-font-smoothing: antialiased;

    }

    button,
    input {
      font: inherit;
    }

    button {
      border: none;
    }

    a {
      text-decoration: none;
    }


    /* ========================================================
       PAGE
    ======================================================== */

    .page {

      min-height: 100vh;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 30px 20px;

      position: relative;

      overflow: hidden;

    }


    /* ========================================================
       BACKGROUND
    ======================================================== */

    .background-circle {

      position: absolute;

      border-radius: 50%;

      pointer-events: none;

    }

    .circle-one {

      width: 430px;

      height: 430px;

      top: -220px;

      right: -130px;

      background:
        rgba(37, 99, 235, 0.08);

    }

    .circle-two {

      width: 360px;

      height: 360px;

      bottom: -210px;

      left: -160px;

      background:
        rgba(14, 165, 233, 0.07);

    }


    /* ========================================================
       CARD
    ======================================================== */

    .card {

      position: relative;

      z-index: 2;

      width: 100%;

      max-width: 560px;

      background: #ffffff;

      border:
        1px solid
        rgba(148, 163, 184, 0.20);

      border-radius: 24px;

      padding: 48px 52px;

      box-shadow:
        0 30px 80px
        rgba(15, 23, 42, 0.13);

    }


    /* ========================================================
       LOGO
    ======================================================== */

    .logo {

      width: 58px;

      height: 58px;

      display: flex;

      align-items: center;

      justify-content: center;

      margin-bottom: 22px;

      border-radius: 16px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #082b55,
          #1459a6
        );

      box-shadow:
        0 12px 30px
        rgba(37, 99, 235, 0.20);

      font-size: 26px;

      font-weight: 950;

    }


    /* ========================================================
       BRAND
    ======================================================== */

    .brand {

      color: #0b2545;

      font-size: 25px;

      line-height: 1.1;

      font-weight: 950;

      letter-spacing: -0.5px;

    }

    .tagline {

      margin-top: 6px;

      color: #64748b;

      font-size: 9px;

      font-weight: 850;

      letter-spacing: 1.2px;

      text-transform: uppercase;

    }


    /* ========================================================
       CONTENT
    ======================================================== */

    .kicker {

      margin-top: 32px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 950;

      letter-spacing: 1.4px;

      text-transform: uppercase;

    }

    .title {

      margin-top: 8px;

      color: #0b2545;

      font-size: 31px;

      line-height: 1.15;

      font-weight: 950;

      letter-spacing: -0.7px;

    }

    .description {

      max-width: 430px;

      margin-top: 10px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;

    }


    /* ========================================================
       STATUS
    ======================================================== */

    .status {

      display: none;

      margin-top: 22px;

      padding: 12px 14px;

      border-radius: 10px;

      font-size: 11px;

      line-height: 1.5;

      font-weight: 750;

    }

    .status.error {

      display: block;

      color: #991b1b;

      background: #fef2f2;

      border:
        1px solid
        #fecaca;

    }

    .status.success {

      display: block;

      color: #166534;

      background: #f0fdf4;

      border:
        1px solid
        #bbf7d0;

    }


    /* ========================================================
       FORM
    ======================================================== */

    .form {

      margin-top: 28px;

    }

    .field {

      margin-bottom: 18px;

    }

    .field-label {

      display: block;

      margin-bottom: 7px;

      color: #334155;

      font-size: 10px;

      font-weight: 900;

    }

    .input-wrap {

      position: relative;

    }

    .field-input {

      width: 100%;

      height: 50px;

      padding:
        0 48px 0 14px;

      color: #172033;

      background: #f8fafc;

      border:
        1px solid
        #dbe3ec;

      border-radius: 10px;

      outline: none;

      font-size: 13px;

      transition:
        border-color .16s ease,
        background .16s ease,
        box-shadow .16s ease;

    }

    .field-input::placeholder {

      color: #a0aec0;

    }

    .field-input:hover {

      border-color:
        #cbd5e1;

    }

    .field-input:focus {

      background: #ffffff;

      border-color:
        #60a5fa;

      box-shadow:
        0 0 0 4px
        rgba(37,99,235,0.08);

    }


    /* ========================================================
       SHOW / HIDE PASSWORD
    ======================================================== */

    .toggle-password {

      position: absolute;

      right: 10px;

      top: 50%;

      transform:
        translateY(-50%);

      width: 34px;

      height: 34px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 8px;

      background: transparent;

      color: #64748b;

      cursor: pointer;

      font-size: 14px;

    }

    .toggle-password:hover {

      background:
        #eef2f7;

      color: #1e40af;

    }


    /* ========================================================
       PASSWORD REQUIREMENTS
    ======================================================== */

    .requirements {

      margin-top: -7px;

      margin-bottom: 18px;

      color: #64748b;

      font-size: 9px;

      line-height: 1.6;

    }


    /* ========================================================
       BUTTON
    ======================================================== */

    .button {

      width: 100%;

      height: 50px;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      border-radius: 10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #1d4ed8
        );

      cursor: pointer;

      font-size: 12px;

      font-weight: 900;

      box-shadow:
        0 10px 24px
        rgba(37,99,235,0.20);

      transition:
        transform .15s ease,
        box-shadow .15s ease,
        opacity .15s ease;

    }

    .button:hover:not(:disabled) {

      transform:
        translateY(-1px);

      box-shadow:
        0 14px 28px
        rgba(37,99,235,0.25);

    }

    .button:disabled {

      cursor: wait;

      opacity: .72;

    }


    /* ========================================================
       SPINNER
    ======================================================== */

    .spinner {

      width: 14px;

      height: 14px;

      border-radius: 50%;

      border:
        2px solid
        rgba(255,255,255,0.35);

      border-top-color:
        #ffffff;

      animation:
        spin .7s linear infinite;

    }

    @keyframes spin {

      to {

        transform:
          rotate(360deg);

      }

    }


    /* ========================================================
       BACK LOGIN
    ======================================================== */

    .back-login {

      margin-top: 22px;

      text-align: center;

      color: #64748b;

      font-size: 11px;

    }

    .back-login a {

      color: #2563eb;

      font-weight: 900;

    }

    .back-login a:hover {

      text-decoration: underline;

    }


    /* ========================================================
       SECURITY NOTE
    ======================================================== */

    .security-note {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      margin-top: 22px;

      color: #94a3b8;

      font-size: 9px;

      font-weight: 700;

    }


    /* ========================================================
       MOBILE
    ======================================================== */

    @media (max-width: 600px) {

      .page {

        padding: 18px;

      }

      .card {

        padding:
          38px 30px;

        border-radius: 20px;

      }

      .title {

        font-size: 27px;

      }

    }

    @media (max-width: 420px) {

      .page {

        padding: 10px;

      }

      .card {

        padding:
          32px 22px;

      }

    }

  </style>

</head>


<body>

  <main class="page">

    <!-- Background -->

    <div
      class="background-circle circle-one"
    ></div>

    <div
      class="background-circle circle-two"
    ></div>


    <!-- Card -->

    <section class="card">

      <!-- Logo -->

      <div class="logo">
        H
      </div>


      <!-- Brand -->

      <div class="brand">
        Habitat IAS
      </div>

      <div class="tagline">
        Civil Services Preparation
      </div>


      <!-- Content -->

      <div class="kicker">
        Secure Account Recovery
      </div>

      <h1 class="title">
        Create a new password
      </h1>

      <p class="description">

        Choose a new password for your
        Habitat IAS account. Your new password
        will replace the previous password.

      </p>


      <!-- Status -->

      <div
        id="status"
        class="status"
        role="alert"
        aria-live="polite"
      ></div>


      <!-- FORM -->

      <form
        id="resetForm"
        class="form"
        novalidate
      >


        <!-- NEW PASSWORD -->

        <div class="field">

          <label
            class="field-label"
            for="password"
          >
            New Password
          </label>

          <div class="input-wrap">

            <input
              id="password"
              name="password"
              class="field-input"
              type="password"
              autocomplete="new-password"
              placeholder="Enter your new password"
              minlength="8"
              required
            />

            <button
              id="togglePassword"
              class="toggle-password"
              type="button"
              aria-label="Show password"
            >
              👁
            </button>

          </div>

        </div>


        <!-- REQUIREMENTS -->

        <div class="requirements">

          Password must contain at least
          <strong>8 characters</strong>.

        </div>


        <!-- CONFIRM PASSWORD -->

        <div class="field">

          <label
            class="field-label"
            for="confirmPassword"
          >
            Confirm New Password
          </label>

          <div class="input-wrap">

            <input
              id="confirmPassword"
              name="confirmPassword"
              class="field-input"
              type="password"
              autocomplete="new-password"
              placeholder="Enter the password again"
              minlength="8"
              required
            />

            <button
              id="toggleConfirmPassword"
              class="toggle-password"
              type="button"
              aria-label="Show password"
            >
              👁
            </button>

          </div>

        </div>


        <!-- SUBMIT -->

        <button
          id="resetButton"
          class="button"
          type="submit"
        >

          <span id="buttonText">
            Update Password
          </span>

        </button>

      </form>


      <!-- BACK -->

      <div class="back-login">

        Already have your password?

        <a href="/login">
          Back to Login
        </a>

      </div>


      <!-- SECURITY -->

      <div class="security-note">

        <span>🔐</span>

        Secure password recovery powered by Supabase

      </div>

    </section>

  </main>


  <!-- ======================================================
       JAVASCRIPT
  ======================================================= -->

  <script>

    import {
      supabase
    } from "../lib/supabase";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const form =
      document.getElementById(
        "resetForm"
      );

    const passwordInput =
      document.getElementById(
        "password"
      );

    const confirmPasswordInput =
      document.getElementById(
        "confirmPassword"
      );

    const resetButton =
      document.getElementById(
        "resetButton"
      );

    const buttonText =
      document.getElementById(
        "buttonText"
      );

    const statusBox =
      document.getElementById(
        "status"
      );

    const togglePassword =
      document.getElementById(
        "togglePassword"
      );

    const toggleConfirmPassword =
      document.getElementById(
        "toggleConfirmPassword"
      );


    /* ======================================================
       STATUS
    ====================================================== */

    function showStatus(
      message,
      type = "error"
    ) {

      if (!statusBox) return;

      statusBox.textContent =
        message;

      statusBox.className =
        "status " + type;

    }


    function clearStatus() {

      if (!statusBox) return;

      statusBox.textContent =
        "";

      statusBox.className =
        "status";

    }


    /* ======================================================
       LOADING
    ====================================================== */

    function setLoading(
      loading
    ) {

      if (!resetButton) return;

      resetButton.disabled =
        loading;

      if (loading) {

        buttonText.innerHTML = `
          <span class="spinner"></span>
          Updating password...
        `;

      } else {

        buttonText.textContent =
          "Update Password";

      }

    }


    /* ======================================================
       SHOW / HIDE PASSWORD
    ====================================================== */

    function toggleField(
      input,
      button
    ) {

      if (!input || !button) return;

      const isPassword =
        input.type === "password";


      input.type =
        isPassword
          ? "text"
          : "password";


      button.textContent =
        isPassword
          ? "🙈"
          : "👁";


      button.setAttribute(
        "aria-label",
        isPassword
          ? "Hide password"
          : "Show password"
      );

    }


    togglePassword?.addEventListener(
      "click",
      () => {

        toggleField(
          passwordInput,
          togglePassword
        );

      }
    );


    toggleConfirmPassword?.addEventListener(
      "click",
      () => {

        toggleField(
          confirmPasswordInput,
          toggleConfirmPassword
        );

      }
    );


    /* ======================================================
       CHECK RECOVERY SESSION
    ====================================================== */

    async function checkRecoverySession() {

      try {

        const {
          data,
          error
        } =
          await supabase.auth
            .getSession();


        if (error) {

          console.error(
            "Recovery session error:",
            error
          );

          showStatus(
            "Unable to verify the password-reset session. Please request a new reset link."
          );

          if (resetButton) {

            resetButton.disabled =
              true;

          }

          return;

        }


        /*
         * Supabase should provide a session
         * after the recovery link has been
         * processed.
         */

        if (!data?.session) {

          showStatus(
            "This password-reset link is invalid or has expired. Please request a new reset link."
          );

          if (resetButton) {

            resetButton.disabled =
              true;

          }

          return;

        }


        console.log(
          "[Habitat IAS] PASSWORD RECOVERY SESSION VERIFIED"
        );

      } catch (error) {

        console.error(
          "Unexpected recovery-session error:",
          error
        );

        showStatus(
          "Unable to verify the reset session. Please request a new reset link."
        );

        if (resetButton) {

          resetButton.disabled =
            true;

        }

      }

    }


    /*
     * Listen for Supabase authentication
     * events as the recovery session is
     * established.
     */

    supabase.auth.onAuthStateChange(
      (
        event,
        session
      ) => {

        console.log(
          "[Habitat IAS] AUTH EVENT:",
          event
        );


        if (
          event ===
          "PASSWORD_RECOVERY"
          &&
          session
        ) {

          clearStatus();

          if (resetButton) {

            resetButton.disabled =
              false;

          }

        }

      }
    );


    checkRecoverySession();


    /* ======================================================
       CLEAR ERROR WHEN USER TYPES
    ====================================================== */

    [
      passwordInput,
      confirmPasswordInput
    ].forEach(
      (input) => {

        input?.addEventListener(
          "input",
          () => {

            if (
              statusBox?.classList.contains(
                "error"
              )
            ) {

              clearStatus();

            }

          }
        );

      }
    );


    /* ======================================================
       SUBMIT
    ====================================================== */

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();

        clearStatus();


        const password =
          passwordInput?.value || "";


        const confirmPassword =
          confirmPasswordInput?.value || "";


        /* --------------------------------------------------
           VALIDATION
        -------------------------------------------------- */

        if (!password) {

          showStatus(
            "Please enter a new password."
          );

          passwordInput?.focus();

          return;

        }


        if (password.length < 8) {

          showStatus(
            "Password must contain at least 8 characters."
          );

          passwordInput?.focus();

          return;

        }


        if (!confirmPassword) {

          showStatus(
            "Please confirm your new password."
          );

          confirmPasswordInput?.focus();

          return;

        }


        if (
          password !==
          confirmPassword
        ) {

          showStatus(
            "The passwords do not match."
          );

          confirmPasswordInput?.focus();

          return;

        }


        /* --------------------------------------------------
           UPDATE PASSWORD
        -------------------------------------------------- */

        setLoading(true);


        try {

          const {
            data,
            error
          } =
            await supabase.auth
              .updateUser({
                password:
                  password
              });


          /* -----------------------------------------------
             ERROR
          ------------------------------------------------ */

          if (error) {

            console.error(
              "Password update error:",
              error
            );


            const errorText =
              (
                error.message ||
                ""
              ).toLowerCase();


            let message =
              "Unable to update your password. Please try again.";


            if (
              errorText.includes(
                "expired"
              )
            ) {

              message =
                "This reset link has expired. Please request a new password reset link.";

            }

            else if (
              errorText.includes(
                "same"
              )
            ) {

              message =
                "Please choose a password different from your previous password.";

            }

            else if (
              errorText.includes(
                "weak"
              )
            ) {

              message =
                "This password is too weak. Please choose a stronger password.";

            }


            showStatus(
              message
            );

            setLoading(false);

            return;

          }


          /* -----------------------------------------------
             SUCCESS
          ------------------------------------------------ */

          console.log(
            "[Habitat IAS] PASSWORD UPDATED SUCCESSFULLY",
            data
          );


          showStatus(
            "Password updated successfully. Redirecting you to login...",
            "success"
          );


          /*
           * Sign out after password reset so
           * the student explicitly logs in
           * using the new password.
           */

          await supabase.auth.signOut();


          setLoading(false);


          setTimeout(
            () => {

              window.location.href =
                "/login";

            },
            1800
          );


        } catch (error) {

          console.error(
            "Unexpected password update error:",
            error
          );


          showStatus(
            "Something went wrong while updating your password. Please try again."
          );


          setLoading(false);

        }

      }
    );

  </script>

</body>

</html>