  <script>

    /*
     * =========================================================
     * MOBILE MENU
     * =========================================================
     */

    const menuButton =
      document.querySelector(".mobile-menu");


    const navLinks =
      document.querySelector(".nav-links");


    if (
      menuButton &&
      navLinks
    ) {

      menuButton.addEventListener(
        "click",
        () => {

          const isOpen =
            navLinks.classList.toggle(
              "mobile-open"
            );


          menuButton.setAttribute(
            "aria-expanded",
            String(isOpen)
          );

        }
      );

    }


    /*
     * =========================================================
     * PURCHASE MODAL
     * =========================================================
     */

    const purchaseModal =
      document.getElementById(
        "purchaseModal"
      );


    const closePurchaseModal =
      document.getElementById(
        "closePurchaseModal"
      );


    const openPurchaseButtons =
      document.querySelectorAll(
        "[data-open-purchase]"
      );


    function openModal() {

      if (!purchaseModal) {
        return;
      }


      purchaseModal.classList.add(
        "active"
      );


      purchaseModal.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.classList.add(
        "modal-open"
      );

    }


    function closeModal() {

      if (!purchaseModal) {
        return;
      }


      purchaseModal.classList.remove(
        "active"
      );


      purchaseModal.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.classList.remove(
        "modal-open"
      );

    }


    openPurchaseButtons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          openModal
        );

      }
    );


    closePurchaseModal?.addEventListener(
      "click",
      closeModal
    );


    purchaseModal?.addEventListener(
      "click",
      (event) => {

        if (
          event.target ===
          purchaseModal
        ) {

          closeModal();

        }

      }
    );


    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          purchaseModal?.classList.contains(
            "active"
          )
        ) {

          closeModal();

        }

      }
    );


    /*
     * =========================================================
     * EDITION SELECTION
     *
     * THIS IS THE IMPORTANT FIX.
     *
     * Hindi:
     * /book/buy/?edition=hindi
     *
     * English:
     * /book/buy/?edition=english
     *
     * PRICE IS NOT SENT IN THE URL.
     *
     * The server-side checkout decides:
     *
     * Hindi   = ₹249
     * English = ₹299
     *
     * =========================================================
     */

    const editionButtons =
      document.querySelectorAll(
        ".edition-buy"
      );


    editionButtons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const edition =
              button.getAttribute(
                "data-edition"
              );


            /*
             * Hindi Edition
             */

            if (
              edition === "hindi"
            ) {

              window.location.assign(
                "/book/buy/?edition=hindi"
              );

              return;
            }


            /*
             * English Edition
             */

            if (
              edition === "english"
            ) {

              window.location.assign(
                "/book/buy/?edition=english"
              );

              return;
            }


            /*
             * Invalid edition protection
             */

            console.error(
              "Invalid book edition:",
              edition
            );

          }
        );

      }
    );


  </script>


