---
const sampleBook =
  "https://drive.google.com/file/d/1gy_Im2Qs9Z7pwpYGUn7QSH0lJ4cwO5a5/view?usp=sharing";

const bookTitle = "JPSC Prelims Decoded: Topic-Wise PYQs";

const bookDescription =
  "Topic-wise and subject-wise previous year questions of the JPSC Civil Services Examination with detailed explanations, trend analysis and exam-focused preparation support.";

const hindiPrice = 249;
const englishPrice = 299;
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    {bookTitle} | Habitat IAS
  </title>

  <meta
    name="description"
    content={bookDescription}
  />

  <meta
    name="keywords"
    content="JPSC PYQ, JPSC Prelims PYQ, JPSC previous year questions, JPSC book, JPSC preparation, Jharkhand PSC, Habitat IAS"
  />

  <meta
    name="author"
    content="Habitat IAS"
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href="/book/"
  />

  <meta
    property="og:type"
    content="book"
  />

  <meta
    property="og:title"
    content={bookTitle}
  />

  <meta
    property="og:description"
    content={bookDescription}
  />

  <meta
    property="og:image"
    content="/book-cover.jpg"
  />

  <meta
    property="og:url"
    content="/book/"
  />

  <meta
    property="og:site_name"
    content="Habitat IAS"
  />

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={bookTitle}
  />

  <meta
    name="twitter:description"
    content={bookDescription}
  />

  <meta
    name="twitter:image"
    content="/book-cover.jpg"
  />

  <link
    rel="icon"
    href="/favicon.ico"
  />


  <style>

    :root {
      --blue: #1557d6;
      --blue-dark: #0d3f9f;
      --blue-light: #eef4ff;
      --yellow: #ffd43b;
      --text: #13213c;
      --muted: #667085;
      --border: #e5eaf2;
      --white: #ffffff;
      --bg: #f7f9fc;
      --green: #159447;
      --green-light: #eaf8ef;
      --shadow: 0 18px 50px rgba(15, 39, 83, 0.1);
      --radius: 20px;
    }


    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      margin: 0;

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
    }


    body.modal-open {
      overflow: hidden;
    }


    img {
      display: block;
      max-width: 100%;
    }


    a {
      color: inherit;
      text-decoration: none;
    }


    button {
      font: inherit;
      cursor: pointer;
    }


    /* =========================
       HEADER
    ========================== */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      background: rgba(255, 255, 255, 0.96);

      border-bottom:
        1px solid var(--border);

      backdrop-filter: blur(12px);
    }


    .nav {
      width:
        min(
          1200px,
          calc(100% - 40px)
        );

      min-height: 76px;

      margin: 0 auto;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 24px;
    }


    .brand {
      display: inline-flex;

      align-items: center;

      gap: 12px;

      font-size: 25px;

      font-weight: 800;

      color: var(--blue);

      white-space: nowrap;
    }


    .brand-mark {
      width: 44px;
      height: 44px;

      border-radius: 13px;

      display: grid;

      place-items: center;

      color: white;

      background: var(--blue);

      font-weight: 900;

      box-shadow:
        0 8px 20px
        rgba(21, 87, 214, 0.22);
    }


    .nav-links {
      display: flex;

      align-items: center;

      justify-content: flex-end;

      gap: 20px;

      font-size: 14px;

      font-weight: 700;

      color: #3f4d68;
    }


    .nav-links a:hover {
      color: var(--blue);
    }


    .nav-cta {
      padding: 12px 20px;

      border-radius: 12px;

      color: white !important;

      background: var(--blue);

      border: 0;
    }


    .mobile-menu {
      display: none;

      width: 44px;
      height: 44px;

      border: 0;

      border-radius: 12px;

      color: white;

      background: var(--blue);

      font-size: 23px;
    }


    /* =========================
       COMMON BUTTONS
    ========================== */

    .btn {
      min-height: 48px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 12px 21px;

      border-radius: 12px;

      border:
        1px solid transparent;

      font-size: 15px;

      font-weight: 800;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }


    .btn:hover {
      transform: translateY(-2px);
    }


    .btn-primary {
      background: var(--yellow);

      color: #17233a;

      box-shadow:
        0 10px 25px
        rgba(0, 0, 0, 0.13);
    }


    .btn-blue {
      background: var(--blue);

      color: white;

      box-shadow:
        0 10px 25px
        rgba(21, 87, 214, 0.18);
    }


    .btn-light {
      border-color:
        rgba(255, 255, 255, 0.5);

      color: white;

      background:
        rgba(255, 255, 255, 0.08);
    }


    .btn-outline {
      border-color: var(--border);

      color: var(--blue);

      background: white;
    }


    .hero-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 13px;

      margin-top: 30px;
    }


    /* =========================
       HERO
    ========================== */

    .hero {
      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(255, 255, 255, 0.16),
          transparent 28%
        ),
        linear-gradient(
          135deg,
          #1145ad,
          #2164e2
        );

      color: white;

      padding:
        82px 0 90px;
    }


    .hero-inner {
      width:
        min(
          1200px,
          calc(100% - 40px)
        );

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        minmax(0, 1.08fr)
        minmax(330px, 0.92fr);

      gap: 70px;

      align-items: center;
    }


    .eyebrow {
      display: inline-flex;

      padding: 8px 15px;

      border:
        1px solid
        rgba(255, 255, 255, 0.45);

      border-radius: 999px;

      font-size: 12px;

      font-weight: 800;

      letter-spacing: 1.3px;

      text-transform: uppercase;
    }


    .hero h1 {
      margin: 25px 0 18px;

      max-width: 700px;

      font-size:
        clamp(42px, 6vw, 72px);

      line-height: 0.98;

      letter-spacing: -3px;
    }


    .hero h1 span {
      color: var(--yellow);
    }


    .hero-text {
      max-width: 650px;

      margin: 0;

      color:
        rgba(255, 255, 255, 0.9);

      font-size: 18px;
    }


    .hero-card {
      padding: 30px;

      border-radius: 26px;

      color: var(--text);

      background: white;

      box-shadow:
        0 25px 60px
        rgba(4, 22, 61, 0.2);
    }


    .hero-card-label {
      margin-bottom: 10px;

      color: var(--blue);

      font-size: 12px;

      font-weight: 900;

      letter-spacing: 1.5px;

      text-transform: uppercase;
    }


    .hero-card h2 {
      margin: 0 0 20px;

      font-size: 30px;

      line-height: 1.15;
    }


    .check-list {
      display: grid;

      gap: 13px;

      margin: 0;

      padding: 0;

      list-style: none;
    }


    .check-list li {
      display: flex;

      gap: 10px;

      align-items: flex-start;

      color: #46536b;

      font-size: 15px;
    }


    .check {
      flex:
        0 0 auto;

      width: 23px;
      height: 23px;

      display: grid;

      place-items: center;

      border-radius: 50%;

      color: var(--blue);

      background: #eaf1ff;

      font-size: 13px;

      font-weight: 900;
    }


    /* =========================
       SECTIONS
    ========================== */

    .section {
      width:
        min(
          1100px,
          calc(100% - 40px)
        );

      margin: 0 auto;

      padding: 82px 0;
    }


    .section-header {
      max-width: 760px;

      margin:
        0 auto 42px;

      text-align: center;
    }


    .section-label {
      color: var(--blue);

      font-size: 12px;

      font-weight: 900;

      letter-spacing: 1.5px;

      text-transform: uppercase;
    }


    .section-header h2 {
      margin:
        8px 0 12px;

      font-size:
        clamp(30px, 4vw, 44px);

      line-height: 1.1;
    }


    .section-header p {
      margin: 0;

      color: var(--muted);
    }


    /* =========================
       BOOK
    ========================== */

    .book-layout {
      display: grid;

      grid-template-columns:
        minmax(280px, 380px)
        minmax(0, 1fr);

      gap: 65px;

      align-items: center;
    }


    .book-cover-wrap {
      width:
        min(100%, 360px);

      margin: 0 auto;

      overflow: hidden;

      border-radius: 16px;

      background: white;

      box-shadow: var(--shadow);
    }


    .book-cover-image {
      width: 100%;

      height: auto;

      aspect-ratio: 2 / 3;

      object-fit: cover;
    }


    .book-content h2 {
      margin:
        0 0 15px;

      font-size: 38px;

      line-height: 1.15;
    }


    .book-content > p {
      margin:
        0 0 22px;

      color: var(--muted);

      font-size: 16px;
    }


    /* =========================
       PRICE OPTIONS
    ========================== */

    .edition-prices {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 14px;

      margin: 24px 0;
    }


    .edition-mini {
      padding: 18px;

      border:
        1px solid var(--border);

      border-radius: 16px;

      background: white;
    }


    .edition-mini strong {
      display: block;

      margin-bottom: 4px;

      font-size: 15px;
    }


    .edition-mini .mini-price {
      color: var(--blue);

      font-size: 25px;

      font-weight: 900;
    }


    .edition-mini small {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 12px;
    }


    .license-notice {
      margin: 18px 0;

      padding: 14px 16px;

      border:
        1px solid #dce8ff;

      border-radius: 13px;

      background: #f3f7ff;

      color: #53627c;

      font-size: 12px;
    }


    .license-notice strong {
      color: var(--blue);
    }


    /* =========================
       FEATURES
    ========================== */

    .analysis {
      background: white;
    }


    .feature-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }


    .feature-card {
      padding: 27px;

      border:
        1px solid var(--border);

      border-radius: var(--radius);

      background: white;

      box-shadow:
        0 8px 25px
        rgba(17, 39, 77, 0.04);
    }


    .feature-number {
      width: 42px;
      height: 42px;

      display: grid;

      place-items: center;

      margin-bottom: 17px;

      border-radius: 12px;

      color: var(--blue);

      background: var(--blue-light);

      font-weight: 900;
    }


    .feature-card h3 {
      margin: 0 0 8px;

      font-size: 19px;
    }


    .feature-card p {
      margin: 0;

      color: var(--muted);

      font-size: 14px;
    }


    /* =========================
       ANALYSIS
    ========================== */

    .analysis-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 20px;
    }


    .analysis-card {
      padding: 28px;

      border:
        1px solid var(--border);

      border-radius: var(--radius);

      background: #fbfcff;
    }


    .analysis-card h3 {
      margin: 0 0 8px;

      font-size: 20px;
    }


    .analysis-card p {
      margin: 0;

      color: var(--muted);

      font-size: 15px;
    }


    .topics {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 14px;

      margin-top: 30px;
    }


    .topic {
      display: flex;

      align-items: center;

      gap: 12px;

      padding: 15px;

      border:
        1px solid var(--border);

      border-radius: 14px;

      background: white;
    }


    .topic-dot {
      width: 9px;
      height: 9px;

      flex: 0 0 auto;

      border-radius: 50%;

      background: var(--blue);
    }


    .topic span {
      font-size: 14px;

      font-weight: 700;
    }


    /* =========================
       SAMPLE
    ========================== */

    .sample-box {
      display: grid;

      grid-template-columns:
        1fr auto;

      gap: 25px;

      align-items: center;

      padding: 35px;

      border-radius: 24px;

      color: white;

      background:
        linear-gradient(
          135deg,
          #123f9d,
          #1d62da
        );

      box-shadow: var(--shadow);
    }


    .sample-box h2 {
      margin: 0 0 8px;

      font-size: 30px;
    }


    .sample-box p {
      margin: 0;

      max-width: 700px;

      color:
        rgba(255, 255, 255, 0.84);
    }


    .sample-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 10px;
    }


    /* =========================
       FAQ
    ========================== */

    .faq-list {
      max-width: 850px;

      margin: 0 auto;

      display: grid;

      gap: 13px;
    }


    .faq {
      padding: 21px 23px;

      border:
        1px solid var(--border);

      border-radius: 15px;

      background: white;
    }


    .faq h3 {
      margin:
        0 0 7px;

      font-size: 17px;
    }


    .faq p {
      margin: 0;

      color: var(--muted);

      font-size: 14px;
    }


    /* =========================
       FINAL CTA
    ========================== */

    .final-cta {
      padding: 82px 20px;

      text-align: center;

      color: white;

      background: #102f73;
    }


    .final-cta h2 {
      margin:
        0 0 12px;

      font-size:
        clamp(30px, 4vw, 45px);
    }


    .final-cta p {
      max-width: 650px;

      margin:
        0 auto 25px;

      color:
        rgba(255, 255, 255, 0.82);
    }


    /* =========================
       FOOTER
    ========================== */

    .site-footer {
      color: #c6d0e5;

      background: #091a3b;
    }


    .footer-inner {
      width:
        min(
          1100px,
          calc(100% - 40px)
        );

      margin: 0 auto;

      padding:
        45px 0 25px;
    }


    .footer-main {
      display: flex;

      justify-content:
        space-between;

      gap: 40px;
    }


    .footer-brand {
      color: white;

      font-size: 23px;

      font-weight: 800;
    }


    .footer-description {
      max-width: 420px;

      margin:
        10px 0 0;

      color: #9eabc5;

      font-size: 14px;
    }


    .footer-links {
      display: flex;

      flex-wrap: wrap;

      gap: 18px;

      align-content: flex-start;
    }


    .footer-links a {
      color: #d5dced;

      font-size: 14px;
    }


    .footer-bottom {
      margin-top: 35px;

      padding-top: 20px;

      border-top:
        1px solid
        rgba(255, 255, 255, 0.1);

      color: #8d9ab4;

      font-size: 13px;
    }


    /* =========================
       PURCHASE MODAL
    ========================== */

    .modal-backdrop {
      position: fixed;

      inset: 0;

      z-index: 5000;

      display: none;

      align-items: center;

      justify-content: center;

      padding: 20px;

      background:
        rgba(4, 15, 35, 0.72);

      backdrop-filter: blur(5px);
    }


    .modal-backdrop.active {
      display: flex;
    }


    .purchase-modal {
      width:
        min(
          680px,
          100%
        );

      max-height:
        calc(100vh - 40px);

      overflow-y: auto;

      position: relative;

      padding: 34px;

      border-radius: 24px;

      background: white;

      box-shadow:
        0 30px 90px
        rgba(0, 0, 0, 0.3);

      animation:
        modalIn 0.2s ease;
    }


    @keyframes modalIn {

      from {
        opacity: 0;

        transform:
          translateY(12px)
          scale(0.98);
      }

      to {
        opacity: 1;

        transform:
          translateY(0)
          scale(1);
      }

    }


    .modal-close {
      position: absolute;

      top: 15px;
      right: 15px;

      width: 40px;
      height: 40px;

      border: 0;

      border-radius: 50%;

      background: #f1f4f8;

      color: #44516a;

      font-size: 22px;
    }


    .modal-label {
      color: var(--blue);

      font-size: 11px;

      font-weight: 900;

      letter-spacing: 1.3px;

      text-transform: uppercase;
    }


    .purchase-modal h2 {
      margin:
        7px 45px 8px 0;

      font-size: 30px;

      line-height: 1.2;
    }


    .modal-description {
      margin:
        0 0 25px;

      color: var(--muted);

      font-size: 14px;
    }


    .edition-options {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 16px;
    }


    .edition-card {
      position: relative;

      padding: 22px;

      border:
        2px solid var(--border);

      border-radius: 18px;

      background: white;

      transition:
        border-color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }


    .edition-card:hover {
      transform:
        translateY(-3px);

      border-color:
        var(--blue);

      box-shadow:
        0 12px 30px
        rgba(21, 87, 214, 0.1);
    }


    .edition-flag {
      font-size: 30px;
    }


    .edition-card h3 {
      margin:
        10px 0 3px;

      font-size: 20px;
    }


    .edition-price {
      margin-bottom: 10px;

      color: var(--blue);

      font-size: 30px;

      font-weight: 950;
    }


    .edition-card p {
      min-height: 65px;

      margin:
        0 0 17px;

      color: var(--muted);

      font-size: 12px;
    }


    .edition-card .btn {
      width: 100%;
    }


    .modal-notice {
      margin-top: 20px;

      padding: 14px;

      border-radius: 13px;

      background: #f5f7fb;

      color: #667085;

      font-size: 11px;

      line-height: 1.55;
    }


    .modal-notice strong {
      color: #344054;
    }


    /* =========================
       MOBILE NAV
    ========================== */

    @media (max-width: 900px) {

      .nav-links {
        display: none;

        position: absolute;

        left: 14px;
        right: 14px;

        top: 70px;

        padding: 18px;

        flex-direction: column;

        align-items: stretch;

        gap: 0;

        border:
          1px solid var(--border);

        border-radius: 16px;

        background: white;

        box-shadow: var(--shadow);
      }


      .nav-links.mobile-open {
        display: flex;
      }


      .nav-links a {
        padding: 12px 8px;
      }


      .mobile-menu {
        display: grid;

        place-items: center;
      }


      .hero-inner {
        grid-template-columns: 1fr;

        gap: 40px;
      }


      .book-layout {
        grid-template-columns: 1fr;

        gap: 40px;
      }


      .book-content {
        text-align: center;
      }


      .book-content .check-list {
        text-align: left;

        max-width: 500px;

        margin: 0 auto;
      }


      .hero-actions {
        justify-content: center;
      }


      .feature-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }


      .sample-box {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 620px) {

      .nav {
        width:
          calc(100% - 28px);

        min-height: 64px;
      }


      .brand {
        font-size: 20px;

        gap: 8px;
      }


      .brand-mark {
        width: 38px;
        height: 38px;

        border-radius: 11px;
      }


      .hero {
        padding:
          52px 0 60px;
      }


      .hero-inner,
      .section {
        width:
          calc(100% - 28px);
      }


      .hero h1 {
        margin-top: 20px;

        font-size: 43px;

        letter-spacing: -2px;
      }


      .hero-text {
        font-size: 15px;
      }


      .hero-card {
        padding: 23px;

        border-radius: 20px;
      }


      .hero-card h2 {
        font-size: 25px;
      }


      .section {
        padding: 58px 0;
      }


      .section-header {
        margin-bottom: 28px;
      }


      .section-header h2 {
        font-size: 31px;
      }


      .book-content h2 {
        font-size: 31px;
      }


      .feature-grid,
      .analysis-grid,
      .topics,
      .edition-prices,
      .edition-options {
        grid-template-columns: 1fr;
      }


      .feature-card {
        padding: 22px;
      }


      .sample-box {
        padding: 25px;
      }


      .sample-box h2 {
        font-size: 25px;
      }


      .sample-actions {
        flex-direction: column;
      }


      .sample-actions .btn {
        width: 100%;
      }


      .footer-main {
        flex-direction: column;

        gap: 25px;
      }


      .footer-inner {
        width:
          calc(100% - 28px);
      }


      .purchase-modal {
        padding:
          26px 20px;
      }


      .purchase-modal h2 {
        font-size: 26px;
      }


      .edition-card p {
        min-height: auto;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       HEADER
  ========================== -->

