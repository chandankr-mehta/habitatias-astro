---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const pageTitle =
  "JPSC Prelims Syllabus & Exam Pattern 2027: Papers, Marks, Subjects, Strategy & PYQ Plan";
const pageDescription =
  "JPSC Prelims syllabus and exam pattern guide covering General Studies Paper I and II, marks, duration, question structure, qualifying rules, syllabus areas, PYQ strategy, mock tests and preparation planning.";
const pageUrl = "https://habitatias.com/blog/jpsc-prelims-syllabus-exam-pattern/";

const faqs = [
  {
    question: "How many papers are there in JPSC Prelims?",
    answer:
      "The official Combined Civil Services framework provides two compulsory objective papers: General Studies Paper I and General Studies Paper II. Each paper carries 200 marks and has a duration of 2 hours.",
  },
  {
    question: "How many marks are there in JPSC Prelims?",
    answer:
      "The two compulsory Preliminary papers carry 200 marks each, for a total of 400 marks.",
  },
  {
    question: "Is there negative marking in JPSC Prelims?",
    answer:
      "The official JPSC Combined Civil Services examination framework cited in this guide states that there is no negative marking for incorrect answers in the Preliminary Examination.",
  },
  {
    question: "Does JPSC Prelims have two General Studies papers?",
    answer:
      "Yes. The Preliminary Examination consists of General Studies Paper I and General Studies Paper II as the two compulsory objective papers.",
  },
  {
    question: "How long is each JPSC Prelims paper?",
    answer:
      "Each Preliminary paper has a duration of 2 hours under the current official examination framework referenced here.",
  },
  {
    question: "Do JPSC Prelims marks count in final merit?",
    answer:
      "The Preliminary Examination is a screening stage for admission to the Main Examination. The exact treatment of marks and qualifying standards should always be checked in the notification/rules applicable to the examination cycle.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  url: pageUrl,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: {
    "@type": "Organization",
    name: "Habitat IAS",
  },
  publisher: {
    "@type": "Organization",
    name: "Habitat IAS",
    url: "https://habitatias.com/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle} | Habitat IAS</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="JPSC syllabus 2027, JPSC Prelims syllabus, JPSC exam pattern, JPSC Prelims exam pattern, JPSC syllabus PDF, JPSC General Studies Paper 1, JPSC General Studies Paper 2, JPSC marks, JPSC preparation"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Habitat IAS" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body>
    <Header />

    <main>
      <div class="breadcrumb-wrap">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/blog/">Blog</a>
            <span>›</span>
            <span>JPSC Prelims Syllabus & Exam Pattern</span>
          </nav>
        </div>
      </div>

      <section class="hero">
        <div class="container hero-inner">
          <div class="pill">JPSC PRELIMS • SYLLABUS • EXAM PATTERN</div>

          <h1>
            JPSC Prelims Syllabus & Exam Pattern:
            <span>Know the Paper Before You Prepare.</span>
          </h1>

          <p class="hero-copy">
            A structured guide to the two-paper Preliminary stage, marks,
            duration, subject areas, syllabus mapping, PYQ analysis and mock
            test strategy — with the latest official JPSC framework as the
            reference point.
          </p>

          <div class="meta">
            <span>Updated: 16 August 2026</span>
            <span>•</span>
            <span>Habitat IAS</span>
            <span>•</span>
            <span>Approx. 14 min read</span>
          </div>

          <div class="actions">
            <a href="#pattern" class="btn yellow">See Exam Pattern ↓</a>
            <a href="/mock-tests/free-gs/" class="btn outline">Attempt Free Mock →</a>
          </div>
        </div>
      </section>

      <section class="notice-section">
        <div class="container">
          <div class="notice">
            <strong>Official-source note:</strong>
            <p>
              JPSC's website currently lists the Jharkhand Combined Civil
              Services Examination syllabus and the 2025 recruitment cycle
              (Advertisement No. 01/2026). This article uses the current
              official framework available from JPSC and should be rechecked
              against the notification for the specific cycle you apply for.
            </p>
          </div>
        </div>
      </section>

      <section class="quick-section">
        <div class="container">
          <div class="heading">
            <div class="eyebrow">AT A GLANCE</div>
            <h2>JPSC Prelims is a <span>two-paper screening stage.</span></h2>
          </div>

          <div class="quick-grid">
            <div><strong>02</strong><span>Compulsory Papers</span></div>
            <div><strong>200</strong><span>Marks per Paper</span></div>
            <div><strong>400</strong><span>Total Marks</span></div>
            <div><strong>2h</strong><span>Per Paper</span></div>
            <div><strong>GS-I</strong><span>General Studies I</span></div>
            <div><strong>GS-II</strong><span>General Studies II</span></div>
            <div><strong>MCQ</strong><span>Objective Type</span></div>
            <div class="green"><strong>0</strong><span>Negative Marking</span></div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <div class="container layout">
          <aside class="toc">
            <div class="toc-title">ON THIS PAGE</div>
            <a href="#pattern">Exam pattern</a>
            <a href="#papers">Two Preliminary papers</a>
            <a href="#paper1">General Studies Paper I</a>
            <a href="#paper2">General Studies Paper II</a>
            <a href="#qualifying">Selection & qualifying</a>
            <a href="#strategy">How to read the syllabus</a>
            <a href="#pyq">PYQ strategy</a>
            <a href="#mock">Mock-test strategy</a>
            <a href="#plan">Preparation plan</a>
            <a href="#mistakes">Common mistakes</a>
            <a href="#faq">FAQs</a>
          </aside>

          <article class="article">
            <p class="lead">
              Before buying books, joining a mock series or making a timetable,
              understand the JPSC Preliminary Examination structure. The
              official framework currently available from JPSC provides two
              compulsory objective papers — General Studies I and General
              Studies II — each carrying 200 marks and each having a 2-hour
              duration. The two papers together carry 400 marks.
            </p>

            <h2 id="pattern">JPSC Prelims Exam Pattern</h2>

            <div class="pattern-table">
              <div class="table-head">
                <span>Parameter</span>
                <span>JPSC Prelims</span>
              </div>

              <div>
                <strong>Stage</strong>
                <span>Preliminary Examination</span>
              </div>

              <div>
                <strong>Purpose</strong>
                <span>Screening for admission to the Main Examination</span>
              </div>

              <div>
                <strong>Number of papers</strong>
                <span>2 compulsory papers</span>
              </div>

              <div>
                <strong>Paper I</strong>
                <span>General Studies – I</span>
              </div>

              <div>
                <strong>Paper II</strong>
                <span>General Studies – II</span>
              </div>

              <div>
                <strong>Marks per paper</strong>
                <span>200</span>
              </div>

              <div>
                <strong>Total Preliminary marks</strong>
                <span>400</span>
              </div>

              <div>
                <strong>Duration</strong>
                <span>2 hours per paper</span>
              </div>

              <div>
                <strong>Question type</strong>
                <span>Objective / Multiple Choice Questions</span>
              </div>

              <div>
                <strong>Language</strong>
                <span>Question papers are set in Hindi and English</span>
              </div>

              <div>
                <strong>Negative marking</strong>
                <span>No negative marking for incorrect answers under the cited official framework</span>
              </div>
            </div>

            <div class="source-box">
              <strong>Official basis:</strong>
              JPSC's published Combined Civil Services framework states that
              the Preliminary Examination has two compulsory 200-mark papers,
              each of 2 hours, and that the question papers are objective type.
              It also states that there is no negative marking for incorrect
              answers. citeturn0search14turn0search12
            </div>

            <h2 id="papers">The Two Papers: Don't Treat Them as One Giant Subject</h2>

            <div class="paper-cards">
              <div class="paper-card">
                <div class="number">I</div>
                <span>GENERAL STUDIES</span>
                <h3>Paper I</h3>
                <p>
                  The broad General Studies paper. Your preparation should be
                  divided into individual syllabus domains instead of being
                  studied as one continuous block.
                </p>
                <div class="card-stat">
                  <strong>200 marks</strong>
                  <span>2 hours</span>
                </div>
              </div>

              <div class="paper-card second">
                <div class="number">II</div>
                <span>GENERAL STUDIES</span>
                <h3>Paper II</h3>
                <p>
                  The second compulsory General Studies paper. Treat its
                  syllabus as a separate preparation and testing track.
                </p>
                <div class="card-stat">
                  <strong>200 marks</strong>
                  <span>2 hours</span>
                </div>
              </div>
            </div>

            <div class="important">
              <strong>Important:</strong>
              Do not assume that a subject is low priority merely because it
              feels smaller in your notes. Your final preparation should cover
              the applicable official syllabus and then use PYQs to decide
              depth and revision priority.
            </div>

            <h2 id="paper1">General Studies Paper I — What to Prepare</h2>

            <p>
              The official syllabus should be your master checklist. Convert
              each broad heading into a subject → topic → subtopic structure.
              That makes revision and PYQ mapping much easier.
            </p>

            <div class="syllabus-grid">
              <div>
                <span>HISTORY</span>
                <h3>History of India</h3>
                <p>
                  Ancient, Medieval and Modern India, including major historical
                  developments and movements.
                </p>
              </div>

              <div>
                <span>GEOGRAPHY</span>
                <h3>Geography of India</h3>
                <p>
                  General, physical, economic and social-demographic geography,
                  along with important spatial relationships.
                </p>
              </div>

              <div>
                <span>POLITY</span>
                <h3>Indian Polity & Governance</h3>
                <p>
                  Constitution, governance, public administration and
                  decentralisation-related areas.
                </p>
              </div>

              <div>
                <span>ECONOMY</span>
                <h3>Economic & Sustainable Development</h3>
                <p>
                  Indian economy, development, sustainability, economic issues,
                  reforms and related contemporary dimensions.
                </p>
              </div>

              <div>
                <span>SCIENCE</span>
                <h3>Science & Technology</h3>
                <p>
                  General science, agriculture and technology development,
                  information and communication technology and related areas.
                </p>
              </div>

              <div>
                <span>STATE</span>
                <h3>Jharkhand-specific areas</h3>
                <p>
                  Build a dedicated state file covering the applicable
                  Jharkhand-specific history, geography, society, economy,
                  culture, governance and current-affairs areas.
                </p>
              </div>
            </div>

            <div class="source-box">
              <strong>Why the exact wording matters:</strong>
              Older JPSC documents and historical syllabus proposals can differ
              from the current Combined Civil Services framework. For example,
              JPSC's current official syllabus page lists the Combined Civil
              Services Examination separately, while older documents contain
              different structures. Always use the current official syllabus
              for your examination cycle. citeturn0search2turn0search13
            </div>

            <h2 id="paper2">General Studies Paper II — Build a Separate Tracker</h2>

            <p>
              Paper II should not disappear inside your Paper I preparation.
              Create a separate tracker from the applicable official syllabus,
              then record every PYQ and mock-test error against that tracker.
            </p>

            <div class="tracker">
              <div>
                <strong>SYLLABUS</strong>
                <p>List every applicable Paper II domain.</p>
              </div>
              <div>
                <strong>CONCEPT</strong>
                <p>Record what each domain actually requires.</p>
              </div>
              <div>
                <strong>PYQ</strong>
                <p>Map previous questions to each domain.</p>
              </div>
              <div>
                <strong>MOCK</strong>
                <p>Track performance and recurring errors.</p>
              </div>
              <div>
                <strong>REVISION</strong>
                <p>Convert mistakes into short revision points.</p>
              </div>
            </div>

            <h2 id="qualifying">How the Preliminary Stage Fits into Selection</h2>

            <p>
              The Preliminary Examination is the screening stage used for
              selecting candidates for the Main Examination. The official
              framework also describes preparation of the Main-selection list
              using the combined marks of the two Preliminary papers, subject
              to the applicable qualifying standards and rules. citeturn0search14
            </p>

            <div class="flow">
              <div>
                <span>STAGE 01</span>
                <strong>Prelims</strong>
                <small>Objective screening examination</small>
              </div>
              <b>→</b>
              <div>
                <span>STAGE 02</span>
                <strong>Mains</strong>
                <small>Written examination</small>
              </div>
              <b>→</b>
              <div>
                <span>STAGE 03</span>
                <strong>Interview</strong>
                <small>Personality assessment</small>
              </div>
              <b>→</b>
              <div>
                <span>FINAL</span>
                <strong>Selection</strong>
                <small>As per applicable rules</small>
              </div>
            </div>

            <div class="important">
              <strong>Don't confuse screening with low importance:</strong>
              Even when Preliminary marks are not treated as final-merit
              marks, the Prelims determines whether you progress to the next
              stage. Your immediate objective is therefore to clear the
              applicable Preliminary standard with a reliable margin.
            </div>

            <h2 id="strategy">How to Convert the Syllabus into a Study Plan</h2>

            <p>
              Reading the syllabus once is not enough. Turn it into a working
              document that controls your books, PYQs, revision and mocks.
            </p>

            <div class="study-system">
              <div>
                <span>01</span>
                <h3>Download / verify syllabus</h3>
                <p>Start from the latest official JPSC document.</p>
              </div>
              <div>
                <span>02</span>
                <h3>Make topic buckets</h3>
                <p>Break every broad heading into manageable topics.</p>
              </div>
              <div>
                <span>03</span>
                <h3>Attach resources</h3>
                <p>Assign one main source and your notes to each bucket.</p>
              </div>
              <div>
                <span>04</span>
                <h3>Map PYQs</h3>
                <p>Mark which topics have actually produced questions.</p>
              </div>
              <div>
                <span>05</span>
                <h3>Test</h3>
                <p>Use sectional and full-length mocks.</p>
              </div>
              <div>
                <span>06</span>
                <h3>Revise weak areas</h3>
                <p>Use your error log to determine the next study block.</p>
              </div>
            </div>

            <h2>Use a 4-Level Syllabus Tracker</h2>

            <div class="tracker-four">
              <div class="not-started">
                <strong>NOT STARTED</strong>
                <span>Never studied</span>
              </div>
              <div class="learning">
                <strong>LEARNING</strong>
                <span>Currently studying</span>
              </div>
              <div class="revision">
                <strong>REVISION</strong>
                <span>Studied once, needs recall</span>
              </div>
              <div class="mastered">
                <strong>TESTED</strong>
                <span>Repeatedly tested and stable</span>
              </div>
            </div>

            <h2 id="pyq">Why PYQs Should Be Placed Beside the Syllabus</h2>

            <p>
              PYQs are not merely an end-stage practice exercise. They help you
              determine the depth at which a syllabus topic has historically
              been tested.
            </p>

            <div class="pyq-flow">
              <div>
                <span>01</span>
                <strong>Find the question</strong>
                <small>Identify the exact PYQ.</small>
              </div>
              <b>→</b>
              <div>
                <span>02</span>
                <strong>Map topic</strong>
                <small>Attach it to the syllabus.</small>
              </div>
              <b>→</b>
              <div>
                <span>03</span>
                <strong>Study concept</strong>
                <small>Understand the tested idea.</small>
              </div>
              <b>→</b>
              <div>
                <span>04</span>
                <strong>Record pattern</strong>
                <small>Note recurring themes.</small>
              </div>
              <b>→</b>
              <div>
                <span>05</span>
                <strong>Revise</strong>
                <small>Convert it into recall material.</small>
              </div>
            </div>

            <div class="book-cta">
              <div>
                <span>HABITAT IAS</span>
                <h3>JPSC Prelims Decoded: Topic-Wise PYQs</h3>
                <p>
                  Use topic-wise and subject-wise previous questions with
                  explanations to connect the official syllabus with actual
                  examination questions.
                </p>
              </div>
              <a class="btn yellow" href="/book/">View PYQ Book →</a>
            </div>

            <h2 id="mock">How Mock Tests Should Follow the Syllabus</h2>

            <p>
              Do not take mocks randomly and record only the score. A useful
              mock system tells you which syllabus areas are weak and what to
              revise next.
            </p>

            <div class="mock-grid">
              <div>
                <strong>Score</strong>
                <p>Track total performance.</p>
              </div>
              <div>
                <strong>Accuracy</strong>
                <p>Measure how reliably you answer attempted questions.</p>
              </div>
              <div>
                <strong>Topic</strong>
                <p>Identify weak syllabus domains.</p>
              </div>
              <div>
                <strong>Error type</strong>
                <p>Knowledge, confusion, careless error or guess.</p>
              </div>
              <div>
                <strong>Revision action</strong>
                <p>Decide exactly what to study next.</p>
              </div>
              <div>
                <strong>Retest</strong>
                <p>Check whether the weakness has actually improved.</p>
              </div>
            </div>

            <div class="mock-cta">
              <div>
                <span>HABITAT IAS MOCKS</span>
                <h3>Don't just know the syllabus. Test it.</h3>
                <p>
                  Start with an open mock, analyse your mistakes and use the
                  result to update your study plan.
                </p>
              </div>

              <div class="cta-actions">
                <a class="btn yellow" href="/mock-tests/free-gs/">Free GS Mock →</a>
                <a class="btn outline" href="/mock-tests/free-jharkhand/">Free Jharkhand Mock →</a>
              </div>
            </div>

            <h2>JPSC Prelims Time-Management Logic</h2>

            <p>
              Because each Preliminary paper has a 2-hour duration, practise
              answering under a fixed time limit. Do not wait until the final
              weeks to discover that your reading speed and decision-making
              speed are incompatible with the paper.
            </p>

            <div class="time-grid">
              <div>
                <strong>PHASE 1</strong>
                <h3>Build knowledge</h3>
                <p>Learn concepts without obsessing over speed.</p>
              </div>
              <div>
                <strong>PHASE 2</strong>
                <h3>Add timed sections</h3>
                <p>Introduce short timed question sets.</p>
              </div>
              <div>
                <strong>PHASE 3</strong>
                <h3>Full-paper simulation</h3>
                <p>Practise complete papers under the actual time limit.</p>
              </div>
              <div>
                <strong>PHASE 4</strong>
                <h3>Optimise decisions</h3>
                <p>Review where time was lost and why.</p>
              </div>
            </div>

            <h2>What "No Negative Marking" Does — and Does Not — Mean</h2>

            <p>
              The cited official framework states there is no negative marking
              for an incorrect answer. However, candidates should still
              distinguish between an unanswered question and multiple answers:
              the official framework states that giving more than one answer is
              treated as wrong and receives no marks. citeturn0search12
            </p>

            <div class="decision-box">
              <div>
                <span>INCORRECT</span>
                <strong>No negative-mark penalty under the cited framework.</strong>
              </div>
              <div>
                <span>BLANK</span>
                <strong>No penalty for leaving the question unanswered.</strong>
              </div>
              <div>
                <span>MULTIPLE ANSWERS</span>
                <strong>Treated as wrong; no marks awarded.</strong>
              </div>
            </div>

            <h2>Build Your JPSC Preparation Around Four Documents</h2>

            <div class="documents">
              <div>
                <span>A</span>
                <h3>Syllabus</h3>
                <p>Your master checklist.</p>
              </div>
              <div>
                <span>B</span>
                <h3>PYQ Tracker</h3>
                <p>What the examination actually asked.</p>
              </div>
              <div>
                <span>C</span>
                <h3>Revision Notes</h3>
                <p>What you need to remember quickly.</p>
              </div>
              <div>
                <span>D</span>
                <h3>Error Log</h3>
                <p>What you keep getting wrong.</p>
              </div>
            </div>

            <h2 id="plan">A Practical 30-Day Syllabus-Completion Framework</h2>

            <p>
              This is a flexible framework rather than a claim about the exact
              number of days required by every candidate. Adapt the sequence
              according to your existing preparation.
            </p>

            <div class="thirty">
              <div>
                <strong>Days 1–4</strong>
                <span>Syllabus audit + History</span>
              </div>
              <div>
                <strong>Days 5–8</strong>
                <span>Geography + maps</span>
              </div>
              <div>
                <strong>Days 9–12</strong>
                <span>Polity + governance</span>
              </div>
              <div>
                <strong>Days 13–16</strong>
                <span>Economy + development</span>
              </div>
              <div>
                <strong>Days 17–20</strong>
                <span>Science + technology</span>
              </div>
              <div>
                <strong>Days 21–23</strong>
                <span>Jharkhand-specific preparation</span>
              </div>
              <div>
                <strong>Days 24–26</strong>
                <span>Current affairs + weak areas</span>
              </div>
              <div>
                <strong>Days 27–28</strong>
                <span>PYQs + error log</span>
              </div>
              <div class="final">
                <strong>Days 29–30</strong>
                <span>Full mock + analysis + revision</span>
              </div>
            </div>

            <h2>How to Use the Syllabus on Every Study Day</h2>

            <div class="daily">
              <div>
                <span>BEFORE STUDY</span>
                <strong>Choose one syllabus topic.</strong>
              </div>
              <div>
                <span>DURING STUDY</span>
                <strong>Study only the required depth.</strong>
              </div>
              <div>
                <span>AFTER STUDY</span>
                <strong>Solve related PYQs.</strong>
              </div>
              <div>
                <span>WEEKLY</span>
                <strong>Test and update the error log.</strong>
              </div>
            </div>

            <h2 id="mistakes">10 Common JPSC Syllabus Mistakes</h2>

            <div class="mistakes">
              <div><b>01</b><span>Using an old syllabus without checking the current official document.</span></div>
              <div><b>02</b><span>Reading the syllabus once and never using it again.</span></div>
              <div><b>03</b><span>Buying books before mapping the syllabus.</span></div>
              <div><b>04</b><span>Ignoring Paper II until late preparation.</span></div>
