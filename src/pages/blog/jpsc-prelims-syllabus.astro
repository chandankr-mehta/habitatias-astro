const pageTitle =
  "JPSC Prelims Syllabus 2027: Complete Paper 1 & Paper 2 Syllabus, Exam Pattern & Preparation Strategy";
const pageDescription =
  "JPSC Prelims Syllabus 2027 explained paper-wise with the latest published JPSC structure, marks, questions, subjects, Jharkhand-specific topics, PYQ strategy, mock-test strategy and preparation guidance.";

const faqs = [
  {
    question: "How many papers are there in JPSC Prelims?",
    answer:
      "The Preliminary Examination consists of two compulsory papers: General Studies Paper-I and General Studies Paper-II. Each paper carries 200 marks.",
  },
  {
    question: "How many questions are there in each JPSC Prelims paper?",
    answer:
      "The published JPSC scheme specifies 100 objective-type questions in each paper, with each question carrying 2 marks.",
  },
  {
    question: "How much time is given for each JPSC Prelims paper?",
    answer:
      "The published JPSC scheme specifies 2 hours for each Preliminary paper.",
  },
  {
    question: "Is there negative marking in JPSC Prelims?",
    answer:
      "The JPSC examination scheme states that there is no negative marking for an incorrect answer. If more than one option is marked for a question, no marks are awarded; an unanswered question carries no penalty.",
  },
  {
    question: "Is Jharkhand-specific knowledge important for JPSC Prelims?",
    answer:
      "Yes. Jharkhand-specific content is a dedicated component of the Preliminary syllabus, and the second paper is heavily focused on Jharkhand-related subjects.",
  },
  {
    question: "Should I solve JPSC previous year questions?",
    answer:
      "Yes. PYQs should be used to identify recurring topics, understand question framing and connect the official syllabus with actual examination questions.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  url: pageUrl,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: {
    "@type": "Organization",
    name: "Habitat IAS",
  },
  publisher: {
    "@type": "Organization",
    name: "Habitat IAS",
    url: "https://habitatias.com/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
