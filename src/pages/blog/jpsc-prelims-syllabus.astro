      <section class="content-section" id="syllabus">
        <div class="container content-layout">
          <aside class="toc">
            <div class="toc-title">ON THIS PAGE</div>

            <a href="#exam-pattern">1. Exam Pattern</a>
            <a href="#paper-one">2. Paper-I Syllabus</a>
