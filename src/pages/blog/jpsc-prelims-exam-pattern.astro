---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const pageTitle =
  "JPSC Prelims Exam Pattern 2027: Marks, Questions, Time, Negative Marking & Selection Process";
const pageDescription =
  "JPSC Prelims Exam Pattern 2027 explained in detail: two papers, 400 marks, 100 questions per paper, duration, negative marking, qualifying rules, cutoff, selection for Mains and preparation strategy.";
const pageUrl = "https://habitatias.com/blog/jpsc-prelims-exam-pattern/";

const faqs = [
  {
    question: "How many papers are there in JPSC Prelims?",
    answer:
      "JPSC Preliminary Examination consists of two compulsory objective papers: General Studies Paper-I and General Studies Paper-II.",
  },
  {
    question: "How many marks are there in JPSC Prelims?",
    answer:
      "The two Preliminary papers carry 200 marks each, making the Preliminary Examination 400 marks in total.",
  },
  {
    question: "How many questions are asked in each JPSC Prelims paper?",
    answer:
      "The published JPSC scheme specifies 100 objective questions in each paper, with each question carrying 2 marks.",
  },
  {
    question: "What is the duration of JPSC Prelims?",
    answer:
      "Each Preliminary paper is of 2 hours duration under the published scheme.",
  },
  {
    question: "Is there negative marking in JPSC Prelims?",
    answer:
      "The published JPSC scheme states that there is no negative marking for an incorrect answer. If more than one option is marked for a question, no marks are awarded for that question.",
  },
  {
    question: "Are JPSC Prelims marks counted in final merit?",
    answer:
      "The Preliminary Examination is a screening stage for admission to the Main Examination. Candidates should consult the latest applicable JPSC rules and advertisement for the exact treatment of Preliminary marks in the recruitment cycle.",
  },
  {
    question: "How are candidates selected for JPSC Mains?",
    answer:
      "The published JPSC scheme states that the Preliminary selection list is prepared on the basis of marks obtained in both Preliminary papers, subject to the applicable minimum qualifying standards and category-wise cutoff provisions.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  url: pageUrl,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: {
    "@type": "Organization",
    name: "Habitat IAS",
  },
  publisher: {
    "@type": "Organization",
    name: "Habitat IAS",
    url: "https://habitatias.com/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle} | Habitat IAS</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="JPSC exam pattern 2027, JPSC prelims exam pattern, JPSC prelims marks, JPSC prelims questions, JPSC negative marking, JPSC paper 1, JPSC paper 2, JPSC selection process, JPSC cutoff, JPSC prelims preparation"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Habitat IAS" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body>
    <Header />

    <main>
      <div class="breadcrumb-wrap">
        <div class="container">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/blog/">Blog</a>
            <span>›</span>
            <span>JPSC Prelims Exam Pattern</span>
          </nav>
        </div>
      </div>

      <section class="hero">
        <div class="container hero-inner">
          <div class="eyebrow-pill">JPSC EXAM GUIDE</div>

          <h1>
            JPSC Prelims Exam Pattern 2027:
            <span>Complete Marks &amp; Paper Pattern</span>
          </h1>

          <p class="hero-copy">
            How many questions? How many marks? How much time? Is there
            negative marking? This complete guide explains the JPSC Preliminary
            Examination structure and how to use it to plan your preparation.
          </p>

          <div class="meta">
            <span>Updated: 16 August 2026</span>
            <span>•</span>
            <span>Habitat IAS</span>
            <span>•</span>
            <span>Approx. 12 min read</span>
          </div>

          <div class="actions">
            <a href="#pattern" class="btn yellow">See Exam Pattern ↓</a>
            <a href="/mock-tests/free-gs/" class="btn outline">
              Attempt Free Mock →
            </a>
          </div>
        </div>
      </section>

      <section class="notice-section">
        <div class="container">
          <div class="notice">
            <strong>2027 preparation note:</strong>
            <p>
              JPSC's official website currently lists the Jharkhand Combined
              Civil Services Examination-2025 under Advertisement No. 01/2026,
              with subsequent notices and the Preliminary result published in
              2026. This article uses the latest published examination
              structure as the preparation reference for future aspirants.
              Always verify the next official notification before relying on
              any changed rule, date or qualifying standard.
            </p>
          </div>
        </div>
      </section>

      <section class="quick-section" id="pattern">
        <div class="container">
          <div class="heading">
            <div class="eyebrow">AT A GLANCE</div>
            <h2>JPSC Prelims <span>in Numbers</span></h2>
          </div>

          <div class="quick-grid">
            <div><strong>2</strong><span>Compulsory Papers</span></div>
            <div><strong>400</strong><span>Total Marks</span></div>
            <div><strong>100</strong><span>Questions / Paper</span></div>
            <div><strong>200</strong><span>Marks / Paper</span></div>
            <div><strong>2 hrs</strong><span>Time / Paper</span></div>
            <div class="green"><strong>0</strong><span>Negative Marking</span></div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <div class="container layout">
          <aside class="toc">
            <div class="toc-title">ON THIS PAGE</div>
            <a href="#pattern-table">Exam Pattern</a>
            <a href="#paper-one">Paper-I</a>
            <a href="#paper-two">Paper-II</a>
            <a href="#negative">Negative Marking</a>
            <a href="#selection">Selection for Mains</a>
            <a href="#cutoff">Cutoff &amp; Qualifying</a>
            <a href="#time">Time Management</a>
            <a href="#strategy">Preparation Strategy</a>
            <a href="#mock">Mock-Test Strategy</a>
            <a href="#faq">FAQs</a>
          </aside>

          <article class="article">
            <p class="lead">
              Knowing the JPSC syllabus is only half the preparation problem.
              You also need to understand the examination mechanics: the
              number of papers, marks, question count, time available, marking
              rules and the way the Preliminary stage leads to the Main
              Examination.
            </p>

            <h2 id="pattern-table">JPSC Prelims Exam Pattern</h2>

            <p>
              According to the JPSC examination scheme published with the
              Combined Civil Services examination advertisement, the
              Preliminary Examination has two compulsory objective papers:
              General Studies-I and General Studies-II. Each paper carries
              200 marks and is conducted for 2 hours.
            </p>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Feature</th>
                    <th>Paper-I</th>
                    <th>Paper-II</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Subject</td>
                    <td>General Studies-I</td>
                    <td>General Studies-II</td>
                    <td>2 papers</td>
                  </tr>
                  <tr>
                    <td>Question type</td>
                    <td>Objective / MCQ</td>
                    <td>Objective / MCQ</td>
                    <td>MCQ</td>
                  </tr>
                  <tr>
                    <td>Questions</td>
                    <td>100</td>
                    <td>100</td>
                    <td>200</td>
                  </tr>
                  <tr>
                    <td>Marks</td>
                    <td>200</td>
                    <td>200</td>
                    <td>400</td>
                  </tr>
                  <tr>
                    <td>Duration</td>
                    <td>2 hours</td>
                    <td>2 hours</td>
                    <td>4 hours total</td>
                  </tr>
                  <tr>
                    <td>Language</td>
                    <td colspan="2">Hindi &amp; English</td>
                    <td>Both</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="official-box">
              <strong>Official rule:</strong>
              The JPSC scheme states that the Preliminary question papers are
              set in both Hindi and English. The selection list for the Main
              Examination is prepared from the marks obtained in both
              Preliminary papers, subject to the applicable qualifying
              standards.
            </div>

            <h2 id="paper-one">JPSC Prelims Paper-I</h2>

            <p>
              General Studies-I is the broad General Studies paper. The
              published distribution covers Indian History, Geography of India,
              Indian Polity and Governance, Economic and Sustainable
              Development, Science and Technology, Jharkhand-specific
              knowledge, national and international current events, and general
              miscellaneous topics.
            </p>

            <div class="subject-grid">
              <div>
                <b>15</b>
                <h3>History of India</h3>
                <p>Ancient, Medieval and Modern India.</p>
              </div>
              <div>
                <b>10</b>
                <h3>Geography of India</h3>
                <p>General, physical, economic, social and demographic geography.</p>
              </div>
              <div>
                <b>10</b>
                <h3>Polity &amp; Governance</h3>
                <p>Constitution, administration, governance and local bodies.</p>
              </div>
              <div>
                <b>10</b>
                <h3>Economy &amp; Development</h3>
                <p>Indian economy, sustainable development and reforms.</p>
              </div>
              <div>
                <b>15</b>
                <h3>Science &amp; Technology</h3>
                <p>General science, agriculture technology and ICT.</p>
              </div>
              <div>
                <b>10</b>
                <h3>Jharkhand Specific</h3>
                <p>State history, society, culture and heritage.</p>
              </div>
              <div>
                <b>15</b>
                <h3>Current Events</h3>
                <p>National and international current events.</p>
              </div>
              <div>
                <b>15</b>
                <h3>Miscellaneous</h3>
                <p>General topics included in the published syllabus.</p>
              </div>
            </div>

            <p class="small">
              The distribution above follows the published JPSC Paper-I
              structure. See the complete syllabus guide for topic-level
              preparation.
            </p>

            <a class="internal-link" href="/blog/jpsc-prelims-syllabus/">
              Read: JPSC Prelims Syllabus 2027 — Complete Paper-I &amp;
              Paper-II Guide →
            </a>

            <h2 id="paper-two">JPSC Prelims Paper-II</h2>

            <p>
              General Studies-II has a strong Jharkhand focus. The published
              syllabus covers the history and movement of Jharkhand, its
              distinct identity, culture, literature, educational institutions,
              sports, land laws, geography and economic development, industries,
              major schemes, forests and wildlife, environment, disaster
              management and miscellaneous/current-affairs areas.
            </p>

            <div class="jh-grid">
              <span>Jharkhand History</span>
              <span>Jharkhand Movement</span>
              <span>Distinct Identity</span>
              <span>Culture &amp; Festivals</span>
              <span>Literature &amp; Writers</span>
              <span>Educational Institutions</span>
              <span>Sports</span>
              <span>CNT &amp; SPT / Land Laws</span>
              <span>Geography</span>
              <span>Economic Development</span>
              <span>Industries</span>
              <span>Major Schemes</span>
              <span>Forest &amp; Wildlife</span>
              <span>Environment</span>
              <span>Disaster Management</span>
              <span>Current Affairs</span>
            </div>

            <div class="jh-cta">
              <div>
                <span>JHARKHAND SPECIAL PRACTICE</span>
                <h3>Test your Jharkhand preparation.</h3>
                <p>
                  Don't wait until the final revision to discover weak areas.
                  Attempt the free Jharkhand-focused mock.
                </p>
              </div>
              <a class="btn yellow" href="/mock-tests/free-jharkhand/">
                Attempt Free Jharkhand Mock →
              </a>
            </div>

            <h2 id="negative">Negative Marking in JPSC Prelims</h2>

            <div class="zero-card">
              <div class="zero">0</div>
              <div>
                <h3>No negative marking for an incorrect answer</h3>
                <p>
                  The published JPSC scheme states that there is no negative
                  marking for an incorrect answer. However, marking more than
                  one answer for a question results in no marks for that
                  question, and leaving a question blank carries no penalty.
                 
                </p>
              </div>
            </div>

            <h3>What does this mean in practice?</h3>

            <ul class="checks">
              <li>Incorrect single option → no negative deduction.</li>
              <li>More than one option marked → no marks for that question.</li>
              <li>Question left unanswered → no penalty.</li>
              <li>Correct answer → full marks under the published +2 structure.</li>
            </ul>

            <div class="tip">
              <strong>Preparation lesson:</strong>
              No negative marking should not become an excuse for careless
              attempts. Train yourself to distinguish between questions you
              know, questions you can solve by elimination and questions where
              you have no usable information.
            </div>

            <h2 id="selection">JPSC Prelims Selection Process</h2>

            <p>
              The Combined Civil Services examination is conducted in successive
              stages. The Preliminary Examination is an objective screening
              examination used for selection of candidates for the Main Written
              Examination. The complete recruitment process then proceeds
              through the Main Examination and interview stage under the
              applicable rules.
            </p>

            <div class="process">
              <div>
                <span>01</span>
                <strong>Prelims</strong>
                <small>Objective screening examination</small>
              </div>
              <i>→</i>
              <div>
                <span>02</span>
                <strong>Mains</strong>
                <small>Written Main Examination</small>
              </div>
              <i>→</i>
              <div>
                <span>03</span>
                <strong>Interview</strong>
                <small>Personality / interview stage</small>
              </div>
              <i>→</i>
              <div>
                <span>04</span>
                <strong>Final Selection</strong>
                <small>As per applicable rules</small>
              </div>
            </div>

            <h2 id="cutoff">JPSC Prelims Cutoff &amp; Qualifying Standard</h2>

            <p>
              There is an important distinction between the overall Preliminary
              score and the minimum qualifying standard. The published
              advertisement states that the selection list for the Main
              Examination is prepared from the combined marks of both
              Preliminary papers, while candidates must also meet the minimum
              qualifying standard prescribed under the applicable JPSC rules.
             
            </p>

            <div class="cutoff-grid">
              <div>
                <strong>01</strong>
                <h3>Total Prelims score</h3>
                <p>Both compulsory papers contribute to the Preliminary selection score.</p>
              </div>
              <div>
                <strong>02</strong>
                <h3>Category cutoff</h3>
                <p>The Commission prepares the selection list according to applicable category-wise provisions.</p>
              </div>
              <div>
                <strong>03</strong>
                <h3>Minimum qualifying standard</h3>
                <p>Candidates must satisfy the qualifying standard prescribed in the applicable rules.</p>
              </div>
            </div>

            <div class="warning">
              <strong>Do not memorize one fixed cutoff for every JPSC cycle.</strong>
              <p>
                Cutoff changes with vacancies, candidate performance, paper
                difficulty and applicable category-wise rules. Use previous
                cutoffs for planning, not as a permanent qualifying threshold.
              </p>
            </div>

            <h2 id="time">JPSC Prelims Time Management</h2>

            <p>
              With 100 questions in 120 minutes, the simple mathematical
              average is approximately 72 seconds per question. That does not
              mean you should spend exactly 72 seconds on every question.
              Questions vary significantly in difficulty.
            </p>

            <div class="time-grid">
              <div>
                <strong>Pass 1</strong>
                <h3>Direct questions</h3>
                <p>Answer questions you know immediately.</p>
              </div>
              <div>
                <strong>Pass 2</strong>
                <h3>Reasoning / elimination</h3>
                <p>Return to questions that require thought but remain manageable.</p>
              </div>
              <div>
                <strong>Pass 3</strong>
                <h3>Review</h3>
                <p>Use remaining time to check doubtful questions and marking.</p>
              </div>
            </div>

            <div class="formula">
              <span>120 MINUTES</span>
              <b>÷</b>
              <span>100 QUESTIONS</span>
              <b>≈</b>
              <strong>72 SEC / QUESTION</strong>
            </div>

            <h2 id="strategy">How to Prepare According to the Exam Pattern</h2>

            <p>
              Your preparation should mirror the structure of the examination.
              Treat Paper-I and Paper-II as connected but separate preparation
              tracks, then combine them through mixed mocks.
            </p>

            <div class="strategy-grid">
              <div>
                <span>01</span>
                <h3>Build Paper-I foundation</h3>
                <p>Cover History, Geography, Polity, Economy, Science and current affairs.</p>
              </div>
              <div>
                <span>02</span>
                <h3>Build Jharkhand depth</h3>
                <p>Maintain a separate Jharkhand notebook for Paper-I and Paper-II.</p>
              </div>
              <div>
                <span>03</span>
                <h3>Analyse PYQs</h3>
                <p>Map previous questions to the syllabus and identify recurring themes.</p>
              </div>
              <div>
                <span>04</span>
                <h3>Introduce timed mocks</h3>
                <p>Practise the complete 100-question, 120-minute format.</p>
              </div>
            </div>

            <h2 id="mock">Why Mock Tests Matter</h2>

            <p>
              Reading the exam pattern tells you what the paper looks like.
              A timed mock tells you whether your preparation works under
              examination conditions.
            </p>

            <div class="mock-box">
              <div>
                <span>FREE OPEN MOCK</span>
                <h3>Experience the JPSC pattern before the real exam.</h3>
                <p>
                  Attempt a free Habitat IAS mock, analyse your performance and
                  identify the subjects that need more revision.
                </p>
              </div>
              <div class="mock-actions">
                <a class="btn yellow" href="/mock-tests/free-gs/">
                  Free GS Mock →
                </a>
                <a class="btn outline" href="/mock-tests/free-jharkhand/">
                  Free Jharkhand Mock →
                </a>
              </div>
            </div>

            <h2>Use PYQs to Understand the Pattern</h2>

            <p>
              The exam pattern tells you the structure; previous year questions
              show you how that structure becomes real questions. For every PYQ,
              record the paper, subject, topic, difficulty and whether the
              question is factual, conceptual or current-affairs based.
            </p>

            <a class="book-box" href="/book/">
              <div>
                <span>JPSC PRELIMS DECODED</span>
                <h3>Connect the syllabus with topic-wise PYQs.</h3>
                <p>
                  Explore Habitat IAS's <strong>JPSC Prelims Decoded:
                  Topic-Wise PYQs</strong> with explanations and structured
                  previous-year-question analysis.
                </p>
              </div>
              <strong>Explore Book →</strong>
            </a>

            <h2>JPSC Prelims: The Smart Preparation Formula</h2>

            <div class="formula big">
              <span>SYLLABUS</span>
              <b>+</b>
              <span>PYQs</span>
              <b>+</b>
              <span>REVISION</span>
              <b>+</b>
              <span>MOCKS</span>
              <b>=</b>
              <strong>EXAM READINESS</strong>
            </div>

            <h2 id="faq">Frequently Asked Questions</h2>

            <div class="faq">
              {faqs.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>

            <div class="official-source">
              <h3>Check the latest official JPSC information</h3>
              <p>
                JPSC's official website currently lists the Combined Civil
                Services Examination-2025 under Advertisement No. 01/2026 and
                maintains the official syllabus, examination notices and
                related documents.
              </p>
              <a
                href="https://www.jpsc.gov.in/exam_files.php?id=13039"
                target="_blank"
                rel="noopener noreferrer"
              >
                View official Combined Civil Services notices →
              </a>
              <a
                href="https://www.jpsc.gov.in/Syllabus.php"
                target="_blank"
                rel="noopener noreferrer"
              >
                View official JPSC syllabus page →
              </a>
            </div>
          </article>
        </div>
      </section>

      <section class="related-section">
        <div class="container">
          <div class="heading">
            <div class="eyebrow">CONTINUE PREPARATION</div>
            <h2>What should you do <span>next?</span></h2>
          </div>

          <div class="related-grid">
            <a href="/blog/jpsc-prelims-syllabus/" class="related-card">
              <span>01</span>
              <h3>JPSC Syllabus</h3>
              <p>Study the complete Paper-I and Paper-II syllabus.</p>
              <strong>Read syllabus →</strong>
            </a>

            <a href="/mock-tests/free-gs/" class="related-card">
              <span>02</span>
              <h3>Free GS Mock</h3>
              <p>Test your General Studies preparation.</p>
              <strong>Attempt mock →</strong>
            </a>

            <a href="/mock-tests/free-jharkhand/" class="related-card">
              <span>03</span>
              <h3>Jharkhand Mock</h3>
              <p>Practise Jharkhand-focused questions.</p>
              <strong>Attempt mock →</strong>
            </a>

            <a href="/book/" class="related-card">
              <span>04</span>
              <h3>JPSC PYQ Book</h3>
              <p>Explore topic-wise previous year questions.</p>
              <strong>View book →</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    color: #10264d;
    background: #fff;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
  }
  :global(a) { text-decoration: none; }

  :root {
    --blue: #1657d9;
    --dark: #0d2450;
    --yellow: #ffd43b;
    --light: #f4f7fd;
    --lighter: #f8faff;
    --border: #dce5f5;
    --muted: #64748b;
    --green: #14804a;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .breadcrumb-wrap {
    border-bottom: 1px solid var(--border);
    background: #fff;
  }

  .breadcrumbs {
    min-height: 58px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    color: #7a8aa5;
    font-size: 13px;
  }

  .breadcrumbs a {
    color: var(--blue);
    font-weight: 800;
  }

  .hero {
    background:
      radial-gradient(circle at 90% 15%, rgba(255,212,59,.17), transparent 25%),
      linear-gradient(120deg, #0e357f, #1657d9 68%, #2d6ee5);
  }

  .hero-inner {
    padding: 78px 0 82px;
    color: white;
  }

  .eyebrow,
  .eyebrow-pill,
  .jh-cta span,
  .mock-box span,
  .book-box span {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.35px;
    text-transform: uppercase;
  }

  .eyebrow-pill {
    display: inline-flex;
    padding: 9px 14px;
    border: 1px solid rgba(255,255,255,.42);
    border-radius: 30px;
  }

  .hero h1 {
    max-width: 1000px;
