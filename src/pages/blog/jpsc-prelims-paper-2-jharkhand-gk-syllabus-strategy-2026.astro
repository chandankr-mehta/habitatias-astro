---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const title =
  "JPSC Prelims Paper 2: Jharkhand GK Syllabus, Important Topics, PYQ Strategy & Preparation Plan 2026";
const description =
  "Complete JPSC Prelims Paper 2 Jharkhand GK guide covering Jharkhand history, movement, tribes, culture, literature, geography, laws, economy, industries, schemes, environment, disaster management, PYQs and a practical preparation strategy.";
const canonical =
  "https://habitatias.com/blog/jpsc-prelims-paper-2-jharkhand-gk-syllabus-strategy-2026/";

const faqs = [
  {
    q: "What is JPSC Prelims Paper 2?",
    a: "Paper 2 is the Jharkhand-focused General Studies paper in the published Combined Civil Services Preliminary scheme. It tests knowledge of Jharkhand's history, movement, society, culture, literature, geography, economy, laws, development, environment and other state-specific areas.",
  },
  {
    q: "Is Jharkhand GK important for JPSC Prelims?",
    a: "Yes. Jharkhand-specific knowledge is a major part of the Preliminary examination and deserves dedicated preparation rather than being treated as a small supplement to general studies.",
  },
  {
    q: "Which Jharkhand topics should I study first?",
    a: "Start with the official syllabus, then prioritise Jharkhand history and movement, geography, tribes and society, culture and literature, land-related laws, economy and industries, government schemes, environment and current affairs. Use PYQs to refine the order.",
  },
  {
    q: "How should I prepare CNT and SPT Acts for JPSC?",
    a: "Study the purpose, historical context, key provisions, terminology, applicability and major distinctions from an authoritative source. Then solve JPSC PYQs and create a short revision sheet. Verify legal provisions against the current law and official sources.",
  },
  {
    q: "How can PYQs help with Jharkhand GK?",
    a: "PYQs reveal which parts of the large Jharkhand syllabus have actually been converted into objective questions. Map each question to a topic, study the underlying concept, record mistakes and revisit the topic during revision.",
  },
  {
    q: "Should I study Jharkhand current affairs separately?",
    a: "Yes. Maintain a dedicated Jharkhand current-affairs section and connect each important event with its static background, such as geography, institutions, schemes, economy, environment or culture.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: canonical,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: { "@type": "Organization", name: "Habitat IAS" },
  publisher: {
    "@type": "Organization",
    name: "Habitat IAS",
    url: "https://habitatias.com/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<html lang="en">
