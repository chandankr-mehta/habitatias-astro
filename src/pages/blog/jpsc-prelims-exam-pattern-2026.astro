---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const title =
  "JPSC Prelims Exam Pattern 2026: Papers, Marks, Duration, Questions & Qualifying Rules";
const description =
  "Complete JPSC Prelims exam pattern guide covering the two-paper structure, marks, questions, duration, screening role, marking rules and how to prepare using PYQs and mocks.";
const canonical =
  "https://habitatias.com/blog/jpsc-prelims-exam-pattern-2026/";

const faqs = [
  {
    q: "How many papers are there in JPSC Prelims?",
    a: "The JPSC Combined Civil Services Preliminary Examination has two compulsory General Studies papers under the current published framework: General Studies Paper-I and General Studies Paper-II.",
  },
  {
    q: "How many marks is JPSC Prelims?",
    a: "The current published JPSC framework specifies two Preliminary papers of 200 marks each, for 400 marks in total.",
  },
  {
    q: "How many questions are there in JPSC Prelims?",
    a: "The published scheme specifies 100 objective-type questions in each Preliminary paper, with each question carrying 2 marks.",
  },
  {
    q: "How much time is given for each JPSC Prelims paper?",
    a: "The published scheme provides 2 hours for each Preliminary paper.",
  },
  {
    q: "Do JPSC Prelims marks count in final merit?",
    a: "The 2021 rules describe the Preliminary Examination as a screening test and state that Preliminary marks of candidates qualified for the Main Examination are not counted for final merit. Candidates should verify the rules applicable to their current recruitment.",
  },
  {
    q: "Is there negative marking in JPSC Prelims?",
    a: "The 2021 rules state that there is no negative marking for an incorrect answer and no penalty for leaving a question blank, while selecting more than one answer is treated as wrong. Always check the current advertisement and rules before the examination.",
  },
  {
    q: "What is the best way to prepare according to the JPSC exam pattern?",
    a: "Use the official syllabus as the master list, analyse previous-year questions topic-wise, practise full papers under the applicable time limit, maintain an error log and use mocks to improve accuracy and speed.",
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: canonical,
  datePublished: "2026-08-16",
  dateModified: "2026-08-16",
  author: { "@type": "Organization", name: "Habitat IAS" },
  publisher: {
    "@type": "Organization",
    name: "Habitat IAS",
    url: "https://habitatias.com/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

