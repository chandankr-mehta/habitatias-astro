---
/*
 * ============================================================
 * HABITAT IAS
 * FORGOT PASSWORD PAGE
 * ============================================================
 *
 * Supabase password reset flow:
 *
 * 1. Student enters registered email.
 * 2. Supabase sends password-reset email.
 * 3. Email redirects student back to the website.
 * 4. Reset-password page will handle the new password.
 *
 * ============================================================
 */
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Habitat IAS Student Password Recovery"
  />

  <title>Forgot Password | Habitat IAS</title>

  <style>

    /* ========================================================
       RESET
    ======================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {

      min-height: 100vh;

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #eef5ff 0%,
          #f7faff 45%,
          #edf7ff 100%
        );

      color: #102a43;

      -webkit-font-smoothing: antialiased;

    }

    button,
    input {
      font: inherit;
    }

    button {
      border: none;
    }

    a {
      text-decoration: none;
    }


    /* ========================================================
       PAGE
    ======================================================== */

    .page {

      min-height: 100vh;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 30px 20px;

      position: relative;

      overflow: hidden;

    }


    /* ========================================================
       BACKGROUND DECORATION
    ======================================================== */

    .background-circle {

      position: absolute;

      border-radius: 50%;

      pointer-events: none;

      filter: blur(1px);

    }

    .circle-one {

      width: 430px;

      height: 430px;

      top: -220px;

      right: -130px;

      background:
        rgba(37, 99, 235, 0.08);

    }

    .circle-two {

      width: 360px;

      height: 360px;

      bottom: -210px;

      left: -160px;

      background:
        rgba(14, 165, 233, 0.07);

    }


    /* ========================================================
       CARD
    ======================================================== */

    .card {

      position: relative;

      z-index: 2;

      width: 100%;

      max-width: 560px;

      background: #ffffff;

      border:
        1px solid
        rgba(148, 163, 184, 0.20);

      border-radius: 24px;

      padding: 48px 52px;

      box-shadow:
        0 30px 80px
        rgba(15, 23, 42, 0.13);

    }


    /* ========================================================
       LOGO
    ======================================================== */

    .logo {

      width: 58px;

      height: 58px;

      display: flex;

      align-items: center;

      justify-content: center;

      margin-bottom: 22px;

      border-radius: 16px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #082b55,
          #1459a6
        );

      box-shadow:
        0 12px 30px
        rgba(37, 99, 235, 0.20);

      font-size: 26px;

      font-weight: 950;

    }


    /* ========================================================
       BRAND
    ======================================================== */

    .brand {

      color: #0b2545;

      font-size: 25px;

      line-height: 1.1;

      font-weight: 950;

      letter-spacing: -0.5px;

    }

    .tagline {

      margin-top: 6px;

      color: #64748b;

      font-size: 9px;

      font-weight: 850;

      letter-spacing: 1.2px;

      text-transform: uppercase;

    }


    /* ========================================================
       CONTENT
    ======================================================== */

    .kicker {

      margin-top: 32px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 950;

      letter-spacing: 1.4px;

      text-transform: uppercase;

    }

    .title {

      margin-top: 8px;

      color: #0b2545;

      font-size: 31px;

      line-height: 1.15;

      font-weight: 950;

      letter-spacing: -0.7px;

    }

    .description {

      max-width: 430px;

      margin-top: 10px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;

    }


    /* ========================================================
       STATUS
    ======================================================== */

    .status {

      display: none;

      margin-top: 22px;

      padding: 12px 14px;

      border-radius: 10px;

      font-size: 11px;

      line-height: 1.5;

      font-weight: 750;

    }

    .status.error {

      display: block;

      color: #991b1b;

      background: #fef2f2;

      border:
        1px solid
        #fecaca;

    }

    .status.success {

      display: block;

      color: #166534;

      background: #f0fdf4;

      border:
        1px solid
        #bbf7d0;

    }


    /* ========================================================
       FORM
    ======================================================== */

    .form {

      margin-top: 28px;

    }

    .field {

      margin-bottom: 18px;

    }

    .field-label {

      display: block;

      margin-bottom: 7px;

      color: #334155;

      font-size: 10px;

      font-weight: 900;

    }

    .input-wrap {

      position: relative;

    }

    .input-icon {

      position: absolute;

      left: 14px;

      top: 50%;

      transform:
        translateY(-50%);

      color: #94a3b8;

      font-size: 13px;

      pointer-events: none;

    }

    .field-input {

      width: 100%;

      height: 50px;

      padding:
        0 14px 0 40px;

      color: #172033;

      background: #f8fafc;

      border:
        1px solid
        #dbe3ec;

      border-radius: 10px;

      outline: none;

      font-size: 13px;

      transition:
        border-color .16s ease,
        background .16s ease,
        box-shadow .16s ease;

    }

    .field-input::placeholder {

      color: #a0aec0;

    }

    .field-input:hover {

      border-color:
        #cbd5e1;

    }

    .field-input:focus {

      background: #ffffff;

      border-color:
        #60a5fa;

      box-shadow:
        0 0 0 4px
        rgba(37,99,235,0.08);

    }


    /* ========================================================
       BUTTON
    ======================================================== */

    .button {

      width: 100%;

      height: 50px;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      border-radius: 10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #1d4ed8
        );

      cursor: pointer;

      font-size: 12px;

      font-weight: 900;

      box-shadow:
        0 10px 24px
        rgba(37,99,235,0.20);

      transition:
        transform .15s ease,
        box-shadow .15s ease,
        opacity .15s ease;

    }

    .button:hover:not(:disabled) {

      transform:
        translateY(-1px);

      box-shadow:
        0 14px 28px
        rgba(37,99,235,0.25);

    }

    .button:active:not(:disabled) {

      transform:
        translateY(0);

    }

    .button:disabled {

      cursor: wait;

      opacity: .72;

    }


    /* ========================================================
       SPINNER
    ======================================================== */

    .spinner {

      width: 14px;

      height: 14px;

      border-radius: 50%;

      border:
        2px solid
        rgba(255,255,255,0.35);

      border-top-color:
        #ffffff;

      animation:
        spin .7s linear infinite;

    }

    @keyframes spin {

      to {

        transform:
          rotate(360deg);

      }

    }


    /* ========================================================
       BACK TO LOGIN
    ======================================================== */

    .back-login {

      margin-top: 22px;

      text-align: center;

      color: #64748b;

      font-size: 11px;

    }

    .back-login a {

      color: #2563eb;

      font-weight: 900;

    }

    .back-login a:hover {

      text-decoration: underline;

    }


    /* ========================================================
       SECURITY NOTE
    ======================================================== */

    .security-note {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      margin-top: 22px;

      color: #94a3b8;

      font-size: 9px;

      font-weight: 700;

    }


    /* ========================================================
       MOBILE
    ======================================================== */

    @media (max-width: 600px) {

      .page {

        padding: 18px;

      }

      .card {

        padding:
          38px 30px;

        border-radius: 20px;

      }

      .title {

        font-size: 27px;

      }

    }

    @media (max-width: 420px) {

      .page {

        padding: 10px;

      }

      .card {

        padding:
          32px 22px;

      }

    }

  </style>

</head>


<body>

  <main class="page">

    <!-- Background -->

    <div
      class="background-circle circle-one"
    ></div>

    <div
      class="background-circle circle-two"
    ></div>


    <!-- Card -->

    <section class="card">

      <!-- Logo -->

      <div class="logo">
        H
      </div>


      <!-- Brand -->

      <div class="brand">
        Habitat IAS
      </div>

      <div class="tagline">
        Civil Services Preparation
      </div>


      <!-- Content -->

      <div class="kicker">
        Account Recovery
      </div>

      <h1 class="title">
        Forgot your password?
      </h1>

      <p class="description">

        Enter the email address associated with
        your Habitat IAS student account. We will
        send you a secure password reset link.

      </p>


      <!-- Status -->

      <div
        id="status"
        class="status"
        role="alert"
        aria-live="polite"
      ></div>


      <!-- Form -->

      <form
        id="forgotForm"
        class="form"
        novalidate
      >

        <div class="field">

          <label
            class="field-label"
            for="email"
          >
            Email Address
          </label>

          <div class="input-wrap">

            <span
              class="input-icon"
              aria-hidden="true"
            >
              ✉
            </span>

            <input
              id="email"
              name="email"
              class="field-input"
              type="email"
              autocomplete="email"
              placeholder="Enter your registered email"
              required
            />

          </div>

        </div>


        <button
          id="resetButton"
          class="button"
          type="submit"
        >

          <span id="buttonText">
            Send Reset Link
          </span>

        </button>

      </form>


      <!-- Back -->

      <div class="back-login">

        Remember your password?

        <a href="/login">
          Back to Login
        </a>

      </div>


      <!-- Security -->

      <div class="security-note">

        <span>🔐</span>

        Secure password recovery powered by Supabase

      </div>

    </section>

  </main>


  <!-- ======================================================
       JAVASCRIPT
  ======================================================= -->

  <script>

    import {
      supabase
    } from "../lib/supabase";


    /* ======================================================
       ELEMENTS
    ======================================================= */

    const form =
      document.getElementById(
        "forgotForm"
      );

    const emailInput =
      document.getElementById(
        "email"
      );

    const resetButton =
      document.getElementById(
        "resetButton"
      );

    const buttonText =
      document.getElementById(
        "buttonText"
      );

    const statusBox =
      document.getElementById(
        "status"
      );


    /* ======================================================
       STATUS
    ======================================================= */

    function showStatus(
      message,
      type = "error"
    ) {

      if (!statusBox) return;

      statusBox.textContent =
        message;

      statusBox.className =
        "status " + type;

    }


    function clearStatus() {

      if (!statusBox) return;

      statusBox.textContent =
        "";

      statusBox.className =
        "status";

    }


    /* ======================================================
       LOADING
    ======================================================= */

    function setLoading(
      loading
    ) {

      if (!resetButton) return;

      resetButton.disabled =
        loading;

      if (loading) {

        buttonText.innerHTML = `
          <span class="spinner"></span>
          Sending reset link...
        `;

      } else {

        buttonText.textContent =
          "Send Reset Link";

      }

    }


    /* ======================================================
       CLEAR STATUS
    ======================================================= */

    emailInput?.addEventListener(
      "input",
      () => {

        if (
          statusBox?.classList.contains(
            "error"
          )
        ) {

          clearStatus();

        }

      }
    );


    /* ======================================================
       PASSWORD RESET
    ======================================================= */

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();

        clearStatus();


        const email =
          emailInput?.value
            ?.trim()
            ?.toLowerCase();


        /* --------------------------------------------------
           VALIDATION
        -------------------------------------------------- */

        if (!email) {

          showStatus(
            "Please enter your email address."
          );

          emailInput?.focus();

          return;

        }


        if (!email.includes("@")) {

          showStatus(
            "Please enter a valid email address."
          );

          emailInput?.focus();

          return;

        }


        /* --------------------------------------------------
           START REQUEST
        -------------------------------------------------- */

        setLoading(true);


        try {

          /*
           * Supabase will send the recovery email.
           *
           * The user will be redirected to:
           *
           * /reset-password
           *
           * after opening the recovery link.
           */

          const {
            error
          } =
            await supabase.auth
              .resetPasswordForEmail(
                email,
                {
                  redirectTo:
                    `${window.location.origin}/reset-password`
                }
              );


          /* ------------------------------------------------
             ERROR
          ------------------------------------------------- */

          if (error) {

            console.error(
              "Password reset error:",
              error
            );


            const errorText =
              (
                error.message ||
                ""
              ).toLowerCase();


            let message =
              "Unable to send the reset link. Please try again.";


            if (
              errorText.includes(
                "rate"
              )
            ) {

              message =
                "Too many requests. Please wait a moment and try again.";

            }

            else if (
              errorText.includes(
                "network"
              )
            ) {

              message =
                "Network connection problem. Please check your internet connection.";

            }


            showStatus(
              message
            );

            setLoading(false);

            return;

          }


          /* ------------------------------------------------
             SUCCESS
          ------------------------------------------------- */

          showStatus(
            "If an account exists with this email, a password reset link has been sent. Please check your inbox.",
            "success"
          );


          /*
           * Clear the email after successful request.
           */

          if (emailInput) {

            emailInput.value = "";

          }


          setLoading(false);


        } catch (error) {

          console.error(
            "Unexpected password reset error:",
            error
          );


          showStatus(
            "Something went wrong. Please try again."
          );


          setLoading(false);

        }

      }
    );

  </script>

</body>

</html>