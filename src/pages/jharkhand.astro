    description:
      "Ancient, medieval and modern historical developments, regional kingdoms, tribal history and important historical events.",
    link: "#history"
  },
  {
    icon: "🌳",
    title: "Jharkhand Geography",
    description:
      "Physiography, rivers, climate, soils, forests, minerals, agriculture, resources and regional geography.",
    link: "#geography"
  },
  {
    icon: "🧑🏽‍🤝‍🧑🏽",
    title: "Tribes & Culture",
    description:
      "Major tribal communities, languages, traditions, festivals, folk culture, literature and social institutions.",
    link: "#tribes"
  },
  {
    icon: "⚖️",
    title: "Land Laws",
    description:
      "Important provisions and examination-relevant aspects of CNT Act, SPT Act and other land-related laws.",
    link: "#land-laws"
  },
  {
    icon: "⛏️",
    title: "Economy & Industries",
    description:
      "Mineral resources, industries, agriculture, infrastructure, employment and major economic activities.",
    link: "#economy"
  },
  {
    icon: "🏢",
    title: "Government & Schemes",
    description:
      "Jharkhand government institutions, policies, welfare programmes and important state-level initiatives.",
    link: "#schemes"
  }
];

const focusAreas = [
  "History of Jharkhand",
  "Jharkhand Movement",
  "Tribes & Communities",
  "Folk Literature",
  "Jharkhand Geography",
  "Mineral Resources",
  "Industries",
  "Agriculture",
  "Environment",
  "CNT Act",
  "SPT Act",
  "State Schemes"
];
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Jharkhand Special by Habitat IAS — JPSC-focused notes covering Jharkhand history, geography, tribes, culture, economy, land laws, schemes and environment."
  />

  <meta
    name="keywords"
    content="JPSC Jharkhand, Jharkhand GK, Jharkhand History, Jharkhand Geography, CNT Act, SPT Act, Jharkhand Tribes, Jharkhand Economy"
  />

  <title>Jharkhand Special | JPSC | Habitat IAS</title>

  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;

      color: #172033;

      background: #f7f9fc;
    }

    a {
      text-decoration: none;
    }

    /* ================= HEADER ================= */

    .header {
      position: sticky;

      top: 0;

      z-index: 1000;

      background: rgba(255,255,255,0.97);

      border-bottom: 1px solid #e5eaf2;

      backdrop-filter: blur(12px);
    }

    .nav {
      max-width: 1240px;

      min-height: 78px;

      margin: auto;

      padding: 0 24px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 25px;
    }

    .brand {
      display: flex;

      align-items: center;

      gap: 11px;

      color: #1657d9;

      font-size: 24px;

      font-weight: 900;
    }

    .brand-icon {
      width: 43px;

      height: 43px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      color: white;

      background: #1657d9;

      box-shadow:
        0 8px 22px rgba(22,87,217,0.25);
    }

    .nav-links {
      display: flex;

      align-items: center;

      gap: 18px;
    }

    .nav-links a {
      color: #536078;

      font-size: 14px;

      font-weight: 800;
    }

    .nav-links a:hover {
      color: #1657d9;
    }

    .nav-links .active {
      color: #1657d9;
    }

    .nav-cta {
      padding: 12px 18px;

      border-radius: 10px;

      color: white !important;

      background: #1657d9;
    }

    /* ================= HERO ================= */

    .hero {
      color: white;

      background:
        radial-gradient(
          circle at 82% 18%,
          rgba(255,209,61,0.18),
          transparent 25%
        ),
        linear-gradient(
          135deg,
          #0c347d,
          #1657d9,
          #2872e8
        );
    }

    .hero-inner {
      max-width: 1240px;

      margin: auto;

      padding: 82px 24px 92px;
    }

    .hero-label {
      color: #ffd13d;

      font-size: 12px;

      font-weight: 900;

      letter-spacing: 1.3px;

      text-transform: uppercase;
    }

    .hero h1 {
      max-width: 900px;

      margin: 16px 0 20px;

      font-size: clamp(45px,6vw,72px);

      line-height: 1;

      letter-spacing: -2.5px;
    }

    .hero h1 span {
      color: #ffd13d;
    }

    .hero p {
      max-width: 820px;

      margin: 0;

      color: rgba(255,255,255,0.86);

      font-size: 18px;

      line-height: 1.75;
    }

    .hero-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 12px;

      margin-top: 30px;
    }

    .button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 14px 21px;

      border-radius: 11px;

      font-size: 14px;

      font-weight: 850;

      transition: 0.2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .primary {
      color: #172033;

      background: #ffd13d;
    }

    .secondary {
      color: white;

      background: rgba(255,255,255,0.08);

      border: 1px solid rgba(255,255,255,0.3);
    }

    /* ================= GENERAL ================= */

    .section {
      max-width: 1240px;

      margin: auto;

      padding: 75px 24px;
    }

    .heading {
      max-width: 850px;

      margin-bottom: 40px;
    }

    .section-label {
      color: #1657d9;

      font-size: 12px;

      font-weight: 900;

      letter-spacing: 1.2px;

      text-transform: uppercase;
    }

    .heading h2 {
      margin: 10px 0;

      font-size: clamp(32px,4vw,46px);

      line-height: 1.1;

      letter-spacing: -1.5px;
    }

    .heading p {
      margin: 0;

      color: #68748a;

      font-size: 16px;

      line-height: 1.7;
    }

    /* ================= CORE AREAS ================= */

    .area-grid {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 19px;
    }

    .area-card {
      min-height: 270px;

      padding: 27px;

      display: flex;

      flex-direction: column;

      background: white;

      border: 1px solid #e2e8f1;

      border-radius: 18px;

      transition: 0.25s ease;
    }

    .area-card:hover {
      transform: translateY(-5px);

      box-shadow:
        0 18px 40px rgba(30,50,90,0.09);
    }

    .area-icon {
      width: 54px;

      height: 54px;

      display: grid;

      place-items: center;

      margin-bottom: 19px;

      border-radius: 15px;

      background: #edf3ff;

      font-size: 25px;
    }

    .area-card h3 {
      margin: 0 0 10px;

      font-size: 20px;
    }

    .area-card p {
      margin: 0;

      color: #68748a;

      font-size: 14px;

      line-height: 1.65;
    }

    .area-link {
      margin-top: auto;

      padding-top: 20px;

      color: #1657d9;

      font-size: 12px;

      font-weight: 900;
    }

    /* ================= FOCUS ================= */

    .focus-section {
      background: white;
    }

    .focus-box {
      padding: 38px;

      border: 1px solid #e2e8f1;

      border-radius: 21px;

      background: white;
    }

    .focus-box h3 {
      margin: 0 0 10px;

      font-size: 26px;
    }

    .focus-box p {
      max-width: 780px;

      margin: 0 0 25px;

      color: #68748a;

      font-size: 14px;

      line-height: 1.7;
    }

    .focus-list {
      display: flex;

      flex-wrap: wrap;

      gap: 9px;
    }

    .focus-item {
      padding: 9px 12px;

      border-radius: 8px;

      color: #536078;

      background: #f1f4f8;

      font-size: 12px;

      font-weight: 750;
    }

    /* ================= JPSC CONNECTION ================= */

    .connection {
      background: #f7f9fc;
    }

    .connection-grid {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 18px;
    }

    .connection-card {
      padding: 27px;

      background: white;

      border: 1px solid #e2e8f1;

      border-radius: 18px;
    }

    .connection-number {
      color: #1657d9;

      font-size: 13px;

      font-weight: 950;

      letter-spacing: 1px;
    }

    .connection-card h3 {
      margin: 13px 0 9px;

      font-size: 19px;
    }

    .connection-card p {
      margin: 0;

      color: #68748a;

      font-size: 13px;

      line-height: 1.65;
    }

    /* ================= SPECIAL LAND LAW ================= */

    .land-law {
      color: white;

      background:
        radial-gradient(
          circle at 82% 20%,
          rgba(255,209,61,0.18),
          transparent 25%
        ),
        linear-gradient(
          135deg,
          #102f78,
          #1657d9
        );
    }

    .land-inner {
      max-width: 1240px;

      margin: auto;

      padding: 75px 24px;
    }

    .land-law .section-label {
      color: #ffd13d;
    }

    .land-law h2 {
      max-width: 850px;

      margin: 10px 0 15px;

      font-size: clamp(34px,4vw,50px);

      line-height: 1.05;

      letter-spacing: -1.5px;
    }

    .land-law p {
      max-width: 790px;

      margin: 0;

      color: rgba(255,255,255,0.80);

      font-size: 16px;

      line-height: 1.7;
    }

    .law-points {
      display: grid;

      grid-template-columns:
        repeat(3,1fr);

      gap: 14px;

      margin-top: 30px;
    }

    .law-point {
      padding: 19px;

      border-radius: 12px;

      color: white;

      background: rgba(255,255,255,0.08);

      border: 1px solid rgba(255,255,255,0.12);

      font-size: 13px;

      font-weight: 750;
    }

    /* ================= CTA ================= */

    .cta {
      max-width: 1190px;

      margin: auto;

      padding: 75px 24px;
    }

    .cta-box {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 30px;

      padding: 45px;

      color: white;

      border-radius: 24px;

      background:
        linear-gradient(
          135deg,
          #102f78,
          #1657d9
        );
    }

    .cta-box h2 {
      margin: 0 0 10px;

      font-size: 32px;
    }

    .cta-box p {
      margin: 0;

      color: rgba(255,255,255,0.78);

      line-height: 1.6;
    }

    /* ================= FOOTER ================= */

    .footer {
      padding: 45px 24px;

      color: #9ba7ba;

      background: #101827;
    }

    .footer-inner {
      max-width: 1240px;

      margin: auto;

      display: flex;

      justify-content: space-between;

      gap: 25px;
    }

    .footer-brand {
      margin-bottom: 7px;

      color: white;

      font-size: 21px;

      font-weight: 900;
    }

    .footer-links {
      display: flex;

      flex-wrap: wrap;

      gap: 20px;
    }

    .footer-links a {
      color: #c5cfdd;

      font-size: 14px;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 1000px) {

      .area-grid {
        grid-template-columns:
          repeat(2,1fr);
      }

      .connection-grid {
        grid-template-columns:
          repeat(2,1fr);
      }

      .law-points {
        grid-template-columns:
          repeat(2,1fr);
      }

    }

    @media (max-width: 700px) {

      .nav {
        min-height: 70px;

        padding: 0 18px;
      }

      .nav-links {
        gap: 7px;
      }

      .nav-links a:not(.nav-cta) {
        display: none;
      }

      .hero-inner {
        padding: 60px 20px 70px;
      }

      .section {
        padding: 60px 20px;
      }

      .area-grid,
      .connection-grid,
      .law-points {
        grid-template-columns: 1fr;
      }

      .focus-box {
        padding: 25px;
      }

      .land-inner {
        padding: 60px 20px;
      }

      .cta {
        padding: 0 20px 60px;
      }

      .cta-box {
        padding: 30px 24px;

        flex-direction: column;

        align-items: flex-start;
      }

      .footer-inner {
        flex-direction: column;
      }

    }

  </style>

</head>


<body>


  <!-- =====================================================
       HEADER
  ====================================================== -->

  <header class="header">

    <nav class="nav">

      <a
        href="/"
