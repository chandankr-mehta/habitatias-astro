---
/*
 * ============================================================
 * HABITAT IAS
 * STUDENT LOGIN PAGE
 * ============================================================
 *
 * Existing Supabase client:
 * src/lib/supabase
 *
 * Existing registration:
 * /register
 *
 * Successful login:
 * /dashboard
 *
 * ============================================================
 */
---

<!doctype html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Habitat IAS Student Login — JPSC Civil Services Preparation"
  />

  <title>
    Student Login | Habitat IAS
  </title>


  <style>

    /* ========================================================
       RESET
    ======================================================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      min-height: 100vh;

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #eef5ff 0%,
          #f7faff 45%,
          #edf7ff 100%
        );

      color: #102a43;

      -webkit-font-smoothing: antialiased;

    }


    button,
    input {
      font: inherit;
    }


    button {
      border: none;
    }


    a {
      text-decoration: none;
    }


    /* ========================================================
       PAGE
    ======================================================== */

    .page {

      min-height: 100vh;

      display: flex;

      align-items: center;

      justify-content: center;

      padding:
        30px 20px;

      position: relative;

      overflow: hidden;

    }


    /* ========================================================
       BACKGROUND DECORATION
    ======================================================== */

    .background-circle {

      position: absolute;

      border-radius: 50%;

      pointer-events: none;

      filter: blur(1px);

    }


    .circle-one {

      width: 430px;

      height: 430px;

      top: -220px;

      right: -130px;

      background:
        rgba(37, 99, 235, 0.08);

    }


    .circle-two {

      width: 360px;

      height: 360px;

      bottom: -210px;

      left: -160px;

      background:
        rgba(14, 165, 233, 0.07);

    }


    /* ========================================================
       MAIN LOGIN CARD
    ======================================================== */

    .login-card {

      position: relative;

      z-index: 2;

      width: 100%;

      max-width: 1040px;

      min-height: 620px;

      display: grid;

      grid-template-columns:
        1fr 1fr;

      background: #ffffff;

      border:
        1px solid
        rgba(148, 163, 184, 0.20);

      border-radius: 26px;

      overflow: hidden;

      box-shadow:
        0 30px 80px
        rgba(15, 23, 42, 0.13);

    }


    /* ========================================================
       LEFT BRAND PANEL
    ======================================================== */

    .brand-panel {

      position: relative;

      overflow: hidden;

      display: flex;

      flex-direction: column;

      justify-content: center;

      padding:
        65px 58px;

      color: #ffffff;

      background:
        linear-gradient(
          145deg,
          #082b55 0%,
          #0d427d 50%,
          #1459a6 100%
        );

    }


    .brand-panel::before {

      content: "";

      position: absolute;

      width: 390px;

      height: 390px;

      border-radius: 50%;

      top: -180px;

      right: -170px;

      background:
        rgba(255,255,255,0.07);

    }


    .brand-panel::after {

      content: "";

      position: absolute;

      width: 320px;

      height: 320px;

      border-radius: 50%;

      bottom: -180px;

      left: -150px;

      background:
        rgba(56,189,248,0.09);

    }


    .brand-content {

      position: relative;

      z-index: 3;

    }


    /* ========================================================
       LOGO
    ======================================================== */

    .logo {

      width: 58px;

      height: 58px;

      display: flex;

      align-items: center;

      justify-content: center;

      margin-bottom: 25px;

      border-radius: 16px;

      color: #ffffff;

      background:
        rgba(255,255,255,0.14);

      border:
        1px solid
        rgba(255,255,255,0.24);

      box-shadow:
        0 12px 30px
        rgba(0,0,0,0.12);

      font-size: 26px;

      font-weight: 950;

    }


    .brand-name {

      font-size: 35px;

      line-height: 1.1;

      font-weight: 950;

      letter-spacing: -1px;

    }


    .brand-tagline {

      margin-top: 7px;

      color:
        rgba(255,255,255,0.68);

      font-size: 10px;

      font-weight: 850;

      letter-spacing: 1.2px;

      text-transform: uppercase;

    }


    .brand-description {

      max-width: 390px;

      margin-top: 25px;

      color:
        rgba(255,255,255,0.78);

      font-size: 13px;

      line-height: 1.75;

    }


    /* ========================================================
       FEATURES
    ======================================================== */

    .feature-list {

      margin-top: 35px;

      display: grid;

      gap: 14px;

    }


    .feature {

      display: flex;

      align-items: center;

      gap: 12px;

      color:
        rgba(255,255,255,0.91);

      font-size: 12px;

      font-weight: 700;

    }


    .feature-icon {

      flex: 0 0 auto;

      width: 28px;

      height: 28px;

      display: flex;

      align-items: center;

      justify-content: center;

      border-radius: 9px;

      color: #dbeafe;

      background:
        rgba(255,255,255,0.12);

      border:
        1px solid
        rgba(255,255,255,0.12);

      font-size: 12px;

    }


    /* ========================================================
       RIGHT LOGIN PANEL
    ======================================================== */

    .login-panel {

      display: flex;

      flex-direction: column;

      justify-content: center;

      padding:
        60px 65px;

      background: #ffffff;

    }


    .login-kicker {

      color: #2563eb;

      font-size: 10px;

      font-weight: 950;

      letter-spacing: 1.4px;

      text-transform: uppercase;

    }


    .login-title {

      margin-top: 9px;

      color: #0b2545;

      font-size: 31px;

      line-height: 1.15;

      font-weight: 950;

      letter-spacing: -0.7px;

    }


    .login-description {

      max-width: 390px;

      margin-top: 9px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.65;

    }


    /* ========================================================
       STATUS
    ======================================================== */

    .status {

      display: none;

      margin-top: 22px;

      padding:
        12px 14px;

      border-radius: 10px;

      font-size: 11px;

      line-height: 1.5;

      font-weight: 750;

    }


    .status.error {

      display: block;

      color: #991b1b;

      background: #fef2f2;

      border:
        1px solid
        #fecaca;

    }


    .status.success {

      display: block;

      color: #166534;

      background: #f0fdf4;

      border:
        1px solid
        #bbf7d0;

    }


    /* ========================================================
       FORM
    ======================================================== */

    .login-form {

      margin-top: 30px;

    }


    .field {

      margin-bottom: 18px;

    }


    .field-label {

      display: block;

      margin-bottom: 7px;

      color: #334155;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: 0.15px;

    }


    .input-wrap {

      position: relative;

    }


    .input-icon {

      position: absolute;

      left: 14px;

      top: 50%;

      transform:
        translateY(-50%);

      color: #94a3b8;

      font-size: 13px;

      pointer-events: none;

    }


    .field-input {

      width: 100%;

      height: 50px;

      padding:
        0 14px 0 40px;

      color: #172033;

      background: #f8fafc;

      border:
        1px solid
        #dbe3ec;

      border-radius: 10px;

      outline: none;

      font-size: 13px;

      transition:
        border-color .16s ease,
        background .16s ease,
        box-shadow .16s ease;

    }


    .field-input::placeholder {

      color: #a0aec0;

    }


    .field-input:hover {

      border-color:
        #cbd5e1;

    }


    .field-input:focus {

      background: #ffffff;

      border-color:
        #60a5fa;

      box-shadow:
        0 0 0 4px
        rgba(37,99,235,0.08);

    }


    /* ========================================================
       PASSWORD TOGGLE
    ======================================================== */

    .password-toggle {

      position: absolute;

      right: 10px;

      top: 50%;

      transform:
        translateY(-50%);

      padding:
        7px 9px;

      color: #64748b;

      background: transparent;

      cursor: pointer;

      border-radius: 7px;

      font-size: 10px;

      font-weight: 800;

    }


    .password-toggle:hover {

      color: #2563eb;

      background:
        #eff6ff;

    }


    /* ========================================================
       FORGOT PASSWORD
    ======================================================== */

    .form-footer {

      display: flex;

      justify-content: flex-end;

      margin-top: -5px;

      margin-bottom: 20px;

    }


    .forgot-link {

      color: #2563eb;

      font-size: 10px;

      font-weight: 850;

    }


    .forgot-link:hover {

      text-decoration: underline;

    }


    /* ========================================================
       LOGIN BUTTON
    ======================================================== */

    .login-button {

      width: 100%;

      height: 50px;

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      border-radius: 10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #1d4ed8
        );

      cursor: pointer;

      font-size: 12px;

      font-weight: 900;

      box-shadow:
        0 10px 24px
        rgba(37,99,235,0.20);

      transition:
        transform .15s ease,
        box-shadow .15s ease,
        opacity .15s ease;

    }


    .login-button:hover:not(:disabled) {

      transform:
        translateY(-1px);

      box-shadow:
        0 14px 28px
        rgba(37,99,235,0.25);

    }


    .login-button:active:not(:disabled) {

      transform:
        translateY(0);

    }


    .login-button:disabled {

      cursor: wait;

      opacity: .72;

    }


    /* ========================================================
       SPINNER
    ======================================================== */

    .spinner {

      width: 14px;

      height: 14px;

      border-radius: 50%;

      border:
        2px solid
        rgba(255,255,255,0.35);

      border-top-color:
        #ffffff;

      animation:
        spin .7s linear infinite;

    }


    @keyframes spin {

      to {
        transform:
          rotate(360deg);
      }

    }


    /* ========================================================
       REGISTER
    ======================================================== */

    .register-line {

      margin-top: 24px;

      text-align: center;

      color: #64748b;

      font-size: 11px;

    }


    .register-link {

      color: #2563eb;

      font-weight: 900;

    }


    .register-link:hover {

      text-decoration: underline;

    }


    /* ========================================================
       SECURITY NOTE
    ======================================================== */

    .security-note {

      display: flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      margin-top: 23px;

      color: #94a3b8;

      font-size: 9px;

      font-weight: 700;

    }


    /* ========================================================
       MOBILE
    ======================================================== */

    @media (max-width: 780px) {

      .page {

        padding:
          18px;

      }


      .login-card {

        grid-template-columns:
          1fr;

        max-width: 520px;

        min-height: auto;

        border-radius: 20px;

      }


      .brand-panel {

        padding:
          38px 32px;

      }


      .brand-name {

        font-size: 29px;

      }


      .brand-description {

        margin-top: 16px;

      }


      .feature-list {

        margin-top: 23px;

      }


      .login-panel {

        padding:
          38px 30px;

      }

    }


    @media (max-width: 420px) {

      .page {

        padding: 10px;

      }


      .brand-panel {

        padding:
          30px 24px;

      }


      .login-panel {

        padding:
          32px 22px;

      }


      .login-title {

        font-size: 27px;

      }

    }

  </style>

</head>


<body>


  <!-- ======================================================
       PAGE
  ======================================================= -->

  <main class="page">


    <!-- Background decoration -->

    <div
      class="background-circle circle-one"
    ></div>

    <div
      class="background-circle circle-two"
    ></div>


    <!-- ====================================================
         LOGIN CARD
    ===================================================== -->

    <div class="login-card">


      <!-- ==================================================
           BRAND PANEL
      =================================================== -->

      <section class="brand-panel">


        <div class="brand-content">


          <div class="logo">
            H
          </div>


          <h1 class="brand-name">
            Habitat IAS
          </h1>


          <div class="brand-tagline">
            Civil Services Preparation
          </div>


          <p class="brand-description">

            Your dedicated platform for
            JPSC Prelims preparation,
            realistic computer-based tests,
            performance analysis and
            structured examination practice.

          </p>


          <div class="feature-list">


            <div class="feature">

              <span class="feature-icon">
                ✓
              </span>

              JPSC Prelims Mock Test Series

            </div>


            <div class="feature">

              <span class="feature-icon">
                ✓
              </span>

              Realistic Computer-Based Tests

            </div>


            <div class="feature">

              <span class="feature-icon">
                ✓
              </span>

              Detailed Performance Analysis

            </div>


            <div class="feature">

              <span class="feature-icon">
                ✓
              </span>

              Personal Test History

            </div>


            <div class="feature">

              <span class="feature-icon">
                ✓
              </span>

              Secure Student Account

            </div>


          </div>


        </div>


      </section>



      <!-- ==================================================
           LOGIN PANEL
      =================================================== -->

      <section class="login-panel">


        <div class="login-kicker">
          Student Portal
        </div>


        <h2 class="login-title">
          Welcome back
        </h2>


        <p class="login-description">

          Sign in to continue your JPSC
          preparation and access your
          Habitat IAS student dashboard.

        </p>


        <!-- STATUS MESSAGE -->

        <div
          id="loginStatus"
          class="status"
          role="alert"
          aria-live="polite"
        ></div>


        <!-- ==================================================
             LOGIN FORM
        =================================================== -->

        <form
          id="loginForm"
          class="login-form"
          novalidate
        >


          <!-- EMAIL -->

          <div class="field">


            <label
              class="field-label"
              for="email"
            >
              Email Address
            </label>


            <div class="input-wrap">


              <span
                class="input-icon"
                aria-hidden="true"
              >
                ✉
              </span>


              <input
                id="email"
                name="email"
                class="field-input"
                type="email"
                autocomplete="email"
                placeholder="Enter your email address"
                required
              />


            </div>


          </div>



          <!-- PASSWORD -->

          <div class="field">


            <label
              class="field-label"
              for="password"
            >
              Password
            </label>


            <div class="input-wrap">


              <span
                class="input-icon"
                aria-hidden="true"
              >
                🔒
              </span>


              <input
                id="password"
                name="password"
                class="field-input"
                type="password"
                autocomplete="current-password"
                placeholder="Enter your password"
                required
              />


              <button
                id="passwordToggle"
                class="password-toggle"
                type="button"
                aria-label="Show password"
              >
                SHOW
              </button>


            </div>


          </div>



          <!-- FORGOT -->

          <div class="form-footer">

            <a
              href="/forgot-password"
              class="forgot-link"
            >
              Forgot password?
            </a>

          </div>



          <!-- LOGIN -->

          <button
            id="loginButton"
            class="login-button"
            type="submit"
          >

            <span
              id="loginButtonText"
            >
              Login to Student Portal
            </span>

          </button>


        </form>



        <!-- REGISTER -->

        <div class="register-line">

          Don't have a student account?

          <a
            href="/register"
            class="register-link"
          >
            Create Account
          </a>

        </div>



        <!-- SECURITY -->

        <div class="security-note">

          <span>
            🔐
          </span>

          Secure authentication powered by Supabase

        </div>


      </section>


    </div>


  </main>



  <!-- ======================================================
       JAVASCRIPT
  ======================================================= -->

  <script>

    import {
      supabase
    } from "../lib/supabase";


    /* ======================================================
       ELEMENTS
    ======================================================= */

    const form =
      document.getElementById(
        "loginForm"
      );


    const emailInput =
      document.getElementById(
        "email"
      );


    const passwordInput =
      document.getElementById(
        "password"
      );


    const passwordToggle =
      document.getElementById(
        "passwordToggle"
      );


    const loginButton =
      document.getElementById(
        "loginButton"
      );


    const loginButtonText =
      document.getElementById(
        "loginButtonText"
      );


    const statusBox =
      document.getElementById(
        "loginStatus"
      );


    /* ======================================================
       STATUS FUNCTION
    ======================================================= */

    function showStatus(
      message,
      type = "error"
    ) {

      if (!statusBox) return;


      statusBox.textContent =
        message;


      statusBox.className =
        "status " + type;

    }


    function clearStatus() {

      if (!statusBox) return;


      statusBox.textContent =
        "";

      statusBox.className =
        "status";

    }


    /* ======================================================
       LOADING
    ======================================================= */

    function setLoading(
      loading
    ) {

      if (!loginButton) return;


      loginButton.disabled =
        loading;


      if (loading) {

        loginButtonText.innerHTML =
          `
            <span class="spinner"></span>
            Signing in...
          `;

      } else {

        loginButtonText.textContent =
          "Login to Student Portal";

      }

    }


    /* ======================================================
       PASSWORD SHOW / HIDE
    ======================================================= */

    passwordToggle?.addEventListener(
      "click",
      () => {

        const isPassword =
          passwordInput.type ===
          "password";


        if (isPassword) {

          passwordInput.type =
            "text";

          passwordToggle.textContent =
            "HIDE";

          passwordToggle.setAttribute(
            "aria-label",
            "Hide password"
          );

        } else {

          passwordInput.type =
            "password";

          passwordToggle.textContent =
            "SHOW";

          passwordToggle.setAttribute(
            "aria-label",
            "Show password"
          );

        }

      }
    );


    /* ======================================================
       CLEAR STATUS WHEN USER TYPES
    ======================================================= */

    emailInput?.addEventListener(
      "input",
      () => {

        if (
          statusBox?.classList.contains(
            "error"
          )
        ) {

          clearStatus();

        }

      }
    );


    passwordInput?.addEventListener(
      "input",
      () => {

        if (
          statusBox?.classList.contains(
            "error"
          )
        ) {

          clearStatus();

        }

      }
    );


    /* ======================================================
       CHECK EXISTING SESSION
    ======================================================= */

    async function checkExistingSession() {

      try {

        const {
          data,
          error
        } =
          await supabase.auth
            .getSession();


        if (error) {

          console.error(
            "Supabase session error:",
            error
          );

          return;

        }


        if (
          data?.session?.user
        ) {

          /*
           * User is already logged in.
           *
           * Do not make them login again.
           */

          window.location.replace(
            "/dashboard"
          );

        }

      } catch (error) {

        console.error(
          "Session check failed:",
          error
        );

      }

    }


    checkExistingSession();


    /* ======================================================
       LOGIN
    ======================================================= */

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        clearStatus();


        const email =
          emailInput?.value
            ?.trim()
            ?.toLowerCase();


        const password =
          passwordInput?.value ||
          "";


        /* --------------------------------------------------
           VALIDATION
        -------------------------------------------------- */

        if (!email) {

          showStatus(
            "Please enter your email address."
          );

          emailInput?.focus();

          return;

        }


        if (
          !email.includes("@")
        ) {

          showStatus(
            "Please enter a valid email address."
          );

          emailInput?.focus();

          return;

        }


        if (!password) {

          showStatus(
            "Please enter your password."
          );

          passwordInput?.focus();

          return;

        }


        /* --------------------------------------------------
           START LOGIN
        -------------------------------------------------- */

        setLoading(true);


        try {


          const {
            data,
            error
          } =
            await supabase.auth
              .signInWithPassword({

                email:
                  email,

                password:
                  password

              });


          /* ------------------------------------------------
             ERROR
          ------------------------------------------------- */

          if (error) {

            console.error(
              "Login error:",
              error
            );


            const errorText =
              (
                error.message ||
                ""
              ).toLowerCase();


            let message =
              "Unable to sign in. Please check your email and password.";


            if (
              errorText.includes(
                "invalid login credentials"
              )
            ) {

              message =
                "Incorrect email or password. Please try again.";

            }


            else if (
              errorText.includes(
                "email not confirmed"
              )
            ) {

              message =
                "Your email has not been confirmed yet. Please check your inbox.";

            }


            else if (
              errorText.includes(
                "too many requests"
              )
            ) {

              message =
                "Too many login attempts. Please wait a moment and try again.";

            }


            else if (
              errorText.includes(
                "network"
              )
            ) {

              message =
                "Network connection problem. Please check your internet connection.";

            }


            showStatus(
              message
            );


            setLoading(false);

            return;

          }


          /* ------------------------------------------------
             USER CHECK
          ------------------------------------------------- */

          if (
            !data?.user
          ) {

            showStatus(
              "Login could not be completed. Please try again."
            );


            setLoading(false);

            return;

          }


          /* ------------------------------------------------
             SUCCESS
          ------------------------------------------------- */

          showStatus(
            "Login successful. Opening your dashboard...",
            "success"
          );


          /*
           * Give the success message
           * a moment to appear.
           */

          setTimeout(
            () => {

              window.location.replace(
                "/dashboard"
              );

            },
            500
          );


        } catch (error) {

          console.error(
            "Unexpected authentication error:",
            error
          );


          showStatus(
            "Something went wrong. Please try again."
          );


          setLoading(false);

        }

      }
    );


    /* ======================================================
       AUTH STATE LISTENER
    ======================================================= */

    supabase.auth.onAuthStateChange(
      (
        event,
        session
      ) => {

        if (
          event === "SIGNED_IN" &&
          session?.user
        ) {

          /*
           * Successful authentication.
           */

          window.location.replace(
            "/dashboard"
          );

        }

      }
    );

  </script>


</body>

</html>