---
import { createClient } from "@supabase/supabase-js";
import Header from "../components/Header.astro";
import { checkMockAccess } from "../lib/mockAccess";

export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const serviceRoleKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

if (!supabaseUrl) {
  throw new Error("PUBLIC_SUPABASE_URL is missing.");
}

if (!serviceRoleKey) {
  throw new Error("SUPABASE_SERVICE_ROLE_KEY is missing.");
}

const supabaseAdmin = createClient(
  supabaseUrl,
  serviceRoleKey,
  {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  }
);

/* =========================================================
   SAME LOGIN SESSION USED BY THE CBT
   habitat-access-token -> Supabase user -> user_id
   ========================================================= */

const accessToken = Astro.cookies.get(
  "habitat-access-token"
)?.value;

let currentUserId: string | null = null;

if (accessToken) {
  const { data: authData, error: authError } =
    await supabaseAdmin.auth.getUser(accessToken);

  if (!authError && authData?.user?.id) {
    currentUserId = authData.user.id;
  }
}

/* =========================================================
   CORE SERIES ACCESS

   PAID purchase OR manual access = true
   Everything else = false
   ========================================================= */

const mockAccess = await checkMockAccess(currentUserId);
const hasCoreAccess = mockAccess.allowed === true;

const coreSeriesHref = hasCoreAccess
  ? "/mock-tests-series/"
  : "/mock-tests/buy/";

const coreSeriesButtonText = hasCoreAccess
  ? "Open My 20-Test Series →"
  : "View 20 Core Tests →";

const coreSeriesButtonLabel = hasCoreAccess
  ? "CORE SERIES ACCESS ACTIVE"
  : "PREMIUM ACCESS REQUIRED";

const coreTests = [
  { no: 1, title: "GS Sectional Test 01", category: "GS Sectional" },
  { no: 2, title: "GS Sectional Test 02", category: "GS Sectional" },
  { no: 3, title: "GS Sectional Test 03", category: "GS Sectional" },
  { no: 4, title: "GS Sectional Test 04", category: "GS Sectional" },
  { no: 5, title: "GS Sectional Test 05", category: "GS Sectional" },

  { no: 6, title: "Jharkhand Sectional Test 01", category: "Jharkhand Sectional" },
  { no: 7, title: "Jharkhand Sectional Test 02", category: "Jharkhand Sectional" },
  { no: 8, title: "Jharkhand Sectional Test 03", category: "Jharkhand Sectional" },
  { no: 9, title: "Jharkhand Sectional Test 04", category: "Jharkhand Sectional" },
  { no: 10, title: "Jharkhand Sectional Test 05", category: "Jharkhand Sectional" },

  { no: 11, title: "GS Full-Length Test 01", category: "GS Full Length" },
  { no: 12, title: "GS Full-Length Test 02", category: "GS Full Length" },
  { no: 13, title: "GS Full-Length Test 03", category: "GS Full Length" },
  { no: 14, title: "GS Full-Length Test 04", category: "GS Full Length" },
  { no: 15, title: "GS Full-Length Test 05", category: "GS Full Length" },

  {
    no: 16,
    title: "Jharkhand Special Full-Length Test 01",
    category: "Jharkhand Special Full Length"
  },
  {
    no: 17,
    title: "Jharkhand Special Full-Length Test 02",
    category: "Jharkhand Special Full Length"
  },
  {
    no: 18,
    title: "Jharkhand Special Full-Length Test 03",
    category: "Jharkhand Special Full Length"
  },
  {
    no: 19,
    title: "Jharkhand Special Full-Length Test 04",
    category: "Jharkhand Special Full Length"
  },
  {
    no: 20,
    title: "Jharkhand Special Full-Length Test 05",
    category: "Jharkhand Special Full Length"
  }
];
