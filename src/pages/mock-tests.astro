const jharkhandTests = [
  {
    number: "01",
    title: "Jharkhand History",
    description: "History, movements and important historical events of Jharkhand.",
    questions: "25 Questions",
    time: "25 Minutes",
  },
  {
    number: "02",
    title: "Jharkhand Geography",
    description: "Physical geography, rivers, minerals, forests and districts.",
    questions: "25 Questions",
    time: "25 Minutes",
  },
  {
    number: "03",
    title: "Jharkhand Economy",
    description: "Industries, minerals, agriculture, development and state economy.",
    questions: "25 Questions",
    time: "25 Minutes",
  },
  {
    number: "04",
    title: "Jharkhand Culture & Society",
    description: "Tribes, festivals, languages, literature, art and culture.",
    questions: "25 Questions",
    time: "25 Minutes",
  },
  {
    number: "05",
    title: "Jharkhand Complete",
    description: "Mixed Jharkhand Special test covering major state-specific areas.",
    questions: "50 Questions",
    time: "50 Minutes",
  },
];

const paperOneTests = [
  {
    number: "01",
    title: "Paper-I Simulation 01",
  },
  {
    number: "02",
    title: "Paper-I Simulation 02",
  },
  {
    number: "03",
    title: "Paper-I Simulation 03",
  },
  {
    number: "04",
    title: "Paper-I Simulation 04",
  },
  {
    number: "05",
    title: "Paper-I Simulation 05",
  },
];

const paperTwoTests = [
  {
    number: "01",
    title: "Paper-II Simulation 01",
  },
  {
    number: "02",
    title: "Paper-II Simulation 02",
  },
  {
    number: "03",
    title: "Paper-II Simulation 03",
  },
  {
    number: "04",
    title: "Paper-II Simulation 04",
  },
  {
    number: "05",
