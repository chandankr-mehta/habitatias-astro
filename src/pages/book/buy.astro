              target="_blank"
              rel="noopener noreferrer"
            >
              📥 Download Your PDF
            </a>


            <div class="download-expiry">
              🔒 This secure download link expires after
              1 hour. Please download your book before it expires.
            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           ORDER SUMMARY
           ================================================= -->

      <aside class="card summary-card">

        <div class="card-label">
          Order Summary
        </div>


        <div class="summary-title">
          JPSC Prelims Decoded
        </div>


        <div class="summary-row">

          <span>
            Book
          </span>

          <span>
            JPSC Prelims Decoded
          </span>

        </div>


        <div class="summary-row">

          <span>
            Edition
          </span>

          <span id="summaryEdition">
            Hindi Edition
          </span>

        </div>


        <div class="summary-row">

          <span>
