  <!-- =====================================================
       JAVASCRIPT
       ===================================================== -->

  <script is:inline>

    document.addEventListener(
      "DOMContentLoaded",
      () => {


        /* =================================================
           1. READ EDITION
           ================================================= */

        const params =
          new URLSearchParams(
            window.location.search
          );


        const requestedEdition =
          (
            params.get("edition") ||
            "hindi"
          )
            .trim()
            .toLowerCase();


        /*
         * Only two editions are allowed.
         */

        const edition =
          requestedEdition === "english"
            ? "english"
            : "hindi";


        /* =================================================
           2. EDITION CONFIGURATION
           ================================================= */

        const editionConfig = {

          hindi: {

            name:
              "Hindi Edition",

            language:
              "Hindi",

            price:
              249,

            icon:
              "🇮🇳",

            razorpayDescription:
              "JPSC Prelims Decoded — Hindi Edition"

          },


          english: {

            name:
              "English Edition",

            language:
              "English",

            price:
              299,

            icon:
              "🇬🇧",

            razorpayDescription:
              "JPSC Prelims Decoded — English Edition"

          }

        };


        const selected =
          editionConfig[edition];


        /* =================================================
           3. ELEMENTS
           ================================================= */

        const editionIcon =
          document.getElementById(
            "editionIcon"
          );


        const editionName =
          document.getElementById(
            "editionName"
          );


        const editionPrice =
          document.getElementById(
            "editionPrice"
          );


        const summaryEdition =
          document.getElementById(
            "summaryEdition"
          );


        const summaryLanguage =
          document.getElementById(
            "summaryLanguage"
          );


        const summaryPrice =
          document.getElementById(
            "summaryPrice"
          );


        const paymentButton =
          document.getElementById(
            "paymentButton"
          );


        const form =
          document.getElementById(
            "checkoutForm"
          );


        const nameInput =
          document.getElementById(
            "name"
          );


        const emailInput =
          document.getElementById(
            "email"
          );


        const mobileInput =
          document.getElementById(
            "mobile"
          );


        const errorMessage =
          document.getElementById(
            "errorMessage"
          );


        const successMessage =
          document.getElementById(
            "successMessage"
          );


        const successOrderText =
          document.getElementById(
            "successOrderText"
          );


        const downloadSection =
          document.getElementById(
            "downloadSection"
          );


        const downloadButton =
          document.getElementById(
            "downloadButton"
          );


        const downloadDetails =
          document.getElementById(
            "downloadDetails"
          );


        /* =================================================
           4. UPDATE EDITION UI
           ================================================= */

        editionIcon.textContent =
          selected.icon;


        editionName.textContent =
          selected.name;


        editionPrice.textContent =
          `₹${selected.price}`;


        summaryEdition.textContent =
          selected.name;


        summaryLanguage.textContent =
          selected.language;


        summaryPrice.textContent =
          `₹${selected.price}`;


        paymentButton.textContent =
          `Continue to Secure Payment — ₹${selected.price}`;


        document.title =
          `Purchase ${selected.name} | Habitat IAS`;


        /* =================================================
           5. ERROR HELPERS
           ================================================= */

        function showError(
          message
        ) {

          errorMessage.textContent =
            message;

          errorMessage.classList.add(
            "show"
          );

        }


        function clearError() {

          errorMessage.textContent =
            "";

          errorMessage.classList.remove(
            "show"
          );

        }


        /* =================================================
           6. CUSTOMER VALIDATION
           ================================================= */

        function validateCustomer() {

          clearError();


          const name =
            nameInput.value.trim();


          const email =
            emailInput.value.trim();


          const mobile =
            mobileInput.value
              .replace(/\D/g, "");


          if (
            name.length < 2
          ) {

            showError(
              "Please enter your full name."
            );

            nameInput.focus();

            return null;

          }


          const emailRegex =
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


          if (
            !emailRegex.test(email)
          ) {

            showError(
              "Please enter a valid email address."
            );

            emailInput.focus();

            return null;

          }


          if (
            !/^[6-9]\d{9}$/.test(mobile)
          ) {

            showError(
              "Please enter a valid 10-digit Indian mobile number."
            );

            mobileInput.focus();

            return null;

          }


          return {

            name,
            email,
            mobile

          };

        }


        /* =================================================
           7. CREATE RAZORPAY ORDER
           ================================================= */

        async function createOrder(
          customer
        ) {

          /*
           * IMPORTANT:
           *
           * Only edition is trusted from this page.
           *
           * The server decides:
           *
           * Hindi   = ₹249
           * English = ₹299
           */

          const response =
            await fetch(
              "/api/razorpay/create-order",
              {

                method:
                  "POST",

                headers: {

                  "Content-Type":
                    "application/json"

                },

                body:
                  JSON.stringify({

                    edition:
                      edition,

                    name:
                      customer.name,

                    email:
                      customer.email,

                    mobile:
                      customer.mobile

                  })

              }
            );


          let data;


          try {

            data =
              await response.json();

          } catch {

            throw new Error(
              "The server returned an invalid response."
            );

          }


          if (
            !response.ok
          ) {

            throw new Error(
              data?.error ||
              "Unable to create Razorpay order."
            );

          }


          if (
            data?.success !== true
          ) {

            throw new Error(
              data?.error ||
              "Unable to create payment order."
            );

          }


          if (
            !data?.order?.id
          ) {

            throw new Error(
              "Razorpay order ID was not returned by the server."
            );

          }


          return data;

        }


        /* =================================================
           8. OPEN RAZORPAY
           ================================================= */

        function openRazorpay(
          orderData,
          customer
        ) {

          if (
            typeof window.Razorpay ===
            "undefined"
          ) {

            throw new Error(
              "Razorpay Checkout could not be loaded. Please refresh the page and try again."
            );

          }


          const options = {

            key:
              orderData.keyId,


            amount:
              orderData.order.amount,


            currency:
              orderData.order.currency ||
              "INR",


            order_id:
              orderData.order.id,


            name:
              "Habitat IAS",


            description:
              selected.razorpayDescription,


            prefill: {

              name:
                customer.name,

              email:
                customer.email,

              contact:
                customer.mobile

            },


            notes: {

              book:
                "JPSC Prelims Decoded: Topic-Wise PYQs",

              edition:
                selected.name

            },


            theme: {

              color:
                "#1557d6"

            },


            /*
            =================================================
            SUCCESSFUL PAYMENT
            =================================================
            */

            handler:
              async function (
                paymentResponse
              ) {

                await verifyPayment(
                  paymentResponse,
                  customer
                );

              },


            /*
            =================================================
            CHECKOUT CLOSED
            =================================================
            */

            modal: {

              ondismiss:
                function () {

                  /*
                   * Do not reset the button if payment has
                   * already been successfully verified.
                   */

                  if (
                    !downloadSection.classList.contains(
                      "show"
                    )
                  ) {

                    paymentButton.disabled =
                      false;

                    paymentButton.textContent =
                      `Continue to Secure Payment — ₹${selected.price}`;

                  }

                }

            }

          };


          const razorpay =
            new window.Razorpay(
              options
            );


          /* =================================================
             PAYMENT FAILURE
             ================================================= */

          razorpay.on(
            "payment.failed",
            function (
              response
            ) {

              console.error(
                "Razorpay payment failed:",
                response
              );


              showError(
                response
                  ?.error
                  ?.description ||
                "Payment failed. Please try again."
              );


              paymentButton.disabled =
                false;


              paymentButton.textContent =
                `Continue to Secure Payment — ₹${selected.price}`;

            }
          );


          /*
           * OPEN CHECKOUT
           */

          razorpay.open();

        }


        /* =================================================
           9. VERIFY PAYMENT
           ================================================= */

        async function verifyPayment(
          paymentResponse,
          customer
        ) {

          paymentButton.disabled =
            true;


          paymentButton.textContent =
            "Verifying Payment...";


          clearError();


          try {


            /* ===============================================
               SEND PAYMENT DATA TO SERVER
               =============================================== */

            const response =
              await fetch(
                "/api/razorpay/verify-payment",
                {

                  method:
                    "POST",

                  headers: {

                    "Content-Type":
                      "application/json"

                  },

                  body:
                    JSON.stringify({

                      razorpay_payment_id:
                        paymentResponse
                          .razorpay_payment_id,


                      razorpay_order_id:
                        paymentResponse
                          .razorpay_order_id,


                      razorpay_signature:
                        paymentResponse
                          .razorpay_signature,


                      edition:
                        edition,


                      name:
                        customer.name,


                      email:
                        customer.email,


                      mobile:
                        customer.mobile

                    })

                }
              );


            /* ===============================================
               READ RESPONSE
               =============================================== */

            let data;


            try {

              data =
                await response.json();

            } catch {

              throw new Error(
                "Payment verification returned an invalid response."
              );

            }


            /* ===============================================
               SERVER ERROR
               =============================================== */

            if (
              !response.ok
            ) {

              throw new Error(
                data?.error ||
                "Payment verification failed."
              );

            }


            /* ===============================================
               SUCCESS CHECK
               ===============================================

               IMPORTANT:

               We check:

                 data.success === true

               NOT:

                 data.verified === true

               The new verify-payment.ts returns:

                 success: true

                 download: {
                   available: true,
                   url: "..."
                 }
               =============================================== */

            if (
              data?.success !== true
            ) {

              throw new Error(
                data?.error ||
                "Payment could not be verified."
              );

            }


            /* ===============================================
               PAYMENT VERIFIED
               =============================================== */

            successMessage.classList.add(
              "show"
            );


            const orderNumber =
              data?.order?.orderNumber ||
              data?.order?.id ||
              paymentResponse
                .razorpay_order_id;


            const purchasedEdition =
              data?.order?.edition ||
              selected.name;


            const purchasedAmount =
              data?.order?.amount ??
              selected.price;


            successOrderText.innerHTML = `

              Your payment of
              <strong>
                ₹${purchasedAmount}
              </strong>

              for

              <strong>
                ${purchasedEdition}
              </strong>

              has been successfully verified.

              <br />

              Order:
              <strong>
                ${orderNumber}
              </strong>

            `;


            /* ===============================================
               CHECK DOWNLOAD URL
               =============================================== */

            if (
              data?.download?.available !== true ||
              !data?.download?.url
            ) {

              throw new Error(
                "Payment was successful, but the secure PDF download link could not be generated. Please contact Habitat IAS support."
              );

            }


            /* ===============================================
               SECURE DOWNLOAD URL
               =============================================== */

            const downloadUrl =
              data.download.url;


            /*
             * The browser receives only the temporary signed
             * URL generated by the server.
             *
             * The Supabase bucket remains PRIVATE.
             */


            downloadButton.href =
              downloadUrl;


            downloadButton.target =
              "_blank";


            downloadButton.rel =
              "noopener noreferrer";


            /* ===============================================
               DOWNLOAD DETAILS
               =============================================== */

            const filename =
              data?.download?.filename ||
              "JPSC-Prelims-Decoded.pdf";


            const language =
              data?.download?.language ||
              selected.language;


            downloadDetails.innerHTML = `

              <strong>
                ${language} Edition
              </strong>

              <br />

              File:
              <strong>
                ${filename}
              </strong>

              <br />

              Your secure download link is ready.

            `;


            /* ===============================================
               SHOW DOWNLOAD
               =============================================== */

            downloadSection.classList.add(
              "show"
            );


            /* ===============================================
               LOCK PAYMENT BUTTON
               =============================================== */

            paymentButton.textContent =
              "Payment Verified ✓";


            paymentButton.disabled =
              true;


            /* ===============================================
               LOGGING
               =============================================== */

            console.log(
              "Payment verified successfully:",
              data
            );


            console.log(
              "Secure PDF download URL:",
              downloadUrl
            );


            console.log(
              "Order:",
              data.order
            );


          } catch (
            error
          ) {

            console.error(
              "Verification error:",
              error
            );


            showError(
              error?.message ||
              "Payment verification failed. Please contact Habitat IAS support."
            );


            paymentButton.disabled =
              false;


            paymentButton.textContent =
              `Continue to Secure Payment — ₹${selected.price}`;

          }

        }


        /* =================================================
           10. FORM SUBMISSION
           ================================================= */

        form.addEventListener(
          "submit",
          async function (
            event
          ) {

            event.preventDefault();


            /*
             * Prevent double-click.
             */

            if (
              paymentButton.disabled
            ) {

              return;

            }


            const customer =
              validateCustomer();


            if (
              !customer
            ) {

              return;

            }


            /*
             * Lock button.
             */

            paymentButton.disabled =
              true;


            paymentButton.textContent =
              "Creating Secure Payment...";


            try {


              /* =========================================
                 CREATE SERVER-SIDE ORDER
                 ========================================= */

              const orderData =
                await createOrder(
                  customer
                );


              console.log(
                "Razorpay order created:",
                orderData
              );


              /* =========================================
                 OPEN RAZORPAY
                 ========================================= */

              openRazorpay(
                orderData,
                customer
              );


            } catch (
              error
            ) {

              console.error(
                "Payment initialization error:",
                error
              );


              showError(
                error?.message ||
                "Unable to start payment. Please try again."
              );


              paymentButton.disabled =
                false;


              paymentButton.textContent =
                `Continue to Secure Payment — ₹${selected.price}`;

            }

          }
        );

      }
    );

  </script>


</body>

</html>