  </section>


  <!-- =====================================================
       CHECKOUT
       ===================================================== -->

  <main class="checkout-section">

    <div class="checkout-grid">


      <!-- =================================================
           CUSTOMER INFORMATION
           ================================================= -->

      <section class="card">

        <div class="card-label">
          Customer Details
        </div>


        <h2>
          Your Information
        </h2>


        <p class="card-description">
          Enter your details carefully. Your name and email
          will be associated with your digital purchase.
        </p>


        <!-- =================================================
             EDITION
             ================================================= -->

        <div
          class="edition-banner"
          id="editionBanner"
        >

          <div class="edition-left">

            <div
              class="edition-icon"
              id="editionIcon"
            >
              🇮🇳
            </div>


            <div>

              <div
                class="edition-name"
                id="editionName"
              >
                Hindi Edition
              </div>


              <div class="edition-language">
                Digital PDF • Secure Delivery
              </div>

            </div>

          </div>


          <div
            class="edition-price"
            id="editionPrice"
          >
            ₹249
          </div>

        </div>


        <!-- =================================================
             ERROR
             ================================================= -->

        <div
          id="errorMessage"
          class="error-message"
          role="alert"
        ></div>


        <!-- =================================================
             FORM
             ================================================= -->

        <form
          id="checkoutForm"
          novalidate
        >


          <!-- NAME -->

          <div class="form-group">

            <label for="name">
              Full Name *
            </label>


            <input
              id="name"
              name="name"
              type="text"
              placeholder="Enter your full name"
              autocomplete="name"
              maxlength="100"
              required
            />

          </div>


          <!-- EMAIL -->

          <div class="form-group">

            <label for="email">
              Email Address *
            </label>


            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              autocomplete="email"
              maxlength="150"
              required
            />


            <div class="form-help">
              Your purchase and delivery information
              will be associated with this email.
            </div>

          </div>


          <!-- MOBILE -->

          <div class="form-group">

            <label for="mobile">
              Mobile Number *
            </label>


            <input
              id="mobile"
              name="mobile"
              type="tel"
              inputmode="numeric"
              placeholder="10-digit mobile number"
              autocomplete="tel"
              maxlength="10"
              required
            />


            <div class="form-help">
              Enter a valid Indian mobile number.
            </div>

          </div>


          <!-- PAYMENT BUTTON -->

          <button
            id="paymentButton"
            class="payment-button"
            type="submit"
          >
            Continue to Secure Payment — ₹249
          </button>

        </form>


        <!-- =================================================
             SECURITY
             ================================================= -->

        <div class="security-notice">

          <div class="security-icon">
            🔒
          </div>


          <div>

            <strong>
