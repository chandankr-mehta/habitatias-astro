          </span>


          <div id="successOrderText">
            Your payment has been successfully verified.
          </div>


          <!-- =================================================
               DOWNLOAD
               ================================================= -->

          <div
            id="downloadSection"
            class="download-section"
          >

            <div class="download-title">
