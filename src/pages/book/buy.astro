---
/*
=========================================================
HABITAT IAS
JPSC PRELIMS DECODED
BOOK PURCHASE / CHECKOUT PAGE
=========================================================

EDITIONS

Hindi Edition   : ₹249
English Edition : ₹299

The edition is read by the browser from:

/book/buy?edition=hindi
/book/buy?edition=english

The browser NEVER decides the actual payment amount.

The server decides and verifies:
Hindi   = ₹249
English = ₹299
=========================================================
*/

const sampleBook =
  "https://drive.google.com/file/d/1gy_Im2Qs9Z7pwpYGUn7QSH0lJ4cwO5a5/view?usp=sharing";

const bookTitle =
  "JPSC Prelims Decoded: Topic-Wise PYQs";
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="theme-color"
    content="#1557d6"
  />

  <title>
    Purchase | Habitat IAS
  </title>

  <meta
    name="description"
    content="Purchase JPSC Prelims Decoded: Topic-Wise PYQs digital PDF from Habitat IAS."
  />

  <!-- =====================================================
       RAZORPAY CHECKOUT
       ===================================================== -->

  <script
    src="https://checkout.razorpay.com/v1/checkout.js"
  ></script>


  <style>

    /* =====================================================
       ROOT
       ===================================================== */

    :root {

      --blue: #1557d6;
      --blue-dark: #0d3f9f;
      --blue-light: #eef4ff;

      --yellow: #ffd43b;

      --text: #13213c;
      --muted: #667085;

      --border: #e5eaf2;

      --white: #ffffff;
      --bg: #f7f9fc;

      --green: #159447;
      --green-light: #eaf8ef;

      --red: #c62828;
      --red-light: #fff1f1;

      --shadow:
        0 18px 50px rgba(15, 39, 83, 0.10);

      --radius: 20px;

    }


    /* =====================================================
       RESET
       ===================================================== */

    * {
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      margin: 0;

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: var(--text);

      background: var(--bg);

      line-height: 1.6;

    }


    a {

      color: inherit;

      text-decoration: none;

    }


    button,
    input {

      font: inherit;

    }


    button {

      cursor: pointer;

    }


    /* =====================================================
       HEADER
       ===================================================== */

    .site-header {

      position: sticky;

      top: 0;

      z-index: 1000;

      background:
        rgba(255,255,255,0.97);

      border-bottom:
        1px solid var(--border);

      backdrop-filter:
        blur(12px);

    }


    .nav {

      width:
        min(
          1200px,
          calc(100% - 40px)
        );

      min-height: 76px;

      margin: 0 auto;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 25px;

    }


    .brand {

      display: inline-flex;

      align-items: center;

      gap: 12px;

      color: var(--blue);

      font-size: 24px;

      font-weight: 900;

      white-space: nowrap;

    }


    .brand-mark {

      width: 44px;

      height: 44px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      color: white;

      background: var(--blue);

      font-weight: 900;

      box-shadow:
        0 8px 20px
        rgba(21,87,214,0.22);

    }


    .nav-links {

      display: flex;

      align-items: center;

      gap: 20px;

      color: #3f4d68;

      font-size: 14px;

      font-weight: 700;

    }


    .nav-links a:hover {

      color: var(--blue);

    }


    .nav-cta {

      padding:
        11px 18px;

      border: 0;

      border-radius: 11px;

      color: white;

      background: var(--blue);

      font-weight: 800;

    }


    /* =====================================================
       HERO
       ===================================================== */

    .hero {

      padding:
        65px 20px 55px;

      color: white;

      background:
        linear-gradient(
          135deg,
          #1145ad,
          #2164e2
        );

    }


    .hero-inner {

      width:
        min(
          1100px,
          calc(100% - 20px)
        );

      margin: 0 auto;

      text-align: center;

    }


    .eyebrow {

      display: inline-flex;

      padding:
        7px 14px;

      border:
        1px solid
        rgba(255,255,255,0.4);

      border-radius: 999px;

      font-size: 11px;

      font-weight: 900;

      letter-spacing: 1.2px;

      text-transform: uppercase;

    }


    .hero h1 {

      margin:
        20px 0 12px;

      font-size:
        clamp(34px, 5vw, 55px);

      line-height: 1.05;

      letter-spacing: -2px;

    }


    .hero h1 span {

      color: var(--yellow);

    }


    .hero p {

      max-width: 700px;

      margin: 0 auto;

      color:
        rgba(255,255,255,0.88);

      font-size: 17px;

    }


    /* =====================================================
       CHECKOUT
       ===================================================== */

    .checkout-section {

      width:
        min(
          1100px,
          calc(100% - 40px)
        );

      margin: 0 auto;

      padding:
        65px 0 90px;

    }


    .checkout-grid {

      display: grid;

      grid-template-columns:
        minmax(0,1.1fr)
        minmax(320px,0.9fr);

      gap: 30px;

      align-items: start;

    }


    /* =====================================================
       CARD
       ===================================================== */

    .card {

      padding: 30px;

      border:
        1px solid var(--border);

      border-radius: 22px;

      background: white;

      box-shadow: var(--shadow);

    }


    .card-label {

      margin-bottom: 7px;

      color: var(--blue);

      font-size: 11px;

      font-weight: 900;

      letter-spacing: 1.4px;

      text-transform: uppercase;

    }


    .card h2 {

      margin:
        0 0 8px;

      font-size: 28px;

      line-height: 1.2;

    }


    .card-description {

      margin:
        0 0 25px;

      color: var(--muted);

      font-size: 14px;

    }


    /* =====================================================
       EDITION
       ===================================================== */

    .edition-banner {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      padding: 18px;

      margin-bottom: 25px;

      border:
        1px solid #dce8ff;

      border-radius: 16px;

      background:
        var(--blue-light);

    }


    .edition-left {

      display: flex;

      align-items: center;

      gap: 13px;

    }


    .edition-icon {

      width: 45px;

      height: 45px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background: white;

      font-size: 24px;

    }


    .edition-name {

      font-size: 16px;

      font-weight: 900;

    }


    .edition-language {

      color: var(--muted);

      font-size: 12px;

    }


    .edition-price {

      color: var(--blue);

      font-size: 26px;

      font-weight: 950;

      white-space: nowrap;

    }


    /* =====================================================
       FORM
       ===================================================== */

    .form-group {

      margin-bottom: 18px;

    }


    .form-group label {

      display: block;

      margin-bottom: 7px;

      color: #344054;

      font-size: 13px;

      font-weight: 800;

    }


    .form-group input {

      width: 100%;

      min-height: 50px;

      padding:
        12px 14px;

      border:
        1px solid #d8dee9;

      border-radius: 12px;

      outline: none;

      color: var(--text);

      background: white;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;

    }


    .form-group input:focus {

      border-color:
        var(--blue);

      box-shadow:
        0 0 0 4px
        rgba(21,87,214,0.10);

    }


    .form-help {

      margin-top: 5px;

      color: #8a94a8;

      font-size: 11px;

    }


    /* =====================================================
       PAYMENT BUTTON
       ===================================================== */

    .payment-button {

      width: 100%;

      min-height: 55px;

      margin-top: 8px;

      padding:
        13px 20px;

      border: 0;

      border-radius: 13px;

      color: #17233a;

      background: var(--yellow);

      box-shadow:
        0 10px 25px
        rgba(0,0,0,0.13);

      font-size: 15px;

      font-weight: 900;

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;

    }


    .payment-button:hover:not(:disabled) {

      transform:
        translateY(-2px);

    }


    .payment-button:disabled {

      cursor: not-allowed;

      opacity: 0.65;

    }


    /* =====================================================
       SECURITY
       ===================================================== */

    .security-notice {

      display: flex;

      gap: 10px;

      margin-top: 17px;

      padding: 14px;

      border-radius: 13px;

      background: #f5f7fb;

      color: #667085;

      font-size: 11px;

      line-height: 1.5;

    }


    .security-icon {

      flex: 0 0 auto;

      font-size: 16px;

    }


    /* =====================================================
       SUMMARY
       ===================================================== */

    .summary-card {

      position: sticky;

      top: 105px;

    }


    .summary-title {

      margin-bottom: 20px;

      font-size: 19px;

      font-weight: 900;

    }


    .summary-row {

      display: flex;

      justify-content: space-between;

      gap: 20px;

      padding:
        13px 0;

      border-bottom:
        1px solid var(--border);

      font-size: 14px;

    }


    .summary-row span:first-child {

      color: var(--muted);

    }


    .summary-row span:last-child {

      text-align: right;

      font-weight: 800;

    }


    .summary-total {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding-top: 20px;

    }


    .summary-total-label {

      font-size: 18px;

      font-weight: 900;

    }


    .summary-total-price {

      color: var(--blue);

      font-size: 30px;

      font-weight: 950;

    }


    /* =====================================================
       BENEFITS
       ===================================================== */

    .benefits {

      display: grid;

      gap: 12px;

      margin-top: 25px;

    }


    .benefit {

      display: flex;

      align-items: flex-start;

      gap: 10px;

      color: #526079;

      font-size: 13px;

    }


    .benefit-icon {

      width: 22px;

      height: 22px;

      display: grid;

      place-items: center;

      flex: 0 0 auto;

      border-radius: 50%;

      color: var(--green);

      background:
        var(--green-light);

      font-size: 12px;

      font-weight: 900;

    }


    /* =====================================================
       ERROR
       ===================================================== */

    .error-message {

      display: none;

      margin-bottom: 18px;

      padding:
        13px 15px;

      border:
        1px solid #ffd2d2;

      border-radius: 12px;

      color: var(--red);

      background: var(--red-light);

      font-size: 13px;

      font-weight: 700;

    }


    .error-message.show {

      display: block;

    }


    /* =====================================================
       SUCCESS
       ===================================================== */

    .success-message {

      display: none;

      margin-top: 20px;

      padding: 20px;

      border:
        1px solid #b9e8c8;

      border-radius: 16px;

      color: #126b34;

      background:
        var(--green-light);

      font-size: 13px;

      line-height: 1.6;

    }


    .success-message.show {

      display: block;

    }


    .success-title {

      display: block;

      margin-bottom: 7px;

      font-size: 22px;

      font-weight: 900;

    }


    .download-section {

      display: none;

      margin-top: 20px;

      padding: 20px;

      border:
        1px solid #b7e4c7;

      border-radius: 15px;

      background: white;

    }


    .download-section.show {

      display: block;

    }


    .download-title {

      margin-bottom: 8px;

      color: #126b34;

      font-size: 18px;

      font-weight: 900;

    }


    .download-details {

      margin-bottom: 16px;

      color: #526079;

      font-size: 13px;

    }


    .download-button {

      display: inline-block;

      padding:
        13px 22px;

      border-radius: 11px;

      color: white;

      background:
        var(--blue);

      font-size: 14px;

      font-weight: 900;

    }


    .download-button:hover {

      background:
        var(--blue-dark);

    }


    .download-expiry {

      margin-top: 12px;

      color: #8a94a8;

      font-size: 11px;

    }


    /* =====================================================
       FOOTER
       ===================================================== */

    .footer {

      padding:
        35px 20px;

      color: #aab6cc;

      background: #091a3b;

      text-align: center;

      font-size: 13px;

    }


    .footer strong {

      color: white;

    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 850px) {

      .nav {

        width:
          calc(100% - 28px);

      }


      .nav-links {

        display: none;

      }


      .checkout-grid {

        grid-template-columns: 1fr;

      }


      .summary-card {

        position: static;

      }

    }


    @media (max-width: 600px) {

      .hero {

        padding:
          45px 15px;

      }


      .checkout-section {

        width:
          calc(100% - 28px);

        padding:
          40px 0 60px;

      }


      .card {

        padding: 22px;

        border-radius: 18px;

      }


      .edition-banner {

        align-items:
          flex-start;

        flex-direction:
          column;

      }


      .edition-price {

        margin-left: 58px;

      }


      .brand {

        font-size: 20px;

      }


      .brand-mark {

        width: 38px;

        height: 38px;

      }

    }

  </style>

</head>


<body>


  <!-- =====================================================
       HEADER
