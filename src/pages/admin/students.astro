            <div class="stat-description">
              Access rate: {accessRate}%
            </div>

          </div>

        </div>

        <!-- =================================================
             STUDENT TABLE
        ================================================== -->

        <div class="card">

          <div class="card-header">

            <h2>
              Registered Students
            </h2>

            <p>
              {totalStudents} registered account{totalStudents === 1 ? "" : "s"}
              in the system.
            </p>

          </div>

          <!-- FILTERS -->

          <div class="filters">

            <div class="search-wrapper">

              <span class="search-icon">
                ⌕
              </span>

              <input
                id="studentSearch"
                class="search-input"
                type="text"
                placeholder="Search student name or email..."
                autocomplete="off"
              />

            </div>

            <select
              id="accessFilter"
              class="filter-select"
            >
              <option value="all">
                All Access
              </option>

              <option value="paid">
                Paid Access
              </option>

              <option value="manual">
                Manual Access
              </option>

              <option value="none">
                No Access
              </option>
            </select>

          </div>

          <!-- TABLE -->

          <div class="table-wrapper">

            <table>

              <thead>

                <tr>

                  <th>
                    STUDENT
                  </th>

                  <th>
                    SERIES
                  </th>

                  <th>
                    ACCESS
                  </th>

                  <th>
                    TESTS
                  </th>

                  <th>
                    PURCHASE
                  </th>

                  <th>
                    REGISTERED
                  </th>

                  <th>
                    ACTION
                  </th>

                </tr>

              </thead>

              <tbody id="studentsTableBody">

                {
                  students.map((student) => (
                    <tr
                      class="student-row"
                      data-name={student.name.toLowerCase()}
                      data-email={student.email.toLowerCase()}
                      data-access={student.accessType}
                    >

                      <td>

                        <div class="student-name">
                          {student.name}
                        </div>

                        <div class="student-email">
                          {student.email}
                        </div>

                      </td>

                      <td>

                        <div
                          style="
                            font-weight: 800;
                            color: #173b65;
                          "
                        >
                          JPSC Prelims
                        </div>

                        <div
                          style="
                            margin-top: 3px;
                            font-size: 12px;
                            color: #7386a0;
                          "
                        >
                          20-Test Series
                        </div>

                      </td>

                      <td>

                        <span
                          class={`access-badge ${student.accessType}`}
                        >
                          {student.accessLabel}
                        </span>

                      </td>

                      <td>

                        <span class="tests-count">
                          {student.testsUnlocked} / {TOTAL_TESTS}
                        </span>

                      </td>

                      <td>

                        {
                          student.accessType === "paid" ? (
                            <span class="purchase-badge paid">
                              Paid
                            </span>
                          ) : student.accessType === "manual" ? (
                            <span class="purchase-badge manual">
                              Manual
                            </span>
                          ) : (
                            <span
                              style="
                                color:#71839d;
                                font-size:13px;
                              "
                            >
                              No purchase
                            </span>
                          )
                        }

                      </td>

                      <td>

                        <span class="date">
                          {formatDate(
                            student.registeredAt
                          )}
                        </span>

                      </td>

                      <td>

                        <a
                          href={`/admin/access?user_id=${encodeURIComponent(student.id)}`}
                          class="action-button"
                        >
                          Manage Access
                        </a>

                      </td>

                    </tr>
                  ))
                }

                <tr
                  id="noResultsRow"
                  style="display:none;"
                >

                  <td
                    colspan="7"
                    class="empty-state"
                  >

                    <div class="empty-state-icon">
                      🔎
                    </div>

                    <div class="empty-state-title">
                      No students found
                    </div>

                    <div class="empty-state-text">
                      Try changing your search or access filter.
                    </div>

                  </td>

                </tr>

              </tbody>

            </table>

          </div>

        </div>

      </section>

    </main>

  </div>

  <!-- =====================================================
       CLIENT-SIDE SEARCH / FILTER
  ====================================================== -->

  <script>
    const searchInput =
      document.getElementById(
        "studentSearch"
      );

    const accessFilter =
      document.getElementById(
        "accessFilter"
      );

    const rows = Array.from(
      document.querySelectorAll(
        ".student-row"
      )
    );

    const noResultsRow =
      document.getElementById(
        "noResultsRow"
      );

    function applyStudentFilters() {

      const search =
        (
          searchInput?.value || ""
        )
          .trim()
          .toLowerCase();

      const access =
        accessFilter?.value || "all";

      let visibleCount = 0;

      rows.forEach((row) => {

        const name =
          row.dataset.name || "";

        const email =
          row.dataset.email || "";

        const rowAccess =
          row.dataset.access || "";

        const matchesSearch =
          !search ||
          name.includes(search) ||
          email.includes(search);

        const matchesAccess =
          access === "all" ||
          rowAccess === access;

        const visible =
          matchesSearch &&
          matchesAccess;

        row.style.display =
          visible ? "" : "none";

        if (visible) {
          visibleCount++;
        }
      });

      if (noResultsRow) {
        noResultsRow.style.display =
          visibleCount === 0
            ? ""
            : "none";
      }
    }

    searchInput?.addEventListener(
      "input",
      applyStudentFilters
    );

    accessFilter?.addEventListener(
      "change",
      applyStudentFilters
    );
  </script>

</body>
</html>