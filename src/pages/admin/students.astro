---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   ENVIRONMENT
========================================================= */

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const serviceRoleKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;
const adminUserId = import.meta.env.ADMIN_USER_ID;

if (!supabaseUrl) {
  throw new Error("PUBLIC_SUPABASE_URL is missing.");
}

if (!serviceRoleKey) {
  throw new Error("SUPABASE_SERVICE_ROLE_KEY is missing.");
}

if (!adminUserId) {
  throw new Error("ADMIN_USER_ID is missing.");
}

/* =========================================================
   CONSTANTS
========================================================= */

const PRODUCT_ID = "jpsc_prelims_20_test_series";
const TOTAL_TESTS = 20;

/* =========================================================
   SUPABASE ADMIN CLIENT
========================================================= */

const supabaseAdmin = createClient(
  supabaseUrl,
  serviceRoleKey,
  {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  }
);

/* =========================================================
   AUTHENTICATE ADMIN
========================================================= */

const accessToken =
  Astro.cookies.get("habitat-access-token")?.value;

let isAuthenticated = false;
let isAdmin = false;
let pageError = "";

/* =========================================================
   VERIFY SESSION
========================================================= */

if (accessToken) {
  const {
    data: userData,
    error: userError,
  } = await supabaseAdmin.auth.getUser(accessToken);

  if (!userError && userData?.user) {
    isAuthenticated = true;
    isAdmin = userData.user.id === adminUserId;
  }
}

/* =========================================================
   DATA TYPES
========================================================= */

type Student = {
  id: string;
  name: string;
  email: string;
  registeredAt: string | null;
  accessType: "paid" | "manual" | "none";
  accessLabel: string;
  testsUnlocked: number;
  purchaseStatus: string;
  manualAccess: boolean;
};

/* =========================================================
   STUDENT DATA
========================================================= */

let students: Student[] = [];

if (!isAuthenticated) {
  pageError = "Authentication required.";
} else if (!isAdmin) {
  pageError = "Admin access denied.";
} else {
  try {
    /* =======================================================
       1. LOAD AUTH USERS
    ======================================================= */

    const allUsers: any[] = [];

    let page = 1;
    const perPage = 1000;

    while (true) {
      const {
        data: usersData,
        error: usersError,
      } = await supabaseAdmin.auth.admin.listUsers({
        page,
        perPage,
      });

      if (usersError) {
        throw usersError;
      }

      const users = usersData?.users ?? [];

      allUsers.push(...users);

      if (users.length < perPage) {
        break;
      }

      page++;
    }

    /* =======================================================
       2. LOAD PAID PURCHASES
    ======================================================= */

    const {
      data: purchases,
      error: purchasesError,
    } = await supabaseAdmin
      .from("purchases")
      .select(
        "id, user_id, product_id, payment_status, created_at"
      )
      .eq("product_id", PRODUCT_ID)
      .eq("payment_status", "paid");

    if (purchasesError) {
      throw purchasesError;
    }

    /* =======================================================
       3. BUILD PAID USER MAP
    ======================================================= */

    const paidUsers = new Map<
      string,
      {
        status: string;
        createdAt: string | null;
      }
    >();

    for (const purchase of purchases ?? []) {
      if (!purchase.user_id) continue;

      if (!paidUsers.has(purchase.user_id)) {
        paidUsers.set(
          purchase.user_id,
          {
            status: "paid",
            createdAt:
              purchase.created_at ?? null,
          }
        );
      }
    }

    /* =======================================================
       4. LOAD MANUAL ACCESS
    ======================================================= */

    const {
      data: manualAccessRows,
      error: manualAccessError,
    } = await supabaseAdmin
      .from("manual_series_access")
      .select(
        "id, user_id, product_id, granted_by, granted_at, updated_at"
      )
      .eq("product_id", PRODUCT_ID);

    if (manualAccessError) {
      throw manualAccessError;
    }

    /* =======================================================
       5. BUILD MANUAL ACCESS MAP
    ======================================================= */

    const manualUsers = new Set<string>();

    for (const row of manualAccessRows ?? []) {
      if (row.user_id) {
        manualUsers.add(row.user_id);
      }
    }

    /* =======================================================
       6. BUILD STUDENT LIST
    ======================================================= */

    students = allUsers.map((user) => {
      const paid = paidUsers.has(user.id);
      const manual = manualUsers.has(user.id);

      let accessType: "paid" | "manual" | "none" =
        "none";

      let accessLabel = "No Access";
      let testsUnlocked = 0;
      let purchaseStatus = "No purchase";

      /*
       * Paid access has priority.
       * If a student has both paid and manual access,
       * we display Paid Access.
       */

      if (paid) {
        accessType = "paid";
        accessLabel = "Paid Access";
        testsUnlocked = TOTAL_TESTS;
        purchaseStatus = "Paid";
      } else if (manual) {
        accessType = "manual";
        accessLabel = "Manual Access";
        testsUnlocked = TOTAL_TESTS;
        purchaseStatus = "Manual";
      }

      const metadata =
        user.user_metadata ?? {};

      const name =
        metadata.full_name ||
        metadata.name ||
        metadata.display_name ||
        user.email?.split("@")[0] ||
        "Student";

      return {
        id: user.id,
        name,
        email: user.email ?? "No email",
        registeredAt:
          user.created_at ?? null,
        accessType,
        accessLabel,
        testsUnlocked,
        purchaseStatus,
        manualAccess: manual,
      };
    });

    /* =======================================================
       7. SORT NEWEST FIRST
    ======================================================= */

    students.sort((a, b) => {
      const dateA = a.registeredAt
        ? new Date(a.registeredAt).getTime()
        : 0;

      const dateB = b.registeredAt
        ? new Date(b.registeredAt).getTime()
        : 0;

      return dateB - dateA;
    });
  } catch (error) {
    console.error(
      "Student management error:",
      error
    );

    pageError =
      "Unable to load student information.";
  }
}

/* =========================================================
   STAGE 16 — STUDENT PERFORMANCE DATA
   =========================================================
   Uses existing mock_attempts data.
   Best submitted attempt per student/test determines rank.
   Equal scores receive the same rank.
   ========================================================= */

type StudentPerformance = {
  attempts: number;
  bestScore: number;
  averageScore: number;
  averagePercentage: number;
  bestRank: number | null;
  latestRank: number | null;
  testsAttempted: number;
};

const performanceByStudent =
  new Map<string, StudentPerformance>();

try {
  if (isAuthenticated && isAdmin) {
    const {
      data: performanceAttempts,
      error: performanceError,
    } = await supabaseAdmin
      .from("mock_attempts")
      .select(
        "id, user_id, test_id, score, status, submitted_at, created_at"
      )
      .eq("status", "submitted");

    if (performanceError) {
      throw performanceError;
    }

    const {
      data: performanceTests,
      error: performanceTestsError,
    } = await supabaseAdmin
      .from("mock_tests")
      .select(
        "id, test_number, title, question_count"
      );

    if (performanceTestsError) {
      throw performanceTestsError;
    }

    const testMap = new Map<string, any>();

    for (const test of performanceTests ?? []) {
      testMap.set(String(test.id), test);
    }

    const bestByStudentTest =
      new Map<string, any>();

    for (const attempt of performanceAttempts ?? []) {
      if (!attempt.user_id || !attempt.test_id) {
        continue;
      }

      const key =
        `${String(attempt.user_id)}:${String(attempt.test_id)}`;

      const existing =
        bestByStudentTest.get(key);

      const score =
        Number(attempt.score ?? 0);

      if (
        !existing ||
        score > Number(existing.score ?? -Infinity) ||
        (
          score === Number(existing.score ?? -Infinity) &&
          new Date(
            attempt.submitted_at ||
            attempt.created_at ||
            0
          ).getTime() >
          new Date(
            existing.submitted_at ||
            existing.created_at ||
            0
          ).getTime()
        )
      ) {
        bestByStudentTest.set(
          key,
          attempt
        );
      }
    }

    const rankingGroups =
      new Map<string, any[]>();

    for (const attempt of bestByStudentTest.values()) {
      const key = String(attempt.test_id);
      const group = rankingGroups.get(key) || [];
      group.push(attempt);
      rankingGroups.set(key, group);
    }

    const rankByStudentTest =
      new Map<string, number>();

    for (const group of rankingGroups.values()) {
      group.sort(
        (a, b) =>
          Number(b.score ?? 0) -
          Number(a.score ?? 0)
      );

      let previousScore: number | null = null;
      let currentRank = 0;

      group.forEach((attempt, index) => {
        const score =
          Number(attempt.score ?? 0);

        if (
          previousScore === null ||
          score !== previousScore
        ) {
          currentRank = index + 1;
        }

        rankByStudentTest.set(
          `${String(attempt.user_id)}:${String(attempt.test_id)}`,
          currentRank
        );

        previousScore = score;
      });
    }

    const attemptsByStudent =
      new Map<string, any[]>();

    for (const attempt of performanceAttempts ?? []) {
      if (!attempt.user_id) continue;

      const key = String(attempt.user_id);
      const group = attemptsByStudent.get(key) || [];
      group.push(attempt);
      attemptsByStudent.set(key, group);
    }

    for (const student of students) {
      const userAttempts =
        attemptsByStudent.get(String(student.id)) || [];

      if (!userAttempts.length) {
        performanceByStudent.set(
          String(student.id),
          {
            attempts: 0,
            bestScore: 0,
            averageScore: 0,
            averagePercentage: 0,
            bestRank: null,
            latestRank: null,
            testsAttempted: 0,
          }
        );
        continue;
      }

      let totalScore = 0;
      let totalPercentage = 0;
      let bestScore = 0;

      const attemptedTests =
        new Set<string>();

      for (const attempt of userAttempts) {
        const score =
          Number(attempt.score ?? 0);

        const test =
          testMap.get(String(attempt.test_id));

        const questionCount =
          Number(test?.question_count ?? 0);

        const maxMarks =
          questionCount > 0
            ? questionCount * 2
            : 0;

        const percentage =
          maxMarks > 0
            ? (score / maxMarks) * 100
            : 0;

        totalScore += score;
        totalPercentage += percentage;

        bestScore =
          Math.max(bestScore, score);

        attemptedTests.add(
          String(attempt.test_id)
        );
      }

      const ranks: number[] = [];

      for (const testId of attemptedTests) {
        const rank =
          rankByStudentTest.get(
            `${String(student.id)}:${testId}`
          );

        if (rank) ranks.push(rank);
      }

      ranks.sort((a, b) => a - b);

      const datedAttempts =
        [...userAttempts].sort(
          (a, b) =>
            new Date(
              b.submitted_at ||
              b.created_at ||
              0
            ).getTime() -
            new Date(
              a.submitted_at ||
              a.created_at ||
              0
            ).getTime()
        );

      const latestAttempt =
        datedAttempts[0];

      const latestRank =
        latestAttempt
          ? (
              rankByStudentTest.get(
                `${String(student.id)}:${String(
                  latestAttempt.test_id
                )}`
              ) ?? null
            )
          : null;

      performanceByStudent.set(
        String(student.id),
        {
          attempts: userAttempts.length,
          bestScore,
          averageScore:
            totalScore / userAttempts.length,
          averagePercentage:
            totalPercentage / userAttempts.length,
          bestRank:
            ranks.length ? ranks[0] : null,
          latestRank,
          testsAttempted:
            attemptedTests.size,
        }
      );
    }
  }
} catch (error) {
  console.error(
    "Student performance error:",
    error
  );
}

/* =========================================================
   STAGE 17 — STUDENT TEST HISTORY
   =========================================================
   Detailed history is calculated from existing mock_attempts.

   Each student's best submitted attempt for each test is shown.
   Rank is calculated within that test.
   The raw attempt IDs are retained so the admin can open the
   existing individual-attempt analysis page.
   ========================================================= */

type StudentTestHistory = {
  attemptId: string;
  testId: string;
  testNumber: number | null;
  title: string;
  score: number;
  maxMarks: number;
  percentage: number;
  rank: number | null;
  participants: number;
  submittedAt: string | null;
};

const historyByStudent =
  new Map<string, StudentTestHistory[]>();

try {
  if (isAuthenticated && isAdmin) {
    const {
      data: historyAttempts,
      error: historyAttemptsError,
    } = await supabaseAdmin
      .from("mock_attempts")
      .select(
        "id, user_id, test_id, score, status, submitted_at, created_at"
      )
      .eq("status", "submitted");

    if (historyAttemptsError) {
      throw historyAttemptsError;
    }

    const {
      data: historyTests,
      error: historyTestsError,
    } = await supabaseAdmin
      .from("mock_tests")
      .select(
        "id, test_number, title, question_count"
      );

    if (historyTestsError) {
      throw historyTestsError;
    }

    const historyTestMap =
      new Map<string, any>();

    for (const test of historyTests ?? []) {
      historyTestMap.set(
        String(test.id),
        test
      );
    }

    /* Best attempt for every student/test. */
    const bestHistoryAttempt =
      new Map<string, any>();

    for (const attempt of historyAttempts ?? []) {
      if (!attempt.user_id || !attempt.test_id) {
        continue;
      }

      const key =
        `${String(attempt.user_id)}:${String(attempt.test_id)}`;

      const existing =
        bestHistoryAttempt.get(key);

      const score =
        Number(attempt.score ?? 0);

      if (
        !existing ||
        score > Number(existing.score ?? -Infinity) ||
        (
          score === Number(existing.score ?? -Infinity) &&
          new Date(
            attempt.submitted_at ||
            attempt.created_at ||
            0
          ).getTime() >
          new Date(
            existing.submitted_at ||
            existing.created_at ||
            0
          ).getTime()
        )
      ) {
        bestHistoryAttempt.set(
          key,
          attempt
        );
      }
    }

    /* Rank the best attempt inside every test. */
    const historyGroups =
      new Map<string, any[]>();

    for (
      const attempt of bestHistoryAttempt.values()
    ) {
      const key =
        String(attempt.test_id);

      const group =
        historyGroups.get(key) || [];

      group.push(attempt);
      historyGroups.set(key, group);
    }

    const historyRank =
      new Map<
        string,
        {
          rank: number;
          participants: number;
        }
      >();

    for (const group of historyGroups.values()) {
      group.sort(
        (a, b) =>
          Number(b.score ?? 0) -
          Number(a.score ?? 0)
      );

      let previousScore:
        number | null = null;

      let currentRank = 0;

      group.forEach(
        (attempt, index) => {
          const score =
            Number(attempt.score ?? 0);

          if (
            previousScore === null ||
            score !== previousScore
          ) {
            currentRank =
              index + 1;
          }

          historyRank.set(
            String(attempt.id),
            {
              rank: currentRank,
              participants:
                group.length,
            }
          );

          previousScore = score;
        }
      );
    }

    const historyAccumulator =
      new Map<
        string,
        StudentTestHistory[]
      >();

    for (
      const attempt
      of bestHistoryAttempt.values()
    ) {
      const studentId =
        String(attempt.user_id);

      const test =
        historyTestMap.get(
          String(attempt.test_id)
        );

      const questionCount =
        Number(
          test?.question_count ?? 0
        );

      const maxMarks =
        questionCount > 0
          ? questionCount * 2
          : 0;

      const score =
        Number(attempt.score ?? 0);

      const percentage =
        maxMarks > 0
          ? (score / maxMarks) * 100
          : 0;

      const ranking =
        historyRank.get(
          String(attempt.id)
        );

      const historyItem: StudentTestHistory = {
        attemptId:
          String(attempt.id),
        testId:
          String(attempt.test_id),
        testNumber:
          test?.test_number !== null &&
          test?.test_number !== undefined
            ? Number(test.test_number)
            : null,
        title:
          String(
            test?.title ||
            "Mock Test"
          ),
        score,
        maxMarks,
        percentage,
        rank:
          ranking?.rank ?? null,
        participants:
          ranking?.participants ?? 0,
        submittedAt:
          attempt.submitted_at ||
          attempt.created_at ||
          null,
      };

      const list =
        historyAccumulator.get(
          studentId
        ) || [];

      list.push(historyItem);

      historyAccumulator.set(
        studentId,
        list
      );
    }

    for (
      const [studentId, history]
      of historyAccumulator
    ) {
      history.sort((a, b) => {
        if (
          a.testNumber !== null &&
          b.testNumber !== null
        ) {
          return (
            a.testNumber -
            b.testNumber
          );
        }

        return a.title.localeCompare(
          b.title
        );
      });

      historyByStudent.set(
        studentId,
        history
      );
    }
  }
} catch (error) {
  console.error(
    "Student test history error:",
    error
  );
}

/* =========================================================
   STAGE 19 — OPEN MOCK STUDENT INTELLIGENCE
   =========================================================
   Compares Test 21 and Test 22 using the existing best-attempt
   history already calculated above.

   Categories:
   80%+  = Excellent
   60–79.9% = Good
   40–59.9% = Average
   <40% = Needs Improvement

   Change = Test 22 percentage - Test 21 percentage.
   Rank movement = Test 21 rank - Test 22 rank.
   Positive values mean improvement.
   ========================================================= */

type OpenMockComparison = {
  hasTest21: boolean;
  hasTest22: boolean;
  test21: StudentTestHistory | null;
  test22: StudentTestHistory | null;
  percentageChange: number | null;
  rankChange: number | null;
  scoreChange: number | null;
  category21: string | null;
  category22: string | null;
  outcome: "improved" | "declined" | "same" | "not-comparable";
};

function getPerformanceCategory(
  percentage: number
): string {
  if (percentage >= 80) return "Excellent";
  if (percentage >= 60) return "Good";
  if (percentage >= 40) return "Average";
  return "Needs Improvement";
}

const openMockComparisonByStudent =
  new Map<string, OpenMockComparison>();

for (const student of students) {
  const history =
    historyByStudent.get(String(student.id)) || [];

  const test21 =
    history.find(
      (item) => Number(item.testNumber) === 21
    ) || null;

  const test22 =
    history.find(
      (item) => Number(item.testNumber) === 22
    ) || null;

  const category21 =
    test21
      ? getPerformanceCategory(test21.percentage)
      : null;

  const category22 =
    test22
      ? getPerformanceCategory(test22.percentage)
      : null;

  let percentageChange: number | null = null;
  let rankChange: number | null = null;
  let scoreChange: number | null = null;

  let outcome:
    | "improved"
    | "declined"
    | "same"
    | "not-comparable" =
    "not-comparable";

  if (test21 && test22) {
    percentageChange =
      test22.percentage - test21.percentage;

    scoreChange =
      test22.score - test21.score;

    if (
      test21.rank !== null &&
      test22.rank !== null
    ) {
      rankChange =
        test21.rank - test22.rank;
    }

    if (percentageChange > 0.05) {
      outcome = "improved";
    } else if (percentageChange < -0.05) {
      outcome = "declined";
    } else {
      outcome = "same";
    }
  }

  openMockComparisonByStudent.set(
    String(student.id),
    {
      hasTest21: Boolean(test21),
      hasTest22: Boolean(test22),
      test21,
      test22,
      percentageChange,
      rankChange,
      scoreChange,
      category21,
      category22,
      outcome,
    }
  );
}

/* =========================================================
   STAGE 19 — ADMIN SUMMARY
   ========================================================= */

const comparableOpenMockStudents =
  [...openMockComparisonByStudent.values()]
    .filter(
      (comparison) =>
        comparison.hasTest21 &&
        comparison.hasTest22
    );

const improvedOpenMockStudents =
  comparableOpenMockStudents.filter(
    (comparison) =>
      comparison.outcome === "improved"
  ).length;

const declinedOpenMockStudents =
  comparableOpenMockStudents.filter(
    (comparison) =>
      comparison.outcome === "declined"
  ).length;

const unchangedOpenMockStudents =
  comparableOpenMockStudents.filter(
    (comparison) =>
      comparison.outcome === "same"
  ).length;

const averageOpenMockChange =
  comparableOpenMockStudents.length > 0
    ? comparableOpenMockStudents.reduce(
        (total, comparison) =>
          total +
          Number(
            comparison.percentageChange ?? 0
          ),
        0
      ) / comparableOpenMockStudents.length
    : 0;

const largestOpenMockImprovement =
  comparableOpenMockStudents.length > 0
    ? Math.max(
        ...comparableOpenMockStudents.map(
          (comparison) =>
            Number(
              comparison.percentageChange ?? 0
            )
        )
      )
    : 0;

const largestOpenMockDecline =
  comparableOpenMockStudents.length > 0
    ? Math.min(
        ...comparableOpenMockStudents.map(
          (comparison) =>
            Number(
              comparison.percentageChange ?? 0
            )
        )
      )
    : 0;

/* =========================================================
   STATISTICS
   ========================================================= *//* =========================================================
   STATISTICS
========================================================= */

const totalStudents = students.length;

const paidStudents = students.filter(
  (student) =>
    student.accessType === "paid"
).length;

const manualStudents = students.filter(
  (student) =>
    student.accessType === "manual"
).length;

const noAccessStudents = students.filter(
  (student) =>
    student.accessType === "none"
).length;

const totalAccess =
  paidStudents + manualStudents;

const accessRate =
  totalStudents > 0
    ? Math.round(
        (totalAccess / totalStudents) * 100
      )
    : 0;

/* =========================================================
   FORMAT DATE
========================================================= */

function formatDate(
  value: string | null
) {
  if (!value) return "—";

  try {
    return new Date(value).toLocaleDateString(
      "en-IN",
      {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }
    );
  } catch {
    return "—";
  }
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Students | Habitat IAS Admin
  </title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background: #f4f7fb;
      color: #0b2d59;
    }

    body {
      min-height: 100vh;
    }

    button,
    input,
    select {
      font: inherit;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* =====================================================
       LAYOUT
    ===================================================== */

    .layout {
      min-height: 100vh;
      display: flex;
    }

    .sidebar {
      width: 285px;
      background: #ffffff;
      border-right: 1px solid #d9e3f0;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      overflow-y: auto;
      z-index: 20;
    }

    .brand {
      height: 132px;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 24px 22px;
      border-bottom: 1px solid #d9e3f0;
    }

    .brand-logo {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: #1760d4;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: 900;
    }

    .brand-title {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .brand-subtitle {
      margin-top: 3px;
      color: #6b7f9c;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .sidebar-section {
      padding: 26px 14px 4px;
    }

    .sidebar-heading {
      padding: 0 12px 12px;
      color: #7b8ca7;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 13px 16px;
      margin: 3px 0;
      border-radius: 12px;
      color: #143761;
      font-weight: 700;
      font-size: 15px;
    }

    .nav-item:hover {
      background: #f0f5ff;
    }

    .nav-item.active {
      background: #e9f0ff;
      color: #1458cf;
    }

    .nav-icon {
      width: 20px;
      text-align: center;
      font-weight: 900;
    }

    .nav-count {
      margin-left: auto;
      background: #edf2f8;
      color: #5b6e89;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 900;
    }

    .sidebar-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 20px 28px;
      border-top: 1px solid #d9e3f0;
      background: #fff;
      color: #617794;
      font-size: 13px;
      font-weight: 600;
    }

    .main {
      margin-left: 285px;
      width: calc(100% - 285px);
      min-height: 100vh;
    }

    /* =====================================================
       TOPBAR
    ===================================================== */

    .topbar {
      height: 84px;
      background: white;
      border-bottom: 1px solid #d9e3f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 34px;
    }

    .topbar-title {
      font-size: 22px;
      font-weight: 900;
      color: #102f58;
    }

    .topbar-subtitle {
      margin-top: 4px;
      font-size: 13px;
      color: #7185a1;
    }

    .topbar-actions {
      display: flex;
      gap: 10px;
    }

    .top-button {
      border: 1px solid #d4dfef;
      background: white;
      color: #12355f;
      padding: 11px 17px;
      border-radius: 10px;
      font-weight: 800;
      cursor: pointer;
    }

    .top-button:hover {
      background: #f5f8fd;
    }

    /* =====================================================
       CONTENT
    ===================================================== */

    .content {
      padding: 34px;
      max-width: 1600px;
      margin: 0 auto;
    }

    .page-heading {
      margin-bottom: 25px;
    }

    .page-heading h1 {
      margin: 0;
      font-size: 32px;
      letter-spacing: -1px;
      color: #092f61;
    }

    .page-heading p {
      margin: 8px 0 0;
      color: #6d819d;
      font-size: 15px;
    }

    /* =====================================================
       ERROR
    ===================================================== */

    .error-box {
      padding: 18px 20px;
      background: #fff0f0;
      border: 1px solid #ffc5c5;
      border-left: 5px solid #d52929;
      border-radius: 12px;
      color: #b71c1c;
      margin-bottom: 25px;
      font-weight: 700;
    }

    /* =====================================================
       STAT CARDS
    ===================================================== */

    .stats-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: white;
      border: 1px solid #d9e3f0;
      border-radius: 16px;
      padding: 24px;
      box-shadow:
        0 2px 8px rgba(20, 50, 90, 0.03);
    }

    .stat-label {
      color: #71839d;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.8px;
      text-transform: uppercase;
    }

    .stat-value {
      margin-top: 12px;
      font-size: 34px;
      line-height: 1;
      font-weight: 950;
      color: #0b3264;
    }

    .stat-description {
      margin-top: 9px;
      color: #7285a0;
      font-size: 13px;
    }

    /* =====================================================
       MAIN CARD
    ===================================================== */

    .card {
      background: white;
      border: 1px solid #d9e3f0;
      border-radius: 16px;
      overflow: hidden;
      box-shadow:
        0 2px 8px rgba(20, 50, 90, 0.03);
    }

    .card-header {
      padding: 24px;
      border-bottom: 1px solid #dce5f0;
    }

    .card-header h2 {
      margin: 0;
      font-size: 20px;
      color: #0a315f;
    }

    .card-header p {
      margin: 7px 0 0;
      color: #71839c;
      font-size: 13px;
    }

    /* =====================================================
       FILTERS
    ===================================================== */

    .filters {
      display: flex;
      gap: 12px;
      padding: 18px 24px;
      background: #fbfcfe;
      border-bottom: 1px solid #dce5f0;
    }

    .search-wrapper {
      flex: 1;
      position: relative;
    }

    .search-icon {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: #7b8da7;
    }

    .search-input,
    .filter-select {
      width: 100%;
      height: 48px;
      border: 1px solid #cedbea;
      border-radius: 10px;
      background: white;
      color: #173b65;
      outline: none;
    }

    .search-input {
      padding: 0 15px 0 42px;
    }

    .filter-select {
      width: 180px;
      padding: 0 13px;
    }

    .search-input:focus,
    .filter-select:focus {
      border-color: #2364d7;
      box-shadow:
        0 0 0 3px rgba(35, 100, 215, 0.1);
    }

    /* =====================================================
       TABLE
    ===================================================== */

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1050px;
    }

    thead th {
      padding: 16px 18px;
      text-align: left;
      background: #fbfcfe;
      color: #687c98;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      border-bottom: 1px solid #dce5f0;
      white-space: nowrap;
    }

    tbody td {
      padding: 18px;
      border-bottom: 1px solid #edf1f6;
      vertical-align: middle;
      font-size: 14px;
    }

    tbody tr:hover {
      background: #fafcff;
    }

    .student-name {
      font-weight: 900;
      color: #0b3263;
      font-size: 14px;
    }

    .student-email {
      margin-top: 4px;
      color: #71839d;
      font-size: 12px;
    }

    .access-badge,
    .purchase-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 11px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 900;
      white-space: nowrap;
    }

    .access-badge::before,
    .purchase-badge::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }

    .paid {
      background: #e8f8ef;
      color: #087d50;
    }

    .manual {
      background: #eee9ff;
      color: #6d42c7;
    }

    .none {
      background: #fff0f0;
      color: #c52929;
    }

    .tests-count {
      font-weight: 900;
      color: #123b6d;
    }

    .date {
      color: #607692;
      white-space: nowrap;
      font-size: 13px;
    }

    .performance-cell {
      min-width: 150px;
    }

    .performance-main {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
      font-weight: 900;
      color: #123b6d;
    }

    .performance-meta {
      margin-top: 5px;
      color: #7486a0;
      font-size: 11px;
      line-height: 1.4;
    }

    .rank-pill {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 999px;
      background: #edf3ff;
      color: #145bd0;
      font-size: 10px;
      font-weight: 900;
    }

    .action-group {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .performance-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(7, 27, 54, .48);
    }

    .performance-modal.open {
      display: flex;
    }

    .performance-dialog {
      width: min(760px, 100%);
      max-height: 88vh;
      overflow: auto;
      background: white;
      border-radius: 18px;
      border: 1px solid #d9e3f0;
      box-shadow: 0 20px 70px rgba(10, 39, 76, .25);
    }

    .performance-dialog-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 22px 24px;
      border-bottom: 1px solid #dce5f0;
    }

    .performance-dialog-title {
      margin: 0;
      color: #092f61;
      font-size: 20px;
      font-weight: 900;
    }

    .performance-dialog-email {
      margin-top: 5px;
      color: #71839d;
      font-size: 12px;
    }

    .modal-close {
      border: 1px solid #d4dfef;
      background: white;
      color: #173b65;
      border-radius: 9px;
      padding: 7px 10px;
      cursor: pointer;
      font-weight: 900;
    }

    .performance-summary {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      padding: 20px 24px;
    }

    .performance-summary-card {
      border: 1px solid #dce5f0;
      border-radius: 12px;
      padding: 14px;
      background: #fbfcfe;
    }

    .performance-summary-label {
      color: #71839d;
      font-size: 10px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .6px;
    }

    .performance-summary-value {
      margin-top: 7px;
      color: #0b3264;
      font-size: 22px;
      font-weight: 950;
    }

    .performance-note {
      margin: 0 24px 22px;
      padding: 12px 14px;
      border: 1px solid #d7e4f7;
      border-radius: 10px;
      background: #f5f9ff;
      color: #536887;
      font-size: 11px;
      line-height: 1.5;
    }

    .open-mock-comparison {
      margin: 0 24px 18px;
      padding: 17px;
      border: 1px solid #dce5f0;
      border-radius: 12px;
      background: #fbfcfe;
    }

    .open-mock-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 13px;
    }

    .open-mock-heading-title {
      color: #0b3264;
      font-size: 13px;
      font-weight: 950;
    }

    .open-mock-heading-subtitle {
      margin-top: 3px;
      color: #71839d;
      font-size: 10px;
    }

    .open-mock-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .open-mock-test-card {
      padding: 12px;
      border: 1px solid #dce5f0;
      border-radius: 10px;
      background: #fff;
    }

    .open-mock-test-number {
      color: #145bd0;
      font-size: 9px;
      font-weight: 950;
      letter-spacing: .5px;
    }

    .open-mock-test-score {
      margin-top: 5px;
      color: #0b3264;
      font-size: 20px;
      font-weight: 950;
    }

    .open-mock-test-meta {
      margin-top: 4px;
      color: #71839d;
      font-size: 10px;
      line-height: 1.45;
    }

    .open-mock-category {
      display: inline-flex;
      margin-top: 8px;
      padding: 4px 8px;
      border-radius: 999px;
      background: #edf3ff;
      color: #145bd0;
      font-size: 9px;
      font-weight: 900;
    }

    .open-mock-change {
      margin-top: 12px;
      padding: 11px 12px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 850;
    }

    .open-mock-change.improved {
      background: #eaf8f0;
      color: #087d50;
    }

    .open-mock-change.declined {
      background: #fff0f0;
      color: #b42318;
    }

    .open-mock-change.same {
      background: #f2f4f7;
      color: #667085;
    }

    .open-mock-change.not-comparable {
      background: #fff8eb;
      color: #9a6700;
    }

    .open-mock-mini {
      color: #145bd0;
      font-weight: 850;
    }

    .intelligence-summary {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 10px;
    }

    .intelligence-card {
      padding: 10px;
      border: 1px solid #e1e8f1;
      border-radius: 9px;
      background: #fff;
    }

    .intelligence-label {
      color: #7a8aa0;
      font-size: 8px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .45px;
    }

    .intelligence-value {
      margin-top: 4px;
      color: #123b6d;
      font-size: 15px;
      font-weight: 950;
    }

    .intelligence-note {
      margin-top: 10px;
      color: #71839d;
      font-size: 9px;
      line-height: 1.45;
    }

    .history-list {
      display: grid;
      gap: 9px;
      padding: 0 24px 24px;
    }

    .history-item {
      display: grid;
      grid-template-columns:
        minmax(190px, 1.8fr)
        minmax(80px, .7fr)
        minmax(80px, .7fr)
        minmax(90px, .8fr)
        minmax(90px, .8fr);
      gap: 10px;
      align-items: center;
      padding: 12px 13px;
      border: 1px solid #e0e7f0;
      border-radius: 11px;
      background: #fff;
    }

    .history-test {
      min-width: 0;
    }

    .history-test-number {
      color: #145bd0;
      font-size: 10px;
      font-weight: 900;
    }

    .history-test-title {
      margin-top: 3px;
      color: #123b6d;
      font-size: 12px;
      font-weight: 850;
      line-height: 1.35;
    }

    .history-label {
      color: #7a8aa0;
      font-size: 9px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .history-value {
      margin-top: 3px;
      color: #173b65;
      font-size: 12px;
      font-weight: 900;
    }

    .history-trend {
      margin: 0 24px 18px;
      padding: 15px;
      border: 1px solid #dce5f0;
      border-radius: 12px;
      background: #fbfcfe;
    }

    .trend-heading {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .trend-title {
      color: #0b3264;
      font-size: 12px;
      font-weight: 900;
    }

    .trend-summary {
      color: #71839d;
      font-size: 10px;
      font-weight: 750;
    }

    .trend-bars {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      height: 145px;
      margin-top: 15px;
      padding: 0 3px;
      overflow-x: auto;
    }

    .trend-bar-wrap {
      flex: 0 0 30px;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 5px;
    }

    .trend-bar {
      width: 20px;
      min-height: 4px;
      border-radius: 5px 5px 2px 2px;
      background: #6f91c9;
      border: 1px solid #5d80bc;
    }

    .trend-bar-label {
      color: #73859d;
      font-size: 8px;
      font-weight: 850;
      white-space: nowrap;
    }

    .trend-bar-value {
      color: #173b65;
      font-size: 8px;
      font-weight: 900;
    }

    .history-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 31px;
      padding: 0 9px;
      border: 1px solid #d2deed;
      border-radius: 8px;
      color: #145bd0;
      background: #fff;
      font-size: 10px;
      font-weight: 850;
      text-decoration: none;
    }

    .history-link:hover {
      background: #f3f7fd;
      border-color: #aebfd8;
    }

    .history-empty {
      padding: 22px;
      text-align: center;
      color: #7b8da5;
      font-size: 12px;
    }

    @media (max-width: 700px) {
      .open-mock-grid {
        grid-template-columns: 1fr;
      }

      .intelligence-summary {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .history-item {
        grid-template-columns: 1fr 1fr;
      }

      .history-item > :first-child {
        grid-column: 1 / -1;
      }
    }

    .action-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 9px 13px;
      border-radius: 9px;
      border: 1px solid #ccd9e9;
      background: white;
      color: #145bd0;
      font-weight: 800;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
    }

    .action-button:hover {
      background: #edf4ff;
      border-color: #9fbee9;
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #7486a0;
    }

    .empty-state-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .empty-state-title {
      font-size: 18px;
      font-weight: 900;
      color: #173b65;
    }

    .empty-state-text {
      margin-top: 6px;
      font-size: 13px;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1100px) {
      .stats-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 800px) {
      .sidebar {
        width: 230px;
      }

      .main {
        margin-left: 230px;
        width: calc(100% - 230px);
      }

      .content {
        padding: 20px;
      }

      .filters {
        flex-direction: column;
      }

      .filter-select {
        width: 100%;
      }
    }

    @media (max-width: 600px) {
      .sidebar {
        display: none;
      }

      .main {
        margin-left: 0;
        width: 100%;
      }

      .topbar {
        padding: 0 18px;
      }

      .topbar-subtitle {
        display: none;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .page-heading h1 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

  <div class="layout">

    <!-- ===================================================
         SIDEBAR
    ==================================================== -->

    <aside class="sidebar">

      <div class="brand">

        <div class="brand-logo">
          H
        </div>

        <div>
          <div class="brand-title">
            Habitat IAS
          </div>

          <div class="brand-subtitle">
            ADMIN CONTROL PANEL
          </div>
        </div>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          OVERVIEW
        </div>

        <a
          href="/admin"
          class="nav-item"
        >
          <span class="nav-icon">⌂</span>
          <span>Dashboard</span>
        </a>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          MOCK TEST
        </div>

        <a
          href="/admin/mock-tests"
          class="nav-item"
        >
          <span class="nav-icon">↗</span>
          <span>Mock Tests</span>

          <span class="nav-count">
            20
          </span>
        </a>

        <a
          href="/admin/questions"
          class="nav-item"
        >
          <span class="nav-icon">?</span>
          <span>Questions</span>

          <span class="nav-count">
            2,000
          </span>
        </a>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          STUDENTS
        </div>

        <a
          href="/admin/students"
          class="nav-item active"
        >
          <span class="nav-icon">•</span>
          <span>Students</span>

          <span
            class="nav-count"
            id="sidebarStudentCount"
          >
            {totalStudents}
          </span>
        </a>

        <a
          href="/admin/attempts"
          class="nav-item"
        >
          <span class="nav-icon">↗</span>
          <span>Student Attempts</span>
        </a>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          ANALYTICS
        </div>

        <a
          href="/admin/results"
          class="nav-item"
        >
          <span class="nav-icon">▥</span>
          <span>Results & Analytics</span>
        </a>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          ACCESS
        </div>

        <a
          href="/admin/access"
          class="nav-item"
        >
          <span class="nav-icon">◇</span>
          <span>Series Access</span>
        </a>

      </div>

      <div class="sidebar-section">

        <div class="sidebar-heading">
          SYSTEM
        </div>

        <a
          href="/admin/settings"
          class="nav-item"
        >
          <span class="nav-icon">⚙</span>
          <span>Settings</span>
        </a>

      </div>

      <div class="sidebar-footer">
        ← Back to Habitat IAS website
      </div>

    </aside>

    <!-- ===================================================
         MAIN
    ==================================================== -->

    <main class="main">

      <!-- TOPBAR -->

      <header class="topbar">

        <div>
          <div class="topbar-title">
            Student Management
          </div>

          <div class="topbar-subtitle">
            Manage registered Habitat IAS students
          </div>
        </div>

        <div class="topbar-actions">

          <a
            href="/admin"
            class="top-button"
          >
            ← Dashboard
          </a>

          <a
            href="/admin/access"
            class="top-button"
          >
            Series Access
          </a>

        </div>

      </header>

      <!-- CONTENT -->

      <section class="content">

        <div class="page-heading">

          <h1>
            Students
          </h1>

          <p>
            View registered students, account status and
            JPSC Prelims 20-Test Series access.
          </p>

        </div>

        {
          pageError && (
            <div class="error-box">
              {pageError}
            </div>
          )
        }

        <!-- =================================================
             STATISTICS
        ================================================== -->

        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-label">
              Total Students
            </div>

            <div class="stat-value">
              {totalStudents}
            </div>

            <div class="stat-description">
              Registered accounts
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-label">
              Paid Access
            </div>

            <div class="stat-value">
              {paidStudents}
            </div>

            <div class="stat-description">
              Students with genuine purchase
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-label">
              Manual Access
            </div>

            <div class="stat-value">
              {manualStudents}
            </div>

            <div class="stat-description">
              Complimentary/admin access
            </div>

          </div>

          <div class="stat-card">

            <div class="stat-label">
              No Access
            </div>

            <div class="stat-value">
              {noAccessStudents}
            </div>

            <div class="stat-description">
              Access rate: {accessRate}%
            </div>

          </div>

        </div>

        <!-- =================================================
             STAGE 19 — OPEN MOCK INTELLIGENCE SUMMARY
        ================================================== -->

        <div class="card" style="margin-bottom:25px;">

          <div class="card-header">
            <h2>
              Open Mock Student Intelligence
            </h2>

            <p>
              Test 21 vs Test 22 comparison for students who attempted both.
            </p>
          </div>

          <div style="padding:18px 24px 22px;">

            <div class="intelligence-summary">

              <div class="intelligence-card">
                <div class="intelligence-label">
                  Comparable Students
                </div>
                <div class="intelligence-value">
                  {comparableOpenMockStudents.length}
                </div>
              </div>

              <div class="intelligence-card">
                <div class="intelligence-label">
                  Improved
                </div>
                <div class="intelligence-value">
                  {improvedOpenMockStudents}
                </div>
              </div>

              <div class="intelligence-card">
                <div class="intelligence-label">
                  Declined
                </div>
                <div class="intelligence-value">
                  {declinedOpenMockStudents}
                </div>
              </div>

              <div class="intelligence-card">
                <div class="intelligence-label">
                  Average Change
                </div>
                <div class="intelligence-value">
                  {averageOpenMockChange >= 0 ? "+" : ""}
                  {averageOpenMockChange.toFixed(1)}%
                </div>
              </div>

            </div>

            <div class="intelligence-note">
              Largest improvement:
              {largestOpenMockImprovement >= 0 ? "+" : ""}
              {largestOpenMockImprovement.toFixed(1)}%
              {" · "}
              Largest decline:
              {largestOpenMockDecline >= 0 ? "+" : ""}
              {largestOpenMockDecline.toFixed(1)}%
              {" · "}
              Stable:
              {unchangedOpenMockStudents}
              {" · "}
              Comparison is based on each student's best submitted attempt for
              Test 21 and Test 22.
            </div>

          </div>

        </div>

        <!-- =================================================
             STUDENT TABLE
        ================================================== -->

        <div class="card">

          <div class="card-header">

            <h2>
              Registered Students
            </h2>

            <p>
              {totalStudents} registered account{totalStudents === 1 ? "" : "s"}
              in the system.
            </p>

          </div>

          <!-- FILTERS -->

          <div class="filters">

            <div class="search-wrapper">

              <span class="search-icon">
                ⌕
              </span>

              <input
                id="studentSearch"
                class="search-input"
                type="text"
                placeholder="Search student name or email..."
                autocomplete="off"
              />

            </div>

            <select
              id="accessFilter"
              class="filter-select"
            >
              <option value="all">
                All Access
              </option>

              <option value="paid">
                Paid Access
              </option>

              <option value="manual">
                Manual Access
              </option>

              <option value="none">
                No Access
              </option>
            </select>

          </div>

          <!-- TABLE -->

          <div class="table-wrapper">

            <table>

              <thead>

                <tr>

                  <th>
                    STUDENT
                  </th>

                  <th>
                    SERIES
                  </th>

                  <th>
                    ACCESS
                  </th>

                  <th>
                    TESTS
                  </th>

                  <th>
                    PERFORMANCE
                  </th>

                  <th>
                    PURCHASE
                  </th>

                  <th>
                    REGISTERED
                  </th>

                  <th>
                    ACTION
                  </th>

                </tr>

              </thead>

              <tbody id="studentsTableBody">

                {
                  students.map((student) => (
                    <tr
                      class="student-row"
                      data-name={student.name.toLowerCase()}
                      data-email={student.email.toLowerCase()}
                      data-access={student.accessType}
                      data-performance={JSON.stringify(
                        performanceByStudent.get(
                          String(student.id)
                        ) || {
                          attempts: 0,
                          bestScore: 0,
                          averageScore: 0,
                          averagePercentage: 0,
                          bestRank: null,
                          latestRank: null,
                          testsAttempted: 0,
                        }
                      )}
                      data-history={JSON.stringify(
                        historyByStudent.get(
                          String(student.id)
                        ) || []
                      )}
                      data-open-mock-comparison={JSON.stringify(
                        openMockComparisonByStudent.get(
                          String(student.id)
                        ) || {
                          hasTest21: false,
                          hasTest22: false,
                          test21: null,
                          test22: null,
                          percentageChange: null,
                          rankChange: null,
                          scoreChange: null,
                          category21: null,
                          category22: null,
                          outcome: "not-comparable",
                        }
                      )}
                    >

                      <td>

                        <div class="student-name">
                          {student.name}
                        </div>

                        <div class="student-email">
                          {student.email}
                        </div>

                      </td>

                      <td>

                        <div
                          style="
                            font-weight: 800;
                            color: #173b65;
                          "
                        >
                          JPSC Prelims
                        </div>

                        <div
                          style="
                            margin-top: 3px;
                            font-size: 12px;
                            color: #7386a0;
                          "
                        >
                          20-Test Series
                        </div>

                      </td>

                      <td>

                        <span
                          class={`access-badge ${student.accessType}`}
                        >
                          {student.accessLabel}
                        </span>

                      </td>

                      <td>

                        <span class="tests-count">
                          {student.testsUnlocked} / {TOTAL_TESTS}
                        </span>

                      </td>

                      <td class="performance-cell">

                        {
                          (() => {
                            const performance =
                              performanceByStudent.get(
                                String(student.id)
                              );

                            if (!performance) {
                              return (
                                <span class="performance-meta">
                                  No data
                                </span>
                              );
                            }

                            return (
                              <>
                                <div class="performance-main">
                                  <span>
                                    {performance.attempts}
                                    {" "}
                                    attempt{performance.attempts === 1 ? "" : "s"}
                                  </span>

                                  {
                                    performance.bestRank !== null && (
                                      <span class="rank-pill">
                                        Best #{performance.bestRank}
                                      </span>
                                    )
                                  }
                                </div>

                                <div class="performance-meta">
                                  Avg {performance.averagePercentage.toFixed(1)}%
                                  {" · "}
                                  Best {performance.bestScore}
                                  {" · "}
                                  {performance.testsAttempted}
                                  {" test"}
                                  {performance.testsAttempted === 1 ? "" : "s"}
                                </div>

                                {
                                  (() => {
                                    const comparison =
                                      openMockComparisonByStudent.get(
                                        String(student.id)
                                      );

                                    if (
                                      !comparison ||
                                      comparison.outcome === "not-comparable"
                                    ) {
                                      return null;
                                    }

                                    return (
                                      <div class="performance-meta open-mock-mini">
                                        Open Mock:{" "}
                                        {
                                          comparison.outcome === "improved"
                                            ? "↑ Improved"
                                            : comparison.outcome === "declined"
                                            ? "↓ Declined"
                                            : "→ Stable"
                                        }
                                        {" · "}
                                        {comparison.percentageChange! >= 0 ? "+" : ""}
                                        {comparison.percentageChange!.toFixed(1)}%
                                      </div>
                                    );
                                  })()
                                }
                              </>
                            );
                          })()
                        }

                      </td>

                      <td>

                        {
                          student.accessType === "paid" ? (
                            <span class="purchase-badge paid">
                              Paid
                            </span>
                          ) : student.accessType === "manual" ? (
                            <span class="purchase-badge manual">
                              Manual
                            </span>
                          ) : (
                            <span
                              style="
                                color:#71839d;
                                font-size:13px;
                              "
                            >
                              No purchase
                            </span>
                          )
                        }

                      </td>

                      <td>

                        <span class="date">
                          {formatDate(
                            student.registeredAt
                          )}
                        </span>

                      </td>

                      <td>

                        <div class="action-group">

                          <button
                            type="button"
                            class="action-button view-performance"
                          >
                            Performance
                          </button>

                          <button
                            type="button"
                            class="action-button view-open-mock"
                          >
                            Open Mock
                          </button>

                          <a
                            href={`/admin/access?user_id=${encodeURIComponent(student.id)}`}
                            class="action-button"
                          >
                            Manage Access
                          </a>

                        </div>

                      </td>

                    </tr>
                  ))
                }

                <tr
                  id="noResultsRow"
                  style="display:none;"
                >

                  <td
                    colspan="8"
                    class="empty-state"
                  >

                    <div class="empty-state-icon">
                      🔎
                    </div>

                    <div class="empty-state-title">
                      No students found
                    </div>

                    <div class="empty-state-text">
                      Try changing your search or access filter.
                    </div>

                  </td>

                </tr>

              </tbody>

            </table>

          </div>

        </div>

        <div
          id="performanceModal"
          class="performance-modal"
          aria-hidden="true"
        >
          <div
            class="performance-dialog"
            role="dialog"
            aria-modal="true"
          >
            <div class="performance-dialog-header">
              <div>
                <h2
                  id="performanceModalTitle"
                  class="performance-dialog-title"
                >
                  Student Performance
                </h2>

                <div
                  id="performanceModalEmail"
                  class="performance-dialog-email"
                ></div>
              </div>

              <button
                type="button"
                id="performanceModalClose"
                class="modal-close"
              >
                Close
              </button>
            </div>

            <div
              id="performanceModalBody"
              class="performance-summary"
            ></div>

            <div
              id="openMockComparison"
              class="open-mock-comparison"
              style="display:none;"
            ></div>

            <div
              id="performanceHistory"
              class="history-list"
            ></div>

            <div
              id="performanceTrend"
              class="history-trend"
              style="display:none;"
            ></div>

            <div class="performance-note">
              Ranking uses the student's best submitted score for each
              test. Equal scores receive the same rank. Data is calculated
              from the existing attempt records.
            </div>
          </div>
        </div>

      </section>

    </main>

  </div>

  <script>
    const performanceModal =
      document.getElementById("performanceModal");

    const performanceModalTitle =
      document.getElementById("performanceModalTitle");

    const performanceModalEmail =
      document.getElementById("performanceModalEmail");

    const performanceModalBody =
      document.getElementById("performanceModalBody");

    const performanceHistory =
      document.getElementById("performanceHistory");

    const performanceTrend =
      document.getElementById("performanceTrend");

    const openMockComparison =
      document.getElementById("openMockComparison");

    const performanceModalClose =
      document.getElementById("performanceModalClose");

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatDate(value) {
      if (!value) return "—";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "—";
      }

      return date.toLocaleDateString(
        undefined,
        {
          day: "2-digit",
          month: "short",
          year: "numeric",
        }
      );
    }

    function renderHistory(history) {
      if (!performanceHistory) return;

      if (!Array.isArray(history) || !history.length) {
        performanceHistory.innerHTML = `
          <div class="history-empty">
            No submitted test history available.
          </div>
        `;
        return;
      }

      performanceHistory.innerHTML =
        history.map((item) => `
          <div class="history-item">

            <div class="history-test">

              <div class="history-test-number">
                ${
                  item.testNumber !== null &&
                  item.testNumber !== undefined
                    ? `TEST ${escapeHtml(item.testNumber)}`
                    : "MOCK TEST"
                }
              </div>

              <div class="history-test-title">
                ${escapeHtml(item.title)}
              </div>

              <div class="history-label" style="margin-top:5px;">
                ${escapeHtml(formatDate(item.submittedAt))}
              </div>

            </div>

            <div>
              <div class="history-label">
                Score
              </div>

              <div class="history-value">
                ${escapeHtml(item.score)}
                /
                ${escapeHtml(item.maxMarks)}
              </div>
            </div>

            <div>
              <div class="history-label">
                Percentage
              </div>

              <div class="history-value">
                ${Number(item.percentage || 0).toFixed(1)}%
              </div>
            </div>

            <div>
              <div class="history-label">
                Rank
              </div>

              <div class="history-value">
                ${
                  item.rank !== null &&
                  item.rank !== undefined
                    ? `#${escapeHtml(item.rank)} / ${escapeHtml(item.participants)}`
                    : "—"
                }
              </div>
            </div>

            <div>
              <div class="history-label">
                Attempt
              </div>

              <div style="margin-top:5px;">
                <a
                  class="history-link"
                  href="/admin/attempts?attempt_id=${encodeURIComponent(
                    String(item.attemptId)
                  )}"
                >
                  View Analysis
                </a>
              </div>
            </div>

          </div>
        `).join("");
    }

    function renderOpenMockComparison(comparison) {
      if (!openMockComparison) return;

      if (
        !comparison ||
        !comparison.hasTest21 ||
        !comparison.hasTest22
      ) {
        openMockComparison.style.display = "block";

        const missing =
          !comparison?.hasTest21 && !comparison?.hasTest22
            ? "The student has not attempted Test 21 or Test 22."
            : !comparison?.hasTest21
            ? "The student has not attempted Test 21 yet."
            : "The student has not attempted Test 22 yet.";

        openMockComparison.innerHTML = `
          <div class="open-mock-heading">
            <div>
              <div class="open-mock-heading-title">
                Open Mock Comparison
              </div>
              <div class="open-mock-heading-subtitle">
                Test 21 → Test 22
              </div>
            </div>
          </div>

          <div class="open-mock-change not-comparable">
            ${escapeHtml(missing)}
            Comparison becomes available after both tests are submitted.
          </div>
        `;

        return;
      }

      const t21 = comparison.test21;
      const t22 = comparison.test22;

      const change =
        Number(comparison.percentageChange ?? 0);

      const rankChange =
        comparison.rankChange;

      const outcome =
        comparison.outcome || "same";

      const outcomeText =
        outcome === "improved"
          ? "↑ Performance improved"
          : outcome === "declined"
          ? "↓ Performance declined"
          : "→ Performance stable";

      const rankText =
        rankChange === null ||
        rankChange === undefined
          ? "Rank comparison unavailable"
          : rankChange > 0
          ? `↑ Improved ${rankChange} rank place${rankChange === 1 ? "" : "s"}`
          : rankChange < 0
          ? `↓ Fell ${Math.abs(rankChange)} rank place${Math.abs(rankChange) === 1 ? "" : "s"}`
          : "→ Same rank";

      openMockComparison.style.display = "block";

      openMockComparison.innerHTML = `
        <div class="open-mock-heading">
          <div>
            <div class="open-mock-heading-title">
              Open Mock Comparison
            </div>
            <div class="open-mock-heading-subtitle">
              Best attempt in each test · Test 21 → Test 22
            </div>
          </div>
        </div>

        <div class="open-mock-grid">

          <div class="open-mock-test-card">
            <div class="open-mock-test-number">
              TEST 21
            </div>

            <div class="open-mock-test-score">
              ${escapeHtml(t21.score)} / ${escapeHtml(t21.maxMarks)}
            </div>

            <div class="open-mock-test-meta">
              ${Number(t21.percentage).toFixed(1)}%
              {" · "}
              Rank #${escapeHtml(t21.rank)} / ${escapeHtml(t21.participants)}
            </div>

            <span class="open-mock-category">
              ${escapeHtml(comparison.category21)}
            </span>
          </div>

          <div class="open-mock-test-card">
            <div class="open-mock-test-number">
              TEST 22
            </div>

            <div class="open-mock-test-score">
              ${escapeHtml(t22.score)} / ${escapeHtml(t22.maxMarks)}
            </div>

            <div class="open-mock-test-meta">
              ${Number(t22.percentage).toFixed(1)}%
              {" · "}
              Rank #${escapeHtml(t22.rank)} / ${escapeHtml(t22.participants)}
            </div>

            <span class="open-mock-category">
              ${escapeHtml(comparison.category22)}
            </span>
          </div>

        </div>

        <div class="open-mock-change ${escapeHtml(outcome)}">
          ${outcomeText}
          {" · "}
          ${change >= 0 ? "+" : ""}
          ${change.toFixed(1)} percentage points
          {" · "}
          ${rankText}
        </div>
      `;
    }

    function renderTrend(history) {
      if (!performanceTrend) return;

      if (!Array.isArray(history) || !history.length) {
        performanceTrend.style.display = "none";
        performanceTrend.innerHTML = "";
        return;
      }

      const values =
        history.map(
          (item) =>
            Number(item.percentage || 0)
        );

      const highest =
        Math.max(...values, 0);

      const lowest =
        Math.min(...values, 0);

      const first =
        values[0] ?? 0;

      const latest =
        values[values.length - 1] ?? 0;

      const change =
        latest - first;

      const maxBar =
        Math.max(highest, 100);

      const bars =
        history.map((item, index) => {
          const percentage =
            Math.max(
              0,
              Math.min(
                100,
                Number(item.percentage || 0)
              )
            );

          const height =
            Math.max(
              4,
              Math.round(
                (percentage / maxBar) * 105
              )
            );

          const label =
            item.testNumber !== null &&
            item.testNumber !== undefined
              ? `T${item.testNumber}`
              : `#${index + 1}`;

          return `
            <div class="trend-bar-wrap">
              <div class="trend-bar-value">
                ${percentage.toFixed(0)}%
              </div>

              <div
                class="trend-bar"
                style="height:${height}px;"
                title="${escapeHtml(item.title)} — ${percentage.toFixed(1)}%"
              ></div>

              <div class="trend-bar-label">
                ${escapeHtml(label)}
              </div>
            </div>
          `;
        }).join("");

      performanceTrend.style.display = "block";

      performanceTrend.innerHTML = `
        <div class="trend-heading">

          <div class="trend-title">
            Performance Trend
          </div>

          <div class="trend-summary">
            First ${first.toFixed(1)}%
            · Latest ${latest.toFixed(1)}%
            · Change
            ${change >= 0 ? "+" : ""}
            ${change.toFixed(1)}%
            · Best ${highest.toFixed(1)}%
            · Lowest ${lowest.toFixed(1)}%
          </div>

        </div>

        <div class="trend-bars">
          ${bars}
        </div>
      `;
    }

    document.querySelectorAll(".view-performance")
      .forEach((button) => {
        button.addEventListener("click", () => {

          const row =
            button.closest(".student-row");

          if (!row || !performanceModal) {
            return;
          }

          const name =
            row.querySelector(".student-name")
              ?.textContent?.trim() ||
            "Student";

          const email =
            row.querySelector(".student-email")
              ?.textContent?.trim() ||
            "";

          let performance = {};
          let history = [];
          let comparison = {};

          try {
            performance =
              JSON.parse(
                row.dataset.performance || "{}"
              );
          } catch {
            performance = {};
          }

          try {
            history =
              JSON.parse(
                row.dataset.history || "[]"
              );
          } catch {
            history = [];
          }

          try {
            comparison =
              JSON.parse(
                row.dataset.openMockComparison || "{}"
              );
          } catch {
            comparison = {};
          }

          performanceModalTitle.textContent =
            name;

          performanceModalEmail.textContent =
            email;

          const cards = [
            [
              "Tests Attempted",
              performance.testsAttempted ?? 0
            ],
            [
              "Total Attempts",
              performance.attempts ?? 0
            ],
            [
              "Average",
              `${Number(
                performance.averagePercentage ?? 0
              ).toFixed(1)}%`
            ],
            [
              "Average Score",
              Number(
                performance.averageScore ?? 0
              ).toFixed(1)
            ],
            [
              "Best Score",
              Number(
                performance.bestScore ?? 0
              ).toFixed(0)
            ],
            [
              "Best Rank",
              performance.bestRank !== null &&
              performance.bestRank !== undefined
                ? `#${performance.bestRank}`
                : "—"
            ],
            [
              "Latest Rank",
              performance.latestRank !== null &&
              performance.latestRank !== undefined
                ? `#${performance.latestRank}`
                : "—"
            ]
          ];

          performanceModalBody.innerHTML =
            cards.map(
              ([label, value]) => `
                <div class="performance-summary-card">
                  <div class="performance-summary-label">
                    ${label}
                  </div>

                  <div class="performance-summary-value">
                    ${value}
                  </div>
                </div>
              `
            ).join("");

          renderOpenMockComparison(comparison);
          renderHistory(history);
          renderTrend(history);

          performanceModal.classList.add("open");

          performanceModal.setAttribute(
            "aria-hidden",
            "false"
          );

    document.querySelectorAll(".view-open-mock")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const row =
            button.closest(".student-row");

          if (!row || !performanceModal) {
            return;
          }

          const name =
            row.querySelector(".student-name")
              ?.textContent?.trim() ||
            "Student";

          const email =
            row.querySelector(".student-email")
              ?.textContent?.trim() ||
            "";

          let comparison = {};

          try {
            comparison =
              JSON.parse(
                row.dataset.openMockComparison || "{}"
              );
          } catch {
            comparison = {};
          }

          performanceModalTitle.textContent =
            `${name} — Open Mock Intelligence`;

          performanceModalEmail.textContent =
            email;

          performanceModalBody.innerHTML = "";

          renderOpenMockComparison(comparison);

          const history =
            (() => {
              try {
                return JSON.parse(
                  row.dataset.history || "[]"
                );
              } catch {
                return [];
              }
            })();

          renderHistory(
            history.filter(
              (item) =>
                Number(item.testNumber) === 21 ||
                Number(item.testNumber) === 22
            )
          );

          renderTrend(
            history.filter(
              (item) =>
                Number(item.testNumber) === 21 ||
                Number(item.testNumber) === 22
            )
          );

          performanceModal.classList.add("open");

          performanceModal.setAttribute(
            "aria-hidden",
            "false"
          );
        });
      });

        });
      });

    performanceModalClose?.addEventListener(
      "click",
      () => {
        performanceModal?.classList.remove("open");

        performanceModal?.setAttribute(
          "aria-hidden",
          "true"
        );
      }
    );

    performanceModal?.addEventListener(
      "click",
      (event) => {
        if (
          event.target === performanceModal
        ) {
          performanceModal.classList.remove(
            "open"
          );

          performanceModal.setAttribute(
            "aria-hidden",
            "true"
          );
        }
      }
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          performanceModal?.classList.remove(
            "open"
          );

          performanceModal?.setAttribute(
            "aria-hidden",
            "true"
          );
        }
      }
    );
  </script>

  <!-- =====================================================
       CLIENT-SIDE SEARCH / FILTER
  ====================================================== -->

  <script>
    const searchInput =
      document.getElementById(
        "studentSearch"
      );

    const accessFilter =
      document.getElementById(
        "accessFilter"
      );

    const rows = Array.from(
      document.querySelectorAll(
        ".student-row"
      )
    );

    const noResultsRow =
      document.getElementById(
        "noResultsRow"
      );

    function applyStudentFilters() {

      const search =
        (
          searchInput?.value || ""
        )
          .trim()
          .toLowerCase();

      const access =
        accessFilter?.value || "all";

      let visibleCount = 0;

      rows.forEach((row) => {

        const name =
          row.dataset.name || "";

        const email =
          row.dataset.email || "";

        const rowAccess =
          row.dataset.access || "";

        const matchesSearch =
          !search ||
          name.includes(search) ||
          email.includes(search);

        const matchesAccess =
          access === "all" ||
          rowAccess === access;

        const visible =
          matchesSearch &&
          matchesAccess;

        row.style.display =
          visible ? "" : "none";

        if (visible) {
          visibleCount++;
        }
      });

      if (noResultsRow) {
        noResultsRow.style.display =
          visibleCount === 0
            ? ""
            : "none";
      }
    }

    searchInput?.addEventListener(
      "input",
      applyStudentFilters
    );

    accessFilter?.addEventListener(
      "change",
      applyStudentFilters
    );
  </script>

</body>
</html>