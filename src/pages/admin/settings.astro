---
export const prerender = false;

const seriesName = "JPSC Prelims — 20 Test Series";
const productId = "jpsc_prelims_20_test_series";

const totalTests = 20;
const questionsPerTest = 100;
const durationMinutes = 120;
const marksPerCorrect = 2;
const negativeMarking = 0;
const totalMarks = questionsPerTest * marksPerCorrect;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Settings — Habitat IAS</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f4f7fb;
      color: #092c63;
    }

    body {
      min-height: 100vh;
    }

    .layout {
      display: flex;
      min-height: 100vh;
    }

    /* =========================
       SIDEBAR
    ========================= */

    .sidebar {
      width: 285px;
      background: #ffffff;
      border-right: 1px solid #dce5f2;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      overflow-y: auto;
      z-index: 20;
    }

    .brand {
      height: 108px;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 20px 24px;
      border-bottom: 1px solid #dce5f2;
    }

    .brand-logo {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      background: #175bd7;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
      font-weight: 800;
    }

    .brand-title {
      font-size: 20px;
      font-weight: 800;
      color: #092c63;
    }

    .brand-subtitle {
      margin-top: 3px;
      font-size: 12px;
      letter-spacing: 1px;
      color: #61789b;
      font-weight: 600;
    }

    .nav {
      padding: 25px 14px;
    }

    .nav-section {
      margin: 0 12px 12px;
      color: #7890b0;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.2px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 13px;
      min-height: 48px;
      margin-bottom: 5px;
      padding: 0 18px;
      border-radius: 11px;
      text-decoration: none;
      color: #153b70;
      font-size: 15px;
      font-weight: 700;
      transition: 0.15s ease;
    }

    .nav-link:hover {
      background: #eef4ff;
      color: #175bd7;
    }

    .nav-link.active {
      background: #eaf1ff;
      color: #175bd7;
    }

    .nav-icon {
      width: 22px;
      text-align: center;
      font-size: 16px;
    }

    .nav-spacer {
      height: 18px;
    }

    .back-link {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 18px 25px;
      border-top: 1px solid #dce5f2;
      background: white;
      color: #58749b;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }

    /* =========================
       MAIN
    ========================= */

    .main {
      margin-left: 285px;
      width: calc(100% - 285px);
      min-height: 100vh;
    }

    .topbar {
      height: 82px;
      background: white;
      border-bottom: 1px solid #dce5f2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 34px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .top-title {
      font-size: 24px;
      font-weight: 800;
      color: #092c63;
    }

    .top-subtitle {
      margin-top: 4px;
      color: #6b83a5;
      font-size: 13px;
    }

    .top-actions {
      display: flex;
      gap: 10px;
    }

    .btn {
      border: 1px solid #d5e0ef;
      background: white;
      color: #092c63;
      border-radius: 10px;
      padding: 11px 17px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
    }

    .btn:hover {
      background: #f4f7fb;
    }

    .btn-primary {
      background: #175bd7;
      border-color: #175bd7;
      color: white;
    }

    .btn-primary:hover {
      background: #104bb7;
    }

    .content {
      padding: 30px 34px 60px;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* =========================
       PAGE HEADER
    ========================= */

    .page-header {
      margin-bottom: 25px;
    }

    .page-header h1 {
      margin: 0;
      font-size: 32px;
      color: #092c63;
    }

    .page-header p {
      margin: 8px 0 0;
      color: #637b9d;
      font-size: 15px;
    }

    /* =========================
       GRID
    ========================= */

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .card {
      background: white;
      border: 1px solid #dce5f2;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(24, 58, 105, 0.03);
    }

    .card-header {
      padding: 22px 24px;
      border-bottom: 1px solid #e1e8f2;
    }

    .card-title {
      margin: 0;
      font-size: 19px;
      color: #092c63;
    }

    .card-description {
      margin: 6px 0 0;
      color: #6b83a5;
      font-size: 13px;
    }

    .card-body {
      padding: 24px;
    }

    /* =========================
       SETTINGS ROW
    ========================= */

    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 17px 0;
      border-bottom: 1px solid #edf1f6;
    }

    .setting-row:first-child {
      padding-top: 0;
    }

    .setting-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .setting-label {
      color: #173e70;
      font-size: 14px;
      font-weight: 700;
    }

    .setting-help {
      margin-top: 4px;
      color: #7890af;
      font-size: 12px;
    }

    .setting-value {
      min-width: 120px;
      text-align: right;
      color: #092c63;
      font-weight: 800;
      font-size: 15px;
    }

    /* =========================
       STATUS
    ========================= */

    .status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .status-green {
      background: #e9f8f0;
      color: #087d50;
    }

    .status-blue {
      background: #eaf2ff;
      color: #175bd7;
    }

    .status-red {
      background: #fff0f0;
      color: #c52f2f;
    }

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }

    /* =========================
       SCORE BOX
    ========================= */

    .score-box {
      border: 1px solid #cfe0ff;
      background: #f1f6ff;
      border-radius: 13px;
      padding: 18px;
      margin-bottom: 20px;
    }

    .score-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .score-number {
      font-size: 30px;
      font-weight: 900;
      color: #175bd7;
    }

    .score-text {
      color: #52709b;
      font-size: 13px;
      text-align: right;
    }

    /* =========================
       PRODUCT ID
    ========================= */

    .code-box {
      background: #f5f7fa;
      border: 1px solid #e0e6ef;
      border-radius: 9px;
      padding: 13px 15px;
      font-family: Consolas, monospace;
      font-size: 13px;
      color: #243d60;
      word-break: break-all;
    }

    /* =========================
       NOTICE
    ========================= */

    .notice {
      margin-top: 22px;
      border: 1px solid #cfe0ff;
      background: #f1f6ff;
      border-radius: 14px;
      padding: 19px 21px;
    }

    .notice-title {
      font-weight: 800;
      color: #092c63;
      margin-bottom: 7px;
    }

    .notice-text {
      color: #55739d;
      font-size: 13px;
      line-height: 1.65;
    }

    /* =========================
       SYSTEM STATUS
    ========================= */

    .system-list {
      display: grid;
      gap: 12px;
    }

    .system-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px 15px;
      border: 1px solid #e0e7f1;
      border-radius: 10px;
      background: #fbfcfe;
    }

    .system-name {
      color: #24466f;
      font-size: 13px;
      font-weight: 700;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 1000px) {
      .sidebar {
        width: 235px;
      }

      .main {
        margin-left: 235px;
        width: calc(100% - 235px);
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
      }

      .main {
        margin-left: 0;
        width: 100%;
      }

      .layout {
        display: block;
      }

      .back-link {
        position: relative;
      }

      .topbar {
        padding: 0 18px;
      }

      .content {
        padding: 22px 18px 40px;
      }

      .top-actions {
        display: none;
      }
    }
  </style>
</head>

<body>

<div class="layout">

  <!-- =====================================================
       SIDEBAR
  ====================================================== -->

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-logo">H</div>

      <div>
        <div class="brand-title">
          Habitat IAS
        </div>

        <div class="brand-subtitle">
          ADMIN CONTROL PANEL
        </div>
      </div>
    </div>


    <nav class="nav">

      <div class="nav-section">
        OVERVIEW
      </div>

      <a
        href="/admin"
        class="nav-link"
      >
        <span class="nav-icon">⌂</span>
        <span>Dashboard</span>
      </a>


      <div class="nav-spacer"></div>


      <div class="nav-section">
        MOCK TEST
      </div>

      <a
        href="/admin/mock-tests"
        class="nav-link"
      >
        <span class="nav-icon">↗</span>
        <span>Mock Tests</span>
      </a>

      <a
        href="/admin/questions"
        class="nav-link"
      >
        <span class="nav-icon">?</span>
        <span>Questions</span>
      </a>


      <div class="nav-spacer"></div>


      <div class="nav-section">
        STUDENTS
      </div>

      <a
        href="/admin/students"
        class="nav-link"
      >
        <span class="nav-icon">•</span>
        <span>Students</span>
      </a>

      <a
        href="/admin/attempts"
        class="nav-link"
      >
        <span class="nav-icon">↗</span>
        <span>Student Attempts</span>
      </a>


      <div class="nav-spacer"></div>


      <div class="nav-section">
        ANALYTICS
      </div>

      <a
        href="/admin/results"
        class="nav-link"
      >
        <span class="nav-icon">▥</span>
        <span>Results &amp; Analytics</span>
      </a>


      <div class="nav-spacer"></div>


      <div class="nav-section">
        ACCESS
      </div>

      <a
        href="/admin/access"
        class="nav-link"
      >
        <span class="nav-icon">◇</span>
        <span>Series Access</span>
      </a>


      <div class="nav-spacer"></div>


      <div class="nav-section">
        SYSTEM
      </div>

      <a
        href="/admin/settings"
        class="nav-link active"
      >
        <span class="nav-icon">⚙</span>
        <span>Settings</span>
      </a>

      <a
        href="/admin/security"
        class="nav-link"
      >
        <span class="nav-icon">◇</span>
        <span>Security</span>
      </a>

    </nav>


    <a
      href="/"
      class="back-link"
    >
      ← Back to Habitat IAS website
    </a>

  </aside>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="main">

    <header class="topbar">

      <div>
        <div class="top-title">
          Settings
        </div>

        <div class="top-subtitle">
          Configure the Habitat IAS JPSC mock-test system
        </div>
      </div>

      <div class="top-actions">

        <a
          href="/admin"
          class="btn"
        >
          ← Dashboard
        </a>

        <a
          href="/"
          class="btn btn-primary"
        >
          View Website
        </a>

      </div>

    </header>


    <section class="content">

      <!-- PAGE HEADER -->

      <div class="page-header">

        <h1>
          System Settings
        </h1>

        <p>
          Review the current configuration of the JPSC Prelims
          20-Test Series.
        </p>

      </div>


      <div class="grid">

        <!-- =================================================
             SERIES CONFIGURATION
        ================================================== -->

        <section class="card">

          <div class="card-header">

            <h2 class="card-title">
              Series Configuration
            </h2>

            <p class="card-description">
              Current mock-test series configuration.
            </p>

          </div>

          <div class="card-body">

            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Series Name
                </div>

                <div class="setting-help">
                  Public name of the test series.
                </div>
              </div>

              <div class="setting-value">
                {seriesName}
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Total Tests
                </div>

                <div class="setting-help">
                  Number of tests in the series.
                </div>
              </div>

              <div class="setting-value">
                {totalTests}
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Questions per Test
                </div>

                <div class="setting-help">
                  Planned questions in each test.
                </div>
              </div>

              <div class="setting-value">
                {questionsPerTest}
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Duration
                </div>

                <div class="setting-help">
                  Time allowed for each test.
                </div>
              </div>

              <div class="setting-value">
                {durationMinutes} minutes
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Series Status
                </div>

                <div class="setting-help">
                  Current availability status.
                </div>
              </div>

              <div>
                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>
              </div>

            </div>

          </div>

        </section>


        <!-- =================================================
             SCORING
        ================================================== -->

        <section class="card">

          <div class="card-header">

            <h2 class="card-title">
              Scoring Configuration
            </h2>

            <p class="card-description">
              Current scoring rules used by the mock tests.
            </p>

          </div>

          <div class="card-body">

            <div class="score-box">

              <div class="score-main">

                <div>
                  <div class="score-number">
                    +{marksPerCorrect}
                  </div>

                  <div class="score-text">
                    marks for every correct answer
                  </div>
                </div>

                <span class="status status-green">
                  <span class="dot"></span>
                  No Negative Marking
                </span>

              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Correct Answer
                </div>

                <div class="setting-help">
                  Marks awarded for a correct response.
                </div>
              </div>

              <div class="setting-value">
                +{marksPerCorrect}
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Incorrect Answer
                </div>

                <div class="setting-help">
                  Marks deducted for an incorrect response.
                </div>
              </div>

              <div class="setting-value">
                {negativeMarking}
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Unanswered
                </div>

                <div class="setting-help">
                  Marks awarded for an unanswered question.
                </div>
              </div>

              <div class="setting-value">
                0
              </div>

            </div>


            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Maximum Marks
                </div>

                <div class="setting-help">
                  Maximum possible score per test.
                </div>
              </div>

              <div class="setting-value">
                {totalMarks}
              </div>

            </div>

          </div>

        </section>


        <!-- =================================================
             PRODUCT / ACCESS
        ================================================== -->

        <section class="card">

          <div class="card-header">

            <h2 class="card-title">
              Product &amp; Access
            </h2>

            <p class="card-description">
              Product identity used by the access system.
            </p>

          </div>

          <div class="card-body">

            <div class="setting-row">

              <div>
                <div class="setting-label">
                  Product
                </div>

                <div class="setting-help">
                  Product associated with this series.
                </div>
              </div>

              <div>
                <span class="status status-blue">
                  JPSC Prelims
                </span>
              </div>

            </div>


            <div style="margin-top:20px;">

              <div class="setting-label" style="margin-bottom:8px;">
                Product ID
              </div>

              <div class="code-box">
                {productId}
              </div>

            </div>


            <div class="notice">

              <div class="notice-title">
                Access Rule
              </div>

              <div class="notice-text">
                A successful purchase of the JPSC Prelims
                20-Test Series unlocks all 20 mock tests.
                Administrator-granted manual access can also
                unlock the complete series.
              </div>

            </div>

          </div>

        </section>


        <!-- =================================================
             SYSTEM INFORMATION
        ================================================== -->

        <section class="card">

          <div class="card-header">

            <h2 class="card-title">
              System Information
            </h2>

            <p class="card-description">
              Current application configuration status.
            </p>

          </div>

          <div class="card-body">

            <div class="system-list">

              <div class="system-item">

                <span class="system-name">
                  Authentication
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>


              <div class="system-item">

                <span class="system-name">
                  Student Accounts
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>


              <div class="system-item">

                <span class="system-name">
                  Mock Tests
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>


              <div class="system-item">

                <span class="system-name">
                  Attempt Tracking
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>


              <div class="system-item">

                <span class="system-name">
                  Results &amp; Analytics
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>


              <div class="system-item">

                <span class="system-name">
                  Series Access Control
                </span>

                <span class="status status-green">
                  <span class="dot"></span>
                  Active
                </span>

              </div>

            </div>

          </div>

        </section>

      </div>


      <!-- =================================================
           IMPORTANT RULE
      ================================================== -->

      <div class="notice">

        <div class="notice-title">
          ⚠ Current Scoring Rule
        </div>

        <div class="notice-text">
          These JPSC mock tests use <strong>no negative marking</strong>.
          Every correct answer receives <strong>+2 marks</strong>.
          Incorrect and unanswered questions receive <strong>0 marks</strong>.
          With 100 questions, the maximum score is
          <strong>200 marks</strong>.
        </div>

      </div>

    </section>

  </main>

</div>

</body>
</html>