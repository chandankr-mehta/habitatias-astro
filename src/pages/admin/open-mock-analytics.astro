          <a href="/admin/access" class="nav-item">
            <span class="nav-icon">◇</span>
            <span class="nav-text">Series Access</span>
          </a>
        </div>

        <div class="nav-section">
          <div class="nav-title">System</div>
          <a href="/admin/settings" class="nav-item">
            <span class="nav-icon">⚙</span>
            <span class="nav-text">Settings</span>
          </a>
          <a href="/admin/security" class="nav-item">
            <span class="nav-icon">◇</span>
            <span class="nav-text">Security</span>
          </a>
        </div>

      </div>

      <div class="sidebar-footer">
        <a href="/" class="website-link">
          <span>←</span>
          <span>Back to Habitat IAS website</span>
        </a>
      </div>
    </aside>

    <main class="main">

      <header class="topbar">
        <button class="mobile-menu" id="mobileMenu" aria-label="Open menu">☰</button>

        <div class="topbar-title">
          <strong>Open Mock Analytics</strong>
          <span>Test 21 &amp; Test 22 — live performance dashboard</span>
        </div>

        <div class="topbar-actions">
          <a href="/admin" class="website-button">← Dashboard</a>
          <div class="admin-status">
            <span class="status-dot"></span>
            Admin Panel
          </div>
        </div>
      </header>

      <div class="content">

        <div class="page-heading">
          <a href="/admin" class="back-link">← Back to Admin Dashboard</a>
          <h1>Open Mock Analytics</h1>
          <p>
            Compare the two free public mocks using submitted attempts from the existing database.
          </p>
        </div>

        <section class="mock-grid">

          {[
            { number: 21, fallbackTitle: "JPSC General Studies Open Mock" },
            { number: 22, fallbackTitle: "JPSC Jharkhand Special Open Mock" }
          ].map((mock) => {
            const data = mockStats[mock.number];

            return (
              <div class="mock-card">
                <div class="mock-card-head">
                  <div>
                    <div class="mock-number">Test {mock.number}</div>
                    <h2>{data?.title || mock.fallbackTitle}</h2>
                  </div>
                  <span class="badge">FREE OPEN MOCK</span>
                </div>

                <div class="metric-grid">
                  <div class="metric">
                    <div class="metric-label">Students</div>
                    <div class="metric-value">{data?.students ?? 0}</div>
                    <div class="metric-sub">unique students</div>
                  </div>

                  <div class="metric">
                    <div class="metric-label">Attempts</div>
                    <div class="metric-value">{data?.attempts ?? 0}</div>
                    <div class="metric-sub">submitted</div>
                  </div>

                  <div class="metric">
                    <div class="metric-label">Repeat</div>
                    <div class="metric-value">{data?.repeatAttempts ?? 0}</div>
                    <div class="metric-sub">extra attempts</div>
                  </div>

                  <div class="metric">
                    <div class="metric-label">Average</div>
                    <div class="metric-value">{(data?.averagePercentage ?? 0).toFixed(1)}%</div>
                    <div class="metric-sub">best attempt/student</div>
                  </div>

                  <div class="metric">
                    <div class="metric-label">Highest</div>
                    <div class="metric-value">{data?.highestScore ?? 0}</div>
                    <div class="metric-sub">best score</div>
                  </div>

                  <div class="metric">
                    <div class="metric-label">Lowest</div>
                    <div class="metric-value">{data?.lowestScore ?? 0}</div>
                    <div class="metric-sub">best attempt/student</div>
                  </div>
                </div>
              </div>
            );
          })}

        </section>

        <section class="comparison">

          <div class="panel">
            <div class="panel-header">
              <div>
                <h2>Test 21 vs Test 22</h2>
                <p>Participation comparison</p>
              </div>
            </div>

            <div class="bar-panel">
              <div class="bar-row">
                <div class="bar-label">Students — T21</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${comparison.students21}%`}></div>
                </div>
                <div class="bar-value">{comparison.rawStudents21}</div>
              </div>

              <div class="bar-row">
                <div class="bar-label">Students — T22</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${comparison.students22}%`}></div>
                </div>
                <div class="bar-value">{comparison.rawStudents22}</div>
              </div>

              <div class="bar-row">
                <div class="bar-label">Average % — T21</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${comparison.average21}%`}></div>
                </div>
                <div class="bar-value">{comparison.rawAverage21.toFixed(1)}%</div>
              </div>

              <div class="bar-row">
                <div class="bar-label">Average % — T22</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${comparison.average22}%`}></div>
                </div>
                <div class="bar-value">{comparison.rawAverage22.toFixed(1)}%</div>
              </div>
            </div>
          </div>

          <div class="panel">
            <div class="panel-header">
              <div>
                <h2>Open Mock Summary</h2>
                <p>Combined platform activity</p>
              </div>
            </div>

            <div class="bar-panel">
              <div class="metric-grid">
                <div class="metric">
                  <div class="metric-label">Combined Attempts</div>
                  <div class="metric-value">{combined.attempts}</div>
                </div>
                <div class="metric">
                  <div class="metric-label">Unique Students</div>
                  <div class="metric-value">{combined.uniqueStudents}</div>
                </div>
                <div class="metric">
                  <div class="metric-label">Repeat Attempts</div>
                  <div class="metric-value">{combined.repeatAttempts}</div>
                </div>
                <div class="metric">
                  <div class="metric-label">Avg Score</div>
                  <div class="metric-value">{combined.averagePercentage.toFixed(1)}%</div>
                </div>
              </div>
            </div>
          </div>

        </section>

        <section class="panel">

          <div class="panel-header">
            <div>
              <h2>Top Performers</h2>
              <p>Best submitted attempt per student in each open mock</p>
            </div>
          </div>

          {topPerformers.length ? (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Student</th>
                    <th>Mock</th>
                    <th>Score</th>
                    <th>Percentage</th>
                    <th>Correct</th>
                    <th>Incorrect</th>
                    <th>Time</th>
                  </tr>
                </thead>

                <tbody>
                  {topPerformers.map((row) => (
                    <tr>
                      <td class="rank">#{row.rank}</td>
                      <td>
                        <div class="student-name">{row.name}</div>
                        <div style="color:#8a96a8;font-size:9px;margin-top:3px;">
                          {row.email}
                        </div>
                      </td>
                      <td>Test {row.testNumber}</td>
                      <td class="score">{row.score}/{row.maxMarks}</td>
                      <td>{row.percentage.toFixed(1)}%</td>
                      <td>{row.correct}</td>
                      <td>{row.incorrect}</td>
                      <td>{row.time}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty">
              No submitted attempts are available for Test 21 or Test 22 yet.
            </div>
          )}

          <div class="notice">
            Ranking and analytics use the student's best submitted attempt for each test.
            Equal scores receive the same rank. The mock scoring model remains +2 for
            each correct answer with no negative marking.
          </div>

        </section>

      </div>
    </main>
  </div>

  <script>
    const menuButton = document.getElementById("mobileMenu");
    const sidebar = document.getElementById("sidebar");

    if (menuButton && sidebar) {
      menuButton.addEventListener("click", () => {
        sidebar.classList.toggle("open");
      });

      document.addEventListener("click", (event) => {
        const target = event.target;

        if (
          target instanceof Node &&
          !sidebar.contains(target) &&
          !menuButton.contains(target)
        ) {
          sidebar.classList.remove("open");
        }
      });
    }
  </script>

</body>
</html>
