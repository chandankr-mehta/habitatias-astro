<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Open Mock Analytics | Habitat IAS</title>

  <style>
    :root {
      --blue: #1557d6;
      --blue-dark: #0f3f9f;
      --blue-light: #eef4ff;
      --navy: #10264b;
      --text: #172b4d;
      --muted: #667085;
      --bg: #f5f7fb;
      --white: #fff;
      --border: #e4e9f2;
      --green: #087443;
      --green-bg: #eaf8f0;
      --orange: #b54708;
      --orange-bg: #fff4e8;
      --red: #b42318;
      --shadow: 0 8px 30px rgba(16,38,75,.055);
      --sidebar-width: 260px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    a { color: inherit; text-decoration: none; }

    .app { min-height: 100vh; display: flex; }

    .sidebar {
      width: var(--sidebar-width);
      min-width: var(--sidebar-width);
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      background: #fff;
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      z-index: 100;
    }

    .brand {
      height: 76px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid var(--border);
    }

    .brand-logo {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      background: var(--blue);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 21px;
      font-weight: 900;
    }

    .brand-name { font-size: 18px; font-weight: 800; color: var(--navy); }
    .brand-subtitle { margin-top: 4px; font-size: 10px; letter-spacing: .08em; font-weight: 700; color: var(--muted); }

    .sidebar-content { flex: 1; overflow-y: auto; padding: 18px 12px; }

    .nav-section { margin-bottom: 22px; }
    .nav-title {
      padding: 0 12px 8px;
      color: #8a96a8;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .nav-item {
      min-height: 44px;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 12px;
      margin-bottom: 4px;
      border-radius: 10px;
      color: #344563;
      font-size: 13px;
      font-weight: 650;
    }

    .nav-item:hover { background: #f5f8ff; color: var(--blue); }
    .nav-item.active { background: var(--blue-light); color: var(--blue); }
    .nav-icon { width: 22px; min-width: 22px; display: grid; place-items: center; font-size: 15px; }
    .nav-text { flex: 1; }

    .sidebar-footer { padding: 14px 12px; border-top: 1px solid var(--border); }
    .website-link {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 42px;
      padding: 0 12px;
      border-radius: 10px;
      color: #52627a;
      font-size: 12px;
      font-weight: 650;
    }

    .main { width: calc(100% - var(--sidebar-width)); margin-left: var(--sidebar-width); min-height: 100vh; }

    .topbar {
      height: 76px;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(12px);
    }

    .topbar-title { display: flex; flex-direction: column; gap: 3px; }
    .topbar-title strong { font-size: 19px; color: var(--navy); }
    .topbar-title span { color: var(--muted); font-size: 11px; }

    .topbar-actions { display: flex; align-items: center; gap: 10px; }

    .website-button {
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 15px;
      border: 1px solid #d4dce9;
      border-radius: 10px;
      background: #fff;
      color: #344563;
      font-size: 12px;
      font-weight: 700;
    }

    .admin-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 40px;
      padding: 0 13px;
      border-radius: 10px;
      background: var(--green-bg);
      color: var(--green);
      font-size: 12px;
      font-weight: 750;
    }

    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #12b76a; }

    .content { max-width: 1500px; margin: 0 auto; padding: 32px 30px 60px; }

    .page-heading { margin-bottom: 22px; }
    .page-heading h1 { margin: 0; color: var(--navy); font-size: 29px; letter-spacing: -.02em; }
    .page-heading p { margin: 7px 0 0; color: var(--muted); font-size: 13px; }

    .back-link {
      display: inline-flex;
      margin-bottom: 13px;
      color: var(--blue);
      font-size: 11px;
      font-weight: 800;
    }

    .mock-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 18px;
    }

    .mock-card, .panel {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .mock-card { padding: 20px; }

    .mock-card-head {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      margin-bottom: 18px;
    }

    .mock-number {
      color: var(--blue);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    .mock-card h2 {
      margin: 5px 0 0;
      color: var(--navy);
      font-size: 17px;
      line-height: 1.35;
    }

    .badge {
      padding: 5px 8px;
      border-radius: 999px;
      background: var(--green-bg);
      color: var(--green);
      font-size: 9px;
      font-weight: 850;
      white-space: nowrap;
    }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .metric {
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fafbfe;
    }

    .metric-label {
      color: #77869c;
      font-size: 9px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .metric-value {
      margin-top: 6px;
      color: var(--navy);
      font-size: 19px;
      font-weight: 900;
    }

    .metric-sub {
      margin-top: 3px;
      color: #8995a8;
      font-size: 9px;
    }

    .panel { overflow: hidden; margin-bottom: 18px; }

    .panel-header {
      min-height: 68px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .panel-header h2 { margin: 0; color: var(--navy); font-size: 15px; }
    .panel-header p { margin: 4px 0 0; color: var(--muted); font-size: 11px; }

    .table-wrap { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; min-width: 760px; }
    th {
      padding: 12px 16px;
      text-align: left;
      color: #7c899d;
      background: #fafbfe;
      border-bottom: 1px solid var(--border);
      font-size: 9px;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: .05em;
    }

    td {
      padding: 13px 16px;
      border-bottom: 1px solid #edf0f5;
      color: #35445d;
      font-size: 11px;
      font-weight: 650;
    }

    tbody tr:last-child td { border-bottom: none; }

    .student-name { color: var(--navy); font-weight: 800; }
    .rank { color: var(--blue); font-weight: 900; }
    .score { color: var(--navy); font-weight: 900; }
    .empty { padding: 30px; text-align: center; color: #8491a4; font-size: 12px; }

    .comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .bar-panel { padding: 20px; }

    .bar-row {
      display: grid;
      grid-template-columns: 120px 1fr 60px;
      align-items: center;
      gap: 10px;
      margin: 13px 0;
    }

    .bar-label { color: #53637a; font-size: 10px; font-weight: 750; }
    .bar-track { height: 9px; border-radius: 999px; background: #edf1f7; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: inherit; background: var(--blue); }
    .bar-value { color: var(--navy); font-size: 10px; font-weight: 900; text-align: right; }

    .notice {
      margin: 0 20px 20px;
      padding: 12px 14px;
      border: 1px solid #d8e4f5;
      border-radius: 10px;
      background: #f5f9ff;
      color: #536887;
      font-size: 10px;
      line-height: 1.55;
    }

    .mobile-menu {
      display: none;
      width: 38px;
      height: 38px;
      border: 1px solid #d4dce9;
      border-radius: 9px;
      background: #fff;
      cursor: pointer;
    }

    @media (max-width: 1050px) {
      .mock-grid, .comparison { grid-template-columns: 1fr; }
    }

    @media (max-width: 720px) {
      .sidebar { transform: translateX(-100%); transition: transform .2s ease; }
      .sidebar.open { transform: translateX(0); }
      .main { width: 100%; margin-left: 0; }
      .mobile-menu { display: grid; place-items: center; }
      .topbar { padding: 0 16px; }
      .topbar-title { flex: 1; margin-left: 10px; }
      .website-button, .admin-status { display: none; }
      .content { padding: 24px 15px 45px; }
      .metric-grid { grid-template-columns: repeat(2, 1fr); }
      .bar-row { grid-template-columns: 95px 1fr 52px; }
    }
  </style>
</head>

