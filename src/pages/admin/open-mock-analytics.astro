---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   HABITAT IAS — ADMIN AUTHENTICATION
   ---------------------------------------------------------
   This page is server-protected.
   Only the Supabase user whose ID matches ADMIN_USER_ID
   can access the admin dashboard.
   ========================================================= */

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL;

const serviceRoleKey =
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

const adminUserId =
  import.meta.env.ADMIN_USER_ID;

if (!supabaseUrl) {
  throw new Error(
    "PUBLIC_SUPABASE_URL is missing."
  );
}

if (!serviceRoleKey) {
  throw new Error(
    "SUPABASE_SERVICE_ROLE_KEY is missing."
  );
}

if (!adminUserId) {
  throw new Error(
    "ADMIN_USER_ID is missing."
  );
}

const supabaseAdmin =
  createClient(
    supabaseUrl,
    serviceRoleKey,
    {
      auth: {
        autoRefreshToken: false,
        persistSession: false,
      },
    }
  );

const accessToken =
  Astro.cookies.get(
    "habitat-access-token"
  )?.value;

if (!accessToken) {
  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname
      )
  );
}

const {
  data: authData,
  error: authError,
} = await supabaseAdmin.auth.getUser(
  accessToken
);

if (authError || !authData?.user) {
  Astro.cookies.delete(
    "habitat-access-token",
    { path: "/" }
  );

  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname
      )
  );
}

if (authData.user.id !== adminUserId) {
  return new Response("Forbidden", {
    status: 403,
  });
}
type AttemptRow = {
  id: string;
  user_id: string | null;
  test_id: string | null;
  score: number | null;
  status: string | null;
  correct_count: number | null;
  incorrect_count: number | null;
  unanswered_count: number | null;
  time_taken_seconds: number | null;
  submitted_at: string | null;
  created_at: string | null;
};

type TestRow = {
  id: string;
  test_number: number | null;
  title: string | null;
  question_count: number | null;
};

type StudentRow = {
  id: string;
  email: string | null;
  name: string | null;
  full_name: string | null;
};

const mockStats: Record<number, any> = {};
const topPerformers: any[] = [];

try {
  const { data: tests, error: testsError } =
    await supabaseAdmin
      .from("mock_tests")
      .select("id, test_number, title, question_count")
      .in("test_number", [21, 22]);

  if (testsError) throw testsError;

  const selectedTests = (tests ?? []) as TestRow[];
  const testById = new Map(
    selectedTests.map((test) => [String(test.id), test])
  );

  const testIds = selectedTests.map((test) => String(test.id));

  if (testIds.length) {
    const { data: attempts, error: attemptsError } =
      await supabaseAdmin
        .from("mock_attempts")
        .select(
          "id, user_id, test_id, score, status, correct_count, incorrect_count, unanswered_count, time_taken_seconds, submitted_at, created_at"
        )
        .in("test_id", testIds)
        .eq("status", "submitted");

    if (attemptsError) throw attemptsError;

    const submittedAttempts =
      (attempts ?? []) as AttemptRow[];

    const userIds = [
      ...new Set(
        submittedAttempts
          .map((attempt) => attempt.user_id)
          .filter(Boolean)
          .map(String)
      ),
    ];

    const studentsById = new Map<string, StudentRow>();

    if (userIds.length) {
      const { data: studentsData } =
        await supabaseAdmin
          .from("profiles")
          .select("id, email, name, full_name")
          .in("id", userIds);

      for (const student of (studentsData ?? []) as StudentRow[]) {
        studentsById.set(String(student.id), student);
      }

      /* Fallback to auth users if profiles are unavailable/empty. */
      if (!studentsById.size) {
        const { data: authData } =
          await supabaseAdmin.auth.admin.listUsers({
            page: 1,
            perPage: 1000,
          });

        for (const user of authData?.users ?? []) {
          studentsById.set(
            String(user.id),
            {
              id: String(user.id),
              email: user.email ?? null,
              name:
                user.user_metadata?.name ??
                user.user_metadata?.full_name ??
                null,
              full_name:
                user.user_metadata?.full_name ??
                user.user_metadata?.name ??
                null,
            }
          );
        }
      }
    }

    const bestByStudentTest = new Map<string, AttemptRow>();

    for (const attempt of submittedAttempts) {
      if (!attempt.user_id || !attempt.test_id) continue;

      const key =
        `${String(attempt.user_id)}:${String(attempt.test_id)}`;

      const existing = bestByStudentTest.get(key);

      const score = Number(attempt.score ?? 0);
      const existingScore =
        Number(existing?.score ?? -Infinity);

      const currentDate = new Date(
        attempt.submitted_at ||
        attempt.created_at ||
        0
      ).getTime();

      const existingDate = new Date(
        existing?.submitted_at ||
        existing?.created_at ||
        0
      ).getTime();

      if (
        !existing ||
        score > existingScore ||
        (score === existingScore && currentDate > existingDate)
      ) {
        bestByStudentTest.set(key, attempt);
      }
    }

    for (const test of selectedTests) {
      const testNumber = Number(test.test_number);
      const bestForTest = [
        ...bestByStudentTest.values(),
      ].filter(
        (attempt) =>
          String(attempt.test_id) === String(test.id)
      );

      bestForTest.sort(
        (a, b) =>
          Number(b.score ?? 0) -
          Number(a.score ?? 0)
      );

      const questionCount =
        Number(test.question_count ?? 100);

      const maxMarks =
        questionCount * 2;

      const uniqueStudents =
        new Set(
          bestForTest
            .map((attempt) => attempt.user_id)
            .filter(Boolean)
        );

      const totalAttempts =
        submittedAttempts.filter(
          (attempt) =>
            String(attempt.test_id) === String(test.id)
        ).length;

      const repeatAttempts =
        Math.max(
          0,
          totalAttempts - bestForTest.length
        );

      const percentages =
        bestForTest.map((attempt) => {
          const score = Number(attempt.score ?? 0);
          return maxMarks > 0
            ? (score / maxMarks) * 100
            : 0;
        });

      const averagePercentage =
        percentages.length
          ? percentages.reduce((a, b) => a + b, 0) /
            percentages.length
          : 0;

      const scores =
        bestForTest.map((attempt) =>
          Number(attempt.score ?? 0)
        );

      mockStats[testNumber] = {
        title:
          test.title ||
          `Open Mock Test ${testNumber}`,
        students:
          uniqueStudents.size,
        attempts:
          totalAttempts,
        repeatAttempts,
        averagePercentage,
        highestScore:
          scores.length
            ? Math.max(...scores)
            : 0,
        lowestScore:
          scores.length
            ? Math.min(...scores)
            : 0,
      };

      let previousScore: number | null = null;
      let rank = 0;

      bestForTest.forEach(
        (attempt, index) => {
          const score =
            Number(attempt.score ?? 0);

          if (
            previousScore === null ||
            score !== previousScore
          ) {
            rank = index + 1;
          }

          if (topPerformers.length < 20) {
            const student =
              attempt.user_id
                ? studentsById.get(
                    String(attempt.user_id)
                  )
                : undefined;

            const seconds =
              Number(
                attempt.time_taken_seconds ?? 0
              );

            const minutes =
              Math.floor(seconds / 60);

            const remainingSeconds =
              seconds % 60;

            topPerformers.push({
              rank,
              testNumber,
              name:
                student?.name ||
                student?.full_name ||
                "Student",
              email:
                student?.email ||
                "—",
              score,
              maxMarks,
              percentage:
                maxMarks > 0
                  ? (score / maxMarks) * 100
                  : 0,
              correct:
                Number(
                  attempt.correct_count ?? 0
                ),
              incorrect:
                Number(
                  attempt.incorrect_count ?? 0
                ),
              time:
                seconds > 0
                  ? `${minutes}m ${remainingSeconds}s`
                  : "—",
            });
          }

          previousScore = score;
        }
      );
    }

    topPerformers.sort((a, b) => {
      if (b.percentage !== a.percentage) {
        return b.percentage - a.percentage;
      }

      return b.score - a.score;
    });

    /* Recalculate display rank across the combined top list. */
    let previousCombinedScore: number | null = null;
    let combinedRank = 0;

    topPerformers.forEach((row, index) => {
      if (
        previousCombinedScore === null ||
        row.score !== previousCombinedScore
      ) {
        combinedRank = index + 1;
      }

      row.rank = combinedRank;
      previousCombinedScore = row.score;
    });
  }
} catch (error) {
  console.error(
    "Open mock analytics error:",
    error
  );
}

const test21 = mockStats[21] || {
  students: 0,
  attempts: 0,
  repeatAttempts: 0,
  averagePercentage: 0,
};

const test22 = mockStats[22] || {
  students: 0,
  attempts: 0,
  repeatAttempts: 0,
  averagePercentage: 0,
};

const maxStudents =
  Math.max(
    Number(test21.students || 0),
    Number(test22.students || 0),
    1
  );

const comparison = {
  rawStudents21: Number(test21.students || 0),
  rawStudents22: Number(test22.students || 0),
  students21:
    (Number(test21.students || 0) / maxStudents) * 100,
  students22:
    (Number(test22.students || 0) / maxStudents) * 100,
  rawAverage21:
    Number(test21.averagePercentage || 0),
  rawAverage22:
    Number(test22.averagePercentage || 0),
  average21:
    Math.min(100, Number(test21.averagePercentage || 0)),
  average22:
    Math.min(100, Number(test22.averagePercentage || 0)),
};

const combinedAttempts =
  Number(test21.attempts || 0) +
  Number(test22.attempts || 0);

const combinedRepeat =
  Number(test21.repeatAttempts || 0) +
  Number(test22.repeatAttempts || 0);

const combined = {
  attempts: combinedAttempts,
  repeatAttempts: combinedRepeat,
  uniqueStudents:
    Number(test21.students || 0) +
    Number(test22.students || 0),
  averagePercentage:
    combinedAttempts > 0
      ? (
          (
            Number(test21.averagePercentage || 0) *
            Number(test21.students || 0)
          ) +
          (
            Number(test22.averagePercentage || 0) *
            Number(test22.students || 0)
          )
        ) /
        Math.max(
          1,
          Number(test21.students || 0) +
          Number(test22.students || 0)
        )
      : 0,
};

