---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const serviceRoleKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;
const adminUserId = import.meta.env.ADMIN_USER_ID;

if (!supabaseUrl || !serviceRoleKey || !adminUserId) {
  throw new Error("Required Supabase admin environment variables are missing.");
}

const supabaseAdmin = createClient(supabaseUrl, serviceRoleKey, {
  auth: {
    autoRefreshToken: false,
    persistSession: false,
  },
});

const accessToken = Astro.cookies.get("habitat-access-token")?.value;

if (!accessToken) {
  return Astro.redirect("/login?redirect=/admin/mock-tests");
}

const { data: authData, error: authError } = await supabaseAdmin.auth.getUser(accessToken);

if (authError || !authData?.user) {
  Astro.cookies.delete("habitat-access-token", { path: "/" });
  return Astro.redirect("/login?redirect=/admin/mock-tests");
}

if (authData.user.id !== adminUserId) {
  return new Response("403 - Admin access denied.", {
    status: 403,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  });
}

const { data: tests, error } = await supabaseAdmin
  .from("mock_tests")
  .select("*")
  .order("test_number", { ascending: true });

const testList = tests ?? [];

function valueOf(test: any, keys: string[], fallback: any = "") {
  for (const key of keys) {
    if (test?.[key] !== undefined && test?.[key] !== null && test?.[key] !== "") {
      return test[key];
    }
  }
  return fallback;
}

function formatDate(value: any) {
  if (!value) return "Not scheduled";
  try {
    return new Date(value).toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return String(value);
  }
}

const rows = testList.map((test: any) => {
  const dbId = test?.id;
  const testNumber = valueOf(test, ["test_number", "test_no", "number"], dbId ?? "-");
  const title = valueOf(test, ["title", "name"], `Mock Test ${testNumber}`);
  const description = valueOf(test, ["description", "short_description"], "JPSC Prelims Mock Test");
  const type = valueOf(test, ["test_type", "type"], "Sectional");
  const questions = valueOf(test, ["total_questions", "question_count", "questions_count"], 100);
  const duration = valueOf(test, ["duration_minutes", "duration", "time_limit"], 120);
  const published = valueOf(test, ["is_published", "published"], false) === true;
  const release = valueOf(test, ["release_at", "released_at", "published_at", "release_date"], null);
  const routeId = String(dbId ?? testNumber);

  return {
    routeId,
    number: String(testNumber).padStart(2, "0"),
    title: String(title),
    description: String(description),
    type: String(type),
    questions: String(questions),
    duration: String(duration),
    published,
    release: formatDate(release),
    search: `${testNumber} ${title} ${description}`.toLowerCase(),
  };
});

const publishedCount = rows.filter((row) => row.published).length;
const unpublishedCount = rows.length - publishedCount;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Mock Tests | Habitat IAS Admin</title>
  <style>
    :root{--blue:#1557d6;--blue-dark:#0d3fa8;--text:#102a56;--muted:#71809a;--border:#dfe6f0;--bg:#f5f7fb;--white:#fff;--green:#087f5b;--green-bg:#eaf8f2;--orange:#b45309;--orange-bg:#fff4e5;--red:#b42318;--red-bg:#fff1f0}
    *{box-sizing:border-box}html,body{margin:0;padding:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}a{text-decoration:none;color:inherit}button,input,select{font:inherit}
    .layout{min-height:100vh;display:flex}.sidebar{width:274px;background:#fff;border-right:1px solid var(--border);position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;z-index:20}.brand{height:86px;padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}.brand-logo{width:46px;height:46px;border-radius:13px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:24px;font-weight:800}.brand-name{font-size:21px;font-weight:800}.brand-sub{margin-top:2px;color:var(--muted);font-size:10px;letter-spacing:1px;font-weight:700}.nav{padding:18px 12px;overflow-y:auto}.nav-section{margin:14px 12px 8px;color:#8490a6;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.nav-link{min-height:44px;padding:0 13px;margin:3px 0;border-radius:10px;display:flex;align-items:center;gap:11px;color:#344867;font-size:14px;font-weight:650}.nav-link:hover,.nav-link.active{background:#edf4ff;color:var(--blue)}.nav-icon{width:22px;text-align:center;font-weight:800}.count{margin-left:auto;padding:4px 9px;border-radius:20px;background:#edf2fa;color:#60718e;font-size:11px;font-weight:800}.sidebar-bottom{margin-top:auto;padding:15px;border-top:1px solid var(--border)}.back-link{display:block;padding:10px;color:#5f6e86;font-size:13px;font-weight:600}
    .main{margin-left:274px;width:calc(100% - 274px);min-height:100vh}.topbar{height:86px;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 32px}.page-title{font-size:23px;font-weight:800;margin:0}.page-subtitle{margin-top:4px;color:var(--muted);font-size:13px}.top-actions{display:flex;align-items:center;gap:10px}.website-btn,.admin-status{padding:10px 14px;border-radius:9px;font-weight:700}.website-btn{border:1px solid #d7dfec;background:#fff}.admin-status{background:var(--green-bg);color:var(--green);font-size:13px}
    .content{padding:30px 32px 50px}.content-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px}.heading h1{margin:0;font-size:30px}.heading p{margin:7px 0 0;color:var(--muted);font-size:14px}.primary-btn{border:0;border-radius:9px;background:var(--blue);color:#fff;padding:12px 18px;font-weight:800;cursor:pointer}.error{margin-bottom:20px;background:var(--red-bg);border:1px solid #f3caca;color:var(--red);border-radius:12px;padding:14px 16px;font-size:13px}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}.stat{background:#fff;border:1px solid var(--border);border-radius:15px;padding:20px}.stat-label{color:#65748c;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}.stat-value{margin-top:9px;font-size:30px;font-weight:850}.stat-note{margin-top:3px;color:var(--muted);font-size:12px}
    .toolbar{background:#fff;border:1px solid var(--border);border-radius:15px;padding:16px;display:flex;gap:12px;margin-bottom:18px}.search{flex:1}.search input,.filter{width:100%;height:44px;border:1px solid #d9e1ee;border-radius:9px;padding:0 14px;outline:none;background:#fff}.filter{width:180px;color:#344867}.table-card{background:#fff;border:1px solid var(--border);border-radius:15px;overflow:hidden}.table-top{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}.table-title{font-size:16px;font-weight:800}.table-count{color:var(--muted);font-size:13px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:980px}th{background:#fafbfd;color:#74839a;font-size:11px;text-align:left;text-transform:uppercase;letter-spacing:.6px;padding:13px 18px;border-bottom:1px solid var(--border);white-space:nowrap}td{padding:16px 18px;border-bottom:1px solid #edf1f6;vertical-align:middle;font-size:13px}tr:last-child td{border-bottom:0}.test-number{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:#edf4ff;color:var(--blue);font-weight:850}.test-title{font-weight:800;margin-bottom:4px}.test-description{max-width:360px;color:var(--muted);font-size:12px;line-height:1.45}.type-badge{display:inline-block;padding:5px 9px;border-radius:7px;background:#f0f3f8;color:#586b88;font-size:11px;font-weight:800}.status{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:7px;font-size:11px;font-weight:800}.status.published{background:var(--green-bg);color:var(--green)}.status.unpublished{background:var(--orange-bg);color:var(--orange)}.status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}.actions{display:flex;gap:7px}.action-btn{border:1px solid #dce3ee;background:#fff;color:#2c4a75;border-radius:7px;padding:8px 11px;font-size:11px;font-weight:800;white-space:nowrap}.action-btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.empty{padding:60px 20px;text-align:center;color:var(--muted)}
    @media(max-width:1100px){.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:800px){.sidebar{width:220px}.main{margin-left:220px;width:calc(100% - 220px)}.content{padding:22px 18px 40px}.toolbar{flex-direction:column}.filter{width:100%}}@media(max-width:600px){.sidebar{display:none}.main{margin-left:0;width:100%}.stats{grid-template-columns:1fr}.top-actions{display:none}.content-header{flex-direction:column}}
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand"><div class="brand-logo">H</div><div><div class="brand-name">Habitat IAS</div><div class="brand-sub">ADMIN CONTROL PANEL</div></div></div>
      <nav class="nav">
        <div class="nav-section">Overview</div><a href="/admin" class="nav-link"><span class="nav-icon">⌂</span>Dashboard</a>
        <div class="nav-section">Mock Test</div><a href="/admin/mock-tests" class="nav-link active"><span class="nav-icon">↗</span>Mock Tests<span class="count">{rows.length}</span></a>
        <a href="/admin/questions" class="nav-link"><span class="nav-icon">?</span>Questions<span class="count">2,000</span></a>
        <div class="nav-section">Students</div><a href="/admin/students" class="nav-link"><span class="nav-icon">●</span>Students</a><a href="/admin/attempts" class="nav-link"><span class="nav-icon">↗</span>Student Attempts</a>
        <div class="nav-section">Analytics</div><a href="/admin/results" class="nav-link"><span class="nav-icon">▥</span>Results &amp; Analytics</a>
        <div class="nav-section">Access</div><a href="/admin/access" class="nav-link"><span class="nav-icon">◇</span>Series Access</a><a href="/admin/settings" class="nav-link"><span class="nav-icon">⚙</span>Settings</a>
      </nav>
      <div class="sidebar-bottom"><a href="/" class="back-link">← Back to Habitat IAS website</a></div>
    </aside>

    <main class="main">
      <header class="topbar"><div><h1 class="page-title">Mock Test Management</h1><div class="page-subtitle">Manage the JPSC Prelims 20-test mock-test series</div></div><div class="top-actions"><a href="/" class="website-btn">↗ View Website</a><div class="admin-status">● Admin Panel</div></div></header>
      <section class="content">
        <div class="content-header"><div class="heading"><h1>Mock Tests</h1><p>Create, manage, publish and maintain all 20 JPSC mock tests.</p></div><button id="createTestButton" class="primary-btn" type="button">+ Create Mock Test</button></div>

        {error && <div class="error">Unable to load mock tests from Supabase.<br />{error.message}</div>}

        <div class="stats">
          <div class="stat"><div class="stat-label">Total Tests</div><div class="stat-value">{rows.length}</div><div class="stat-note">Tests in the JPSC mock-test series</div></div>
          <div class="stat"><div class="stat-label">Published</div><div class="stat-value">{publishedCount}</div><div class="stat-note">Currently available tests</div></div>
          <div class="stat"><div class="stat-label">Unpublished</div><div class="stat-value">{unpublishedCount}</div><div class="stat-note">Tests still being prepared</div></div>
          <div class="stat"><div class="stat-label">Planned Questions</div><div class="stat-value">2,000</div><div class="stat-note">100 questions × 20 tests</div></div>
        </div>

        <div class="toolbar"><div class="search"><input id="searchInput" type="search" placeholder="Search by test number, title or description..." /></div><select id="statusFilter" class="filter"><option value="all">All Status</option><option value="published">Published</option><option value="unpublished">Unpublished</option></select><select id="typeFilter" class="filter"><option value="all">All Test Types</option><option value="sectional">Sectional</option><option value="full">Full Length</option></select></div>

        <div class="table-card"><div class="table-top"><div class="table-title">JPSC Mock Test Series</div><div class="table-count"><span id="visibleCount">{rows.length}</span> tests</div></div><div class="table-wrap"><table><thead><tr><th>Test</th><th>Title</th><th>Type</th><th>Questions</th><th>Duration</th><th>Status</th><th>Release</th><th>Actions</th></tr></thead><tbody id="testTableBody">
          {rows.map((row) => (
            <tr class="test-row" data-search={row.search} data-type={row.type.toLowerCase()} data-status={row.published ? "published" : "unpublished"}>
              <td><div class="test-number">{row.number}</div></td>
              <td><div class="test-title">{row.title}</div><div class="test-description">{row.description}</div></td>
              <td><span class="type-badge">{row.type}</span></td>
              <td><strong>{row.questions}</strong></td>
              <td><strong>{row.duration} min</strong></td>
              <td><span class:list={["status", row.published ? "published" : "unpublished"]}><span class="status-dot"></span>{row.published ? "Published" : "Unpublished"}</span></td>
              <td>{row.release}</td>
              <td><div class="actions"><a class="action-btn primary" href={`/admin/mock-tests/${row.routeId}`}>Manage</a><a class="action-btn" href={`/admin/mock-tests/${row.routeId}/questions`}>Questions</a></div></td>
            </tr>
          ))}
        </tbody></table><div id="emptyState" class="empty" style="display:none;">No mock tests match your search.</div></div></div>
      </section>
    </main>
  </div>

  <script>
    const searchInput = document.getElementById("searchInput");
    const statusFilter = document.getElementById("statusFilter");
    const typeFilter = document.getElementById("typeFilter");
    const rows = Array.from(document.querySelectorAll(".test-row"));
    const visibleCount = document.getElementById("visibleCount");
    const emptyState = document.getElementById("emptyState");

    function filterTests() {
      const search = (searchInput?.value || "").trim().toLowerCase();
      const status = statusFilter?.value || "all";
      const type = typeFilter?.value || "all";
      let visible = 0;

      rows.forEach((row) => {
        const matchesSearch = !search || (row.dataset.search || "").includes(search);
        const matchesStatus = status === "all" || row.dataset.status === status;
        const rowType = row.dataset.type || "";
        const matchesType = type === "all" || (type === "sectional" && rowType.includes("section")) || (type === "full" && rowType.includes("full"));
        const show = matchesSearch && matchesStatus && matchesType;
        row.style.display = show ? "" : "none";
        if (show) visible += 1;
      });

      if (visibleCount) visibleCount.textContent = String(visible);
      if (emptyState) emptyState.style.display = visible === 0 ? "block" : "none";
    }

    searchInput?.addEventListener("input", filterTests);
    statusFilter?.addEventListener("change", filterTests);
    typeFilter?.addEventListener("change", filterTests);
    document.getElementById("createTestButton")?.addEventListener("click", () => alert("Create Mock Test will be connected in the next management step."));
  </script>
</body>
</html>
