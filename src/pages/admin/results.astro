---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   HABITAT IAS — ADMIN RESULTS & ANALYTICS
   ========================================================= */

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL;

const serviceRoleKey =
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

const adminUserId =
  import.meta.env.ADMIN_USER_ID;

/* =========================================================
   SUPABASE ADMIN CLIENT
   ========================================================= */

if (!supabaseUrl) {
  throw new Error("PUBLIC_SUPABASE_URL is missing.");
}

if (!serviceRoleKey) {
  throw new Error("SUPABASE_SERVICE_ROLE_KEY is missing.");
}

if (!adminUserId) {
  throw new Error("ADMIN_USER_ID is missing.");
}

const supabaseAdmin = createClient(
  supabaseUrl,
  serviceRoleKey,
  {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  }
);

/* =========================================================
   ADMIN AUTHENTICATION
   ========================================================= */

const accessToken =
  Astro.cookies.get("habitat-access-token")?.value;

if (!accessToken) {
  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname +
          Astro.url.search
      )
  );
}

const {
  data: authData,
  error: authError,
} =
  await supabaseAdmin.auth.getUser(
    accessToken
  );

if (authError || !authData?.user) {
  Astro.cookies.delete(
    "habitat-access-token",
    { path: "/" }
  );

  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname +
          Astro.url.search
      )
  );
}

if (authData.user.id !== adminUserId) {
  return new Response(
    `<!doctype html>
    <html>
      <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>Access Denied | Habitat IAS</title>
        <style>
          body {
            margin:0;
            min-height:100vh;
            display:grid;
            place-items:center;
            background:#f5f7fb;
            font-family:Inter,system-ui,sans-serif;
            color:#172b4d;
          }
          .card {
            width:min(460px,calc(100% - 40px));
            background:#fff;
            border:1px solid #e4e9f2;
            border-radius:18px;
            padding:35px;
            text-align:center;
            box-shadow:0 12px 40px rgba(16,38,75,.08);
          }
          .icon {
            font-size:40px;
            margin-bottom:14px;
          }
          h1 {
            margin:0 0 10px;
          }
          p {
            color:#667085;
            line-height:1.6;
          }
          a {
            display:inline-flex;
            min-height:44px;
            padding:0 18px;
            align-items:center;
            border-radius:10px;
            background:#1557d6;
            color:#fff;
            text-decoration:none;
            font-weight:700;
          }
        </style>
      </head>
      <body>
        <div class="card">
          <div class="icon">🔒</div>
          <h1>Admin Access Denied</h1>
          <p>
            Your account is authenticated, but it does not
            have permission to access the Habitat IAS admin panel.
          </p>
          <a href="/admin">← Back to Admin</a>
        </div>
      </body>
    </html>`,
    {
      status: 403,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "no-store",
      },
    }
  );
}

/* =========================================================
   LOAD ATTEMPTS
   ========================================================= */

const {
  data: attempts,
  error: attemptsError,
} =
  await supabaseAdmin
    .from("mock_attempts")
    .select(`
      id,
      user_id,
      test_id,
      started_at,
      submitted_at,
      score,
      correct_count,
      incorrect_count,
      unanswered_count,
      time_taken_seconds,
      status,
      created_at
    `)
    .order("created_at", {
      ascending: false,
    });

const safeAttempts = attempts || [];

/* =========================================================
   LOAD TESTS
   ========================================================= */

const testIds = [
  ...new Set(
    safeAttempts
      .map((attempt) => attempt.test_id)
      .filter(Boolean)
  ),
];

let testsById = new Map();

if (testIds.length > 0) {
  const {
    data: tests,
    error: testsError,
  } =
    await supabaseAdmin
      .from("mock_tests")
      .select(`
        id,
        test_number,
        title,
        question_count,
        duration_minutes
      `)
      .in("id", testIds);

  if (!testsError) {
    testsById = new Map(
      (tests || []).map((test) => [
        String(test.id),
        test,
      ])
    );
  }
}

/* =========================================================
   LOAD USERS
   ========================================================= */

const userIds = [
  ...new Set(
    safeAttempts
      .map((attempt) => attempt.user_id)
      .filter(Boolean)
  ),
];

let usersById = new Map();

if (userIds.length > 0) {
  const userResults = await Promise.all(
    userIds.map(async (userId) => {
      try {
        const {
          data,
          error,
        } =
          await supabaseAdmin.auth.admin.getUserById(
            userId
          );

        if (error || !data?.user) {
          return [
            String(userId),
            null,
          ];
        }

        return [
          String(userId),
          data.user,
        ];
      } catch {
        return [
          String(userId),
          null,
        ];
      }
    })
  );

  usersById = new Map(userResults);
}

/* =========================================================
   PREPARE DATA
   ========================================================= */

const rows = safeAttempts.map((attempt) => {
  const test =
    testsById.get(
      String(attempt.test_id)
    );

  const user =
    usersById.get(
      String(attempt.user_id)
    );

  const correct =
    Number(attempt.correct_count || 0);

  const incorrect =
    Number(attempt.incorrect_count || 0);

  const unanswered =
    Number(attempt.unanswered_count || 0);

  const totalQuestions =
    Math.max(
      Number(test?.question_count || 0),
      correct +
        incorrect +
        unanswered
    );

  /*
   * HABITAT IAS SCORING
   *
   * Correct     = +2
   * Incorrect   =  0
   * Unanswered  =  0
   *
   * NO NEGATIVE MARKING
   */

  const totalMarks =
    totalQuestions * 2;

  const score =
    Number(attempt.score || 0);

  const percentage =
    totalMarks > 0
      ? (score / totalMarks) * 100
      : 0;

  const displayName =
    user?.user_metadata?.full_name ||
    user?.user_metadata?.name ||
    user?.email ||
    "Unknown Student";

  return {
    attempt,
    test,
    user,
    displayName,
    email:
      user?.email ||
      "Email unavailable",
    correct,
    incorrect,
    unanswered,
    totalQuestions,
    totalMarks,
    score,
    percentage,
    timeTaken:
      Number(
        attempt.time_taken_seconds || 0
      ),
  };
});

/* =========================================================
   SELECTED TEST FILTER
   ========================================================= */

const selectedTestId =
  Astro.url.searchParams.get("test_id");

const selectedTest =
  selectedTestId
    ? testsById.get(
        String(selectedTestId)
      ) || null
    : null;

const analysisRows =
  selectedTestId
    ? rows.filter(
        (row) =>
          String(
            row.attempt.test_id
          ) ===
          String(selectedTestId)
      )
    : rows;

/* =========================================================
   OVERALL STATISTICS
   ========================================================= */

const totalAttempts =
  analysisRows.length;

const submittedRows =
  analysisRows.filter(
    (row) =>
      row.attempt.status ===
      "submitted"
  );

const submittedAttempts =
  submittedRows.length;

const inProgressAttempts =
  analysisRows.filter(
    (row) =>
      row.attempt.status ===
      "in_progress"
  ).length;

const totalCorrect =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.correct,
    0
  );

const totalIncorrect =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.incorrect,
    0
  );

const totalUnanswered =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.unanswered,
    0
  );

const totalQuestionsAttempted =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.totalQuestions,
    0
  );

const totalScore =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.score,
    0
  );

const totalPossibleMarks =
  analysisRows.reduce(
    (sum, row) =>
      sum + row.totalMarks,
    0
  );

const averageScore =
  submittedAttempts > 0
    ? submittedRows.reduce(
        (sum, row) =>
          sum + row.score,
        0
      ) / submittedAttempts
    : 0;

const averagePercentage =
  submittedAttempts > 0
    ? submittedRows.reduce(
        (sum, row) =>
          sum + row.percentage,
        0
      ) / submittedAttempts
    : 0;

const highestScore =
  submittedAttempts > 0
    ? Math.max(
        ...submittedRows.map(
          (row) => row.score
        )
      )
    : 0;

const lowestScore =
  submittedAttempts > 0
    ? Math.min(
        ...submittedRows.map(
          (row) => row.score
        )
      )
    : 0;

const averageTime =
  submittedAttempts > 0
    ? submittedRows.reduce(
        (sum, row) =>
          sum + row.timeTaken,
        0
      ) / submittedAttempts
    : 0;

/* =========================================================
   PERFORMANCE DISTRIBUTION
   ========================================================= */

const highPerformers =
  submittedRows.filter(
    (row) =>
      row.percentage >= 75
  ).length;

const mediumPerformers =
  submittedRows.filter(
    (row) =>
      row.percentage >= 50 &&
      row.percentage < 75
  ).length;

const lowPerformers =
  submittedRows.filter(
    (row) =>
      row.percentage < 50
  ).length;

/* =========================================================
   TEST-WISE ANALYTICS
   ========================================================= */

const testMap = new Map();

for (const row of submittedRows) {
  const key =
    String(
      row.test?.id ||
      row.attempt.test_id ||
      "unknown"
    );

  if (!testMap.has(key)) {
    testMap.set(key, {
      testId: key,
      testNumber:
        row.test?.test_number ??
        null,
      title:
        row.test?.title ||
        "JPSC Mock Test",
      questionCount:
        Number(
          row.test?.question_count ||
          row.totalQuestions ||
          0
        ),
      attempts: 0,
      totalScore: 0,
      totalPercentage: 0,
      highestScore: 0,
      lowestScore: Infinity,
      correct: 0,
      incorrect: 0,
      unanswered: 0,
      totalTime: 0,
    });
  }

  const item =
    testMap.get(key);

  item.attempts += 1;

  item.totalScore +=
    row.score;

  item.totalPercentage +=
    row.percentage;

  item.highestScore =
    Math.max(
      item.highestScore,
      row.score
    );

  item.lowestScore =
    Math.min(
      item.lowestScore,
      row.score
    );

  item.correct +=
    row.correct;

  item.incorrect +=
    row.incorrect;

  item.unanswered +=
    row.unanswered;

  item.totalTime +=
    row.timeTaken;
}

const testAnalytics =
  Array.from(
    testMap.values()
  )
    .map((item) => ({
      ...item,
      averageScore:
        item.attempts > 0
          ? item.totalScore /
            item.attempts
          : 0,
      averagePercentage:
        item.attempts > 0
          ? item.totalPercentage /
            item.attempts
          : 0,
      averageTime:
        item.attempts > 0
          ? item.totalTime /
            item.attempts
          : 0,
      lowestScore:
        item.lowestScore ===
        Infinity
          ? 0
          : item.lowestScore,
    }))
    .sort(
      (a, b) =>
        Number(a.testNumber || 0) -
        Number(b.testNumber || 0)
    );

/* =========================================================
   STUDENT-WISE ANALYTICS
   ========================================================= */

const studentMap = new Map();

for (const row of submittedRows) {
  const key =
    String(
      row.attempt.user_id
    );

  if (!studentMap.has(key)) {
    studentMap.set(key, {
      userId: key,
      name: row.displayName,
      email: row.email,
      attempts: 0,
      totalScore: 0,
      totalPercentage: 0,
      highestScore: 0,
      totalTime: 0,
    });
  }

  const student =
    studentMap.get(key);

  student.attempts += 1;

  student.totalScore +=
    row.score;

  student.totalPercentage +=
    row.percentage;

  student.highestScore =
    Math.max(
      student.highestScore,
      row.score
    );

  student.totalTime +=
    row.timeTaken;
}

const studentAnalytics =
  Array.from(
    studentMap.values()
  )
    .map((student) => ({
      ...student,
      averageScore:
        student.attempts > 0
          ? student.totalScore /
            student.attempts
          : 0,
      averagePercentage:
        student.attempts > 0
          ? student.totalPercentage /
            student.attempts
          : 0,
      averageTime:
        student.attempts > 0
          ? student.totalTime /
            student.attempts
          : 0,
    }))
    .sort(
      (a, b) =>
        b.averagePercentage -
        a.averagePercentage
    );

/* =========================================================
   DYNAMIC OVERALL STUDENT RANK
   ========================================================= */

let previousPercentage: number | null = null;
let currentRank = 0;

const rankedStudentAnalytics =
  studentAnalytics.map(
    (student, index) => {
      const percentage =
        Number(
          student.averagePercentage || 0
        );

      if (
        previousPercentage === null ||
        percentage !== previousPercentage
      ) {
        currentRank = index + 1;
      }

      previousPercentage = percentage;

      return {
        ...student,
        rank: currentRank,
      };
    }
  );

/* =========================================================
   SELECTED TEST — BEST-ATTEMPT LEADERBOARD
   ========================================================= */

const selectedTestSubmittedRows =
  selectedTestId
    ? submittedRows
    : [];

const selectedStudentBestMap =
  new Map<string, {
    userId: string;
    name: string;
    email: string;
    score: number;
    percentage: number;
    timeTaken: number;
    attemptId: number | string;
  }>();

for (
  const row of selectedTestSubmittedRows
) {
  const userId =
    String(
      row.attempt.user_id
    );

  const existing =
    selectedStudentBestMap.get(
      userId
    );

  if (
    !existing ||
    row.score > existing.score
  ) {
    selectedStudentBestMap.set(
      userId,
      {
        userId,
        name: row.displayName,
        email: row.email,
        score: row.score,
        percentage: row.percentage,
        timeTaken: row.timeTaken,
        attemptId: row.attempt.id,
      }
    );
  }
}

const selectedTestLeaderboard =
  Array.from(
    selectedStudentBestMap.values()
  )
    .sort(
      (a, b) =>
        b.score - a.score ||
        a.timeTaken - b.timeTaken
    )
    .map(
      (student, index, array) => {

        const rank =
          index === 0
            ? 1
            : student.score ===
              array[index - 1].score
              ? (
                  array
                    .slice(
                      0,
                      index
                    )
                    .filter(
                      (item) =>
                        item.score >
                        student.score
                    ).length + 1
                )
              : index + 1;

        return {
          ...student,
          rank,
        };
      }
    );

const selectedParticipantCount =
  selectedTestLeaderboard.length;

const selectedTopScore =
  selectedParticipantCount > 0
    ? selectedTestLeaderboard[0].score
    : 0;

const selectedAverageBestScore =
  selectedParticipantCount > 0
    ? selectedTestLeaderboard.reduce(
        (sum, student) =>
          sum + student.score,
        0
      ) /
      selectedParticipantCount
    : 0;

const selectedAverageBestPercentage =
  selectedParticipantCount > 0
    ? selectedTestLeaderboard.reduce(
        (sum, student) =>
          sum + student.percentage,
        0
      ) /
      selectedParticipantCount
    : 0;

/* =========================================================
   HELPERS
   ========================================================= */

function formatTime(
  seconds: number
) {
  const total =
    Number(seconds || 0);

  if (total <= 0) {
    return "0 min";
  }

  const hours =
    Math.floor(
      total / 3600
    );

  const minutes =
    Math.floor(
      (total % 3600) / 60
    );

  if (hours > 0) {
    return `${hours}h ${minutes}m`;
  }

  return `${minutes}m`;
}

function formatDate(
  value: string | null
) {
  if (!value) {
    return "—";
  }

  try {
    return new Intl.DateTimeFormat(
      "en-IN",
      {
        dateStyle: "medium",
        timeStyle: "short",
      }
    ).format(
      new Date(value)
    );
  } catch {
    return "—";
  }
}

function testLabel(
  testNumber: number | null,
  title: string
) {
  if (
    testNumber !== null &&
    Number.isFinite(
      Number(testNumber)
    )
  ) {
    return `TEST ${String(
      testNumber
    ).padStart(2, "0")} — ${title}`;
  }

  return title;
}

function percentageClass(
  percentage: number
) {
  if (percentage >= 75) {
    return "high";
  }

  if (percentage >= 50) {
    return "medium";
  }

  return "low";
}
