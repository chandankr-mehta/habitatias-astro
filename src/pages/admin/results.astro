      gap:7px;
      min-height:40px;
      padding:0 13px;
      border-radius:10px;
      background:var(--green-bg);
      color:var(--green);
      font-size:12px;
      font-weight:750;
    }

    .status-dot {
      width:7px;
      height:7px;
      border-radius:50%;
      background:#12b76a;
    }

    /* =====================================================
       CONTENT
    ===================================================== */

    .content {
      max-width:1600px;
      margin:0 auto;
      padding:32px 30px 60px;
    }

    .page-title {
      margin-bottom:24px;
    }

    .page-title h1 {
      margin:0;
      color:var(--navy);
      font-size:30px;
      line-height:1.15;
      letter-spacing:-.025em;
    }

    .page-title p {
      margin:7px 0 0;
      color:var(--muted);
      font-size:14px;
    }

    /* =====================================================
       STAT CARDS
    ===================================================== */

    .stats {
      display:grid;
      grid-template-columns:
        repeat(4,minmax(0,1fr));
      gap:16px;
      margin-bottom:22px;
    }

    .stat-card {
      background:#fff;
      border:1px solid var(--border);
      border-radius:16px;
      padding:20px;
      box-shadow:var(--shadow);
    }

    .stat-label {
      color:#66758c;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .stat-value {
      margin-top:12px;
      color:var(--navy);
      font-size:29px;
      line-height:1;
      font-weight:850;
    }

    .stat-description {
      margin-top:9px;
      color:#8290a5;
      font-size:11px;
    }

    /* =====================================================
       PANELS
    ===================================================== */

    .panel {
      background:#fff;
      border:1px solid var(--border);
      border-radius:16px;
      box-shadow:var(--shadow);
      overflow:hidden;
      margin-bottom:18px;
    }

    .panel-header {
      min-height:68px;
      padding:16px 20px;
      border-bottom:1px solid var(--border);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:15px;
    }

    .panel-header h2 {
      margin:0;
      color:var(--navy);
      font-size:15px;
      font-weight:800;
    }

    .panel-header p {
      margin:4px 0 0;
      color:var(--muted);
      font-size:11px;
    }

    .panel-body {
      padding:20px;
    }

    /* =====================================================
       ANALYTICS GRID
    ===================================================== */

    .analytics-grid {
      display:grid;
      grid-template-columns:
        repeat(3,minmax(0,1fr));
      gap:18px;
      margin-bottom:18px;
    }

    .metric-box {
      min-height:145px;
      border:1px solid var(--border);
      border-radius:14px;
      padding:18px;
      background:#fff;
    }

    .metric-title {
      color:#66758c;
      font-size:10px;
      text-transform:uppercase;
      letter-spacing:.05em;
      font-weight:800;
    }

    .metric-number {
      margin-top:13px;
      color:var(--navy);
      font-size:25px;
      font-weight:850;
    }

    .metric-note {
      margin-top:7px;
      color:#8290a5;
      font-size:10px;
    }

    /* =====================================================
       DISTRIBUTION
    ===================================================== */

    .distribution {
      display:grid;
      grid-template-columns:
        repeat(3,minmax(0,1fr));
      gap:14px;
    }

    .distribution-card {
      border:1px solid var(--border);
      border-radius:13px;
      padding:17px;
    }

    .distribution-top {
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
    }

    .distribution-name {
      font-size:12px;
      font-weight:800;
      color:var(--navy);
    }

    .distribution-value {
      font-size:18px;
      font-weight:850;
      color:var(--navy);
    }

    .bar {
      margin-top:13px;
      height:8px;
      border-radius:999px;
      background:#edf1f7;
      overflow:hidden;
    }

    .bar-fill {
      height:100%;
      border-radius:999px;
    }

    .bar-high {
      background:#12b76a;
    }

    .bar-medium {
      background:#f79009;
    }

    .bar-low {
      background:#f04438;
    }

    /* =====================================================
       SCORING RULE
    ===================================================== */

    .scoring-rule {
      display:grid;
      grid-template-columns:
        repeat(3,1fr);
      gap:12px;
    }

    .rule {
      padding:16px;
      border-radius:12px;
      background:#fafbfe;
      border:1px solid var(--border);
      text-align:center;
    }

    .rule strong {
      display:block;
      font-size:21px;
      color:var(--navy);
    }

    .rule span {
      display:block;
      margin-top:5px;
      color:var(--muted);
      font-size:10px;
      font-weight:700;
    }

    /* =====================================================
       TABLES
    ===================================================== */

    .table-wrap {
      overflow-x:auto;
    }

    table {
      width:100%;
      border-collapse:collapse;
      min-width:900px;
    }

    th {
      padding:13px 15px;
      background:#fafbfe;
      border-bottom:1px solid var(--border);
      color:#66758c;
      font-size:10px;
      text-transform:uppercase;
      letter-spacing:.04em;
      text-align:left;
      font-weight:800;
      white-space:nowrap;
    }

    td {
      padding:14px 15px;
      border-bottom:1px solid #edf0f5;
      vertical-align:middle;
      font-size:11px;
      color:#344563;
    }

    tbody tr:hover {
      background:#fbfcff;
    }

    tbody tr:last-child td {
      border-bottom:none;
    }

    .student-name {
      color:var(--navy);
      font-weight:800;
    }


    .student-rank {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:42px;
      min-height:30px;
      padding:0 9px;
      border-radius:999px;
      background:var(--blue-light);
      color:var(--blue);
      font-size:12px;
      font-weight:900;
    }

    .student-email {
      margin-top:3px;
      color:#8995a8;
      font-size:9px;
    }

    .test-number {
      color:var(--blue);
      font-size:10px;
      font-weight:850;
    }

    .test-title {
      margin-top:3px;
      color:var(--navy);
      font-weight:700;
      max-width:260px;
    }

    .score {
      font-weight:850;
      color:var(--navy);
    }

    .high {
      color:var(--green);
    }

    .medium {
      color:var(--orange);
    }

    .low {
      color:var(--red);
    }

    .percentage {
      margin-top:3px;
      color:#8290a5;
      font-size:9px;
    }

    .attempt-badge {
      display:inline-flex;
      min-width:30px;
      justify-content:center;
      padding:5px 8px;
      border-radius:999px;
      background:var(--blue-light);
      color:var(--blue);
      font-size:9px;
      font-weight:800;
    }

    .count-correct {
      color:var(--green);
      font-weight:800;
    }

    .count-incorrect {
      color:var(--red);
      font-weight:800;
    }

    .count-unanswered {
      color:#667085;
      font-weight:800;
    }

    /* =====================================================
       SELECTED TEST / LEADERBOARD
    ===================================================== */

    .selected-test-banner {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      margin-bottom:22px;
      padding:18px 20px;
      border:1px solid #c9d9ff;
      border-radius:16px;
      background:#f4f7ff;
      box-shadow:var(--shadow);
    }

    .selected-test-banner strong {
      display:block;
      margin-top:5px;
      color:var(--navy);
      font-size:15px;
      font-weight:850;
    }

    .selected-test-banner span {
      display:block;
      margin-top:5px;
      color:var(--muted);
      font-size:11px;
    }

    .selected-test-label {
      color:var(--blue);
      font-size:9px;
      font-weight:900;
      letter-spacing:.08em;
    }

    .clear-test-filter,
    .leaderboard-link {
      color:var(--blue);
      font-size:10px;
      font-weight:850;
      white-space:nowrap;
    }

    .clear-test-filter:hover,
    .leaderboard-link:hover {
      text-decoration:underline;
    }

    .selected-test-metrics {
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:14px;
      margin-bottom:18px;
    }

    .score-total {
      color:#8290a5;
      font-size:12px;
      font-weight:700;
    }

    .top-rank {
      background:#fff4cc;
      color:#8a5b00;
    }


    /* =====================================================
       SEARCH / FILTER
    ===================================================== */

    .controls {
      display:grid;
      grid-template-columns:
        minmax(280px,1fr)
        200px
        130px;
      gap:10px;
      padding:18px 20px;
    }

    .search,
    .select,
    .clear {
      min-height:42px;
      border:1px solid var(--border-dark);
      border-radius:10px;
      background:#fff;
      padding:0 13px;
      color:var(--text);
      outline:none;
      font-size:11px;
    }

    .search:focus,
    .select:focus {
      border-color:var(--blue);
      box-shadow:
        0 0 0 3px
        rgba(21,87,214,.08);
    }

    .clear {
      cursor:pointer;
      font-weight:750;
    }

    .clear:hover {
      background:#f8faff;
    }

    /* =====================================================
       EMPTY
    ===================================================== */

    .empty {
      padding:50px 25px;
      text-align:center;
      color:var(--muted);
    }

    .empty-icon {
      font-size:34px;
      margin-bottom:10px;
    }

    .empty strong {
      display:block;
      color:var(--navy);
      margin-bottom:6px;
      font-size:15px;
    }

    .error {
      margin:20px;
      padding:16px;
      border-radius:10px;
      border:1px solid #f3b6b1;
      background:var(--red-bg);
      color:var(--red);
      font-size:12px;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    .footer {
      margin-top:25px;
      padding-top:18px;
      border-top:1px solid var(--border);
      display:flex;
      justify-content:space-between;
      color:#8a96a8;
      font-size:10px;
    }

    /* =====================================================
       MOBILE
    ===================================================== */

    @media(max-width:1150px) {

      .stats {
        grid-template-columns:
          repeat(2,1fr);
      }

      .analytics-grid {
        grid-template-columns:
          repeat(2,1fr);
      }

      .controls {
        grid-template-columns:
          1fr 1fr;
      }
    }

    @media(max-width:720px) {

      .sidebar {
        transform:translateX(-100%);
      }

      .main {
        width:100%;
        margin-left:0;
      }

      .topbar {
        padding:0 15px;
      }

      .admin-status {
        display:none;
      }

      .content {
        padding:24px 15px 45px;
      }

      .stats,
      .analytics-grid,
      .distribution,
      .scoring-rule,
      .selected-test-metrics {
        grid-template-columns:1fr;
      }

      .selected-test-banner {
        flex-direction:column;
        align-items:flex-start;
      }

      .controls {
        grid-template-columns:1fr;
      }

      .footer {
        flex-direction:column;
        gap:8px;
      }
    }

  </style>

</head>

<body>

<div class="app">

  <!-- =====================================================
       SIDEBAR
  ====================================================== -->

  <aside class="sidebar">

    <div class="brand">

      <div class="brand-logo">
        H
      </div>

      <div>

        <div class="brand-name">
          Habitat IAS
        </div>

        <div class="brand-subtitle">
          ADMIN CONTROL PANEL
        </div>

      </div>

    </div>


    <div class="sidebar-content">

      <div class="nav-section">

        <div class="nav-title">
          Overview
        </div>

        <a
          href="/admin"
          class="nav-item"
        >
          <span class="nav-icon">⌂</span>
          <span class="nav-text">
            Dashboard
          </span>
        </a>

      </div>


      <div class="nav-section">

        <div class="nav-title">
          Mock Test
        </div>

        <a
          href="/admin/mock-tests"
          class="nav-item"
        >
          <span class="nav-icon">↗</span>

          <span class="nav-text">
            Mock Tests
          </span>

          <span class="nav-count">
            20
          </span>
        </a>

        <a
          href="/admin/questions"
          class="nav-item"
        >
          <span class="nav-icon">?</span>

          <span class="nav-text">
            Questions
          </span>

          <span class="nav-count">
            2,000
          </span>
        </a>

      </div>


      <div class="nav-section">

        <div class="nav-title">
          Students
        </div>

        <a
          href="/admin/students"
          class="nav-item"
        >
          <span class="nav-icon">●</span>

          <span class="nav-text">
            Students
          </span>
        </a>

        <a
          href="/admin/attempts"
          class="nav-item"
        >
          <span class="nav-icon">↗</span>

          <span class="nav-text">
            Student Attempts
          </span>

          <span class="nav-count">
            {totalAttempts}
          </span>
        </a>

      </div>


      <div class="nav-section">

        <div class="nav-title">
          Analytics
        </div>

        <a
          href="/admin/results"
          class="nav-item active"
        >
          <span class="nav-icon">▥</span>

          <span class="nav-text">
            Results &amp; Analytics
          </span>
        </a>

      </div>


      <div class="nav-section">

        <div class="nav-title">
          Access
        </div>

        <a
          href="/admin/access"
          class="nav-item"
        >
          <span class="nav-icon">◇</span>

          <span class="nav-text">
            Series Access
          </span>
        </a>

      </div>


      <div class="nav-section">

        <div class="nav-title">
          System
        </div>

        <a
          href="/admin/settings"
          class="nav-item"
        >
          <span class="nav-icon">⚙</span>

          <span class="nav-text">
            Settings
          </span>
        </a>

        <a
          href="/admin/security"
          class="nav-item"
        >
          <span class="nav-icon">◇</span>

          <span class="nav-text">
            Security
          </span>
        </a>

      </div>

    </div>


    <div class="sidebar-footer">

      <a
        href="/"
        class="website-link"
      >
        <span>←</span>
        <span>
          Back to Habitat IAS website
        </span>
      </a>

    </div>

  </aside>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="main">

    <header class="topbar">

      <div class="topbar-title">

        <strong>
          Results &amp; Analytics
        </strong>

        <span>
          Overall performance and mock-test analytics
        </span>

      </div>


      <div class="topbar-actions">

        <a
          href="/admin"
          class="top-button"
        >
          ← Dashboard
        </a>

        <div class="admin-status">

          <span class="status-dot"></span>

          Admin Panel

        </div>

      </div>

    </header>


    <div class="content">

      <!-- =================================================
           TITLE
      ================================================== -->

      <section class="page-title">

        <h1>
          Results &amp; Analytics
        </h1>

        <p>
          Analyse student performance across the
          Habitat IAS JPSC Prelims Mock Test Series.
        </p>

      </section>


      <!-- =================================================
           SELECTED TEST FILTER / CONTEXT
      ================================================== -->

      {
        selectedTest ? (
          <section class="selected-test-banner">

            <div>
              <div class="selected-test-label">
                FILTERED TEST PERFORMANCE
              </div>

              <strong>
                TEST {
                  selectedTest.test_number !== null
                    ? String(
                        selectedTest.test_number
                      ).padStart(2, "0")
                    : "—"
                } — {selectedTest.title}
              </strong>

              <span>
                Showing analytics and leaderboard for
                this mock test only.
              </span>
            </div>

            <a
              href="/admin/results"
              class="clear-test-filter"
            >
              View All Tests
            </a>

          </section>
        ) : null
      }


      <!-- =================================================
           TOP STATISTICS
      ================================================== -->

      <section class="stats">

        <div class="stat-card">

          <div class="stat-label">
            Total Attempts
          </div>

          <div class="stat-value">
            {totalAttempts}
          </div>

          <div class="stat-description">
            All recorded attempts
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Submitted
          </div>

          <div class="stat-value">
            {submittedAttempts}
          </div>

          <div class="stat-description">
            Completed attempts
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Average Score
          </div>

          <div class="stat-value">
            {averageScore.toFixed(1)}
          </div>

          <div class="stat-description">
            Average marks per submitted attempt
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Average Performance
          </div>

          <div class="stat-value">
            {averagePercentage.toFixed(1)}%
          </div>

          <div class="stat-description">
            Average percentage
          </div>

        </div>

      </section>


      <!-- =================================================
           SCORE METRICS
      ================================================== -->

      <section class="analytics-grid">

        <div class="metric-box">

          <div class="metric-title">
            Highest Score
          </div>

          <div class="metric-number high">
            {highestScore}
          </div>

          <div class="metric-note">
            Best submitted attempt
          </div>

        </div>


        <div class="metric-box">

          <div class="metric-title">
            Lowest Score
          </div>

          <div class="metric-number low">
            {lowestScore}
          </div>

          <div class="metric-note">
            Lowest submitted attempt
          </div>

        </div>


        <div class="metric-box">

          <div class="metric-title">
            Average Time
          </div>

          <div class="metric-number">
            {formatTime(averageTime)}
          </div>

          <div class="metric-note">
            Average time per submitted attempt
          </div>

        </div>


        <div class="metric-box">

          <div class="metric-title">
            Correct Answers
          </div>

          <div class="metric-number high">
            {totalCorrect}
          </div>

          <div class="metric-note">
            Across all recorded attempts
          </div>

        </div>


        <div class="metric-box">

          <div class="metric-title">
            Incorrect Answers
          </div>

          <div class="metric-number low">
            {totalIncorrect}
          </div>

          <div class="metric-note">
            No marks deducted
          </div>

        </div>


        <div class="metric-box">

          <div class="metric-title">
            Unanswered
          </div>

          <div class="metric-number">
            {totalUnanswered}
          </div>

          <div class="metric-note">
            Questions left unanswered
          </div>

        </div>

      </section>


      <!-- =================================================
           SCORING RULE
      ================================================== -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Mock Test Scoring System
            </h2>

            <p>
              Current Habitat IAS scoring rule
            </p>

          </div>

        </div>


        <div class="panel-body">

          <div class="scoring-rule">

            <div class="rule">

              <strong>
                +2
              </strong>

              <span>
                Correct Answer
              </span>

            </div>


            <div class="rule">

              <strong>
                0
              </strong>

              <span>
                Incorrect Answer
              </span>

            </div>


            <div class="rule">

              <strong>
                0
              </strong>

              <span>
                Unanswered
              </span>

            </div>

          </div>

          <p
            style="
              margin:15px 0 0;
              color:#667085;
              font-size:11px;
              line-height:1.6;
            "
          >
            There is <strong>no negative marking</strong>.
            Wrong answers do not reduce the student's score.
          </p>

        </div>

      </section>


      <!-- =================================================
           PERFORMANCE DISTRIBUTION
      ================================================== -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Performance Distribution
            </h2>

            <p>
              Submitted attempts grouped by percentage
            </p>

          </div>

        </div>


        <div class="panel-body">

          <div class="distribution">

            <div class="distribution-card">

              <div class="distribution-top">

                <div class="distribution-name">
                  75% and Above
                </div>

                <div class="distribution-value">
                  {highPerformers}
                </div>

              </div>

              <div class="bar">

                <div
                  class="bar-fill bar-high"
                  style={`width:${
                    submittedAttempts > 0
                      ? (highPerformers /
                          submittedAttempts) *
                        100
                      : 0
                  }%`}
                ></div>

              </div>

            </div>


            <div class="distribution-card">

              <div class="distribution-top">

                <div class="distribution-name">
                  50% – 74.99%
                </div>

                <div class="distribution-value">
                  {mediumPerformers}
                </div>

              </div>

              <div class="bar">

                <div
                  class="bar-fill bar-medium"
                  style={`width:${
                    submittedAttempts > 0
                      ? (mediumPerformers /
                          submittedAttempts) *
                        100
                      : 0
                  }%`}
                ></div>

              </div>

            </div>


            <div class="distribution-card">

              <div class="distribution-top">

                <div class="distribution-name">
                  Below 50%
                </div>

                <div class="distribution-value">
                  {lowPerformers}
                </div>

              </div>

              <div class="bar">

                <div
                  class="bar-fill bar-low"
                  style={`width:${
                    submittedAttempts > 0
                      ? (lowPerformers /
                          submittedAttempts) *
                        100
                      : 0
                  }%`}
                ></div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           TEST-WISE ANALYTICS
      ================================================== -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Test-wise Performance
            </h2>

            <p>
              Performance comparison across mock tests
            </p>

          </div>

          <strong
            style="
              font-size:11px;
              color:#667085;
            "
          >
            {testAnalytics.length} tests
          </strong>

        </div>


        {
          testAnalytics.length === 0 ? (

            <div class="empty">

              <div class="empty-icon">
                📊
              </div>

              <strong>
                No submitted test data
              </strong>

              <div>
                Test analytics will appear after students
                submit mock tests.
              </div>

            </div>

          ) : (

            <div class="table-wrap">

              <table>

                <thead>

                  <tr>

                    <th>
                      Test
                    </th>

                    <th>
                      Attempts
                    </th>

                    <th>
                      Average Score
                    </th>

                    <th>
                      Average %
                    </th>

                    <th>
                      Highest
                    </th>

                    <th>
                      Lowest
                    </th>

                    <th>
                      Correct
                    </th>

                    <th>
                      Incorrect
                    </th>

                    <th>
                      Unanswered
                    </th>

                    <th>
                      Avg Time
                    </th>

                    <th>
                      Leaderboard
                    </th>

                  </tr>

                </thead>


                <tbody>

                  {
                    testAnalytics.map(
                      (test) => (

                        <tr>

                          <td>

                            <div class="test-number">
                              TEST {
                                test.testNumber !== null
                                  ? String(
                                      test.testNumber
                                    ).padStart(
                                      2,
                                      "0"
                                    )
                                  : "—"
                              }
                            </div>

                            <div class="test-title">
                              {
                                test.title
                              }
                            </div>

                          </td>


                          <td>

                            <span class="attempt-badge">
                              {test.attempts}
                            </span>

                          </td>


                          <td>

                            <strong>
                              {test.averageScore.toFixed(1)}
                            </strong>

                            <div class="percentage">
                              / {
                                test.questionCount * 2
                              }
                            </div>

                          </td>


                          <td>

                            <strong
                              class={
                                percentageClass(
                                  test.averagePercentage
                                )
                              }
                            >
                              {
                                test.averagePercentage.toFixed(
                                  1
                                )
                              }%
                            </strong>

                          </td>


                          <td>
                            {test.highestScore}
                          </td>


                          <td>
                            {test.lowestScore}
                          </td>


                          <td class="count-correct">
                            {test.correct}
                          </td>


                          <td class="count-incorrect">
                            {test.incorrect}
                          </td>


                          <td class="count-unanswered">
                            {test.unanswered}
                          </td>


                          <td>
                            {formatTime(
                              test.averageTime
                            )}
                          </td>

                          <td>
                            <a
                              href={`/admin/results?test_id=${test.testId}`}
                              class="leaderboard-link"
                            >
                              View Ranking →
                            </a>
                          </td>

                        </tr>

                      )
                    )
                  }

                </tbody>

              </table>

            </div>

          )
        }

      </section>


      <!-- =================================================
           SELECTED TEST LEADERBOARD
      ================================================== -->

      {
        selectedTest ? (
          <section class="panel">

            <div class="panel-header">

              <div>

                <h2>
                  Test Leaderboard
                </h2>

                <p>
                  Best submitted score for each unique student
                  in this mock test.
                </p>

              </div>

              <a
                href="/admin/results"
                class="top-button"
              >
                Clear Test Filter
              </a>

            </div>

            <div class="panel-body">

              <div class="selected-test-metrics">

                <div class="metric-box">
                  <div class="metric-title">
                    Participants
                  </div>

                  <div class="metric-number">
                    {selectedParticipantCount}
                  </div>

                  <div class="metric-note">
                    Unique students with a submitted attempt
                  </div>
                </div>

                <div class="metric-box">
                  <div class="metric-title">
                    Top Score
                  </div>

                  <div class="metric-number high">
                    {selectedTopScore}
                    <span class="score-total">
                      / {Number(selectedTest.question_count || 0) * 2}
                    </span>
                  </div>

                  <div class="metric-note">
                    Highest best attempt
                  </div>
                </div>

                <div class="metric-box">
                  <div class="metric-title">
                    Average Best Score
                  </div>

                  <div class="metric-number">
                    {selectedAverageBestScore.toFixed(1)}
                  </div>

                  <div class="metric-note">
                    {selectedAverageBestPercentage.toFixed(1)}%
                    average among best attempts
                  </div>
                </div>

              </div>

              {
                selectedTestLeaderboard.length === 0 ? (
                  <div class="empty">
                    <div class="empty-icon">
                      🏆
                    </div>

                    <strong>
                      No submitted attempts
                    </strong>

                    <div>
                      The leaderboard will appear after students
                      submit this mock test.
                    </div>
                  </div>
                ) : (
                  <div class="table-wrap">

                    <table class="leaderboard-table">

                      <thead>
                        <tr>
                          <th>Rank</th>
                          <th>Student</th>
                          <th>Best Score</th>
                          <th>Percentage</th>
                          <th>Time</th>
                          <th>Attempt</th>
                        </tr>
                      </thead>

                      <tbody>
                        {
                          selectedTestLeaderboard.map(
                            (student) => (
                              <tr>

                                <td>
                                  <span
                                    class={`student-rank ${
                                      student.rank <= 3
                                        ? "top-rank"
                                        : ""
                                    }`}
                                  >
                                    #{student.rank}
                                  </span>
                                </td>

                                <td>
                                  <div class="student-name">
                                    {student.name}
                                  </div>

                                  <div class="student-email">
                                    {student.email}
                                  </div>
                                </td>

                                <td>
                                  <strong class="score">
                                    {student.score}
                                    <span class="percentage">
                                      / {Number(selectedTest.question_count || 0) * 2}
                                    </span>
                                  </strong>
                                </td>

                                <td>
                                  <strong
                                    class={percentageClass(
                                      student.percentage
                                    )}
                                  >
                                    {student.percentage.toFixed(1)}%
                                  </strong>
                                </td>

                                <td>
                                  {formatTime(
                                    student.timeTaken
                                  )}
                                </td>

                                <td>
                                  <a
                                    href={`/test-result?attempt_id=${student.attemptId}`}
                                    class="leaderboard-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >
                                    View Result →
                                  </a>
                                </td>

                              </tr>
                            )
                          )
                        }
                      </tbody>

                    </table>

                  </div>
                )
              }

            </div>

          </section>
        ) : null
      }


      <!-- =================================================
           STUDENT PERFORMANCE
      ================================================== -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Student Performance
            </h2>

            <p>
              Submitted-attempt performance by student
            </p>

          </div>

          <strong
            id="studentCount"
            style="
              font-size:11px;
              color:#667085;
            "
          >
            {studentAnalytics.length} students
          </strong>

        </div>


        <div class="controls">

          <input
            id="studentSearch"
            class="search"
            type="search"
            placeholder="Search student or email..."
          >


          <select
            id="studentPerformanceFilter"
            class="select"
          >

            <option value="">
              All Performance
            </option>

            <option value="high">
              75% and above
            </option>

            <option value="medium">
              50% – 74.99%
            </option>

            <option value="low">
              Below 50%
            </option>

          </select>


          <button
            id="clearStudentFilters"
            class="clear"
            type="button"
          >
            Clear
          </button>

        </div>


        {
          studentAnalytics.length === 0 ? (

            <div class="empty">

              <div class="empty-icon">
                👨‍🎓
              </div>

              <strong>
                No student results yet
              </strong>

              <div>
                Student analytics will appear after
                completed attempts are submitted.
              </div>

            </div>

          ) : (

            <div class="table-wrap">

              <table>

                <thead>

                  <tr>

                    <th>
                      Student
                    </th>

                    <th>
                      Attempts
                    </th>

                    <th>
                      Average Score
                    </th>

                    <th>
                      Average %
                    </th>

                    <th>
                      Best Score
                    </th>

                    <th>
                      Average Time
                    </th>

                  </tr>

                </thead>


                <tbody id="studentTableBody">

                  {
                    rankedStudentAnalytics.map(
                      (student) => {

                        const performance =
                          percentageClass(
                            student.averagePercentage
                          );

                        return (

                          <tr
                            class="student-row"
                            data-search={
                              `${student.name} ${student.email}`
                                .toLowerCase()
                            }
                            data-performance={
                              performance
                            }
                          >

                            <td>

                              <div class="student-name">
                                {
                                  student.name
                                }
                              </div>

                              <div class="student-email">
                                {
                                  student.email
                                }
                              </div>

                            </td>


                            <td>

                              <span class="attempt-badge">
                                {student.attempts}
                              </span>

                            </td>


                            <td>

                              <strong>
                                {
                                  student.averageScore.toFixed(
                                    1
                                  )
                                }
                              </strong>

                            </td>


                            <td>

                              <strong
                                class={performance}
                              >
                                {
                                  student.averagePercentage.toFixed(
                                    1
                                  )
                                }%
                              </strong>

                            </td>


                            <td>

                              <strong>
                                {
                                  student.highestScore
                                }
                              </strong>

                            </td>


                            <td>

                              {formatTime(
                                student.averageTime
                              )}

                            </td>

                          </tr>

                        );

                      }
                    )
                  }

                </tbody>

              </table>

            </div>

          )
        }

      </section>


      <!-- =================================================
           ANSWER SUMMARY
      ================================================== -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Answer Summary
            </h2>

            <p>
              Aggregate answer behaviour across attempts
            </p>

          </div>

        </div>


        <div class="panel-body">

          <div class="analytics-grid">

            <div class="metric-box">

              <div class="metric-title">
                Total Correct
              </div>

              <div class="metric-number high">
                {totalCorrect}
              </div>

              <div class="metric-note">
                Correct responses
              </div>

            </div>


            <div class="metric-box">

              <div class="metric-title">
                Total Incorrect
              </div>

              <div class="metric-number low">
                {totalIncorrect}
              </div>

              <div class="metric-note">
                Incorrect responses — no deduction
              </div>

            </div>


            <div class="metric-box">

              <div class="metric-title">
                Total Unanswered
              </div>

              <div class="metric-number">
                {totalUnanswered}
              </div>

              <div class="metric-note">
                Questions not attempted
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           FOOTER
      ================================================== -->

      <footer class="footer">

        <span>
          Habitat IAS · JPSC Prelims Mock Test Series
        </span>

        <span>
          Admin Control Panel
        </span>

      </footer>

    </div>

  </main>

</div>


<!-- =======================================================
     CLIENT FILTERING
======================================================== -->

<script>

  const search =
    document.getElementById(
      "studentSearch"
    );

  const performance =
    document.getElementById(
      "studentPerformanceFilter"
    );

  const clear =
    document.getElementById(
      "clearStudentFilters"
    );

  const count =
    document.getElementById(
      "studentCount"
    );

  const rows =
    Array.from(
      document.querySelectorAll(
        ".student-row"
      )
    );


  function applyStudentFilters() {

    const query =
      (
        search?.value ||
        ""
      )
        .trim()
        .toLowerCase();

    const filter =
      performance?.value ||
      "";

    let visible = 0;


    rows.forEach(
      (row) => {

        const text =
          row.dataset.search ||
          "";

        const rowPerformance =
          row.dataset.performance ||
          "";

        const matchesSearch =
          !query ||
          text.includes(query);

        const matchesPerformance =
          !filter ||
          rowPerformance === filter;

        const show =
          matchesSearch &&
          matchesPerformance;

        row.style.display =
          show ? "" : "none";

        if (show) {
          visible++;
        }

      }
    );


    if (count) {

      count.textContent =
        `${visible} ${
          visible === 1
            ? "student"
            : "students"
        }`;

    }

  }


  search?.addEventListener(
    "input",
    applyStudentFilters
  );

  performance?.addEventListener(
    "change",
    applyStudentFilters
  );


  clear?.addEventListener(
    "click",
    () => {

      if (search) {
        search.value = "";
      }

      if (performance) {
        performance.value = "";
      }

      applyStudentFilters();

    }
  );

</script>

</body>

</html>