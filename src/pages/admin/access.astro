          <div
            style="height:20px;"
          ></div>


          <div class="series-grid">

            {
              Array.from(
                {
                  length: TOTAL_TESTS
                },
                (_, index) =>
                  index + 1
              ).map(
                (testNumber) => (

                  <div class="test-box">

                    <div class="test-number">
                      TEST {
                        String(
                          testNumber
                        ).padStart(
                          2,
                          "0"
                        )
                      }
                    </div>

                    <div class="test-title">
                      JPSC Prelims Mock Test
                    </div>

                    <span class="test-status">
                      Included
                    </span>

                  </div>

                )
              )
            }

          </div>

        </div>

      </div>


      <!-- =================================================
           STUDENT ACCESS TABLE
      ================================================== -->

      <div class="card">

        <div class="card-header">

          <h2>
            Student Access
          </h2>

          <p>
            Paid and manually granted access status.
          </p>

        </div>


        <div class="table-wrap">

          <table>

            <thead>

              <tr>

                <th>
                  Student
                </th>

                <th>
                  Series
                </th>

                <th>
                  Access
                </th>

                <th>
                  Tests
                </th>

                <th>
                  Purchase
                </th>

                <th>
                  Registered
                </th>

                <th>
                  Action
                </th>

              </tr>

            </thead>


            <tbody>

              {
                students.length === 0 ? (

                  <tr>

                    <td
                      colspan="7"
                      class="empty"
                    >
                      No registered students found.
                    </td>

                  </tr>

                ) : (

                  students.map(
                    (student) => (

                      <tr
                        data-student-row={
                          student.id
                        }
                      >

                        <!-- STUDENT -->

                        <td>

                          <div class="student-name">
                            {student.name}
                          </div>

                          <div class="student-email">
                            {student.email}
                          </div>

                        </td>


                        <!-- SERIES -->

                        <td>

                          JPSC Prelims

                          <br />

                          20-Test Series

                        </td>


                        <!-- ACCESS -->

                        <td>

                          {
                            student.paid ? (

                              <div>

                                <span
                                  class="badge paid"
                                >
                                  <span class="badge-dot"></span>
                                  Paid Access
                                </span>

                                {
                                  student.manualAccess && (

                                    <div
                                      style="
                                        margin-top:6px;
                                      "
                                    >

                                      <span
                                        class="badge manual"
                                      >
                                        <span class="badge-dot"></span>
                                        Manual Backup
                                      </span>

                                    </div>

                                  )
                                }

                              </div>

                            ) : student.manualAccess ? (

                              <span
                                class="badge manual"
                              >
                                <span class="badge-dot"></span>
                                Manual Access
                              </span>

                            ) : (

                              <span
                                class="badge unpaid"
                              >
                                <span class="badge-dot"></span>
                                No Access
                              </span>

                            )
                          }

                        </td>


                        <!-- TEST COUNT -->

                        <td>

                          <span
                            class="access-count"
                          >
                            {
                              student.hasAccess
                                ? `${TOTAL_TESTS} / ${TOTAL_TESTS}`
                                : `0 / ${TOTAL_TESTS}`
                            }
                          </span>

                        </td>


                        <!-- PURCHASE -->

                        <td>

                          {
                            student.purchaseId ? (

                              <span
                                class="badge paid"
                              >
                                Paid
                              </span>

                            ) : (

                              <span
                                style="
                                  color:#7b8da9;
                                  font-size:11px;
                                "
                              >
                                No purchase
                              </span>

                            )
                          }

                        </td>


                        <!-- REGISTERED -->

                        <td>

                          {
                            new Date(
                              student.createdAt
                            ).toLocaleDateString(
                              "en-IN",
                              {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                              }
                            )
                          }

                        </td>


                        <!-- ACTION -->

                        <td class="action-cell">

                          {
                            student.paid ? (

                              <div>

                                <button
                                  type="button"
                                  class="action-button protected-button"
                                  disabled
                                >
                                  Paid Access
                                </button>

                                <div class="action-note">
                                  Purchase protected
                                </div>

                              </div>

                            ) : student.manualAccess ? (

                              <button
                                type="button"
                                class="action-button revoke-button"
                                data-action="revoke"
                                data-user-id={
                                  student.id
                                }
                                data-user-name={
                                  student.name
                                }
                              >
                                Revoke Access
                              </button>

                            ) : (

                              <button
                                type="button"
                                class="action-button grant-button"
                                data-action="grant"
                                data-user-id={
                                  student.id
                                }
                                data-user-name={
                                  student.name
                                }
                              >
                                Grant Access
                              </button>

                            )
                          }

                        </td>

                      </tr>

                    )
                  )

                )
              }

            </tbody>

          </table>

        </div>

      </div>


      <!-- =================================================
           ACCESS RULE
      ================================================== -->

      <div class="card">

        <div class="card-header">

          <h2>
            How Access Works
          </h2>

        </div>


        <div class="card-body">

          <div class="note">

            <strong>
              1. Paid Student
            </strong>

            <br />

            A successful paid purchase automatically
            unlocks all 20 tests.

            <br /><br />


            <strong>
              2. Manual Student
            </strong>

            <br />

            Admin can grant complimentary access without
            creating a fake payment.

            <br /><br />


            <strong>
              3. Revoking Manual Access
            </strong>

            <br />

            Removes only the manual access record.
            It does not affect a genuine paid purchase.

            <br /><br />


            <strong>
              4. No Access
            </strong>

            <br />

            Students with neither a paid purchase nor
            manual access remain locked out of the series.

          </div>

        </div>

      </div>

    </section>

  </main>

</div>


<!-- =======================================================
     ACTION MESSAGE
======================================================== -->

<div
  id="actionMessage"
></div>


<!-- =======================================================
     GRANT / REVOKE SCRIPT
======================================================== -->

<script>

  const message =
    document.getElementById(
      "actionMessage"
    );


  function showMessage(
    text,
    type
  ) {

    if (!message) {
      return;
    }

    message.textContent =
      text;

    message.className =
      type;

    window.setTimeout(
      () => {
        message.className = "";
        message.textContent = "";
      },
      3500
    );

  }


  async function changeAccess(
    button
  ) {

    const action =
      button.dataset.action;

    const userId =
      button.dataset.userId;

    const userName =
      button.dataset.userName ||
      "this student";


    if (
      !action ||
      !userId
    ) {

      showMessage(
        "Invalid student information.",
        "error"
      );

      return;
    }


    /* =====================================================
       CONFIRMATION
    ===================================================== */

    if (
      action === "grant"
    ) {

      const confirmed =
        window.confirm(
          `Grant all 20 mock tests to ${userName}?\n\nThis creates manual access only. It does NOT create a payment record.`
        );

      if (!confirmed) {
        return;
      }

    }


    if (
      action === "revoke"
    ) {

      const confirmed =
        window.confirm(
          `Revoke manual access for ${userName}?\n\nThis will lock the student unless they have a genuine paid purchase.`
        );

      if (!confirmed) {
        return;
      }

    }


    /* =====================================================
       BUTTON LOADING
    ===================================================== */

    const originalText =
      button.textContent;

    button.disabled = true;

    button.textContent =
      action === "grant"
        ? "Granting..."
        : "Revoking...";


    try {

      const response =
        await fetch(
          "/api/admin/access",
          {
            method:
              action === "grant"
                ? "POST"
                : "DELETE",

            credentials:
              "include",

            headers: {
              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                user_id:
                  userId,
              }),
          }
        );


      let result = null;

      try {
        result =
          await response.json();
      } catch {
        result = null;
      }


      if (
        !response.ok ||
        !result?.success
      ) {

        throw new Error(
          result?.message ||
          "Access operation failed."
        );

      }


      /* =================================================
         SUCCESS
      ================================================= */

      showMessage(
        result.message ||
          (
            action === "grant"
              ? "Access granted successfully."
              : "Access revoked successfully."
          ),
        "success"
      );


      /*
       * Reload the page so:
       *
       * - status updates
       * - counters update
       * - buttons change
       * - database becomes source of truth
       */

      window.setTimeout(
        () => {
          window.location.reload();
        },
        700
      );


    } catch (error) {

      console.error(
        "Series access action error:",
        error
      );


      showMessage(
        error instanceof Error
          ? error.message
          : "Unable to update access.",
        "error"
      );


      button.disabled =
        false;

      button.textContent =
        originalText;

    }

  }


  /* =======================================================
     ATTACH BUTTON EVENTS
  ======================================================= */

  document
    .querySelectorAll(
      "[data-action]"
    )
    .forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            changeAccess(
              button
            );

          }
        );

      }
    );

</script>

</body>

</html>