import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   ENVIRONMENT
========================================================= */

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL;

const serviceRoleKey =
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

const adminUserId =
  import.meta.env.ADMIN_USER_ID;

if (!supabaseUrl) {
  throw new Error("PUBLIC_SUPABASE_URL is missing.");
}

if (!serviceRoleKey) {
  throw new Error("SUPABASE_SERVICE_ROLE_KEY is missing.");
}

if (!adminUserId) {
  throw new Error("ADMIN_USER_ID is missing.");
}

/* =========================================================
   CONSTANTS
========================================================= */

const PRODUCT_ID =
  "jpsc_prelims_20_test_series";

const TOTAL_TESTS = 20;

/* =========================================================
   SUPABASE ADMIN CLIENT
========================================================= */

const supabaseAdmin = createClient(
  supabaseUrl,
  serviceRoleKey,
  {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  }
);

/* =========================================================
   TYPES
========================================================= */

type StudentRow = {
  id: string;
  email: string;
  name: string;

  paid: boolean;

  manualAccess: boolean;

  hasAccess: boolean;

  purchaseId: string | null;

  manualAccessId: string | null;

  paymentStatus: string;

  createdAt: string;
};

/* =========================================================
   LOAD STUDENTS
========================================================= */

let students: StudentRow[] = [];

let loadError = "";

try {
  /* =======================================================
     LOAD USERS
  ======================================================= */

  const {
    data: usersData,
    error: usersError,
  } =
    await supabaseAdmin.auth.admin.listUsers({
      page: 1,
      perPage: 1000,
    });

  if (usersError) {
    throw usersError;
  }

  const users =
    usersData?.users ?? [];


  /* =======================================================
     LOAD PURCHASES
  ======================================================= */

  const {
    data: purchases,
    error: purchasesError,
  } =
    await supabaseAdmin
      .from("purchases")
      .select(
        "id, user_id, product_id, payment_status, created_at"
      )
      .eq(
        "product_id",
        PRODUCT_ID
      );

  if (purchasesError) {
    throw purchasesError;
  }


  /* =======================================================
     BUILD PURCHASE MAP

     Latest purchase per student.
  ======================================================= */

  const purchaseMap =
    new Map<
      string,
      {
        id: string;
        payment_status: string;
        created_at: string;
      }
    >();

  for (
    const purchase of purchases ?? []
  ) {

    if (!purchase.user_id) {
      continue;
    }

    const existing =
      purchaseMap.get(
        purchase.user_id
      );

    if (
      !existing ||
      new Date(
        purchase.created_at
      ).getTime() >
        new Date(
          existing.created_at
        ).getTime()
    ) {

      purchaseMap.set(
        purchase.user_id,
        {
          id: purchase.id,

          payment_status:
            purchase.payment_status,

          created_at:
            purchase.created_at,
        }
      );
    }
  }


  /* =======================================================
     LOAD MANUAL ACCESS
  ======================================================= */

  const {
    data: manualAccessRows,
    error: manualAccessError,
  } =
    await supabaseAdmin
      .from("manual_series_access")
      .select(
        "id, user_id, product_id, granted_by, granted_at, updated_at"
      )
      .eq(
        "product_id",
        PRODUCT_ID
      );

  if (manualAccessError) {
    throw manualAccessError;
  }


  /* =======================================================
     BUILD MANUAL ACCESS MAP
  ======================================================= */

  const manualAccessMap =
    new Map<
      string,
      {
        id: string;
      }
    >();

  for (
    const access of manualAccessRows ?? []
  ) {

    if (!access.user_id) {
      continue;
    }

    manualAccessMap.set(
      access.user_id,
      {
        id: access.id,
      }
    );
  }


  /* =======================================================
     BUILD STUDENT LIST
  ======================================================= */

  students =
    users
      .map((user) => {

        const purchase =
          purchaseMap.get(
            user.id
          );

        const manualAccess =
          manualAccessMap.get(
            user.id
          );

        const paid =
          purchase?.payment_status ===
          "paid";

        const manuallyGranted =
          Boolean(
            manualAccess
          );

        const hasAccess =
          paid ||
          manuallyGranted;

        const metadata =
          user.user_metadata ?? {};

        const name =
          metadata.full_name ||
          metadata.name ||
          metadata.display_name ||
          user.email?.split("@")[0] ||
          "Student";

        return {
          id: user.id,

          email:
            user.email ??
            "No email",

          name,

          paid,

          manualAccess:
            manuallyGranted,

          hasAccess,

          purchaseId:
            purchase?.id ??
            null,

          manualAccessId:
            manualAccess?.id ??
            null,

          paymentStatus:
            purchase?.payment_status ??
            "not purchased",

          createdAt:
            user.created_at,
        };
      })
      .sort(
        (a, b) =>
          a.name.localeCompare(
            b.name
          )
      );

} catch (error) {

  console.error(
    "Series access page error:",
    error
  );

  loadError =
    error instanceof Error
      ? error.message
      : "Unable to load series access data.";
}

/* =========================================================
   STATISTICS
========================================================= */

const totalStudents =
  students.length;

const paidStudents =
  students.filter(
    (student) =>
      student.paid
  ).length;

const manualStudents =
  students.filter(
    (student) =>
      !student.paid &&
      student.manualAccess
  ).length;

const studentsWithAccess =
  students.filter(
    (student) =>
      student.hasAccess
  ).length;

const studentsWithoutAccess =
  students.filter(
    (student) =>
      !student.hasAccess
  ).length;

const accessPercentage =
  totalStudents > 0
    ? Math.round(
        (studentsWithAccess /
          totalStudents) *
          100
      )
    : 0;
