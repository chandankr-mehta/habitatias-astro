<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Series Access | Habitat IAS Admin
  </title>

  <style>

    :root {
      --blue:#1557d6;
      --blue-dark:#0b347f;
      --blue-light:#eef4ff;

      --green:#087f5b;
      --green-bg:#e9f8f1;

      --red:#c62828;
      --red-bg:#fff0f0;

      --orange:#b54708;
      --orange-bg:#fff4e5;

      --text:#082b62;
      --muted:#5c78a4;

      --border:#d8e2f0;
      --bg:#f4f7fc;
      --white:#fff;
    }

    * {
      box-sizing:border-box;
    }

    body {
      margin:0;
      font-family:
        Arial,
        Helvetica,
        sans-serif;
      background:var(--bg);
      color:var(--text);
    }

    a {
      color:inherit;
      text-decoration:none;
    }

    button,
    input {
      font:inherit;
    }

    /* =====================================================
       LAYOUT
    ===================================================== */

    .layout {
      min-height:100vh;
      display:flex;
    }

    .sidebar {
      width:285px;
      background:var(--white);
      border-right:1px solid var(--border);
      position:fixed;
      inset:0 auto 0 0;
      overflow-y:auto;
      z-index:20;
    }

    .brand {
      min-height:110px;
      padding:25px 24px;
      border-bottom:1px solid var(--border);
    }

    .brand-row {
      display:flex;
      align-items:center;
      gap:14px;
    }

    .brand-logo {
      width:50px;
      height:50px;
      border-radius:14px;
      background:var(--blue);
      color:white;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:25px;
      font-weight:800;
    }

    .brand-name {
      font-size:23px;
      font-weight:800;
    }

    .brand-subtitle {
      margin-top:4px;
      font-size:11px;
      letter-spacing:1px;
      color:var(--muted);
      font-weight:700;
    }

    .nav {
      padding:22px 14px;
    }

    .nav-section {
      margin:0 12px 10px;
      font-size:11px;
      letter-spacing:1px;
      color:#7890b5;
      font-weight:800;
    }

    .nav-link {
      display:flex;
      align-items:center;
      gap:12px;
      padding:13px 18px;
      margin-bottom:5px;
      border-radius:12px;
      font-size:14px;
      font-weight:700;
      color:var(--text);
    }

    .nav-link:hover {
      background:var(--blue-light);
    }

    .nav-link.active {
      background:#eaf1ff;
      color:var(--blue);
    }

    .nav-icon {
      width:18px;
      text-align:center;
    }

    .sidebar-bottom {
      position:absolute;
      bottom:0;
      left:0;
      right:0;
      padding:18px 26px;
      border-top:1px solid var(--border);
      background:white;
      font-size:13px;
      color:var(--muted);
    }

    /* =====================================================
       MAIN
    ===================================================== */

    .main {
      margin-left:285px;
      width:calc(100% - 285px);
      min-height:100vh;
    }

    .topbar {
      min-height:82px;
      background:white;
      border-bottom:1px solid var(--border);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 32px;
    }

    .top-title {
      font-size:15px;
      color:var(--muted);
      font-weight:700;
    }

    .top-actions {
      display:flex;
      gap:10px;
    }

    .button {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:42px;
      padding:0 17px;
      border:1px solid var(--border);
      border-radius:10px;
      background:white;
      color:var(--text);
      font-weight:700;
      font-size:13px;
      cursor:pointer;
    }

    .button:hover {
      background:#f7faff;
    }

    .content {
      padding:34px;
      max-width:1600px;
    }

    .page-heading {
      margin-bottom:28px;
    }

    .page-heading h1 {
      margin:0;
      font-size:32px;
      letter-spacing:-.5px;
    }

    .page-heading p {
      margin:8px 0 0;
      color:var(--muted);
      font-size:14px;
    }

    /* =====================================================
       STATISTICS
    ===================================================== */

    .stats {
      display:grid;
      grid-template-columns:
        repeat(4,minmax(0,1fr));
      gap:18px;
      margin-bottom:24px;
    }

    .stat {
      background:white;
      border:1px solid var(--border);
      border-radius:16px;
      padding:23px;
    }

    .stat-label {
      color:#617ca5;
      font-size:11px;
      font-weight:800;
      letter-spacing:.5px;
      text-transform:uppercase;
    }

    .stat-number {
      margin-top:11px;
      font-size:32px;
      font-weight:800;
    }

    .stat-description {
      margin-top:5px;
      color:var(--muted);
      font-size:12px;
    }

    /* =====================================================
       CARDS
    ===================================================== */

    .card {
      background:white;
      border:1px solid var(--border);
      border-radius:16px;
      margin-bottom:24px;
      overflow:hidden;
    }

    .card-header {
      padding:22px 24px;
      border-bottom:1px solid var(--border);
    }

    .card-header h2 {
      margin:0;
      font-size:20px;
    }

    .card-header p {
      margin:6px 0 0;
      color:var(--muted);
      font-size:13px;
    }

    .card-body {
      padding:24px;
    }

    /* =====================================================
       NOTE
    ===================================================== */

    .note {
      background:var(--blue-light);
      border:1px solid #cbdcff;
      border-radius:12px;
      padding:17px;
      color:var(--text);
      font-size:13px;
      line-height:1.65;
    }

    .error {
      background:var(--red-bg);
      color:var(--red);
      border:1px solid #ffcaca;
      border-radius:12px;
      padding:18px;
      margin-bottom:24px;
      font-size:13px;
    }

    /* =====================================================
       SERIES GRID
    ===================================================== */

    .series-grid {
      display:grid;
      grid-template-columns:
        repeat(5,minmax(0,1fr));
      gap:12px;
    }

    .test-box {
      border:1px solid var(--border);
      border-radius:12px;
      padding:16px;
      background:#fbfcff;
    }

    .test-number {
      color:var(--blue);
      font-size:11px;
      font-weight:800;
    }

    .test-title {
      margin-top:7px;
      font-weight:800;
      font-size:13px;
    }

    .test-status {
      margin-top:11px;
      display:inline-block;
      border-radius:20px;
      padding:5px 9px;
      font-size:10px;
      font-weight:800;
      background:var(--green-bg);
      color:var(--green);
    }

    /* =====================================================
       TABLE
    ===================================================== */

    .table-wrap {
      overflow-x:auto;
    }

    table {
      width:100%;
      border-collapse:collapse;
      min-width:1050px;
    }

    th {
      text-align:left;
      padding:14px 18px;
      background:#f8faff;
      color:#607ba4;
      border-bottom:1px solid var(--border);
      font-size:10px;
      text-transform:uppercase;
      letter-spacing:.4px;
      white-space:nowrap;
    }

    td {
      padding:16px 18px;
      border-bottom:1px solid #edf1f7;
      font-size:13px;
      vertical-align:middle;
    }

    tbody tr:hover {
      background:#fbfcff;
    }

    .student-name {
      font-weight:800;
    }

    .student-email {
      margin-top:4px;
      color:var(--muted);
      font-size:11px;
    }

    /* =====================================================
       BADGES
    ===================================================== */

    .badge {
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:6px 10px;
      border-radius:20px;
      font-size:10px;
      font-weight:800;
      white-space:nowrap;
    }

    .badge.paid {
      color:var(--green);
      background:var(--green-bg);
    }

    .badge.manual {
      color:var(--orange);
      background:var(--orange-bg);
    }

    .badge.unpaid {
      color:var(--red);
      background:var(--red-bg);
    }

    .badge-dot {
      width:6px;
      height:6px;
      border-radius:50%;
      background:currentColor;
    }

    .access-count {
      font-weight:800;
    }

    /* =====================================================
       ACTION BUTTONS
    ===================================================== */

    .action-cell {
      min-width:170px;
    }

    .action-button {
      border:0;
      border-radius:9px;
      min-height:36px;
      padding:0 13px;
      font-size:11px;
      font-weight:800;
      cursor:pointer;
      transition:.15s ease;
    }

    .grant-button {
      background:var(--blue);
      color:white;
    }

    .grant-button:hover {
      background:var(--blue-dark);
    }

    .revoke-button {
      background:var(--red-bg);
      color:var(--red);
      border:1px solid #ffcaca;
    }

    .revoke-button:hover {
      background:#ffe1e1;
    }

    .protected-button {
      background:#f2f5f9;
      color:#6c7e9a;
      border:1px solid var(--border);
      cursor:not-allowed;
    }

    .action-note {
      margin-top:6px;
      font-size:9px;
      color:#8493a9;
    }

    /* =====================================================
       STATUS MESSAGE
    ===================================================== */

    #actionMessage {
      display:none;
      position:fixed;
      right:25px;
      bottom:25px;
      z-index:1000;
      max-width:390px;
      padding:14px 17px;
      border-radius:12px;
      box-shadow:
        0 12px 35px
        rgba(16,38,75,.15);
      font-size:12px;
      font-weight:700;
    }

    #actionMessage.success {
      display:block;
      background:var(--green-bg);
      color:var(--green);
      border:1px solid #b7e5d0;
    }

    #actionMessage.error {
      display:block;
      background:var(--red-bg);
      color:var(--red);
      border:1px solid #ffcaca;
    }

    /* =====================================================
       EMPTY
    ===================================================== */

    .empty {
      padding:45px;
      text-align:center;
      color:var(--muted);
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media(max-width:1100px) {

      .stats {
        grid-template-columns:
          repeat(2,minmax(0,1fr));
      }

      .series-grid {
        grid-template-columns:
          repeat(4,minmax(0,1fr));
      }
    }

    @media(max-width:800px) {

      .layout {
        display:block;
      }

      .sidebar {
        position:static;
        width:100%;
        height:auto;
      }

      .sidebar-bottom {
        position:static;
      }

      .main {
        margin-left:0;
        width:100%;
      }

      .topbar {
        padding:0 20px;
      }

      .content {
        padding:20px;
      }

      .stats {
        grid-template-columns:1fr;
      }

      .series-grid {
        grid-template-columns:
          repeat(2,minmax(0,1fr));
      }
    }

  </style>

</head>


