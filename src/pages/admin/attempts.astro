---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   HABITAT IAS — ADMIN STUDENT ATTEMPTS
   ========================================================= */

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL;

const serviceRoleKey =
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

const adminUserId =
  import.meta.env.ADMIN_USER_ID;

/* =========================================================
   SERVER SUPABASE CLIENT
   ========================================================= */

if (!supabaseUrl) {
  throw new Error(
    "PUBLIC_SUPABASE_URL is missing."
  );
}

if (!serviceRoleKey) {
  throw new Error(
    "SUPABASE_SERVICE_ROLE_KEY is missing."
  );
}

if (!adminUserId) {
  throw new Error(
    "ADMIN_USER_ID is missing."
  );
}

const supabaseAdmin =
  createClient(
    supabaseUrl,
    serviceRoleKey,
    {
      auth: {
        autoRefreshToken: false,
        persistSession: false,
      },
    }
  );

/* =========================================================
   ADMIN AUTHENTICATION
   ========================================================= */

const accessToken =
  Astro.cookies.get(
    "habitat-access-token"
  )?.value;

if (!accessToken) {
  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname +
          Astro.url.search
      )
  );
}

const {
  data: authData,
  error: authError,
} =
  await supabaseAdmin.auth.getUser(
    accessToken
  );

if (
  authError ||
  !authData?.user
) {
  Astro.cookies.delete(
    "habitat-access-token",
    { path: "/" }
  );

  return Astro.redirect(
    "/login?redirect=" +
      encodeURIComponent(
        Astro.url.pathname +
          Astro.url.search
      )
  );
}

if (
  authData.user.id !==
  adminUserId
) {
  return new Response(
    `<!doctype html>
    <html>
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Access Denied | Habitat IAS</title>
        <style>
          body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: #f5f7fb;
            font-family: Inter, system-ui, sans-serif;
            color: #172b4d;
          }

          .card {
            width: min(460px, 100%);
            background: #fff;
            border: 1px solid #e4e9f2;
            border-radius: 18px;
            padding: 34px;
            text-align: center;
            box-shadow: 0 12px 40px rgba(16,38,75,.08);
          }

          .icon {
            font-size: 38px;
            margin-bottom: 15px;
          }

          h1 {
            margin: 0 0 10px;
            font-size: 25px;
          }

          p {
            color: #667085;
            line-height: 1.6;
            font-size: 14px;
          }

          a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 18px;
            border-radius: 10px;
            background: #1557d6;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
          }
        </style>
      </head>

      <body>
        <div class="card">
          <div class="icon">🔒</div>
          <h1>Admin Access Denied</h1>
          <p>
            Your account is authenticated, but it does not
            have permission to access the Habitat IAS
            administration panel.
          </p>
          <a href="/admin">← Back to Admin</a>
        </div>
      </body>
    </html>`,
    {
      status: 403,
      headers: {
        "Content-Type":
          "text/html; charset=utf-8",
        "Cache-Control":
          "no-store",
      },
    }
  );
}

/* =========================================================
   STAGE 15 — DELETE ATTEMPT
   ========================================================= */

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = String(formData.get("action") || "");

    if (action === "delete_attempt") {
      const attemptId = String(
        formData.get("attempt_id") || ""
      ).trim();

      if (!attemptId) {
        return new Response("Attempt ID is required.", {
          status: 400,
          headers: {
            "Content-Type": "text/plain; charset=utf-8",
          },
        });
      }

      const { error: deleteError } =
        await supabaseAdmin
          .from("mock_attempts")
          .delete()
          .eq("id", attemptId);

      if (deleteError) {
        console.error(
          "ADMIN ATTEMPT DELETE ERROR:",
          deleteError
        );

        return new Response(
          `Unable to delete attempt: ${deleteError.message}`,
          {
            status: 500,
            headers: {
              "Content-Type": "text/plain; charset=utf-8",
            },
          }
        );
      }

      return Astro.redirect("/admin/attempts?deleted=1");
    }
  } catch (error) {
    console.error(
      "ADMIN ATTEMPT DELETE REQUEST ERROR:",
      error
    );

    return new Response("Unable to process the request.", {
      status: 500,
      headers: {
        "Content-Type": "text/plain; charset=utf-8",
      },
    });
  }
}

/* =========================================================
   LOAD ATTEMPTS
   ========================================================= */

const {
  data: attempts,
  error: attemptsError,
} =
  await supabaseAdmin
    .from("mock_attempts")
    .select(`
      id,
      user_id,
      test_id,
      started_at,
      submitted_at,
      score,
      correct_count,
      incorrect_count,
      unanswered_count,
      time_taken_seconds,
      status,
      created_at
    `)
    .order(
      "created_at",
      {
        ascending: false,
      }
    );

/* =========================================================
   LOAD TEST INFORMATION
   ========================================================= */

const safeAttempts =
  attempts || [];

const testIds = [
  ...new Set(
    safeAttempts
      .map(
        (attempt) =>
          attempt.test_id
      )
      .filter(Boolean)
  ),
];

let testsById =
  new Map();

if (testIds.length > 0) {
  const {
    data: tests,
    error: testsError,
  } =
    await supabaseAdmin
      .from("mock_tests")
      .select(`
        id,
        test_number,
        title,
        description,
        question_count,
        duration_minutes
      `)
      .in(
        "id",
        testIds
      );

  if (!testsError) {
    testsById =
      new Map(
        (tests || []).map(
          (test) => [
            String(test.id),
            test,
          ]
        )
      );
  }
}

/* =========================================================
   LOAD USER INFORMATION
   ========================================================= */

const userIds = [
  ...new Set(
    safeAttempts
      .map(
        (attempt) =>
          attempt.user_id
      )
      .filter(Boolean)
  ),
];

let usersById =
  new Map();

if (userIds.length > 0) {
  const userResults =
    await Promise.all(
      userIds.map(
        async (userId) => {
          try {
            const {
              data,
              error,
            } =
              await supabaseAdmin
                .auth.admin
                .getUserById(
                  userId
                );

            if (
              error ||
              !data?.user
            ) {
              return [
                String(userId),
                null,
              ];
            }

            return [
              String(userId),
              data.user,
            ];
          } catch {
            return [
              String(userId),
              null,
            ];
          }
        }
      )
    );

  usersById =
    new Map(
      userResults
    );
}

/* =========================================================
   PREPARE ATTEMPT DATA
   ========================================================= */

const rows =
  safeAttempts.map(
    (attempt) => {
      const test =
        testsById.get(
          String(
            attempt.test_id
          )
        );

      const user =
        usersById.get(
          String(
            attempt.user_id
          )
        );

      const correct =
        Number(
          attempt.correct_count ||
            0
        );

      const incorrect =
        Number(
          attempt.incorrect_count ||
            0
        );

      const unanswered =
        Number(
          attempt.unanswered_count ||
            0
        );

      const totalQuestions =
        Math.max(
          Number(
            test?.question_count ||
              0
          ),
          correct +
            incorrect +
            unanswered
        );

      const totalMarks =
        totalQuestions * 2;

      const score =
        Number(
          attempt.score || 0
        );

      const percentage =
        totalMarks > 0
          ? (score /
              totalMarks) *
            100
          : 0;

      const displayName =
        user?.user_metadata
          ?.full_name ||
        user?.user_metadata
          ?.name ||
        user?.email ||
        "Unknown Student";

      return {
        attempt,
        test,
        user,
        displayName,
        correct,
        incorrect,
        unanswered,
        totalQuestions,
        totalMarks,
        score,
        percentage,
      };
    }
  );

/* =========================================================
   STATISTICS
   ========================================================= */

const totalAttempts =
  rows.length;

const submittedAttempts =
  rows.filter(
    (item) =>
      item.attempt.status ===
      "submitted"
  ).length;

const inProgressAttempts =
  rows.filter(
    (item) =>
      item.attempt.status ===
      "in_progress"
  ).length;

const averagePercentage =
  totalAttempts > 0
    ? rows.reduce(
        (sum, item) =>
          sum +
          item.percentage,
        0
      ) / totalAttempts
    : 0;

/* =========================================================
   STAGE 15 — BEST ATTEMPT RANKING
   ========================================================= */

const bestAttemptByStudentTest = new Map();

for (const row of rows) {
  if (row.attempt.status !== "submitted") continue;

  const key =
    `${String(row.attempt.test_id)}:${String(row.attempt.user_id)}`;

  const existing = bestAttemptByStudentTest.get(key);

  if (
    !existing ||
    row.score > existing.score ||
    (
      row.score === existing.score &&
      new Date(row.attempt.submitted_at || 0).getTime() >
        new Date(existing.attempt.submitted_at || 0).getTime()
    )
  ) {
    bestAttemptByStudentTest.set(key, row);
  }
}

const leaderboardByAttemptId = new Map();
const leaderboardGroups = new Map();

for (const row of bestAttemptByStudentTest.values()) {
  const key = String(row.attempt.test_id);
  const group = leaderboardGroups.get(key) || [];
  group.push(row);
  leaderboardGroups.set(key, group);
}

for (const group of leaderboardGroups.values()) {
  group.sort((a, b) => b.score - a.score);

  let previousScore = null;
  let currentRank = 0;

  group.forEach((row, index) => {
    if (
      previousScore === null ||
      row.score !== previousScore
    ) {
      currentRank = index + 1;
    }

    leaderboardByAttemptId.set(
      String(row.attempt.id),
      {
        rank: currentRank,
        participants: group.length,
      }
    );

    previousScore = row.score;
  });
}

/* =========================================================
   HELPERS
   ========================================================= */

function escapeHtml(
  value: unknown
) {
  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );
}

function formatDate(
  value: string | null
) {
  if (!value) {
    return "—";
  }

  try {
    return new Intl.DateTimeFormat(
      "en-IN",
      {
        dateStyle: "medium",
        timeStyle: "short",
      }
    ).format(
      new Date(value)
    );
  } catch {
    return "—";
  }
}

function formatTime(
  seconds: number | null
) {
  const total =
    Number(seconds || 0);

  if (total <= 0) {
    return "0 min";
  }

  const hours =
    Math.floor(
      total / 3600
    );

  const minutes =
    Math.floor(
      (total % 3600) / 60
    );

  const secs =
    total % 60;

  if (hours > 0) {
    return `${hours}h ${minutes}m`;
  }

  if (minutes > 0) {
    return `${minutes}m ${secs}s`;
  }

  return `${secs}s`;
}
