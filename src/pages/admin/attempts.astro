      min-width:
        1100px;
    }

    th {
      padding:
        13px 15px;

      background:
        #fafbfe;

      border-bottom:
        1px solid var(--border);

      color:
        #66758c;

      font-size:
        10px;

      text-transform:
        uppercase;

      letter-spacing:
        .04em;

      text-align:
        left;

      font-weight:
        800;

      white-space:
        nowrap;
    }

    td {
      padding:
        15px;

      border-bottom:
        1px solid #edf0f5;

      vertical-align:
        middle;

      font-size:
        12px;

      color:
        #344563;
    }

    tbody tr:hover {
      background:
        #fbfcff;
    }

    tbody tr:last-child td {
      border-bottom:
        none;
    }

    .student-name {
      color:
        var(--navy);

      font-weight:
        800;
    }

    .student-email {
      margin-top:
        3px;

      color:
        #8995a8;

      font-size:
        10px;

      max-width:
        220px;

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;
    }

    .test-number {
      color:
        var(--blue);

      font-size:
        10px;

      font-weight:
        850;
    }

    .test-title {
      margin-top:
        3px;

      color:
        var(--navy);

      font-weight:
        700;

      max-width:
        240px;
    }

    .score {
      color:
        var(--navy);

      font-weight:
        850;

      font-size:
        13px;
    }

    .percentage {
      margin-top:
        3px;

      color:
        #8290a5;

      font-size:
        10px;
    }

    .score-high {
      color:
        var(--green);
    }

    .score-medium {
      color:
        var(--orange);
    }

    .score-low {
      color:
        var(--red);
    }

    .rank {
      color: var(--navy);
      font-size: 12px;
      font-weight: 850;
      white-space: nowrap;
    }

    .rank-muted {
      margin-top: 3px;
      color: #8995a8;
      font-size: 9px;
    }

    .admin-actions {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
    }

    .view-button.secondary {
      color: #344563;
      border-color: var(--border-dark);
    }

    .view-button.danger {
      color: var(--red);
      border-color: #f0b8b3;
      cursor: pointer;
    }

    .view-button.danger:hover {
      background: var(--red-bg);
      border-color: var(--red);
    }

    .status {
      display:
        inline-flex;

      align-items:
        center;

      padding:
        5px 9px;

      border-radius:
        999px;

      font-size:
        9px;

      font-weight:
        800;

      text-transform:
        capitalize;
    }

    .status-submitted {
      background:
        var(--green-bg);

      color:
        var(--green);
    }

    .status-progress {
      background:
        var(--orange-bg);

      color:
        var(--orange);
    }

    .status-other {
      background:
        #eef2f8;

      color:
        #61708a;
    }

    .count-grid {
      display:
        flex;

      gap:
        7px;

      flex-wrap:
        wrap;
    }

    .count {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        3px;

      font-size:
        10px;

      font-weight:
        750;
    }

    .count.correct {
      color:
        var(--green);
    }

    .count.incorrect {
      color:
        var(--red);
    }

    .count.unanswered {
      color:
        #667085;
    }

    .time {
      color:
        #344563;

      font-weight:
        700;

      white-space:
        nowrap;
    }

    .date {
      color:
        #667085;

      font-size:
        10px;

      line-height:
        1.5;

      white-space:
        nowrap;
    }

    .view-button {
      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      min-height:
        34px;

      padding:
        0 12px;

      border:
        1px solid #b9c8e1;

      border-radius:
        8px;

      background:
        white;

      color:
        var(--blue);

      font-size:
        10px;

      font-weight:
        800;

      white-space:
        nowrap;
    }

    .view-button:hover {
      background:
        var(--blue-light);

      border-color:
        var(--blue);
    }

    /* =====================================================
       EMPTY / ERROR
    ===================================================== */

    .empty {
      padding:
        60px 25px;

      text-align:
        center;

      color:
        var(--muted);
    }

    .empty-icon {
      font-size:
        34px;

      margin-bottom:
        12px;
    }

    .empty strong {
      display:
        block;

      color:
        var(--navy);

      font-size:
        15px;

      margin-bottom:
        7px;
    }

    .error-box {
      margin:
        20px;

      padding:
        16px;

      border:
        1px solid #f3b6b1;

      border-radius:
        10px;

      background:
        var(--red-bg);

      color:
        var(--red);

      font-size:
        12px;

      line-height:
        1.5;
    }

    /* =====================================================
       FOOTER
    ===================================================== */

    .footer {
      margin-top:
        25px;

      padding-top:
        18px;

      border-top:
        1px solid var(--border);

      display:
        flex;

      justify-content:
        space-between;

      color:
        #8a96a8;

      font-size:
        10px;
    }

    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 1150px) {

      .stats {
        grid-template-columns:
          repeat(2,1fr);
      }

      .filters {
        grid-template-columns:
          1fr 1fr;
      }

    }

    @media (max-width: 720px) {

      .sidebar {
        transform:
          translateX(-100%);

        transition:
          transform .2s ease;
      }

      .sidebar.open {
        transform:
          translateX(0);
      }

      .main {
        width:
          100%;

        margin-left:
          0;
      }

      .topbar {
        padding:
          0 16px;
      }

      .admin-status {
        display:
          none;
      }

      .content {
        padding:
          24px 15px 45px;
      }

      .stats {
        grid-template-columns:
          1fr;
      }

      .filters {
        grid-template-columns:
          1fr;
      }

      .footer {
        flex-direction:
          column;
      }

    }

  </style>

</head>

<body>

<div class="app">

  <!-- =====================================================
       SIDEBAR
  ====================================================== -->

  <aside
    class="sidebar"
    id="sidebar"
  >

    <div class="brand">

      <div class="brand-logo">
        H
      </div>

      <div>

        <div class="brand-name">
          Habitat IAS
        </div>

        <div class="brand-subtitle">
          ADMIN CONTROL PANEL
        </div>

      </div>

    </div>

    <div class="sidebar-content">

      <!-- OVERVIEW -->

      <div class="nav-section">

        <div class="nav-title">
          Overview
        </div>

        <a
          href="/admin"
          class="nav-item"
        >
          <span class="nav-icon">
            ⌂
          </span>

          <span class="nav-text">
            Dashboard
          </span>
        </a>

      </div>

      <!-- MOCK TEST -->

      <div class="nav-section">

        <div class="nav-title">
          Mock Test
        </div>

        <a
          href="/admin/mock-tests"
          class="nav-item"
        >
          <span class="nav-icon">
            ↗
          </span>

          <span class="nav-text">
            Mock Tests
          </span>

          <span class="nav-count">
            20
          </span>
        </a>

        <a
          href="/admin/questions"
          class="nav-item"
        >
          <span class="nav-icon">
            ?
          </span>

          <span class="nav-text">
            Questions
          </span>

          <span class="nav-count">
            2,000
          </span>
        </a>

      </div>

      <!-- STUDENTS -->

      <div class="nav-section">

        <div class="nav-title">
          Students
        </div>

        <a
          href="/admin/students"
          class="nav-item"
        >
          <span class="nav-icon">
            ●
          </span>

          <span class="nav-text">
            Students
          </span>
        </a>

        <a
          href="/admin/attempts"
          class="nav-item active"
        >
          <span class="nav-icon">
            ↗
          </span>

          <span class="nav-text">
            Student Attempts
          </span>

          <span
            class="nav-count"
            id="sidebarAttemptCount"
          >
            {totalAttempts}
          </span>
        </a>

      </div>

      <!-- ANALYTICS -->

      <div class="nav-section">

        <div class="nav-title">
          Analytics
        </div>

        <a
          href="/admin/results"
          class="nav-item"
        >
          <span class="nav-icon">
            ▥
          </span>

          <span class="nav-text">
            Results &amp; Analytics
          </span>
        </a>

      </div>

      <!-- ACCESS -->

      <div class="nav-section">

        <div class="nav-title">
          Access
        </div>

        <a
          href="/admin/access"
          class="nav-item"
        >
          <span class="nav-icon">
            ◇
          </span>

          <span class="nav-text">
            Series Access
          </span>
        </a>

      </div>

      <!-- SYSTEM -->

      <div class="nav-section">

        <div class="nav-title">
          System
        </div>

        <a
          href="/admin/settings"
          class="nav-item"
        >
          <span class="nav-icon">
            ⚙
          </span>

          <span class="nav-text">
            Settings
          </span>
        </a>

        <a
          href="/admin/security"
          class="nav-item"
        >
          <span class="nav-icon">
            ◇
          </span>

          <span class="nav-text">
            Security
          </span>
        </a>

      </div>

    </div>

    <div class="sidebar-footer">

      <a
        href="/"
        class="website-link"
      >
        <span>←</span>
        <span>
          Back to Habitat IAS website
        </span>
      </a>

    </div>

  </aside>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="main">

    <!-- TOPBAR -->

    <header class="topbar">

      <div class="topbar-title">

        <strong>
          Student Attempts
        </strong>

        <span>
          Review JPSC Prelims mock-test attempts and performance
        </span>

      </div>

      <div class="topbar-actions">

        <a
          href="/admin"
          class="top-button"
        >
          ← Dashboard
        </a>

        <div class="admin-status">

          <span class="status-dot"></span>

          Admin Panel

        </div>

      </div>

    </header>


    <!-- CONTENT -->

    <div class="content">

      <!-- TITLE -->

      <section class="page-title">

        <h1>
          Student Attempts
        </h1>

        <p>
          Review every mock-test attempt, score,
          accuracy, time and submission status.
        </p>

        {
          Astro.url.searchParams.get("deleted") === "1" && (
            <div
              style="
                margin-top:14px;
                padding:11px 13px;
                border:1px solid #b8ead6;
                border-radius:10px;
                background:#eaf8f0;
                color:#087443;
                font-size:12px;
                font-weight:800;
              "
            >
              Attempt deleted successfully.
            </div>
          )
        }

      </section>


      <!-- STATISTICS -->

      <section class="stats">

        <div class="stat-card">

          <div class="stat-label">
            Total Attempts
          </div>

          <div
            class="stat-value"
            id="totalAttempts"
          >
            {totalAttempts}
          </div>

          <div class="stat-description">
            All recorded student attempts
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Submitted
          </div>

          <div
            class="stat-value"
            id="submittedAttempts"
          >
            {submittedAttempts}
          </div>

          <div class="stat-description">
            Completed and submitted tests
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            In Progress
          </div>

          <div
            class="stat-value"
            id="inProgressAttempts"
          >
            {inProgressAttempts}
          </div>

          <div class="stat-description">
            Currently unfinished attempts
          </div>

        </div>


        <div class="stat-card">

          <div class="stat-label">
            Average Performance
          </div>

          <div
            class="stat-value"
            id="averagePercentage"
          >
            {averagePercentage.toFixed(1)}%
          </div>

          <div class="stat-description">
            Average score percentage
          </div>

        </div>

      </section>


      <!-- FILTERS -->

      <section class="panel">

        <div class="panel-header">

          <div>

            <h2>
              Attempt Records
            </h2>

            <p>
              Search and filter student attempts
            </p>

          </div>

          <strong
            id="visibleCount"
            style="font-size:11px;color:#667085;"
          >
            {totalAttempts} records
          </strong>

        </div>


        <div class="filters">

          <input
            id="searchInput"
            class="search-box"
            type="search"
            placeholder="Search student, email, test title or test number..."
          />


          <select
            id="statusFilter"
            class="filter-select"
          >

            <option value="">
              All Status
            </option>

            <option value="submitted">
              Submitted
            </option>

            <option value="in_progress">
              In Progress
            </option>

          </select>


          <select
            id="scoreFilter"
            class="filter-select"
          >

            <option value="">
              All Scores
            </option>

            <option value="high">
              75% and above
            </option>

            <option value="medium">
              50% – 74.99%
            </option>

            <option value="low">
              Below 50%
            </option>

          </select>


          <button
            id="clearFilters"
            class="clear-button"
            type="button"
          >
            Clear Filters
          </button>

        </div>

      </section>


      <!-- ATTEMPTS TABLE -->

      <section class="panel">

        <div class="table-wrap">

          {
            attemptsError ? (

              <div class="error-box">

                <strong>
                  Unable to load student attempts.
                </strong>

                <br />

                {escapeHtml(
                  attemptsError.message
                )}

              </div>

            ) : rows.length === 0 ? (

              <div class="empty">

                <div class="empty-icon">
                  📋
                </div>

                <strong>
                  No student attempts yet
                </strong>

                <div>
                  Attempts will appear here after
                  students start taking the mock tests.
                </div>

              </div>

            ) : (

              <table>

                <thead>

                  <tr>

                    <th>
                      Student
                    </th>

                    <th>
                      Test
                    </th>

                    <th>
                      Score
                    </th>

                    <th>
                      Performance
                    </th>

                    <th>
                      Correct / Wrong
                    </th>

                    <th>
                      Time
                    </th>

                    <th>
                      Status
                    </th>

                    <th>
                      Submitted
                    </th>

                    <th>
                      Rank
                    </th>

                    <th>
                      Action
                    </th>

                  </tr>

                </thead>


                <tbody id="attemptTableBody">

                  {
                    rows.map(
                      (item) => {

                        const {
                          attempt,
                          test,
                          user,
                          displayName,
                          correct,
                          incorrect,
                          unanswered,
                          totalQuestions,
                          totalMarks,
                          score,
                          percentage,
                        } = item;

                        const email =
                          user?.email ||
                          "Email unavailable";

                        const testNumber =
                          Number(
                            test?.test_number
                          );

                        const displayTestNumber =
                          Number.isInteger(
                            testNumber
                          )
                            ? String(
                                testNumber
                              ).padStart(
                                2,
                                "0"
                              )
                            : "—";

                        const status =
                          String(
                            attempt.status ||
                              "unknown"
                          );

                        const statusClass =
                          status ===
                          "submitted"
                            ? "status-submitted"
                            : status ===
                              "in_progress"
                              ? "status-progress"
                              : "status-other";

                        const scoreClass =
                          percentage >= 75
                            ? "score-high"
                            : percentage >= 50
                              ? "score-medium"
                              : "score-low";

                        return (

                          <tr
                            class="attempt-row"
                            data-search={
                              `${displayName} ${email} ${test?.title || ""} ${displayTestNumber} ${attempt.user_id}`
                                .toLowerCase()
                            }
                            data-status={
                              status
                            }
                            data-score={
                              percentage >= 75
                                ? "high"
                                : percentage >= 50
                                  ? "medium"
                                  : "low"
                            }
                          >

                            <td>

                              <div class="student-name">
                                {
                                  escapeHtml(
                                    displayName
                                  )
                                }
                              </div>

                              <div class="student-email">
                                {
                                  escapeHtml(
                                    email
                                  )
                                }
                              </div>

                            </td>


                            <td>

                              <div class="test-number">
                                TEST {
                                  escapeHtml(
                                    displayTestNumber
                                  )
                                }
                              </div>

                              <div class="test-title">
                                {
                                  escapeHtml(
                                    test?.title ||
                                      "JPSC Mock Test"
                                  )
                                }
                              </div>

                            </td>


                            <td>

                              <div
                                class={`score ${scoreClass}`}
                              >
                                {
                                  score.toFixed(
                                    0
                                  )
                                }
                                /
                                {
                                  totalMarks
                                }
                              </div>

                              <div class="percentage">
                                {
                                  percentage.toFixed(
                                    1
                                  )
                                }%
                              </div>

                            </td>


                            <td>

                              <div class="count-grid">

                                <span class="count correct">
                                  ✓ {correct}
                                </span>

                                <span class="count incorrect">
                                  ✕ {incorrect}
                                </span>

                                <span class="count unanswered">
                                  — {unanswered}
                                </span>

                              </div>

                              <div
                                class="percentage"
                              >
                                {totalQuestions}
                                questions
                              </div>

                            </td>


                            <td>

                              <div class="count-grid">

                                <span class="count correct">
                                  ✓ {correct}
                                </span>

                                <span class="count incorrect">
                                  ✕ {incorrect}
                                </span>

                              </div>

                            </td>


                            <td>

                              <div class="time">
                                {
                                  formatTime(
                                    Number(
                                      attempt.time_taken_seconds ||
                                        0
                                    )
                                  )
                                }
                              </div>

                            </td>


                            <td>

                              <span
                                class={`status ${statusClass}`}
                              >
                                {
                                  status ===
                                  "in_progress"
                                    ? "In Progress"
                                    : status
                                }
                              </span>

                            </td>


                            <td>

                              <div class="date">
                                {
                                  formatDate(
                                    attempt.submitted_at
                                  )
                                }
                              </div>

                            </td>


                            <td>

                              {
                                (() => {
                                  const ranking =
                                    leaderboardByAttemptId.get(
                                      String(attempt.id)
                                    );

                                  return ranking ? (
                                    <div>
                                      <div class="rank">
                                        #{ranking.rank}
                                      </div>

                                      <div class="rank-muted">
                                        of {ranking.participants}
                                      </div>
                                    </div>
                                  ) : (
                                    <span
                                      class="rank-muted"
                                      style="font-size:11px;"
                                    >
                                      Not ranked
                                    </span>
                                  );
                                })()
                              }

                            </td>

                            <td>

                              <div class="admin-actions">

                                <a
                                  href={`/admin/attempts?attempt_id=${encodeURIComponent(
                                    String(attempt.id)
                                  )}`}
                                  class="view-button"
                                >
                                  View
                                </a>

                                {
                                  attempt.status === "submitted" && (
                                    <a
                                      href={`/admin/results?test_id=${encodeURIComponent(
                                        String(attempt.test_id)
                                      )}`}
                                      class="view-button secondary"
                                    >
                                      Test Ranking
                                    </a>
                                  )
                                }

                                <form
                                  method="POST"
                                  style="display:inline;"
                                  onsubmit="return confirm('Delete this attempt? This cannot be undone.');"
                                >
                                  <input
                                    type="hidden"
                                    name="action"
                                    value="delete_attempt"
                                  />

                                  <input
                                    type="hidden"
                                    name="attempt_id"
                                    value={String(attempt.id)}
                                  />

                                  <button
                                    type="submit"
                                    class="view-button danger"
                                  >
                                    Delete
                                  </button>
                                </form>

                              </div>

                            </td>

                          </tr>

                        );

                      }
                    )
                  }

                </tbody>

              </table>

            )
          }

        </div>

      </section>


      <!-- FOOTER -->

      <footer class="footer">

        <span>
          Habitat IAS · JPSC Prelims Mock Test Series
        </span>

        <span>
          Admin Control Panel
        </span>

      </footer>

    </div>

  </main>

</div>


<script>

  const searchInput =
    document.getElementById(
      "searchInput"
    );

  const statusFilter =
    document.getElementById(
      "statusFilter"
    );

  const scoreFilter =
    document.getElementById(
      "scoreFilter"
    );

  const clearFilters =
    document.getElementById(
      "clearFilters"
    );

  const visibleCount =
    document.getElementById(
      "visibleCount"
    );

  const rows =
    Array.from(
      document.querySelectorAll(
        ".attempt-row"
      )
    );


  function applyFilters() {

    const search =
      (
        searchInput?.value ||
        ""
      )
        .trim()
        .toLowerCase();

    const status =
      statusFilter?.value ||
      "";

    const score =
      scoreFilter?.value ||
      "";

    let visible =
      0;

    rows.forEach(
      (row) => {

        const rowSearch =
          row.dataset.search ||
          "";

        const rowStatus =
          row.dataset.status ||
          "";

        const rowScore =
          row.dataset.score ||
          "";

        const matchesSearch =
          !search ||
          rowSearch.includes(
            search
          );

        const matchesStatus =
          !status ||
          rowStatus ===
            status;

        const matchesScore =
          !score ||
          rowScore ===
            score;

        const show =
          matchesSearch &&
          matchesStatus &&
          matchesScore;

        row.style.display =
          show
            ? ""
            : "none";

        if (show) {
          visible++;
        }

      }
    );

    if (visibleCount) {

      visibleCount.textContent =
        `${visible} ${
          visible === 1
            ? "record"
            : "records"
        }`;

    }

  }


  searchInput?.addEventListener(
    "input",
    applyFilters
  );

  statusFilter?.addEventListener(
    "change",
    applyFilters
  );

  scoreFilter?.addEventListener(
    "change",
    applyFilters
  );


  clearFilters?.addEventListener(
    "click",
    () => {

      if (searchInput) {
        searchInput.value =
          "";
      }

      if (statusFilter) {
        statusFilter.value =
          "";
      }

      if (scoreFilter) {
        scoreFilter.value =
          "";
      }

      applyFilters();

    }
  );

</script>

</body>

</html>