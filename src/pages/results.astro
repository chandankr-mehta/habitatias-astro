---
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Results | Habitat IAS</title>

  <style is:global>
    :root {
      --navy: #082b61;
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --green: #15803d;
      --red: #dc2626;
      --gray: #64748b;
      --border: #e2e8f0;
      --bg: #f1f5f9;
      --white: #ffffff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      background: var(--bg);
      color: #0f172a;
    }

    a { font-family: inherit; }

    .page {
      min-height: 100vh;
      padding: 28px 18px 60px;
    }

    .container {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
    }

    .header {
      background: var(--navy);
      color: white;
      border-radius: 18px;
      padding: 28px 30px;
      margin-bottom: 20px;
      box-shadow: 0 10px 30px rgba(15,23,42,.10);
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      opacity: .85;
    }

    h1 {
      margin: 8px 0 5px;
      font-size: 32px;
      line-height: 1.15;
    }

    .header p {
      margin: 0;
      color: #dbeafe;
      font-size: 14px;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 16px;
      border-radius: 9px;
      color: var(--navy);
      background: white;
      text-decoration: none;
      font-size: 13px;
      font-weight: 900;
      white-space: nowrap;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }

    .summary-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 7px 22px rgba(15,23,42,.05);
    }

    .summary-label {
      color: var(--gray);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .6px;
      text-transform: uppercase;
    }

    .summary-value {
      margin-top: 6px;
      color: var(--navy);
      font-size: 29px;
      font-weight: 900;
    }

    .results-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 17px;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(15,23,42,.06);
    }

    .results-header {
      padding: 21px 23px;
      border-bottom: 1px solid var(--border);
    }

    .results-header h2 {
      margin: 0;
      color: var(--navy);
      font-size: 20px;
    }

    .results-header p {
      margin: 6px 0 0;
      color: var(--gray);
      font-size: 13px;
    }

    .loading,
    .empty,
    .error {
      padding: 45px 20px;
      text-align: center;
      color: var(--gray);
      font-weight: 700;
    }

    .error { color: #dc2626; }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      min-width: 850px;
      border-collapse: collapse;
    }

    th {
      padding: 12px 14px;
      background: #f8fafc;
      border-bottom: 1px solid var(--border);
      color: var(--gray);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .55px;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }

    td {
      padding: 15px 14px;
      border-bottom: 1px solid #edf1f5;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      vertical-align: middle;
    }

    tr:last-child td { border-bottom: none; }

    .test-no {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 48px;
      padding: 6px 8px;
      border-radius: 7px;
      background: #eff6ff;
      color: var(--blue);
      font-size: 11px;
      font-weight: 900;
    }

    .test-title {
      color: var(--navy);
      font-weight: 900;
    }

    .date {
      color: var(--gray);
      font-size: 12px;
      margin-top: 4px;
    }

    .score {
      color: var(--navy);
      font-size: 16px;
      font-weight: 900;
    }

    .score-sub {
      margin-top: 2px;
      color: var(--gray);
      font-size: 11px;
    }

    .good { color: var(--green); }
    .bad { color: var(--red); }

    .view-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 125px;
      padding: 10px 14px;
      border-radius: 8px;
      background: var(--blue);
      color: white;
      text-decoration: none;
      font-size: 12px;
      font-weight: 900;
      transition: .18s ease;
    }

    .view-btn:hover { background: var(--blue-dark); }

    @media (max-width: 700px) {
      .page { padding: 18px 12px 40px; }

      .header { padding: 22px; }

      .header-top {
        align-items: flex-start;
        flex-direction: column;
      }

      h1 { font-size: 27px; }

      .summary {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <div class="container">

      <header class="header">
        <div class="header-top">
          <div>
            <div class="brand">Habitat IAS • Student Portal</div>
            <h1>Test Results</h1>
            <p>Review all your completed JPSC mock-test attempts.</p>
          </div>

          <a href="/dashboard" class="back-btn">
            ← Student Dashboard
          </a>
        </div>
      </header>

      <section class="summary">
        <div class="summary-card">
          <div class="summary-label">Tests Attempted</div>
          <div class="summary-value" id="testsAttempted">—</div>
        </div>

        <div class="summary-card">
          <div class="summary-label">Average Score</div>
          <div class="summary-value" id="averageScore">—</div>
        </div>

        <div class="summary-card">
          <div class="summary-label">Best Score</div>
          <div class="summary-value" id="bestScore">—</div>
        </div>
      </section>

      <section class="results-card">
        <div class="results-header">
          <h2>Completed Test Attempts</h2>
          <p>Click “View Analysis” to open the complete result and question-wise review.</p>
        </div>

        <div id="resultsContainer">
          <div class="loading">Loading your results…</div>
        </div>
      </section>

    </div>
  </main>

  <script>
    import { supabase } from "../lib/supabase";

    const resultsContainer =
      document.getElementById("resultsContainer");

    const testsAttemptedEl =
      document.getElementById("testsAttempted");

    const averageScoreEl =
      document.getElementById("averageScore");

    const bestScoreEl =
      document.getElementById("bestScore");

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function formatDate(value) {
      if (!value) return "Date unavailable";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "Date unavailable";
      }

      return date.toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    }

    function formatTime(seconds) {
      const total = Math.max(
        0,
        Number(seconds || 0)
      );

      const minutes = Math.floor(total / 60);
      const secs = total % 60;

      return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(secs).padStart(2, "0")
      );
    }

    async function loadResults() {
      try {
        const {
          data: userData,
          error: userError,
        } = await supabase.auth.getUser();

        if (
          userError ||
          !userData?.user
        ) {
          window.location.href =
            "/login?redirect=/results";
          return;
        }

        const userId =
          userData.user.id;

        const {
          data: attempts,
          error: attemptsError,
        } = await supabase
          .from("mock_attempts")
          .select(`
            id,
            user_id,
            test_id,
            submitted_at,
            score,
            correct_count,
            incorrect_count,
            unanswered_count,
            time_taken_seconds,
            status
          `)
          .eq("user_id", userId)
          .eq("status", "submitted")
          .order("submitted_at", {
            ascending: false,
          })
          .limit(100);

        if (attemptsError) {
          console.error(
            "Results attempts error:",
            attemptsError
          );

          resultsContainer.innerHTML = `
            <div class="error">
              Unable to load your test results.
              Please refresh the page and try again.
            </div>
          `;

          return;
        }

        const safeAttempts =
          attempts || [];

        if (safeAttempts.length === 0) {
          testsAttemptedEl.textContent = "0";
          averageScoreEl.textContent = "—";
          bestScoreEl.textContent = "—";

          resultsContainer.innerHTML = `
            <div class="empty">
              <div style="font-size:32px;margin-bottom:10px;">📋</div>
              <strong>No completed tests yet.</strong>
              <div style="margin-top:6px;font-size:13px;">
                Your submitted mock tests will appear here.
              </div>
            </div>
          `;

          return;
        }

        const testIds = [
          ...new Set(
            safeAttempts
              .map(
                attempt => attempt.test_id
              )
              .filter(Boolean)
          ),
        ];

        const {
          data: tests,
          error: testsError,
        } = await supabase
          .from("mock_tests")
          .select(`
            id,
            test_number,
            title,
            question_count
          `)
          .in("id", testIds);

        if (testsError) {
          console.error(
            "Results test lookup error:",
            testsError
          );
        }

        const testsById =
          new Map(
            (tests || []).map(
              test => [
                String(test.id),
                test,
              ]
            )
          );

        const rows =
          safeAttempts.map(
            attempt => {
              const test =
                testsById.get(
                  String(attempt.test_id)
                );

              const correct =
                Number(
                  attempt.correct_count || 0
                );

              const incorrect =
                Number(
                  attempt.incorrect_count || 0
                );

              const unanswered =
                Number(
                  attempt.unanswered_count || 0
                );

              const attempted =
                correct + incorrect;

              const totalQuestions =
                Math.max(
                  Number(
                    test?.question_count || 0
                  ),
                  attempted + unanswered
                );

              const maximumMarks =
                totalQuestions * 2;

              const score =
                Number(
                  attempt.score || 0
                );

              const percentage =
                maximumMarks > 0
                  ? (score / maximumMarks) * 100
                  : 0;

              return {
                attempt,
                test,
                correct,
                incorrect,
                unanswered,
                attempted,
                totalQuestions,
                maximumMarks,
                score,
                percentage,
              };
            }
          );

        testsAttemptedEl.textContent =
          rows.length;

        const average =
          rows.reduce(
            (sum, row) =>
              sum + row.percentage,
            0
          ) / rows.length;

        const best =
          Math.max(
            ...rows.map(
              row => row.percentage
            )
          );

        averageScoreEl.textContent =
          average.toFixed(1) + "%";

        bestScoreEl.textContent =
          best.toFixed(1) + "%";

        resultsContainer.innerHTML = `
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Test</th>
                  <th>Submitted</th>
                  <th>Score</th>
                  <th>Attempted</th>
                  <th>Response</th>
                  <th>Time</th>
                  <th>Analysis</th>
                </tr>
              </thead>

              <tbody>
                ${rows.map(row => `
                  <tr>

                    <td>
                      <span class="test-no">
                        TEST ${
                          Number.isInteger(
                            Number(
                              row.test?.test_number
                            )
                          )
                            ? String(
                                row.test.test_number
                              ).padStart(2, "0")
                            : "—"
                        }
                      </span>

                      <div
                        class="test-title"
                        style="margin-top:8px;"
                      >
                        ${escapeHtml(
                          row.test?.title ||
                          "Mock Test"
                        )}
                      </div>
                    </td>

                    <td>
                      ${formatDate(
                        row.attempt.submitted_at
                      )}
                    </td>

                    <td>
                      <div class="score">
                        ${row.score}/${row.maximumMarks}
                      </div>

                      <div class="score-sub">
                        ${row.percentage.toFixed(1)}%
                      </div>
                    </td>

                    <td>
                      ${row.attempted}
                      /
                      ${row.totalQuestions}
                    </td>

                    <td>
                      <span class="good">
                        ✓ ${row.correct}
                      </span>
                      &nbsp;
                      <span class="bad">
                        ✕ ${row.incorrect}
                      </span>
                      <div class="score-sub">
                        ${row.unanswered} unanswered
                      </div>
                    </td>

                    <td>
                      ${formatTime(
                        row.attempt.time_taken_seconds
                      )}
                    </td>

                    <td>
                      <a
                        class="view-btn"
                        href="/test-result?attempt_id=${encodeURIComponent(
                          row.attempt.id
                        )}"
                      >
                        View Analysis →
                      </a>
                    </td>

                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        `;
      } catch (error) {
        console.error(
          "Unexpected results page error:",
          error
        );

        resultsContainer.innerHTML = `
          <div class="error">
            Something went wrong while loading your results.
            Please refresh the page.
          </div>
        `;
      }
    }

    loadResults();
  </script>
</body>
</html>
