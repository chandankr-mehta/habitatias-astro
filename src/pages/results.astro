---
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Test Results | Habitat IAS</title>

  <meta
    name="description"
    content="View your Habitat IAS mock test results, score, correct answers, incorrect answers and question-wise performance."
  />

  <style>
    :root {
      --navy: #082b61;
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --green: #15803d;
      --green-bg: #f0fdf4;
      --red: #dc2626;
      --red-bg: #fef2f2;
      --gray: #64748b;
      --gray-dark: #334155;
      --gray-bg: #f8fafc;
      --border: #e2e8f0;
      --white: #ffffff;
      --yellow: #b45309;
      --yellow-bg: #fffbeb;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f1f5f9;
      color: #0f172a;
    }

    button,
    a {
      font-family: inherit;
    }

    button {
      cursor: pointer;
    }

    .page {
      min-height: 100vh;
      padding: 40px 20px 60px;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* =========================
       HEADER
    ========================= */

    .header {
      background: var(--navy);
      color: white;
      border-radius: 18px;
      padding: 35px;
      margin-bottom: 22px;
      box-shadow:
        0 10px 30px rgba(15, 23, 42, 0.12);
    }

    .brand {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 1.5px;
      opacity: 0.85;
      text-transform: uppercase;
    }

    .header h1 {
      margin: 10px 0 6px;
      font-size: 36px;
      line-height: 1.15;
    }

    .header p {
      margin: 0;
      color: #dbeafe;
      font-size: 15px;
    }

    /* =========================
       SCORE
    ========================= */

    .score-section {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 20px;
      margin-bottom: 22px;
    }

    .score-card,
    .info-card,
    .stat-card,
    .review-section {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.06);
    }

    .score-card {
      padding: 30px;
    }

    .score-label {
      color: var(--gray);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .score {
      margin-top: 8px;
      font-size: 52px;
      font-weight: 900;
      color: var(--navy);
      line-height: 1;
    }

    .percentage {
      margin-top: 10px;
      font-size: 18px;
      font-weight: 700;
      color: var(--blue);
    }

    .rule {
      margin-top: 20px;
      padding: 12px 15px;
      border-radius: 10px;
      background: #eff6ff;
      color: #1e40af;
      font-size: 13px;
      font-weight: 600;
    }

    /* =========================
       ATTEMPT INFO
    ========================= */

    .info-card {
      padding: 25px;
    }

    .info-title {
      font-size: 17px;
      font-weight: 800;
      margin-bottom: 18px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-row span:first-child {
      color: var(--gray);
    }

    .info-row span:last-child {
      font-weight: 700;
      text-align: right;
    }

    /* =========================
       STATS
    ========================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }

    .stat-card {
      padding: 24px;
    }

    .stat-number {
      font-size: 34px;
      font-weight: 900;
      line-height: 1;
    }

    .stat-label {
      margin-top: 8px;
      color: var(--gray);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .correct .stat-number {
      color: var(--green);
    }

    .incorrect .stat-number {
      color: var(--red);
    }

    .unanswered .stat-number {
      color: var(--gray);
    }

    /* =========================
       REVIEW SECTION
    ========================= */

    .review-section {
      margin-top: 22px;
      overflow: hidden;
    }

    .review-header {
      padding: 24px;
      border-bottom: 1px solid var(--border);
    }

    .review-title {
      margin: 0;
      color: var(--navy);
      font-size: 22px;
      font-weight: 900;
    }

    .review-subtitle {
      margin: 7px 0 0;
      color: var(--gray);
      font-size: 14px;
    }

    /* =========================
       FILTERS
    ========================= */

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      background: #fcfdff;
    }

    .filter-btn {
      border: 1px solid var(--border);
      background: white;
      color: var(--gray-dark);
      border-radius: 999px;
      padding: 9px 15px;
      font-size: 13px;
      font-weight: 800;
      transition: 0.2s ease;
    }

    .filter-btn:hover {
      border-color: var(--blue);
      color: var(--blue);
    }

    .filter-btn.active {
      background: var(--blue);
      border-color: var(--blue);
      color: white;
    }

    /* =========================
       REVIEW LIST
    ========================= */

    .review-list {
      padding: 20px;
    }

    .question-card {
      border: 1px solid var(--border);
      border-radius: 14px;
      margin-bottom: 14px;
      overflow: hidden;
      background: white;
    }

    .question-card:last-child {
      margin-bottom: 0;
    }

    .question-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 15px 18px;
      background: var(--gray-bg);
      border-bottom: 1px solid var(--border);
    }

    .question-number {
      font-size: 15px;
      font-weight: 900;
      color: var(--navy);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .status-badge.correct {
      color: var(--green);
      background: var(--green-bg);
    }

    .status-badge.incorrect {
      color: var(--red);
      background: var(--red-bg);
    }

    .status-badge.unanswered {
      color: var(--gray);
      background: #f1f5f9;
    }

    .question-body {
      padding: 18px;
    }

    .question-text {
      font-size: 16px;
      line-height: 1.65;
      font-weight: 800;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .options {
      display: grid;
      gap: 8px;
      margin-bottom: 18px;
    }

    .option {
      padding: 11px 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fafafa;
      font-size: 14px;
      line-height: 1.5;
    }

    .option.correct-option {
      background: var(--green-bg);
      border-color: #86efac;
    }

    .answer-row {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 15px;
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
    }

    .answer-row:last-child {
      border-bottom: none;
    }

    .answer-label {
      color: var(--gray);
      font-weight: 700;
    }

    .answer-value {
      font-weight: 800;
      color: #0f172a;
    }

    .answer-value.correct-answer {
      color: var(--green);
    }

    .answer-value.wrong-answer {
      color: var(--red);
    }

    .answer-value.not-answered {
      color: var(--gray);
      font-style: italic;
      font-weight: 600;
    }

    .explanation {
      margin-top: 18px;
      padding: 15px;
      background: #eff6ff;
      border-radius: 10px;
      border: 1px solid #dbeafe;
    }

    .explanation-title {
      font-size: 13px;
      font-weight: 900;
      color: #1e40af;
      margin-bottom: 6px;
    }

    .explanation-text {
      font-size: 14px;
      line-height: 1.65;
      color: #334155;
    }

    /* =========================
       EMPTY REVIEW
    ========================= */

    .empty-review {
      padding: 45px 20px;
      text-align: center;
      color: var(--gray);
      font-weight: 700;
    }

    /* =========================
       ACTIONS
    ========================= */

    .actions {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      margin-top: 22px;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    .primary-btn,
    .secondary-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 22px;
      border-radius: 9px;
      text-decoration: none;
      font-weight: 800;
      font-size: 14px;
      transition: 0.2s ease;
    }

    .primary-btn {
      background: var(--blue);
      color: white;
    }

    .primary-btn:hover {
      background: var(--blue-dark);
    }

    .secondary-btn {
      background: white;
      color: var(--navy);
      border: 1px solid var(--border);
    }

    .secondary-btn:hover {
      border-color: var(--blue);
      color: var(--blue);
    }

    /* =========================
       LOADING / ERROR
    ========================= */

    .loading,
    .error {
      background: white;
      border-radius: 16px;
      padding: 40px;
      text-align: center;
      box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.06);
    }

    .loading {
      color: var(--gray);
      font-weight: 700;
    }

    .error {
      color: var(--red);
      font-weight: 700;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 750px) {
      .page {
        padding: 20px 14px 40px;
      }

      .score-section {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .header {
        padding: 25px;
      }

      .header h1 {
        font-size: 30px;
      }

      .score {
        font-size: 44px;
      }

      .actions {
        flex-direction: column;
      }

      .primary-btn,
      .secondary-btn {
        width: 100%;
      }

      .answer-row {
        grid-template-columns: 1fr;
        gap: 5px;
      }

      .question-top {
        align-items: flex-start;
        flex-direction: column;
      }

      .review-list {
        padding: 12px;
      }

      .filters {
        padding: 15px;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <div class="container">

      <!-- LOADING -->

      <div
        id="loading"
        class="loading"
      >
        Loading your test result...
      </div>


      <!-- ERROR -->

      <div
        id="error"
        class="error"
        style="display:none;"
      >
        Unable to load this test result.
      </div>


      <!-- RESULT CONTENT -->

      <section
        id="resultContent"
        style="display:none;"
      >

        <!-- HEADER -->

        <div class="header">

          <div class="brand">
            Habitat IAS • Test Result
          </div>

          <h1 id="resultTitle">
            Test Result
          </h1>

          <p>
            Your mock test has been submitted successfully.
          </p>

        </div>


        <!-- SCORE + ATTEMPT INFO -->

        <div class="score-section">

          <div class="score-card">

            <div class="score-label">
              Final Score
            </div>

            <div class="score">

              <span id="score">
                0
              </span>

              /

              <span id="totalMarks">
                0
              </span>

            </div>

            <div
              class="percentage"
              id="percentage"
            >
              0%
            </div>

            <div class="rule">
              JPSC scoring: No negative marking.
              Incorrect answers receive 0 marks.
            </div>

          </div>


          <div class="info-card">

            <div class="info-title">
              Attempt Information
            </div>

            <div class="info-row">
              <span>Status</span>
              <span id="status">
                Submitted
              </span>
            </div>

            <div class="info-row">
              <span>Time Used</span>
              <span id="timeUsed">
                00:00
              </span>
            </div>

            <div class="info-row">
              <span>Submitted</span>
              <span id="submittedAt">
                —
              </span>
            </div>

            <div class="info-row">
              <span>Attempt ID</span>
              <span id="attemptId">
                —
              </span>
            </div>

          </div>

        </div>


        <!-- STATS -->

        <div class="stats">

          <div class="stat-card correct">

            <div
              class="stat-number"
              id="correct"
            >
              0
            </div>

            <div class="stat-label">
              Correct
            </div>

          </div>


          <div class="stat-card incorrect">

            <div
              class="stat-number"
              id="incorrect"
            >
              0
            </div>

            <div class="stat-label">
              Incorrect
            </div>

          </div>


          <div class="stat-card unanswered">

            <div
              class="stat-number"
              id="unanswered"
            >
              0
            </div>

            <div class="stat-label">
              Unanswered
            </div>

          </div>

        </div>


        <!-- QUESTION-WISE REVIEW -->

        <section class="review-section">

          <div class="review-header">

            <h2 class="review-title">
              Question-wise Review
            </h2>

            <p class="review-subtitle">
              Review all questions, your selected answers,
              correct answers and explanations.
            </p>

          </div>


          <!-- FILTERS -->

          <div class="filters">

            <button
              type="button"
              class="filter-btn active"
              data-filter="all"
            >
              All
            </button>

            <button
              type="button"
              class="filter-btn"
              data-filter="correct"
            >
              Correct
            </button>

            <button
              type="button"
              class="filter-btn"
              data-filter="incorrect"
            >
              Incorrect
            </button>

            <button
              type="button"
              class="filter-btn"
              data-filter="unanswered"
            >
              Unanswered
            </button>

          </div>


          <!-- QUESTION LIST -->

          <div
            id="reviewList"
            class="review-list"
          >
          </div>

        </section>


        <!-- ACTIONS -->

        <div class="actions">

          <a
            class="secondary-btn"
            href="/mock-tests/"
          >
            Return to Mock Tests
          </a>

          <a
            class="primary-btn"
            href="/mock-tests/"
          >
            Take Another Test
          </a>

        </div>

      </section>

    </div>

  </main>


  <script>
    import { supabase } from "../lib/supabase";


    /* ==========================================
       DOM ELEMENTS
    ========================================== */

    const loading =
      document.getElementById("loading");

    const errorBox =
      document.getElementById("error");

    const resultContent =
      document.getElementById("resultContent");


    const scoreEl =
      document.getElementById("score");

    const totalMarksEl =
      document.getElementById("totalMarks");

    const percentageEl =
      document.getElementById("percentage");


    const correctEl =
      document.getElementById("correct");

    const incorrectEl =
      document.getElementById("incorrect");

    const unansweredEl =
      document.getElementById("unanswered");


    const statusEl =
      document.getElementById("status");

    const timeUsedEl =
      document.getElementById("timeUsed");

    const submittedAtEl =
      document.getElementById("submittedAt");

    const attemptIdEl =
      document.getElementById("attemptId");


    const resultTitleEl =
      document.getElementById("resultTitle");

    const reviewList =
      document.getElementById("reviewList");


    /* ==========================================
       STATE
    ========================================== */

    let reviewAnswers = [];

    let currentFilter = "all";


    /* ==========================================
       ERROR
    ========================================== */

    function showError(message) {

      loading.style.display =
        "none";

      resultContent.style.display =
        "none";

      errorBox.textContent =
        message;

      errorBox.style.display =
        "block";
    }


    /* ==========================================
       FORMAT TIME
    ========================================== */

    function formatTime(seconds) {

      const totalSeconds =
        Number(seconds || 0);

      const hours =
        Math.floor(
          totalSeconds / 3600
        );

      const minutes =
        Math.floor(
          (totalSeconds % 3600) / 60
        );

      const secs =
        totalSeconds % 60;


      if (hours > 0) {

        return [
          String(hours).padStart(2, "0"),
          String(minutes).padStart(2, "0"),
          String(secs).padStart(2, "0"),
        ].join(":");

      }


      return [
        String(minutes).padStart(2, "0"),
        String(secs).padStart(2, "0"),
      ].join(":");
    }


    /* ==========================================
       FORMAT DATE
    ========================================== */

    function formatDate(value) {

      if (!value) {
        return "—";
      }

      const date =
        new Date(value);

      if (
        Number.isNaN(
          date.getTime()
        )
      ) {
        return "—";
      }

      return date.toLocaleString(
        "en-IN",
        {
          dateStyle: "medium",
          timeStyle: "short",
        }
      );
    }


    /* ==========================================
       ESCAPE HTML
    ========================================== */

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {
        return "";
      }

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    /* ==========================================
       GET ANSWER STATUS
    ========================================== */

    function getAnswerStatus(answer) {

      if (
        answer.selected_option === null ||
        answer.selected_option === undefined ||
        answer.selected_option === ""
      ) {

        return "unanswered";

      }


      if (
        answer.is_correct === true
      ) {

        return "correct";

      }


      return "incorrect";
    }


    /* ==========================================
       STATUS LABEL
    ========================================== */

    function getStatusLabel(status) {

      if (status === "correct") {
        return "Correct";
      }

      if (status === "incorrect") {
        return "Incorrect";
      }

      return "Unanswered";
    }


    /* ==========================================
       GET OPTION TEXT
    ========================================== */

    function getOptionText(
      question,
      option
    ) {

      if (!option) {
        return "Not Answered";
      }

      const key =
        String(option).toLowerCase();


      if (key === "a") {
        return `A. ${question.option_a || ""}`;
      }

      if (key === "b") {
        return `B. ${question.option_b || ""}`;
      }

      if (key === "c") {
        return `C. ${question.option_c || ""}`;
      }

      if (key === "d") {
        return `D. ${question.option_d || ""}`;
      }

      return String(option).toUpperCase();
    }


    /* ==========================================
       RENDER QUESTION REVIEW
    ========================================== */

    function renderReview() {

      if (!reviewList) {
        return;
      }


      const filtered =
        reviewAnswers.filter(
          (answer) => {

            const status =
              getAnswerStatus(answer);

            return (
              currentFilter === "all" ||
              status === currentFilter
            );
          }
        );


      if (
        filtered.length === 0
      ) {

        reviewList.innerHTML = `
          <div class="empty-review">
            No questions found in this category.
          </div>
        `;

        return;
      }


      reviewList.innerHTML =
        filtered
          .map(
            (answer) => {

              const status =
                getAnswerStatus(answer);


              const questionNumber =
                answer.question_number;


              const selectedOption =
                answer.selected_option;


              const correctOption =
                answer.correct_option;


              let selectedText =
                "Not Answered";


              if (
                selectedOption !== null &&
                selectedOption !== undefined &&
                selectedOption !== ""
              ) {

                selectedText =
                  getOptionText(
                    answer,
                    selectedOption
                  );

              }


              const correctText =
                getOptionText(
                  answer,
                  correctOption
                );


              return `

                <article
                  class="question-card"
                  data-status="${status}"
                >

                  <div class="question-top">

                    <div class="question-number">
                      Question
                      ${escapeHtml(questionNumber)}
                    </div>

                    <div
                      class="status-badge ${status}"
                    >
                      ${getStatusLabel(status)}
                    </div>

                  </div>


                  <div class="question-body">


                    <!-- QUESTION -->

                    <div class="question-text">

                      ${escapeHtml(
                        answer.question_text
                      )}

                    </div>


                    <!-- OPTIONS -->

                    <div class="options">

                      <div
                        class="option ${
                          String(correctOption).toLowerCase() === "a"
                            ? "correct-option"
                            : ""
                        }"
                      >
                        <strong>A.</strong>
                        ${escapeHtml(
                          answer.option_a
                        )}
                      </div>


                      <div
                        class="option ${
                          String(correctOption).toLowerCase() === "b"
                            ? "correct-option"
                            : ""
                        }"
                      >
                        <strong>B.</strong>
                        ${escapeHtml(
                          answer.option_b
                        )}
                      </div>


                      <div
                        class="option ${
                          String(correctOption).toLowerCase() === "c"
                            ? "correct-option"
                            : ""
                        }"
                      >
                        <strong>C.</strong>
                        ${escapeHtml(
                          answer.option_c
                        )}
                      </div>


                      <div
                        class="option ${
                          String(correctOption).toLowerCase() === "d"
                            ? "correct-option"
                            : ""
                        }"
                      >
                        <strong>D.</strong>
                        ${escapeHtml(
                          answer.option_d
                        )}
                      </div>

                    </div>


                    <!-- SELECTED ANSWER -->

                    <div class="answer-row">

                      <div class="answer-label">
                        Selected Answer
                      </div>

                      <div
                        class="
                          answer-value
                          ${
                            status === "correct"
                              ? "correct-answer"
                              : status === "incorrect"
                              ? "wrong-answer"
                              : "not-answered"
                          }
                        "
                      >

                        ${escapeHtml(
                          selectedText
                        )}

                      </div>

                    </div>


                    <!-- CORRECT ANSWER -->

                    <div class="answer-row">

                      <div class="answer-label">
                        Correct Answer
                      </div>

                      <div
                        class="
                          answer-value
                          correct-answer
                        "
                      >

                        ${escapeHtml(
                          correctText
                        )}

                      </div>

                    </div>


                    <!-- RESULT -->

                    <div class="answer-row">

                      <div class="answer-label">
                        Result
                      </div>

                      <div class="answer-value">

                        ${
                          status === "correct"
                            ? "✓ Correct answer — 2 marks"
                            : status === "incorrect"
                            ? "✗ Incorrect answer — 0 marks"
                            : "— Not answered — 0 marks"
                        }

                      </div>

                    </div>


                    <!-- QUESTION ID -->

                    <div class="answer-row">

                      <div class="answer-label">
                        Question ID
                      </div>

                      <div class="answer-value">

                        ${escapeHtml(
                          answer.question_id
                        )}

                      </div>

                    </div>


                    <!-- EXPLANATION -->

                    ${
                      answer.explanation
                        ? `

                          <div class="explanation">

                            <div
                              class="explanation-title"
                            >
                              Explanation
                            </div>

                            <div
                              class="explanation-text"
                            >

                              ${escapeHtml(
                                answer.explanation
                              )}

                            </div>

                          </div>

                        `
                        : ""
                    }


                  </div>

                </article>

              `;
            }
          )
          .join("");
    }


    /* ==========================================
       FILTER BUTTONS
    ========================================== */

    document
      .querySelectorAll(
        ".filter-btn"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              currentFilter =
                button.dataset.filter ||
                "all";


              document
                .querySelectorAll(
                  ".filter-btn"
                )
                .forEach(
                  (btn) => {

                    btn.classList.remove(
                      "active"
                    );

                  }
                );


              button.classList.add(
                "active"
              );


              renderReview();

            }
          );

        }
      );


    /* ==========================================
       LOAD RESULT
    ========================================== */

    async function loadResult() {

      try {

        /* --------------------------------------
           GET ATTEMPT ID
        -------------------------------------- */

        const params =
          new URLSearchParams(
            window.location.search
          );


        const attemptId =
          params.get(
            "attempt_id"
          );


        if (!attemptId) {

          showError(
            "No test attempt was specified."
          );

          return;
        }


        /* --------------------------------------
           GET CURRENT USER
        -------------------------------------- */

        const {
          data: userData,
          error: userError,
        } =
          await supabase.auth.getUser();


        if (
          userError ||
          !userData?.user
        ) {

          window.location.href =
            "/login?redirect=/results?attempt_id=" +
            encodeURIComponent(
              attemptId
            );

          return;
        }


        const userId =
          userData.user.id;


        /* --------------------------------------
           LOAD ATTEMPT
        -------------------------------------- */

        const {
          data: attempt,
          error: attemptError,
        } =
          await supabase

            .from(
              "mock_attempts"
            )

            .select(`
              id,
              user_id,
              test_id,
              started_at,
              submitted_at,
              score,
              correct_count,
              incorrect_count,
              unanswered_count,
              time_taken_seconds,
              status
            `)

            .eq(
              "id",
              attemptId
            )

            .eq(
              "user_id",
              userId
            )

            .maybeSingle();


        if (attemptError) {

          console.error(
            "[Habitat IAS] ATTEMPT ERROR:",
            attemptError
          );


          showError(
            "Unable to load your test result."
          );

          return;
        }


        if (!attempt) {

          showError(
            "Test result not found or you do not have permission to view it."
          );

          return;
        }


        /* --------------------------------------
           CALCULATE SCORE
        -------------------------------------- */

        const correct =
          Number(
            attempt.correct_count || 0
          );


        const incorrect =
          Number(
            attempt.incorrect_count || 0
          );


        const unanswered =
          Number(
            attempt.unanswered_count || 0
          );


        const score =
          Number(
            attempt.score || 0
          );


        const totalQuestions =
          correct +
          incorrect +
          unanswered;


        const marksPerQuestion =
          2;


        const totalMarks =
          totalQuestions *
          marksPerQuestion;


        const percentage =
          totalMarks > 0
            ? (
                score /
                totalMarks
              ) * 100
            : 0;


        /* --------------------------------------
           DISPLAY RESULT SUMMARY
        -------------------------------------- */

        scoreEl.textContent =
          score.toFixed(0);


        totalMarksEl.textContent =
          totalMarks.toFixed(0);


        percentageEl.textContent =
          percentage.toFixed(2) +
          "%";


        correctEl.textContent =
          correct;


        incorrectEl.textContent =
          incorrect;


        unansweredEl.textContent =
          unanswered;


        statusEl.textContent =
          attempt.status ||
          "submitted";


        timeUsedEl.textContent =
          formatTime(
            attempt.time_taken_seconds
          );


        submittedAtEl.textContent =
          formatDate(
            attempt.submitted_at
          );


        attemptIdEl.textContent =
          attempt.id;


        resultTitleEl.textContent =
          "Test Result";


        /* ======================================
           LOAD ALL QUESTIONS FOR THIS TEST

           THIS IS THE IMPORTANT FIX.

           We load from mock_questions instead
           of relying only on mock_answers.

           Therefore all 100 questions appear.
        ====================================== */

        const {
          data: questions,
          error: questionsError,
        } =
          await supabase

            .from(
              "mock_questions"
            )

            .select(`
              id,
              test_id,
              question_number,
              question_text,
              option_a,
              option_b,
              option_c,
              option_d,
              correct_option,
              explanation,
              subject,
              topic,
              difficulty,
              marks,
              negative_marks
            `)

            .eq(
              "test_id",
              attempt.test_id
            )

            .order(
              "question_number",
              {
                ascending: true,
              }
            );


        if (questionsError) {

          console.error(
            "[Habitat IAS] QUESTIONS ERROR:",
            questionsError
          );


          reviewAnswers = [];


          reviewList.innerHTML = `

            <div class="empty-review">

              Unable to load the test questions.

              <br />

              Please check the
              <strong>mock_questions</strong>
              table permissions.

            </div>

          `;

        } else {

          /* ====================================
             LOAD ANSWERS FOR THIS ATTEMPT
          ==================================== */

          const {
            data: answers,
            error: answersError,
          } =
            await supabase

              .from(
                "mock_answers"
              )

              .select(`
                id,
                attempt_id,
                question_id,
                selected_option,
                is_correct,
                answered_at
              `)

              .eq(
                "attempt_id",
                attempt.id
              );


          if (answersError) {

            console.error(
              "[Habitat IAS] ANSWERS ERROR:",
              answersError
            );


            reviewAnswers = [];


            reviewList.innerHTML = `

              <div class="empty-review">

                Unable to load your submitted answers.

              </div>

            `;

          } else {

            /* ==================================
               CREATE ANSWER LOOKUP MAP
            ================================== */

            const answerMap =
              new Map();


            (answers || [])
              .forEach(
                (answer) => {

                  answerMap.set(
                    String(
                      answer.question_id
                    ),
                    answer
                  );

                }
              );


            /* ==================================
               COMBINE QUESTIONS + ANSWERS

               Every question is retained.

               If an answer doesn't exist,
               selected_option = null.

               That means unanswered.
            ================================== */

            reviewAnswers =
              (questions || [])
                .map(
                  (
                    question,
                    index
                  ) => {

                    const savedAnswer =
                      answerMap.get(
                        String(
                          question.id
                        )
                      );


                    return {

                      /* Question data */

                      question_id:
                        question.id,

                      question_number:
                        question.question_number ||
                        index + 1,

                      question_text:
                        question.question_text,

                      option_a:
                        question.option_a,

                      option_b:
                        question.option_b,

                      option_c:
                        question.option_c,

                      option_d:
                        question.option_d,

                      correct_option:
                        question.correct_option,

                      explanation:
                        question.explanation,

                      subject:
                        question.subject,

                      topic:
                        question.topic,

                      difficulty:
                        question.difficulty,

                      marks:
                        question.marks,

                      negative_marks:
                        question.negative_marks,


                      /* Answer data */

                      attempt_id:
                        attempt.id,

                      selected_option:
                        savedAnswer
                          ? savedAnswer.selected_option
                          : null,

                      is_correct:
                        savedAnswer
                          ? savedAnswer.is_correct
                          : false,

                      answered_at:
                        savedAnswer
                          ? savedAnswer.answered_at
                          : null,

                    };

                  }
                );


            /* ==================================
               RENDER ALL QUESTIONS
            ================================== */

            renderReview();

          }

        }


        /* --------------------------------------
           SHOW PAGE
        -------------------------------------- */

        loading.style.display =
          "none";


        errorBox.style.display =
          "none";


        resultContent.style.display =
          "block";


        /* --------------------------------------
           DEBUG INFORMATION
        -------------------------------------- */

        console.log(
          "[Habitat IAS] RESULT LOADED",
          {

            attemptId:
              attempt.id,

            testId:
              attempt.test_id,

            score,

            correct,

            incorrect,

            unanswered,

            totalQuestions,

            totalMarks,

            percentage,

            questionRecords:
              reviewAnswers.length,

            expectedQuestions:
              100,

          }
        );


      } catch (err) {

        console.error(
          "[Habitat IAS] RESULT EXCEPTION:",
          err
        );


        showError(
          "Unexpected error while loading the result."
        );

      }

    }


    /* ==========================================
       START
    ========================================== */

    loadResult();

  </script>

</body>

</html>