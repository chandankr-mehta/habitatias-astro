/* =========================================================
   MERGE DATABASE DATA WITH FALLBACK STRUCTURE
========================================================= */

const tests = testStructure.map((fallback) => {

  const dbTest =
    (dbTests || []).find(
      (item) =>
        Number(item.test_number) ===
        fallback.number
    );

  return {

    ...fallback,

    id:
      dbTest?.id ??
      fallback.number,

    title:
      dbTest?.title ||
      fallback.title,

    description:
      dbTest?.description ||
      fallback.description,

    questions:
      Number(
        dbTest?.question_count ??
        dbTest?.questions ??
        fallback.questions
      ),

    duration:
      Number(
        dbTest?.duration_minutes ??
        dbTest?.duration ??
        fallback.duration
      ),

    marks:
      Number(
        dbTest?.maximum_marks ??
        dbTest?.marks ??
        fallback.marks
      ),

    topics:
      dbTest?.topics ||
      fallback.topics,

    level:
      dbTest?.difficulty ||
      fallback.level,

    /*
      These are intentionally flexible.
      If your Supabase table later contains an
      availability/release field, the dashboard can
      use it without changing the test structure.
    */

    availableFrom:
      dbTest?.available_from ??
      dbTest?.release_at ??
      dbTest?.release_date ??
      dbTest?.start_at ??
      null

  };

});


/* =========================================================
   GROUPS
========================================================= */

const gsTests =
  tests.filter(
    (test) =>
      test.number >= 1 &&
      test.number <= 5
  );

const jharkhandTests =
  tests.filter(
    (test) =>
      test.number >= 6 &&
      test.number <= 10
  );

const paper1Tests =
  tests.filter(
    (test) =>
      test.number >= 11 &&
      test.number <= 15
  );

const paper2Tests =
  tests.filter(
    (test) =>
      test.number >= 16 &&
      test.number <= 20
  );


const totalTests = tests.length;


/* =========================================================
   PHASE DEFINITIONS
========================================================= */

const groups = [

