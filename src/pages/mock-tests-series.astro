========================================================= */


/* =========================================================
   LOAD TESTS FROM SUPABASE
========================================================= */

const {
  data: dbTests,
  error: dbError
} = await supabase
  .from("mock_tests")
  .select("*")
  .order("test_number", {
    ascending: true
  });

if (dbError) {
  console.error(
    "Could not load mock tests:",
    dbError
  );
}


