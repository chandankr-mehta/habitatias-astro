---
const bookLink = "https://linktr.ee/HabitatIAS";

const sampleBook =
  "https://drive.google.com/file/d/1qy_Im2Qs9Z7pwpYGUn7QSHOlJ4cwO5a5/view?usp=sharing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="JPSC Prelims question trends and topic-wise analysis. Explore Current Affairs and Environment trends from JPSC previous year questions."
    />

    <meta
      name="keywords"
      content="JPSC trends, JPSC PYQ analysis, JPSC current affairs trend, JPSC environment questions, JPSC prelims analysis, Habitat IAS"
    />

    <title>JPSC Trends & Analysis | Habitat IAS</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family:
          Arial,
          Helvetica,
          sans-serif;
        background: #f5f7fb;
        color: #172033;
        line-height: 1.6;
      }

      a {
        text-decoration: none;
      }

      /* =========================
         NAVIGATION
      ========================= */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.97);
        border-bottom: 1px solid #e5e9f2;
        backdrop-filter: blur(10px);
      }

      .nav {
        max-width: 1280px;
        margin: 0 auto;
        min-height: 82px;
        padding: 14px 28px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 12px;

        color: #1657d9;
        font-size: 25px;
        font-weight: 800;
        white-space: nowrap;
      }

      .logo-mark {
        width: 48px;
        height: 48px;

        border-radius: 13px;

        background: #1657d9;
        color: white;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 25px;
        font-weight: 800;

        box-shadow:
          0 8px 20px rgba(22, 87, 217, 0.2);
      }

      .nav-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        gap: 23px;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: #44506a;
        font-size: 15px;
        font-weight: 700;

        transition: 0.2s ease;
      }

      .nav-links a:hover {
        color: #1657d9;
      }

      .nav-cta {
        background: #1657d9;
        color: white !important;

        padding: 13px 20px;
        border-radius: 10px;
      }

      .nav-cta:hover {
        background: #0d46ba;
      }

      /* =========================
         HERO
      ========================= */

      .trends-hero {
        background:
          linear-gradient(
            135deg,
            #102f82 0%,
            #1657d9 55%,
            #2d72e8 100%
          );

        color: white;

        padding: 85px 28px 100px;
      }

      .trends-hero-inner {
        max-width: 1050px;
        margin: 0 auto;
        text-align: center;
      }

      .eyebrow {
        display: inline-block;

        border: 1px solid rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.1);

        border-radius: 999px;

        padding: 8px 17px;

        font-size: 13px;
        font-weight: 800;

        letter-spacing: 0.7px;

        margin-bottom: 20px;
      }

      .trends-hero h1 {
        font-size: clamp(44px, 6vw, 76px);
        line-height: 1.02;
        font-weight: 900;

        margin-bottom: 22px;
      }

      .trends-hero h1 span {
        color: #ffd43b;
      }

      .trends-hero p {
        max-width: 800px;
        margin: 0 auto;

        font-size: 19px;

        color: rgba(255, 255, 255, 0.9);
      }

      /* =========================
         MAIN
      ========================= */

      .trends-main {
        max-width: 1200px;
        margin: -65px auto 0;

        position: relative;
        z-index: 5;

        padding: 0 22px 80px;
      }

      /* =========================
         INTRO
      ========================= */

      .intro-card {
        background: white;

        border-radius: 22px;

        padding: 35px 40px;

        box-shadow:
          0 20px 60px rgba(20, 42, 85, 0.12);

        margin-bottom: 35px;

        text-align: center;
      }

      .intro-card h2 {
        color: #14213d;

        font-size: 34px;
        line-height: 1.15;

        margin-bottom: 12px;
      }

      .intro-card p {
        max-width: 800px;
        margin: 0 auto;

        color: #68748a;
        font-size: 16px;
      }

      /* =========================
         SECTION HEADER
      ========================= */

      .trend-section {
        background: white;

        border-radius: 22px;

        padding: 38px;

        margin-bottom: 35px;

        box-shadow:
          0 15px 45px rgba(20, 42, 85, 0.09);
      }

      .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 28px;
      }

      .section-heading-left .label {
        color: #1657d9;

        font-size: 13px;
        font-weight: 900;

        letter-spacing: 1px;

        margin-bottom: 7px;
      }

      .section-heading-left h2 {
        color: #14213d;

        font-size: 34px;
        line-height: 1.1;
      }

      .section-heading-left p {
        color: #68748a;

        margin-top: 8px;

        max-width: 720px;
      }

      .question-badge {
        background: #eaf1ff;

        color: #1657d9;

        border-radius: 999px;

        padding: 10px 17px;

        font-size: 14px;
        font-weight: 900;

        white-space: nowrap;
      }

      /* =========================
         STAT CARDS
      ========================= */

      .stats-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 16px;

        margin-bottom: 30px;
      }

      .stat-card {
        background: #f7f9fd;

        border: 1px solid #e3e9f4;

        border-radius: 15px;

        padding: 24px;

        text-align: center;
      }

      .stat-number {
        color: #1657d9;

        font-size: 38px;
        line-height: 1;

        font-weight: 900;

        margin-bottom: 8px;
      }

      .stat-title {
        color: #172033;

        font-size: 15px;
        font-weight: 800;
      }

      .stat-description {
        color: #748096;

        font-size: 13px;

        margin-top: 4px;
      }

      /* =========================
         TREND IMAGE
      ========================= */

      .trend-image-wrapper {
        background: #fafbfe;

        border: 1px solid #e2e7f0;

        border-radius: 16px;

        padding: 18px;

        overflow: hidden;

        margin-bottom: 25px;
      }

      .trend-image {
        width: 100%;
        height: auto;

        display: block;

        border-radius: 10px;
      }

      .image-caption {
        text-align: center;

        color: #748096;

        font-size: 13px;

        margin-top: 12px;
      }

      /* =========================
         INTERPRETATION
      ========================= */

      .interpretation {
        background:
          linear-gradient(
            135deg,
            #f1f6ff,
            #f8fbff
          );

        border: 1px solid #dce7fb;

        border-radius: 16px;

        padding: 27px;
      }

      .interpretation h3 {
        color: #14213d;

        font-size: 21px;

        margin-bottom: 12px;
      }

      .interpretation p {
        color: #536078;

        font-size: 15px;

        line-height: 1.75;
      }

      .highlight {
        color: #1657d9;
        font-weight: 800;
      }

      /* =========================
         LOCKED SECTION
      ========================= */

      .locked-section {
        position: relative;

        background:
          linear-gradient(
            135deg,
            #111f3d,
            #172c57
          );

        color: white;

        border-radius: 22px;

        padding: 55px 40px;

        margin-top: 10px;

        text-align: center;

        overflow: hidden;
      }

      .locked-section::before {
        content: "";

        position: absolute;

        width: 300px;
        height: 300px;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.04);

        top: -150px;
        right: -80px;
      }

      .lock-icon {
        width: 62px;
        height: 62px;

        margin: 0 auto 18px;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.1);

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 28px;
      }

      .locked-section h2 {
        position: relative;

        font-size: 34px;

        margin-bottom: 13px;
      }

      .locked-section > p {
        position: relative;

        max-width: 760px;

        margin: 0 auto 28px;

        color: rgba(255, 255, 255, 0.8);
      }

      /* =========================
         LOCKED TOPICS
      ========================= */

      .locked-topics {
        position: relative;

        max-width: 900px;

        margin: 0 auto 30px;

        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 10px;
      }

      .locked-topic {
        background: rgba(255, 255, 255, 0.08);

        border: 1px solid rgba(255, 255, 255, 0.12);

        border-radius: 10px;

        padding: 13px;

        color: #eef3ff;

        font-size: 14px;
        font-weight: 700;
      }

      .locked-topic span {
        opacity: 0.6;

        margin-right: 5px;
      }

      /* =========================
         PURCHASE CTA
      ========================= */

      .purchase-button {
        position: relative;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        background: #ffd43b;

        color: #14213d;

        padding: 14px 25px;

        border-radius: 10px;

        font-size: 16px;

        font-weight: 900;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .purchase-button:hover {
        transform: translateY(-2px);

        box-shadow:
          0 10px 25px rgba(0, 0, 0, 0.18);
      }

      .price-note {
        position: relative;

        margin-top: 12px;

        color: rgba(255, 255, 255, 0.65);

        font-size: 13px;
      }

      /* =========================
         SAMPLE CTA
      ========================= */

      .sample-box {
        background: white;

        border: 1px solid #e3e8f1;

        border-radius: 18px;

        padding: 30px;

        margin-top: 30px;

        text-align: center;
      }

      .sample-box h3 {
        color: #14213d;

        font-size: 23px;

        margin-bottom: 8px;
      }

      .sample-box p {
        color: #68748a;

        margin-bottom: 18px;
      }

      .sample-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        border: 1px solid #1657d9;

        color: #1657d9;

        background: white;

        padding: 12px 20px;

        border-radius: 10px;

        font-weight: 800;

        transition: 0.2s ease;
      }

      .sample-button:hover {
        background: #edf3ff;
      }

      /* =========================
         FOOTER
      ========================= */

      .footer {
        background: #101a2d;

        color: white;

        padding: 50px 28px;
      }

      .footer-inner {
        max-width: 1180px;

        margin: 0 auto;

        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 30px;
      }

      .footer-brand {
        font-size: 23px;
        font-weight: 900;

        margin-bottom: 4px;
      }

      .footer small {
        color: #9da8bb;
      }

      .footer-links {
        display: flex;

        flex-wrap: wrap;

        gap: 20px;
      }

      .footer-links a {
        color: #d6dce8;

        font-size: 14px;
        font-weight: 600;
      }

      .footer-links a:hover {
        color: white;
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 900px) {

        .nav {
          flex-direction: column;

          padding: 16px 20px;
        }

        .nav-links {
          justify-content: center;

          gap: 14px 18px;
        }

        .stats-grid {
          grid-template-columns: 1fr;
        }

        .locked-topics {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .section-heading {
          align-items: flex-start;

          flex-direction: column;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 600px) {

        .trends-hero {
          padding: 55px 20px 90px;
        }

        .trends-main {
          padding-left: 14px;
          padding-right: 14px;
        }

        .intro-card,
        .trend-section {
          padding: 25px 20px;
        }

        .section-heading-left h2 {
          font-size: 28px;
        }

        .question-badge {
          white-space: normal;
        }

        .locked-section {
          padding: 40px 20px;
        }

        .locked-topics {
          grid-template-columns: 1fr;
        }

        .footer-inner {
          flex-direction: column;

          text-align: center;
        }

        .footer-links {
          justify-content: center;
        }

        .nav-links a {
          font-size: 13px;
        }
      }
    </style>
  </head>

  <body>

    <!-- =========================
         HEADER
    ========================= -->

    <header class="site-header">

      <nav class="nav">

        <a href="/" class="logo">
          <span class="logo-mark">H</span>
          Habitat IAS
        </a>

        <div class="nav-links">

          <a href="/">Home</a>

          <a href="/notes/">Notes</a>

          <a href="/pyq/">JPSC PYQ</a>

          <a href="/book/">Book</a>

          <a href="/guidance/">Guidance</a>

          <a href="/trends/">Trends</a>

          <a href="/mock-tests/">Mock Tests</a>

          <a href="/jharkhand/">Jharkhand</a>

          <a href="/resources/">Resources</a>

          <a href="/contact/">Contact</a>

          <a
            href={bookLink}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-cta"
          >
            Get the Book
          </a>

        </div>

      </nav>

    </header>


    <!-- =========================
         HERO
    ========================= -->

    <section class="trends-hero">

      <div class="trends-hero-inner">

        <div class="eyebrow">
          JPSC PRELIMS • PYQ TREND ANALYSIS
        </div>

        <h1>
          Understand the
          <span>Exam Trends.</span>
        </h1>

        <p>
          Explore selected JPSC Prelims question trends based on
          topic-wise analysis of previous year questions.
          Detailed subject-wise analysis is available in the book.
        </p>

      </div>

    </section>


    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="trends-main">


      <!-- INTRO -->

      <div class="intro-card">

        <h2>
          JPSC Question Trend Analysis
        </h2>

        <p>
          We have analysed previous year JPSC Prelims questions
          to identify recurring topics, question concentration
          and high-weightage areas. Two sections are available
          below as a preview.
        </p>

      </div>


      <!-- =====================================================
           CURRENT AFFAIRS
      ====================================================== -->

      <section class="trend-section">

        <div class="section-heading">

          <div class="section-heading-left">

            <div class="label">
              GS PAPER-I • SECTION 1
            </div>

            <h2>
              Current Affairs Trend
            </h2>

            <p>
              Topic-wise distribution of Current Affairs questions
              analysed from JPSC Prelims previous year papers.
            </p>

          </div>

          <div class="question-badge">
            115 Questions Analysed
          </div>

        </div>


        <!-- STATISTICS -->

        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-number">
              115
            </div>

            <div class="stat-title">
              Total Questions
            </div>

            <div class="stat-description">
              Questions analysed
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-number">
              24
            </div>

            <div class="stat-title">
              Highest Topic
            </div>

            <div class="stat-description">
              Sports
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-number">
              75.7%
            </div>

            <div class="stat-title">
              Top 5 Topics
            </div>

            <div class="stat-description">
              Share of analysed questions
            </div>

          </div>

        </div>


        <!-- IMAGE -->

        <div class="trend-image-wrapper">

          <img
            src="/current-affairs-trend.jpg"
  alt="JPSC Current Affairs topic-wise question distribution and trend analysis"
  class="trend-image"
  loading="lazy"
  decoding="async"
          />

          <div class="image-caption">
            Current Affairs — Topic-wise JPSC Prelims question distribution
          </div>

        </div>


        <!-- INTERPRETATION -->

        <div class="interpretation">

          <h3>
            Exam Insight
          </h3>

          <p>
            The analysis shows that Current Affairs questions are
            concentrated in a limited number of recurring categories.
            <span class="highlight">
              Sports recorded the highest frequency with 24 questions.
            </span>

            Prizes, Awards & Titles, Person & Species in News,
            Schemes, and Events & Summits were also major recurring
            areas.

            Together, these five categories account for approximately
            <span class="highlight">
              75.7% of the 115 analysed questions.
            </span>

            This indicates that aspirants should prioritise recurring
            current-affairs themes rather than treating the entire
            current-affairs domain uniformly.
          </p>

        </div>

      </section>


      <!-- =====================================================
           ENVIRONMENT
      ====================================================== -->

      <section class="trend-section">

        <div class="section-heading">

          <div class="section-heading-left">

            <div class="label">
              GS PAPER-I • SECTION 10
            </div>

            <h2>
              Environment Trend
            </h2>

            <p>
              Topic-wise distribution of Environment questions
              analysed from JPSC Prelims previous year papers.
            </p>

          </div>

          <div class="question-badge">
            49 Questions Analysed
          </div>

        </div>


        <!-- STATISTICS -->

        <div class="stats-grid">

          <div class="stat-card">

            <div class="stat-number">
              49
            </div>

            <div class="stat-title">
              Total Questions
            </div>

            <div class="stat-description">
              Questions analysed
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-number">
              9
            </div>

            <div class="stat-title">
              Total Topics
            </div>

            <div class="stat-description">
              Environment topics
            </div>

          </div>


          <div class="stat-card">

            <div class="stat-number">
              11
            </div>

            <div class="stat-title">
              Highest Topic
            </div>

            <div class="stat-description">
              Sustainable Development
            </div>

          </div>

        </div>


        <!-- IMAGE -->

        <div class="trend-image-wrapper">

          <img
            src="/environment-trend.jpg"
  alt="JPSC Environment topic-wise question distribution and trend analysis"
  class="trend-image"
  loading="lazy"
  decoding="async"
          />

          <div class="image-caption">
            Environment — Topic-wise JPSC Prelims question distribution
          </div>

        </div>


        <!-- INTERPRETATION -->

        <div class="interpretation">

          <h3>
            Exam Insight
          </h3>

          <p>
            Environment questions are distributed across nine major
            topics, with a total of
            <span class="highlight">
              49 questions analysed.
            </span>

            Sustainable Development recorded the highest frequency
            with
            <span class="highlight">
              11 questions.
            </span>

            Environmental Organisations and Climate Change & Global
            Warming each contributed 7 questions, while Environmental
            Governance and Pollution contributed 6 questions each.

            The distribution indicates that preparation should give
            particular attention to high-frequency themes while
            maintaining coverage of the remaining Environment topics.
          </p>

        </div>

      </section>


      <!-- =====================================================
           LOCKED / PURCHASE SECTION
      ====================================================== -->

      <section class="locked-section">

        <div class="lock-icon">
          🔒
        </div>

        <h2>
          More JPSC Trends Are Available in the Book
        </h2>

        <p>
          The Current Affairs and Environment analysis above is only
          a preview. The complete topic-wise and subject-wise trend
          analysis is included in
          <strong>
            JPSC Prelims Decoded: Topic-Wise PYQs
          </strong>.
        </p>


        <div class="locked-topics">

          <div class="locked-topic">
            <span>🔒</span>
            Polity
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            International Relations
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Science & Technology
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Geography
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            History
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Economy
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Jharkhand Special
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Other GS Topics
          </div>

          <div class="locked-topic">
            <span>🔒</span>
            Complete PYQ Analysis
          </div>

        </div>


        <a
          href={bookLink}
          target="_blank"
          rel="noopener noreferrer"
          class="purchase-button"
        >
          Get the Complete Analysis →
        </a>

        <div class="price-note">
          JPSC Prelims Decoded • ₹299
        </div>

      </section>


      <!-- =====================================================
           SAMPLE BOOK
      ====================================================== -->

      <div class="sample-box">

        <h3>
          Want to see the book before purchasing?
        </h3>

        <p>
          Download the free sample PDF and explore the format,
          explanations and PYQ analysis.
        </p>

        <a
          href={sampleBook}
          target="_blank"
          rel="noopener noreferrer"
          class="sample-button"
        >
          Download Sample Book
        </a>

      </div>


    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer class="footer">

      <div class="footer-inner">

        <div>

          <div class="footer-brand">
            Habitat IAS
          </div>

          <small>
            Focused preparation for JPSC aspirants.
          </small>

        </div>


        <div class="footer-links">

          <a href="/">
            Home
          </a>

          <a href="/notes/">
            Notes
          </a>

          <a href="/pyq/">
            JPSC PYQ
          </a>

          <a href="/book/">
            Book
          </a>

          <a href="/guidance/">
            Guidance
          </a>

          <a href="/contact/">
            Contact
          </a>

        </div>

      </div>

    </footer>

  </body>
</html>