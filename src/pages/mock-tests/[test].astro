---
import { supabase } from "../../lib/supabase";

export const prerender = true;

/* =========================================================
   HABITAT IAS — JPSC PRELIMS CBT
   ========================================================= */

export async function getStaticPaths() {
  const { data, error } = await supabase
    .from("mock_tests")
    .select("id, test_number")
    .order("test_number", { ascending: true });

  if (error) {
    console.error("getStaticPaths error:", error);
    return [];
  }

  return (data ?? [])
    .filter((row) => Number.isInteger(Number(row.test_number)))
    .map((row) => ({
      params: {
        test: String(row.test_number),
      },
    }));
}

const testNumber = Number(Astro.params.test);

if (!Number.isInteger(testNumber) || testNumber < 1) {
  return Astro.redirect("/mock-tests");
}

/* =========================================================
   LOAD TEST
   ========================================================= */

const {
  data: currentTest,
  error: currentTestError,
} = await supabase
  .from("mock_tests")
  .select("*")
  .eq("test_number", testNumber)
  .single();

if (currentTestError || !currentTest) {
  console.error("Test loading error:", currentTestError);
  return Astro.redirect("/mock-tests");
}

/* =========================================================
   LOAD QUESTIONS
   ========================================================= */

const {
  data: questionRows,
  error: questionError,
} = await supabase
  .from("mock_questions")
  .select(`
    id,
    test_id,
    question_number,
    question_text,
    option_a,
    option_b,
    option_c,
    option_d,
    subject,
    topic,
    difficulty,
    image_url
  `)
  .eq("test_id", currentTest.id)
  .order("question_number", {
    ascending: true,
  });

if (questionError) {
  console.error("Question loading error:", questionError);
}

const questions = (questionRows ?? []).map((q: any) => ({
  id: q.id,
  question_number: Number(q.question_number ?? 0),
  question_text: q.question_text ?? "",
  option_a: q.option_a ?? "",
  option_b: q.option_b ?? "",
  option_c: q.option_c ?? "",
  option_d: q.option_d ?? "",
  subject: q.subject ?? "",
  topic: q.topic ?? "",
  difficulty: q.difficulty ?? "",
  image_url: q.image_url ?? null,
}));

/* =========================================================
   TEST SETTINGS
   ========================================================= */

const totalQuestions = questions.length;

const durationMinutes = Number(
  currentTest.duration_minutes ??
  currentTest.duration ??
  120
);

const marksPerQuestion = Number(
  currentTest.marks_per_question ??
  currentTest.positive_marks ??
  2
);

const negativeMarks = Number(
  currentTest.negative_marks ?? 0
);

const maximumMarks =
  totalQuestions * marksPerQuestion;

const testTitle =
  currentTest.title ||
  `Mock Test ${testNumber}`;

const testDescription =
  currentTest.description ||
  "JPSC Prelims Computer Based Test";

const testType =
  currentTest.test_type ||
  currentTest.type ||
  "Sectional";

/* =========================================================
   SAFE DATA FOR BROWSER

   IMPORTANT:
   correct_option is NEVER sent to browser.
   ========================================================= */

const examData = {
  testId: currentTest.id,
  testNumber,
  title: testTitle,
  description: testDescription,
  testType,
  durationMinutes,
  marksPerQuestion,
  negativeMarks,
  maximumMarks,
  totalQuestions,
  questions,
};
---

<!doctype html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="theme-color"
    content="#071a3a"
  />

  <title>
    {testTitle} | Habitat IAS
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #f4f7fb;
      color: #111827;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button {
      font: inherit;
    }

    button:focus-visible {
      outline: 3px solid #93c5fd;
      outline-offset: 2px;
    }

    /* =====================================================
       HEADER
       ===================================================== */

    .exam-header {
      position: sticky;
      top: 0;
      z-index: 1000;

      min-height: 76px;

      display: grid;
      grid-template-columns:
        minmax(220px, 1fr)
        minmax(280px, 1.5fr)
        minmax(250px, 1fr);

      align-items: center;

      gap: 20px;

      padding: 12px 24px;

      background:
        rgba(255,255,255,.97);

      backdrop-filter:
        blur(18px);

      border-bottom:
        1px solid #e5e7eb;

      box-shadow:
        0 4px 18px rgba(15,23,42,.06);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;

      text-decoration: none;

      color: #071a3a;
    }

    .brand-logo {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background:
        linear-gradient(
          135deg,
          #071a3a,
          #123b72
        );

      color: white;

      font-size: 20px;
      font-weight: 900;
    }

    .brand-name {
      display: block;

      font-size: 17px;
      font-weight: 850;
    }

    .brand-subtitle {
      display: block;

      margin-top: 3px;

      color: #64748b;

      font-size: 9px;
      font-weight: 800;

      letter-spacing: .12em;
    }

    .header-center {
      text-align: center;

      min-width: 0;
    }

    .header-title {
      overflow: hidden;

      color: #071a3a;

      font-size: 17px;
      font-weight: 850;

      white-space: nowrap;

      text-overflow: ellipsis;
    }

    .header-subtitle {
      margin-top: 4px;

      color: #64748b;

      font-size: 9px;
      font-weight: 800;

      letter-spacing: .12em;
    }

    .header-actions {
      display: flex;

      justify-content: flex-end;

      align-items: center;

      gap: 7px;
    }

    .icon-button {
      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      border:
        1px solid #dbe2ea;

      border-radius: 10px;

      background: white;

      color: #334155;

      cursor: pointer;
    }

    .icon-button:hover {
      background: #f8fafc;
    }

    /* =====================================================
       TIMER
       ===================================================== */

    .timer {
      min-width: 145px;

      padding:
        9px 13px;

      border:
        1px solid #dbe2ea;

      border-radius: 12px;

      background: white;

      text-align: center;
    }

    .timer-label {
      display: block;

      color: #64748b;

      font-size: 9px;
      font-weight: 800;

      letter-spacing: .12em;

      text-transform: uppercase;
    }

    #timer {
      display: block;

      margin-top: 3px;

      color: #071a3a;

      font-size: 22px;
      font-weight: 900;

      line-height: 1;

      font-variant-numeric:
        tabular-nums;
    }

    .timer.warning {
      border-color: #fecaca;
      background: #fff7f7;
    }

    .timer.warning #timer {
      color: #dc2626;
    }

    .timer.critical {
      animation:
        timerPulse 1s infinite;
    }

    @keyframes timerPulse {
      50% {
        transform: scale(1.025);
      }
    }

    /* =====================================================
       PAGE
       ===================================================== */

    .page {
      width:
        min(1500px, 100%);

      margin: 0 auto;

      padding:
        20px 24px 100px;
    }

    /* =====================================================
       TEST INFORMATION
       ===================================================== */

    .test-info {
      display: flex;

      align-items: center;

      justify-content:
        space-between;

      gap: 20px;

      margin-bottom: 16px;

      padding:
        18px 20px;

      border:
        1px solid #e2e8f0;

      border-radius: 16px;

      background: white;

      box-shadow:
        0 5px 20px rgba(15,23,42,.04);
    }

    .test-info h1 {
      margin: 0;

      color: #071a3a;

      font-size: 20px;
      font-weight: 850;
    }

    .test-description {
      max-width: 850px;

      margin:
        5px 0 0;

      color: #64748b;

      font-size: 13px;

      line-height: 1.55;
    }

    .test-meta {
      display: flex;

      flex-wrap: wrap;

      justify-content: flex-end;

      gap: 7px;
    }

    .meta-pill {
      padding:
        7px 10px;

      border-radius: 999px;

      background: #f1f5f9;

      color: #475569;

      font-size: 10px;

      font-weight: 800;

      white-space: nowrap;
    }

    /* =====================================================
       PROGRESS
       ===================================================== */

    .progress-card {
      margin-bottom: 16px;

      padding:
        14px 16px;

      border:
        1px solid #e2e8f0;

      border-radius: 14px;

      background: white;
    }

    .progress-top {
      display: flex;

      justify-content:
        space-between;

      margin-bottom: 8px;

      color: #475569;

      font-size: 12px;
      font-weight: 750;
    }

    .progress-track {
      height: 7px;

      overflow: hidden;

      border-radius: 999px;

      background: #e2e8f0;
    }

    .progress-fill {
      width: 0;

      height: 100%;

      border-radius: inherit;

      background:
        linear-gradient(
          90deg,
          #2563eb,
          #3b82f6
        );

      transition:
        width .2s ease;
    }

    /* =====================================================
       MAIN GRID
       ===================================================== */

    .exam-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        330px;

      gap: 18px;

      align-items: start;
    }

    /* =====================================================
       QUESTION CARD
       ===================================================== */

    .question-card {
      overflow: hidden;

      border:
        1px solid #e2e8f0;

      border-radius: 18px;

      background: white;

      box-shadow:
        0 8px 28px rgba(15,23,42,.05);
    }

    .question-head {
      display: flex;

      align-items: center;

      justify-content:
        space-between;

      gap: 14px;

      padding:
        16px 20px;

      border-bottom:
        1px solid #edf1f5;
    }

    .question-number {
      display: flex;

      align-items: center;

      gap: 9px;

      color: #071a3a;

      font-size: 14px;
      font-weight: 850;
    }

    .question-number-badge {
      min-width: 36px;
      height: 36px;

      display: grid;

      place-items: center;

      border-radius: 10px;

      background: #071a3a;

      color: white;

      font-size: 14px;
      font-weight: 900;
    }

    .question-tags {
      display: flex;

      flex-wrap: wrap;

      justify-content:
        flex-end;

      gap: 6px;
    }

    .tag {
      padding:
        5px 8px;

      border-radius: 7px;

      background: #f1f5f9;

      color: #64748b;

      font-size: 10px;
      font-weight: 800;
    }

    .question-body {
      padding:
        26px 24px 20px;
    }

    .question-text {
      color: #111827;

      font-size: 18px;

      font-weight: 650;

      line-height: 1.7;
    }

    .question-image {
      display: block;

      max-width: 100%;
      max-height: 430px;

      margin:
        20px auto 0;

      border:
        1px solid #e2e8f0;

      border-radius: 12px;

      object-fit: contain;
    }

    /* =====================================================
       OPTIONS
       ===================================================== */

    .options {
      display: grid;

      gap: 11px;

      margin-top: 25px;
    }

    .option {
      width: 100%;

      display: grid;

      grid-template-columns:
        38px 1fr;

      align-items: center;

      gap: 13px;

      padding:
        14px 15px;

      border:
        1px solid #dbe3ec;

      border-radius: 13px;

      background: white;

      color: #334155;

      text-align: left;

      cursor: pointer;

      transition:
        .15s ease;
    }

    .option:hover {
      border-color: #93c5fd;

      background: #f8fbff;

      transform:
        translateY(-1px);
    }

    .option.selected {
      border-color: #2563eb;

      background: #eff6ff;

      box-shadow:
        0 0 0 2px
        rgba(37,99,235,.08);
    }

    .option-key {
      width: 34px;
      height: 34px;

      display: grid;

      place-items: center;

      border:
        1px solid #cbd5e1;

      border-radius: 9px;

      background: #f8fafc;

      color: #475569;

      font-size: 13px;
      font-weight: 900;
    }

    .option.selected .option-key {
      border-color: #2563eb;

      background: #2563eb;

      color: white;
    }

    .option-text {
      font-size: 14px;

      line-height: 1.55;
    }

    /* =====================================================
       ACTIONS
       ===================================================== */

    .question-actions {
      display: flex;

      justify-content:
        space-between;

      align-items: center;

      gap: 10px;

      padding:
        15px 20px;

      border-top:
        1px solid #edf1f5;

      background: #fbfcfe;
    }

    .left-actions,
    .right-actions {
      display: flex;

      gap: 8px;

      flex-wrap: wrap;
    }

    .btn {
      min-height: 40px;

      padding:
        9px 14px;

      border:
        1px solid #dbe2ea;

      border-radius: 9px;

      background: white;

      color: #334155;

      font-size: 12px;

      font-weight: 800;

      cursor: pointer;
    }

    .btn:hover:not(:disabled) {
      background: #f8fafc;

      border-color: #aab8c9;
    }

    .btn:disabled {
      opacity: .45;

      cursor: not-allowed;
    }

    .btn-primary {
      border-color: #2563eb;

      background: #2563eb;

      color: white;
    }

    .btn-primary:hover:not(:disabled) {
      background: #1d4ed8;
    }

    .btn-review {
      border-color: #c4b5fd;

      background: #f5f3ff;

      color: #6d28d9;
    }

    .btn-danger {
      border-color: #fecaca;

      background: #fff7f7;

      color: #dc2626;
    }

    /* =====================================================
       SIDEBAR
       ===================================================== */

    .sidebar {
      position: sticky;

      top: 96px;

      display: grid;

      gap: 14px;
    }

    .side-card {
      padding: 17px;

      border:
        1px solid #e2e8f0;

      border-radius: 16px;

      background: white;

      box-shadow:
        0 7px 24px rgba(15,23,42,.04);
    }

    .side-title {
      display: flex;

      align-items: center;

      justify-content:
        space-between;

      margin-bottom: 14px;

      color: #071a3a;

      font-size: 13px;
      font-weight: 900;
    }

    /* =====================================================
       TALLY
       ===================================================== */

    .tally {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 8px;
    }

    .tally-item {
      padding: 11px;

      border-radius: 10px;

      background: #f8fafc;
    }

    .tally-value {
      display: block;

      color: #071a3a;

      font-size: 20px;

      font-weight: 900;
    }

    .tally-label {
      display: block;

      margin-top: 2px;

      color: #64748b;

      font-size: 9px;

      font-weight: 800;

      text-transform: uppercase;
    }

    /* =====================================================
       PALETTE
       ===================================================== */

    .palette {
      display: grid;

      grid-template-columns:
        repeat(8, 1fr);

      gap: 7px;

      max-height: 390px;

      overflow-y: auto;
    }

    .palette-button {
      aspect-ratio: 1;

      display: grid;

      place-items: center;

      border:
        1px solid #dbe2ea;

      border-radius: 8px;

      background: #f8fafc;

      color: #64748b;

      font-size: 11px;

      font-weight: 850;

      cursor: pointer;
    }

    .palette-button.current {
      outline:
        3px solid #1e3a8a;

      outline-offset: 1px;
    }

    .palette-button.not-visited {
      background: #f8fafc;

      color: #64748b;
    }

    .palette-button.not-answered {
      background: #ef4444;

      border-color: #ef4444;

      color: white;
    }

    .palette-button.answered {
      background: #16a34a;

      border-color: #16a34a;

      color: white;
    }

    .palette-button.review {
      background: #7c3aed;

      border-color: #7c3aed;

      color: white;
    }

    .palette-button.review-answered {
      border-color: #7c3aed;

      background:
        linear-gradient(
          135deg,
          #16a34a 0 52%,
          #7c3aed 52% 100%
        );

      color: white;
    }

    /* =====================================================
       LEGEND
       ===================================================== */

    .legend {
      display: grid;

      gap: 9px;

      margin-top: 15px;
    }

    .legend-item {
      display: flex;

      align-items: center;

      gap: 8px;

      color: #64748b;

      font-size: 11px;

      font-weight: 700;
    }

    .legend-dot {
      width: 16px;
      height: 16px;

      flex:
        0 0 16px;

      border:
        1px solid #dbe2ea;

      border-radius: 5px;

      background: #f8fafc;
    }

    .legend-dot.red {
      background: #ef4444;
      border-color: #ef4444;
    }

    .legend-dot.green {
      background: #16a34a;
      border-color: #16a34a;
    }

    .legend-dot.purple {
      background: #7c3aed;
      border-color: #7c3aed;
    }

    /* =====================================================
       SUBMIT
       ===================================================== */

    .submit-card {
      border-color: #bfdbfe;

      background:
        linear-gradient(
          145deg,
          #eff6ff,
          #fff
        );
    }

    .submit-card p {
      margin:
        0 0 13px;

      color: #64748b;

      font-size: 11px;

      line-height: 1.5;
    }

    .submit-button {
      width: 100%;

      min-height: 45px;

      border: 0;

      border-radius: 10px;

      background: #071a3a;

      color: white;

      font-size: 13px;

      font-weight: 900;

      cursor: pointer;
    }

    .submit-button:disabled {
      opacity: .55;

      cursor: wait;
    }

    /* =====================================================
       FONT CONTROL
       ===================================================== */

    .font-control {
      display: flex;

      align-items: center;

      justify-content:
        space-between;

      gap: 8px;
    }

    .font-control span {
      color: #64748b;

      font-size: 11px;

      font-weight: 750;
    }

    .font-buttons {
      display: flex;

      gap: 5px;
    }

    .font-buttons button {
      width: 32px;
      height: 30px;

      border:
        1px solid #dbe2ea;

      border-radius: 7px;

      background: white;

      cursor: pointer;
    }

    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .empty-state {
      padding: 70px 20px;

      text-align: center;

      border:
        1px solid #e2e8f0;

      border-radius: 18px;

      background: white;
    }

    .empty-state h2 {
      margin:
        0 0 8px;

      color: #071a3a;
    }

    .empty-state p {
      color: #64748b;
    }

    /* =====================================================
       MODALS
       ===================================================== */

    .overlay {
      position: fixed;

      inset: 0;

      z-index: 3000;

      display: none;

      place-items: center;

      padding: 20px;

      background:
        rgba(7,26,58,.58);

      backdrop-filter:
        blur(7px);
    }

    .overlay.visible {
      display: grid;
    }

    .modal {
      width:
        min(560px,100%);

      max-height: 90vh;

      overflow-y: auto;

      padding: 25px;

      border-radius: 20px;

      background: white;

      box-shadow:
        0 25px 70px rgba(0,0,0,.25);
    }

    .modal h2 {
      margin: 0;

      color: #071a3a;

      font-size: 21px;
    }

    .modal p {
      color: #64748b;

      line-height: 1.6;
    }

    .confirm-stats {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 8px;

      margin:
        18px 0;
    }

    .confirm-stat {
      padding:
        12px 8px;

      border-radius: 10px;

      background: #f8fafc;

      text-align: center;
    }

    .confirm-stat strong {
      display: block;

      color: #071a3a;

      font-size: 20px;
    }

    .confirm-stat span {
      color: #64748b;

      font-size: 9px;

      font-weight: 800;

      text-transform: uppercase;
    }

    .modal-actions {
      display: flex;

      justify-content:
        flex-end;

      gap: 8px;
    }

    /* =====================================================
       RESULT
       ===================================================== */

    .result-modal {
      width:
        min(760px,100%);
    }

    .result-hero {
      padding: 22px;

      border-radius: 16px;

      background:
        linear-gradient(
          135deg,
          #071a3a,
          #123b72
        );

      color: white;
    }

    .result-hero-label {
      font-size: 10px;

      font-weight: 800;

      letter-spacing: .12em;

      text-transform: uppercase;

      opacity: .75;
    }

    .result-score {
      margin-top: 7px;

      font-size: 38px;

      font-weight: 950;
    }

    .result-percentage {
      margin-top: 2px;

      font-size: 14px;

      opacity: .85;
    }

    .result-grid {
      display: grid;

      grid-template-columns:
        repeat(4,1fr);

      gap: 8px;

      margin-top: 14px;
    }

    .result-box {
      padding: 14px;

      border-radius: 11px;

      background: #f8fafc;
    }

    .result-box strong {
      display: block;

      color: #071a3a;

      font-size: 22px;
    }

    .result-box span {
      color: #64748b;

      font-size: 9px;

      font-weight: 800;

      text-transform: uppercase;
    }

    /* =====================================================
       MOBILE
       ===================================================== */

    .mobile-palette-toggle {
      display: none;

      position: fixed;

      right: 15px;
      bottom: 78px;

      z-index: 1500;

      width: 50px;
      height: 50px;

      border: 0;

      border-radius: 50%;

      background: #071a3a;

      color: white;

      box-shadow:
        0 8px 25px
        rgba(7,26,58,.28);

      cursor: pointer;
    }

    .mobile-footer {
      display: none;

      position: fixed;

      left: 0;
      right: 0;
      bottom: 0;

      z-index: 1400;

      padding: 8px 10px;

      background:
        rgba(255,255,255,.96);

      backdrop-filter:
        blur(16px);

      border-top:
        1px solid #e2e8f0;

      box-shadow:
        0 -5px 20px
        rgba(15,23,42,.07);
    }

    .mobile-footer-inner {
      display: grid;

      grid-template-columns:
        1fr 1.4fr 1fr;

      gap: 7px;
    }

    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media(max-width:1050px) {

      .exam-header {
        grid-template-columns:
          1fr auto;
      }

      .header-center {
        display: none;
      }

      .exam-grid {
        grid-template-columns:
          minmax(0,1fr)
          290px;
      }

    }

    @media(max-width:800px) {

      .page {
        padding:
          12px 10px 90px;
      }

      .exam-grid {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: fixed;

        top: 0;
        right: -360px;
        bottom: 0;

        z-index: 2500;

        width:
          min(350px,92vw);

        padding: 15px;

        overflow-y: auto;

        background: #f4f7fb;

        box-shadow:
          -10px 0 35px
          rgba(0,0,0,.15);

        transition:
          right .22s ease;
      }

      .sidebar.open {
        right: 0;
      }

      .mobile-palette-toggle {
        display: grid;

        place-items: center;
      }

      .mobile-footer {
        display: block;
      }

      .question-body {
        padding:
          20px 15px;
      }

      .question-text {
        font-size: 16px;
      }

      .question-actions {
        display: none;
      }

      .test-info {
        display: block;

        padding: 15px;
      }

      .test-meta {
        justify-content:
          flex-start;

        margin-top: 12px;
      }

      .exam-header {
        min-height: 64px;

        padding:
          8px 12px;
      }

      .brand-subtitle {
        display: none;
      }

      .timer {
        min-width: 115px;
      }

      #timer {
        font-size: 19px;
      }

      .question-tags {
        display: none;
      }

      .result-grid,
      .confirm-stats {
        grid-template-columns:
          repeat(2,1fr);
      }

    }

    @media(max-width:480px) {

      .brand-name {
        font-size: 14px;
      }

      .brand-logo {
        width: 36px;
        height: 36px;
      }

      .timer {
        min-width: 100px;
      }

      #timer {
        font-size: 17px;
      }

      .option {
        grid-template-columns:
          32px 1fr;

        padding: 12px;
      }

      .option-key {
        width: 30px;
        height: 30px;
      }

      .option-text {
        font-size: 13px;
      }

      .palette {
        grid-template-columns:
          repeat(7,1fr);
      }

    }

  </style>

</head>

<body>

  <!-- =====================================================
       HEADER
       ===================================================== -->

  <header class="exam-header">

    <a
      href="/mock-tests"
      class="brand"
    >

      <span class="brand-logo">
        H
      </span>

      <span>

        <span class="brand-name">
          Habitat IAS
        </span>

        <span class="brand-subtitle">
          CIVIL SERVICES PREPARATION
        </span>

      </span>

    </a>

    <div class="header-center">

      <div
        class="header-title"
        title={testTitle}
      >
        {testTitle}
      </div>

      <div class="header-subtitle">
        JPSC PRELIMS • COMPUTER BASED TEST
      </div>

    </div>

    <div class="header-actions">

      <button
        id="fontDown"
        class="icon-button"
        type="button"
        title="Decrease text size"
      >
        A−
      </button>

      <button
        id="fontUp"
        class="icon-button"
        type="button"
        title="Increase text size"
      >
        A+
      </button>

      <button
        id="fullscreenButton"
        class="icon-button"
        type="button"
        title="Fullscreen"
      >
        ⛶
      </button>

      <div
        id="timerBox"
        class="timer"
      >

        <span class="timer-label">
          Time Left
        </span>

        <span id="timer">
          {String(durationMinutes).padStart(2,"0")}:00
        </span>

      </div>

    </div>

  </header>


  <!-- =====================================================
       MAIN
       ===================================================== -->

  <main class="page">

    <section class="test-info">

      <div>

        <h1>
          {testTitle}
        </h1>

        <p class="test-description">
          {testDescription}
        </p>

      </div>

      <div class="test-meta">

        <span class="meta-pill">
          {totalQuestions} Questions
        </span>

        <span class="meta-pill">
          {durationMinutes} Minutes
        </span>

        <span class="meta-pill">
          +{marksPerQuestion} Correct
        </span>

        <span class="meta-pill">
          −{negativeMarks} Wrong
        </span>

        <span class="meta-pill">
          {testType}
        </span>

      </div>

    </section>


    {totalQuestions > 0 && (

      <section class="progress-card">

        <div class="progress-top">

          <span id="progressText">
            Question 1 of {totalQuestions}
          </span>

          <span id="progressPercent">
            0% answered
          </span>

        </div>

        <div class="progress-track">

          <div
            id="progressFill"
            class="progress-fill"
          ></div>

        </div>

      </section>

    )}


    {totalQuestions === 0 ? (

      <section class="empty-state">

        <h2>
          No Questions Available
        </h2>

        <p>
          Questions for this mock test have not been added yet.
        </p>

      </section>

    ) : (

      <div class="exam-grid">

        <!-- QUESTION -->

        <section class="question-card">

          <div class="question-head">

            <div class="question-number">

              <span
                id="questionNumberBadge"
                class="question-number-badge"
              >
                1
              </span>

              <span>
                Current Question
              </span>

            </div>

            <div
              id="questionTags"
              class="question-tags"
            ></div>

          </div>


          <div
            id="questionBody"
            class="question-body"
          ></div>


          <div class="question-actions">

            <div class="left-actions">

              <button
                id="previousButton"
                class="btn"
                type="button"
              >
                ← Previous
              </button>

              <button
                id="clearButton"
                class="btn btn-danger"
                type="button"
              >
                Clear Response
              </button>

            </div>

            <div class="right-actions">

              <button
                id="reviewButton"
                class="btn btn-review"
                type="button"
              >
                Mark for Review &amp; Next
              </button>

              <button
                id="nextButton"
                class="btn btn-primary"
                type="button"
              >
                Save &amp; Next →
              </button>

            </div>

          </div>

        </section>


        <!-- SIDEBAR -->

        <aside
          id="sidebar"
          class="sidebar"
        >

          <!-- SUMMARY -->

          <section class="side-card">

            <div class="side-title">

              <span>
                Question Summary
              </span>

            </div>

            <div class="tally">

              <div class="tally-item">

                <span
                  id="answeredCount"
                  class="tally-value"
                >
                  0
                </span>

                <span class="tally-label">
                  Answered
                </span>

              </div>

              <div class="tally-item">

                <span
                  id="notAnsweredCount"
                  class="tally-value"
                >
                  0
                </span>

                <span class="tally-label">
                  Not Answered
                </span>

              </div>

              <div class="tally-item">

                <span
                  id="reviewCount"
                  class="tally-value"
                >
                  0
                </span>

                <span class="tally-label">
                  Review
                </span>

              </div>

              <div class="tally-item">

                <span
                  id="notVisitedCount"
                  class="tally-value"
                >
                  {totalQuestions}
                </span>

                <span class="tally-label">
                  Not Visited
                </span>

              </div>

            </div>

          </section>


          <!-- PALETTE -->

          <section class="side-card">

            <div class="side-title">

              <span>
                Question Palette
              </span>

              <span>
                {totalQuestions}
              </span>

            </div>

            <div
              id="questionPalette"
              class="palette"
            ></div>

            <div class="legend">

              <div class="legend-item">

                <span class="legend-dot"></span>

                Not Visited

              </div>

              <div class="legend-item">

                <span class="legend-dot red"></span>

                Not Answered

              </div>

              <div class="legend-item">

                <span class="legend-dot green"></span>

                Answered

              </div>

              <div class="legend-item">

                <span class="legend-dot purple"></span>

                Marked for Review

              </div>

            </div>

          </section>


          <!-- FONT -->

          <section class="side-card">

            <div class="font-control">

              <span>
                Question Text Size
              </span>

              <div class="font-buttons">

                <button
                  id="fontDownSide"
                  type="button"
                >
                  A−
                </button>

                <button
                  id="fontReset"
                  type="button"
                >
                  A
                </button>

                <button
                  id="fontUpSide"
                  type="button"
                >
                  A+
                </button>

              </div>

            </div>

          </section>


          <!-- SUBMIT -->

          <section class="side-card submit-card">

            <div class="side-title">
              Submit Test
            </div>

            <p>
              Review your answers before final submission.
              Once submitted, the test cannot be changed.
            </p>

            <button
              id="submitButton"
              class="submit-button"
              type="button"
            >
              Submit Test
            </button>

          </section>

        </aside>

      </div>

    )}

  </main>


  <!-- MOBILE PALETTE -->

  {totalQuestions > 0 && (

    <button
      id="mobilePaletteToggle"
      class="mobile-palette-toggle"
      type="button"
      title="Question Palette"
    >
      ☷
    </button>

  )}


  <!-- MOBILE NAV -->

  {totalQuestions > 0 && (

    <div class="mobile-footer">

      <div class="mobile-footer-inner">

        <button
          id="mobilePrevious"
          class="btn"
          type="button"
        >
          ← Prev
        </button>

        <button
          id="mobileReview"
          class="btn btn-review"
          type="button"
        >
          Review
        </button>

        <button
          id="mobileNext"
          class="btn btn-primary"
          type="button"
        >
          Next →
        </button>

      </div>

    </div>

  )}


  <!-- =====================================================
       SUBMIT MODAL
       ===================================================== -->

  <div
    id="submitOverlay"
    class="overlay"
  >

    <div class="modal">

      <h2>
        Submit Test?
      </h2>

      <p>
        Please check your question summary before submitting.
        Your final submission cannot be changed.
      </p>

      <div class="confirm-stats">

        <div class="confirm-stat">

          <strong id="confirmAnswered">
            0
          </strong>

          <span>
            Answered
          </span>

        </div>

        <div class="confirm-stat">

          <strong id="confirmNotAnswered">
            0
          </strong>

          <span>
            Not Answered
          </span>

        </div>

        <div class="confirm-stat">

          <strong id="confirmReview">
            0
          </strong>

          <span>
            Review
          </span>

        </div>

        <div class="confirm-stat">

          <strong id="confirmNotVisited">
            0
          </strong>

          <span>
            Not Visited
          </span>

        </div>

      </div>

      <div class="modal-actions">

        <button
          id="cancelSubmit"
          class="btn"
          type="button"
        >
          Continue Test
        </button>

        <button
          id="confirmSubmit"
          class="btn btn-primary"
          type="button"
        >
          Submit Now
        </button>

      </div>

    </div>

  </div>


  <!-- =====================================================
       RESULT MODAL
       ===================================================== -->

  <div
    id="resultOverlay"
    class="overlay"
  >

    <div class="modal result-modal">

      <div class="result-hero">

        <div class="result-hero-label">
          Habitat IAS • Test Result
        </div>

        <div
          id="resultScore"
          class="result-score"
        >
          —
        </div>

        <div
          id="resultPercentage"
          class="result-percentage"
        >
          —
        </div>

      </div>

      <div class="result-grid">

        <div class="result-box">

          <strong id="resultCorrect">
            0
          </strong>

          <span>
            Correct
          </span>

        </div>

        <div class="result-box">

          <strong id="resultWrong">
            0
          </strong>

          <span>
            Wrong
          </span>

        </div>

        <div class="result-box">

          <strong id="resultSkipped">
            0
          </strong>

          <span>
            Skipped
          </span>

        </div>

        <div class="result-box">

          <strong id="resultTime">
            00:00
          </strong>

          <span>
            Time Used
          </span>

        </div>

      </div>

      <div
        class="modal-actions"
        style="margin-top:18px"
      >

        <button
          id="resultClose"
          class="btn btn-primary"
          type="button"
        >
          Return to Mock Tests
        </button>

      </div>

    </div>

  </div>


  <!-- =====================================================
       EXAM DATA
       ===================================================== -->

  <script
    id="examData"
    type="application/json"
    set:html={JSON.stringify(examData).replace(/</g, "\\u003c")}
  ></script>


  <!-- =====================================================
       CLIENT ENGINE
       ===================================================== -->

  <script>

    import {
      supabase
    } from "../../lib/supabase";


    /* =====================================================
       DATA
       ===================================================== */

    const dataElement =
      document.getElementById(
        "examData"
      );

    const exam =
      JSON.parse(
        dataElement?.textContent ||
        "{}"
      );

    const questions =
      Array.isArray(
        exam.questions
      )
        ? exam.questions
        : [];

    const total =
      questions.length;


    /* =====================================================
       STORAGE
       ===================================================== */

    const storageKey =
      `habitat-ias-cbt-${exam.testId}-FINAL`;


    /* =====================================================
       STATE
       ===================================================== */

    let currentIndex =
      0;

    let submitted =
      false;

    let answers =
      Array(total)
        .fill(null);

    let visited =
      Array(total)
        .fill(false);

    let reviewFlags =
      Array(total)
        .fill(false);

    let remainingSeconds =
      Math.max(
        0,
        Number(
          exam.durationMinutes ||
          120
        ) * 60
      );

    let timerInterval =
      null;

    let fontSize =
      18;

    let startedAt =
      null;


    /* =====================================================
       ELEMENTS
       ===================================================== */

    const timer =
      document.getElementById(
        "timer"
      );

    const timerBox =
      document.getElementById(
        "timerBox"
      );

    const questionBody =
      document.getElementById(
        "questionBody"
      );

    const questionNumberBadge =
      document.getElementById(
        "questionNumberBadge"
      );

    const questionTags =
      document.getElementById(
        "questionTags"
      );

    const questionPalette =
      document.getElementById(
        "questionPalette"
      );

    const progressText =
      document.getElementById(
        "progressText"
      );

    const progressPercent =
      document.getElementById(
        "progressPercent"
      );

    const progressFill =
      document.getElementById(
        "progressFill"
      );

    const answeredCount =
      document.getElementById(
        "answeredCount"
      );

    const notAnsweredCount =
      document.getElementById(
        "notAnsweredCount"
      );

    const reviewCount =
      document.getElementById(
        "reviewCount"
      );

    const notVisitedCount =
      document.getElementById(
        "notVisitedCount"
      );

    const previousButton =
      document.getElementById(
        "previousButton"
      );

    const nextButton =
      document.getElementById(
        "nextButton"
      );

    const clearButton =
      document.getElementById(
        "clearButton"
      );

    const reviewButton =
      document.getElementById(
        "reviewButton"
      );

    const submitButton =
      document.getElementById(
        "submitButton"
      );

    const submitOverlay =
      document.getElementById(
        "submitOverlay"
      );

    const cancelSubmit =
      document.getElementById(
        "cancelSubmit"
      );

    const confirmSubmit =
      document.getElementById(
        "confirmSubmit"
      );

    const resultOverlay =
      document.getElementById(
        "resultOverlay"
      );

    const resultClose =
      document.getElementById(
        "resultClose"
      );

    const sidebar =
      document.getElementById(
        "sidebar"
      );


    /* =====================================================
       HELPERS
       ===================================================== */

    function escapeHtml(
      value
    ) {

      return String(
        value ?? ""
      )
        .replaceAll(
          "&",
          "&amp;"
        )
        .replaceAll(
          "<",
          "&lt;"
        )
        .replaceAll(
          ">",
          "&gt;"
        )
        .replaceAll(
          '"',
          "&quot;"
        )
        .replaceAll(
          "'",
          "&#039;"
        );

    }


    function formatTime(
      seconds
    ) {

      const safe =
        Math.max(
          0,
          Math.floor(
            Number(seconds) ||
            0
          )
        );

      const hours =
        Math.floor(
          safe / 3600
        );

      const minutes =
        Math.floor(
          (safe % 3600) / 60
        );

      const secs =
        safe % 60;

      if (
        hours > 0
      ) {

        return (
          `${String(hours).padStart(2,"0")}:` +
          `${String(minutes).padStart(2,"0")}:` +
          `${String(secs).padStart(2,"0")}`
        );

      }

      return (
        `${String(minutes).padStart(2,"0")}:` +
        `${String(secs).padStart(2,"0")}`
      );

    }


    /* =====================================================
       STATE
       ===================================================== */

    function resetClientState() {

      currentIndex =
        0;

      answers =
        Array(total)
          .fill(null);

      visited =
        Array(total)
          .fill(false);

      reviewFlags =
        Array(total)
          .fill(false);

      startedAt =
        Date.now();

      remainingSeconds =
        Math.max(
          0,
          Number(
            exam.durationMinutes ||
            120
          ) * 60
        );

      fontSize =
        18;

      try {

        localStorage.removeItem(
          storageKey
        );

      } catch {}

    }


    function saveLocalState() {

      if (
        submitted
      ) {
        return;
      }

      try {

        localStorage.setItem(
          storageKey,
          JSON.stringify({
            currentIndex,
            answers,
            visited,
            reviewFlags,
            startedAt,
            fontSize,
          })
        );

      } catch (
        error
      ) {

        console.warn(
          "State save failed:",
          error
        );

      }

    }


    function restoreLocalState() {

      const durationSeconds =
        Math.max(
          0,
          Number(
            exam.durationMinutes ||
            120
          ) * 60
        );

      try {

        const raw =
          localStorage.getItem(
            storageKey
          );

        if (!raw) {

          resetClientState();

          return;

        }

        const saved =
          JSON.parse(
            raw
          );

        if (
          !saved ||
          !Array.isArray(
            saved.answers
          )
        ) {

          resetClientState();

          return;

        }

        const savedStartedAt =
          Number(
            saved.startedAt
          );

        if (
          !Number.isFinite(
            savedStartedAt
          ) ||
          savedStartedAt <= 0
        ) {

          resetClientState();

          return;

        }

        const elapsed =
          Math.max(
            0,
            Math.floor(
              (
                Date.now() -
                savedStartedAt
              ) / 1000
            )
          );

        /*
         * IMPORTANT:
         * Never submit an expired old browser state
         * automatically when the page opens.
         */

        if (
          elapsed >=
          durationSeconds
        ) {

          resetClientState();

          return;

        }

        currentIndex =
          Math.min(
            Math.max(
              total - 1,
              0
            ),
            Math.max(
              0,
              Number(
                saved.currentIndex
              ) || 0
            )
          );

        answers =
          Array(total)
            .fill(null)
            .map(
              (_, index) =>
                saved.answers[index] ??
                null
            );

        visited =
          Array(total)
            .fill(false)
            .map(
              (_, index) =>
                Boolean(
                  saved.visited?.[index]
                )
            );

        reviewFlags =
          Array(total)
            .fill(false)
            .map(
              (_, index) =>
                Boolean(
                  saved.reviewFlags?.[index]
                )
            );

        startedAt =
          savedStartedAt;

        remainingSeconds =
          Math.max(
            1,
            durationSeconds -
            elapsed
          );

        fontSize =
          Math.min(
            24,
            Math.max(
              15,
              Number(
                saved.fontSize
              ) || 18
            )
          );

      } catch (
        error
      ) {

        console.warn(
          "State restore failed:",
          error
        );

        resetClientState();

      }

    }


    function clearLocalState() {

      try {

        localStorage.removeItem(
          storageKey
        );

      } catch {}

    }


    /* =====================================================
       COUNTS
       ===================================================== */

    function getAnsweredCount() {

      return answers.filter(
        (value) =>
          value !== null
      ).length;

    }


    function getNotAnsweredCount() {

      return answers.reduce(
        (
          count,
          answer,
          index
        ) => {

          if (
            visited[index] &&
            answer === null
          ) {

            return count + 1;

          }

          return count;

        },
        0
      );

    }


    function getReviewCount() {

      return reviewFlags.filter(
        Boolean
      ).length;

    }


    function getNotVisitedCount() {

      return visited.filter(
        (value) =>
          !value
      ).length;

    }


    function getQuestionStatus(
      index
    ) {

      const answered =
        answers[index] !== null;

      const visitedQuestion =
        visited[index];

      const review =
        reviewFlags[index];

      if (
        review &&
        answered
      ) {

        return "review-answered";

      }

      if (
        review
      ) {

        return "review";

      }

      if (
        answered
      ) {

        return "answered";

      }

      if (
        visitedQuestion
      ) {

        return "not-answered";

      }

      return "not-visited";

    }


    function updateCounts() {

      const answered =
        getAnsweredCount();

      const notAnswered =
        getNotAnsweredCount();

      const review =
        getReviewCount();

      const notVisited =
        getNotVisitedCount();

      if (
        answeredCount
      ) {

        answeredCount.textContent =
          String(
            answered
          );

      }

      if (
        notAnsweredCount
      ) {

        notAnsweredCount.textContent =
          String(
            notAnswered
          );

      }

      if (
        reviewCount
      ) {

        reviewCount.textContent =
          String(
            review
          );

      }

      if (
        notVisitedCount
      ) {

        notVisitedCount.textContent =
          String(
            notVisited
          );

      }

      const percentage =
        total > 0
          ? Math.round(
              (answered / total) *
              100
            )
          : 0;

      if (
        progressPercent
      ) {

        progressPercent.textContent =
          `${percentage}% answered`;

      }

      if (
        progressFill
      ) {

        progressFill.style.width =
          `${percentage}%`;

      }

    }


    /* =====================================================
       RENDER QUESTION
       ===================================================== */

    function renderQuestion() {

      const question =
        questions[
          currentIndex
        ];

      if (
        !questionBody ||
        !question
      ) {

        return;

      }

      const selected =
        answers[
          currentIndex
        ];

      if (
        questionNumberBadge
      ) {

        questionNumberBadge.textContent =
          String(
            currentIndex + 1
          );

      }

      if (
        questionTags
      ) {

        const tags =
          [];

        if (
          question.subject
        ) {

          tags.push(
            `<span class="tag">
              ${escapeHtml(question.subject)}
            </span>`
          );

        }

        if (
          question.topic
        ) {

          tags.push(
            `<span class="tag">
              ${escapeHtml(question.topic)}
            </span>`
          );

        }

        if (
          question.difficulty
        ) {

          tags.push(
            `<span class="tag">
              ${escapeHtml(question.difficulty)}
            </span>`
          );

        }

        questionTags.innerHTML =
          tags.join("");

      }

      const options = [
        {
          key: "A",
          text: question.option_a,
        },
        {
          key: "B",
          text: question.option_b,
        },
        {
          key: "C",
          text: question.option_c,
        },
        {
          key: "D",
          text: question.option_d,
        },
      ];

      const image =
        question.image_url
          ? `
            <img
              class="question-image"
              src="${escapeHtml(question.image_url)}"
              alt="Question image"
              loading="lazy"
            />
          `
          : "";

      questionBody.innerHTML = `

        <div
          class="question-text"
          style="font-size:${fontSize}px"
        >
          ${escapeHtml(
            question.question_text
          )}
        </div>

        ${image}

        <div class="options">

          ${options
            .map(
              (option) => `

                <button
                  type="button"
                  class="option ${
                    selected ===
                    option.key
                      ? "selected"
                      : ""
                  }"
                  data-option="${option.key}"
                >

                  <span class="option-key">
                    ${option.key}
                  </span>

                  <span class="option-text">
                    ${escapeHtml(
                      option.text
                    )}
                  </span>

                </button>

              `
            )
            .join("")}

        </div>

      `;

      questionBody
        .querySelectorAll(
          ".option"
        )
        .forEach(
          (
            button
          ) => {

            button.addEventListener(
              "click",
              () => {

                if (
                  submitted
                ) {

                  return;

                }

                answers[
                  currentIndex
                ] =
                  button.dataset.option ??
                  null;

                visited[
                  currentIndex
                ] =
                  true;

                renderQuestion();

                renderPalette();

                updateCounts();

                updateFooterState();

                saveLocalState();

              }
            );

          }
        );

    }


    /* =====================================================
       PALETTE
       ===================================================== */

    function renderPalette() {

      if (
        !questionPalette
      ) {

        return;

      }

      questionPalette.innerHTML =
        "";

      questions.forEach(
        (
          question,
          index
        ) => {

          const button =
            document.createElement(
              "button"
            );

          button.type =
            "button";

          button.className =
            `palette-button ${
              getQuestionStatus(
                index
              )
            }`;

          if (
            index ===
            currentIndex
          ) {

            button.classList.add(
              "current"
            );

          }

          button.textContent =
            String(
              index + 1
            );

          button.title =
            `Question ${index + 1}`;

          button.addEventListener(
            "click",
            () => {

              if (
                submitted
              ) {

                return;

              }

              currentIndex =
                index;

              visited[
                index
              ] =
                true;

              renderQuestion();

              renderPalette();

              updateCounts();

              updateFooterState();

              saveLocalState();

              if (
                window.innerWidth <=
                800
              ) {

                sidebar?.classList.remove(
                  "open"
                );

              }

              window.scrollTo({
                top: 0,
                behavior: "smooth",
              });

            }
          );

          questionPalette.appendChild(
            button
          );

        }
      );

    }


    /* =====================================================
       NAVIGATION
       ===================================================== */

    function updateFooterState() {

      if (
        previousButton
      ) {

        previousButton.disabled =
          currentIndex === 0;

      }

      if (
        clearButton
      ) {

        clearButton.disabled =
          answers[
            currentIndex
          ] === null;

      }

      const reviewed =
        reviewFlags[
          currentIndex
        ];

      if (
        reviewButton
      ) {

        reviewButton.textContent =
          reviewed
            ? "Remove Review"
            : "Mark for Review & Next";

      }

      if (
        nextButton
      ) {

        nextButton.textContent =
          currentIndex ===
          total - 1
            ? "Review Summary"
            : "Save & Next →";

      }

      const mobilePrevious =
        document.getElementById(
          "mobilePrevious"
        );

      const mobileNext =
        document.getElementById(
          "mobileNext"
        );

      const mobileReview =
        document.getElementById(
          "mobileReview"
        );

      if (
        mobilePrevious
      ) {

        mobilePrevious.disabled =
          currentIndex === 0;

      }

      if (
        mobileNext
      ) {

        mobileNext.textContent =
          currentIndex ===
          total - 1
            ? "Summary"
            : "Next →";

      }

      if (
        mobileReview
      ) {

        mobileReview.textContent =
          reviewed
            ? "Remove Review"
            : "Review";

      }

      if (
        progressText
      ) {

        progressText.textContent =
          `Question ${
            currentIndex + 1
          } of ${total}`;

      }

    }


    function goNext() {

      if (
        currentIndex <
        total - 1
      ) {

        currentIndex++;

        visited[
          currentIndex
        ] =
          true;

        renderQuestion();

        renderPalette();

        updateCounts();

        updateFooterState();

        saveLocalState();

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

      } else {

        openSubmitDialog();

      }

    }


    function goPrevious() {

      if (
        currentIndex <= 0
      ) {

        return;

      }

      currentIndex--;

      visited[
        currentIndex
      ] =
        true;

      renderQuestion();

      renderPalette();

      updateCounts();

      updateFooterState();

      saveLocalState();

      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });

    }


    function clearResponse() {

      if (
        submitted
      ) {

        return;

      }

      answers[
        currentIndex
      ] =
        null;

      renderQuestion();

      renderPalette();

      updateCounts();

      updateFooterState();

      saveLocalState();

    }


    function toggleReviewAndNext() {

      if (
        submitted
      ) {

        return;

      }

      reviewFlags[
        currentIndex
      ] =
        !reviewFlags[
          currentIndex
        ];

      if (
        currentIndex <
        total - 1
      ) {

        currentIndex++;

        visited[
          currentIndex
        ] =
          true;

      }

      renderQuestion();

      renderPalette();

      updateCounts();

      updateFooterState();

      saveLocalState();

    }


    previousButton?.addEventListener(
      "click",
      goPrevious
    );

    nextButton?.addEventListener(
      "click",
      goNext
    );

    clearButton?.addEventListener(
      "click",
      clearResponse
    );

    reviewButton?.addEventListener(
      "click",
      toggleReviewAndNext
    );

    document
      .getElementById(
        "mobilePrevious"
      )
      ?.addEventListener(
        "click",
        goPrevious
      );

    document
      .getElementById(
        "mobileNext"
      )
      ?.addEventListener(
        "click",
        goNext
      );

    document
      .getElementById(
        "mobileReview"
      )
      ?.addEventListener(
        "click",
        toggleReviewAndNext
      );

    document
      .getElementById(
        "mobilePaletteToggle"
      )
      ?.addEventListener(
        "click",
        () =>
          sidebar?.classList.toggle(
            "open"
          )
      );


    /* =====================================================
       SUBMIT DIALOG
       ===================================================== */

    function openSubmitDialog() {

      const answered =
        document.getElementById(
          "confirmAnswered"
        );

      const notAnswered =
        document.getElementById(
          "confirmNotAnswered"
        );

      const review =
        document.getElementById(
          "confirmReview"
        );

      const notVisited =
        document.getElementById(
          "confirmNotVisited"
        );

      if (
        answered
      ) {

        answered.textContent =
          String(
            getAnsweredCount()
          );

      }

      if (
        notAnswered
      ) {

        notAnswered.textContent =
          String(
            getNotAnsweredCount()
          );

      }

      if (
        review
      ) {

        review.textContent =
          String(
            getReviewCount()
          );

      }

      if (
        notVisited
      ) {

        notVisited.textContent =
          String(
            getNotVisitedCount()
          );

      }

      submitOverlay?.classList.add(
        "visible"
      );

    }


    submitButton?.addEventListener(
      "click",
      openSubmitDialog
    );

    cancelSubmit?.addEventListener(
      "click",
      () =>
        submitOverlay?.classList.remove(
          "visible"
        )
    );


    /* =====================================================
       TIMER
       ===================================================== */

    function updateTimer() {

      if (
        !timer
      ) {

        return;

      }

      timer.textContent =
        formatTime(
          remainingSeconds
        );

      timerBox?.classList.remove(
        "warning",
        "critical"
      );

      if (
        remainingSeconds <=
        300
      ) {

        timerBox?.classList.add(
          "warning"
        );

      }

      if (
        remainingSeconds <=
        60
      ) {

        timerBox?.classList.add(
          "critical"
        );

      }

    }


    function startTimer() {

      updateTimer();

      if (
        timerInterval
      ) {

        clearInterval(
          timerInterval
        );

        timerInterval =
          null;

      }

      /*
       * Do NOT submit automatically
       * just because an old page loads.
       */

      if (
        remainingSeconds <=
        0
      ) {

        return;

      }

      timerInterval =
        window.setInterval(
          () => {

            if (
              submitted
            ) {

              clearInterval(
                timerInterval
              );

              timerInterval =
                null;

              return;

            }

            remainingSeconds--;

            if (
              remainingSeconds <=
              0
            ) {

              remainingSeconds =
                0;

              updateTimer();

              clearInterval(
                timerInterval
              );

              timerInterval =
                null;

              submitTest(
                true
              );

              return;

            }

            updateTimer();

            saveLocalState();

          },
          1000
        );

    }


    /* =====================================================
       SUBMISSION
       ===================================================== */

    async function submitTest(
      automatic = false
    ) {

      if (
        submitted
      ) {

        return;

      }

      submitted =
        true;

      if (
        timerInterval
      ) {

        clearInterval(
          timerInterval
        );

        timerInterval =
          null;

      }

      submitOverlay?.classList.remove(
        "visible"
      );

      const durationSeconds =
        Number(
          exam.durationMinutes ||
          120
        ) * 60;

      const timeTaken =
        Math.max(
          0,
          durationSeconds -
          remainingSeconds
        );

      try {

        if (
          submitButton
        ) {

          submitButton.disabled =
            true;

          submitButton.textContent =
            "Submitting…";

        }


        /* =================================================
           SESSION
           ================================================= */

        const {
          data: sessionData,
          error: sessionError,
        } =
          await supabase.auth.getSession();

        if (
          sessionError
        ) {

          throw new Error(
            sessionError.message ||
            "Unable to verify your login session."
          );

        }

        const accessToken =
          sessionData
            ?.session
            ?.access_token;

        if (
          !accessToken
        ) {

          throw new Error(
            "Your login session has expired. Please login again."
          );

        }


        /* =================================================
           ANSWERS
           
           correct_option is NEVER sent.
           ================================================= */

        const submittedAnswers =
          answers
            .map(
              (
                answer,
                index
              ) => ({

                questionId:
                  questions[
                    index
                  ]?.id ??
                  null,

                selectedOption:
                  answer ===
                    null ||
                  answer ===
                    undefined ||
                  answer ===
                    ""
                    ? null
                    : String(
                        answer
                      )
                        .trim()
                        .toUpperCase(),

              })
            )
            .filter(
              (
                item
              ) =>
                Boolean(
                  item.questionId
                )
            );


        /* =================================================
           CRITICAL FIX

           JSON MUST BE IN BODY.

           NEVER:
           /api/mock-tests/submit?payload=...

           ALWAYS:
           POST /api/mock-tests/submit
           body = JSON
           ================================================= */

        const submissionBody =
          JSON.stringify({

            testId:
              exam.testId,

            answers:
              submittedAnswers,

            timeTaken:
              Number(
                timeTaken
              ) || 0,

            automatic:
              Boolean(
                automatic
              ),

            submittedAt:
              new Date()
                .toISOString(),

          });


        console.log(
          "[Habitat IAS] SUBMISSION URL:",
          "/api/mock-tests/submit"
        );

        console.log(
          "[Habitat IAS] SUBMISSION BODY LENGTH:",
          submissionBody.length
        );

        console.log(
          "[Habitat IAS] SUBMISSION BODY:",
          submissionBody
        );


        const response =
          await fetch(
            new URL(
              "/api/mock-tests/submit",
              window.location.origin
            ).toString(),
            {

              method:
                "POST",

              credentials:
                "same-origin",

              headers: {

                "Content-Type":
                  "application/json; charset=UTF-8",

                "Accept":
                  "application/json",

                "Authorization":
                  `Bearer ${accessToken}`,

              },

              body:
                submissionBody,

            }
          );


        const responseText =
          await response.text();


        console.log(
          "[Habitat IAS] HTTP STATUS:",
          response.status
        );

        console.log(
          "[Habitat IAS] RESPONSE:",
          responseText
        );


        if (
          !responseText.trim()
        ) {

          throw new Error(
            `Submit API returned an empty response (HTTP ${response.status}).`
          );

        }


        let result;

        try {

          result =
            JSON.parse(
              responseText
            );

        } catch {

          throw new Error(
            `Submit API returned invalid JSON (HTTP ${response.status}).`
          );

        }


        if (
          !response.ok ||
          !result?.success
        ) {

          throw new Error(
            result?.error ||
            result?.message ||
            result?.details ||
            `Test submission failed (HTTP ${response.status}).`
          );

        }


        /* =================================================
           SUCCESS
           ================================================= */

        showResult(
          result
        );

        clearLocalState();


      } catch (
        error
      ) {

        console.error(
          "Submission error:",
          error
        );

        submitted =
          false;

        if (
          submitButton
        ) {

          submitButton.disabled =
            false;

          submitButton.textContent =
            "Submit Test";

        }

        if (
          remainingSeconds >
          0
        ) {

          startTimer();

        } else {

          updateTimer();

        }

        alert(
          error instanceof Error
            ? error.message
            : "Unable to submit the test."
        );

      }

    }


    confirmSubmit?.addEventListener(
      "click",
      () =>
        submitTest(false)
    );


    /* =====================================================
       RESULT
       ===================================================== */

    function showResult(
      result
    ) {

      const maximum =
        Number(
          result.maximumMarks
        ) ||
        Number(
          exam.maximumMarks
        ) ||
        (
          total *
          Number(
            exam.marksPerQuestion ||
            0
          )
        );

      const score =
        Number(
          result.score ||
          0
        );

      const percentage =
        maximum > 0
          ? (
              score /
              maximum
            ) *
            100
          : 0;

      const scoreElement =
        document.getElementById(
          "resultScore"
        );

      const percentageElement =
        document.getElementById(
          "resultPercentage"
        );

      const correctElement =
        document.getElementById(
          "resultCorrect"
        );

      const wrongElement =
        document.getElementById(
          "resultWrong"
        );

      const skippedElement =
        document.getElementById(
          "resultSkipped"
        );

      const timeElement =
        document.getElementById(
          "resultTime"
        );

      if (
        scoreElement
      ) {

        scoreElement.textContent =
          `${score} / ${maximum}`;

      }

      if (
        percentageElement
      ) {

        percentageElement.textContent =
          `${Number(
            result.percentage ??
            percentage
          ).toFixed(2)}%`;

      }

      if (
        correctElement
      ) {

        correctElement.textContent =
          String(
            result.correctCount ??
            0
          );

      }

      if (
        wrongElement
      ) {

        wrongElement.textContent =
          String(
            result.incorrectCount ??
            0
          );

      }

      if (
        skippedElement
      ) {

        skippedElement.textContent =
          String(
            result.unansweredCount ??
            0
          );

      }

      if (
        timeElement
      ) {

        timeElement.textContent =
          formatTime(
            result.timeTaken ??
            0
          );

      }

      resultOverlay?.classList.add(
        "visible"
      );

    }


    resultClose?.addEventListener(
      "click",
      () => {

        window.location.href =
          "/mock-tests";

      }
    );


    /* =====================================================
       FULLSCREEN
       ===================================================== */

    document
      .getElementById(
        "fullscreenButton"
      )
      ?.addEventListener(
        "click",
        async () => {

          try {

            if (
              !document.fullscreenElement
            ) {

              await document
                .documentElement
                .requestFullscreen();

            } else {

              await document
                .exitFullscreen();

            }

          } catch (
            error
          ) {

            console.warn(
              "Fullscreen unavailable:",
              error
            );

          }

        }
      );


    /* =====================================================
       FONT SIZE
       ===================================================== */

    function setFontSize(
      size
    ) {

      fontSize =
        Math.min(
          24,
          Math.max(
            15,
            Number(
              size
            ) || 18
          )
        );

      renderQuestion();

      saveLocalState();

    }


    document
      .getElementById(
        "fontUp"
      )
      ?.addEventListener(
        "click",
        () =>
          setFontSize(
            fontSize + 1
          )
      );

    document
      .getElementById(
        "fontDown"
      )
      ?.addEventListener(
        "click",
        () =>
          setFontSize(
            fontSize - 1
          )
      );

    document
      .getElementById(
        "fontUpSide"
      )
      ?.addEventListener(
        "click",
        () =>
          setFontSize(
            fontSize + 1
          )
      );

    document
      .getElementById(
        "fontDownSide"
      )
      ?.addEventListener(
        "click",
        () =>
          setFontSize(
            fontSize - 1
          )
      );

    document
      .getElementById(
        "fontReset"
      )
      ?.addEventListener(
        "click",
        () =>
          setFontSize(
            18
          )
      );


    /* =====================================================
       KEYBOARD SHORTCUTS
       ===================================================== */

    document.addEventListener(
      "keydown",
      (
        event
      ) => {

        if (
          submitted
        ) {

          return;

        }

        const target =
          event.target;

        if (
          target instanceof
            HTMLInputElement ||
          target instanceof
            HTMLTextAreaElement ||
          target instanceof
            HTMLSelectElement
        ) {

          return;

        }

        const key =
          event.key.toUpperCase();


        /* A / B / C / D */

        if (
          [
            "A",
            "B",
            "C",
            "D",
          ].includes(
            key
          )
        ) {

          event.preventDefault();

          answers[
            currentIndex
          ] =
            key;

          visited[
            currentIndex
          ] =
            true;

          renderQuestion();

          renderPalette();

          updateCounts();

          updateFooterState();

          saveLocalState();

          return;

        }


        /* N = Next */

        if (
          key ===
          "N"
        ) {

          event.preventDefault();

          goNext();

          return;

        }


        /* P = Previous */

        if (
          key ===
          "P"
        ) {

          event.preventDefault();

          goPrevious();

          return;

        }


        /* R = Review */

        if (
          key ===
          "R"
        ) {

          event.preventDefault();

          toggleReviewAndNext();

          return;

        }


        /* Escape closes submit dialog */

        if (
          key ===
          "ESCAPE"
        ) {

          submitOverlay?.classList.remove(
            "visible"
          );

        }

      }
    );


    /* =====================================================
       SAVE BEFORE LEAVING
       ===================================================== */

    window.addEventListener(
      "beforeunload",
      (
        event
      ) => {

        if (
          !submitted
        ) {

          saveLocalState();

          event.preventDefault();

          event.returnValue =
            "";

        }

      }
    );


    document.addEventListener(
      "visibilitychange",
      () => {

        if (
          document.visibilityState ===
          "hidden"
        ) {

          saveLocalState();

        }

      }
    );


    /* =====================================================
       INITIALIZE
       ===================================================== */

    if (
      total > 0
    ) {

      restoreLocalState();

      visited[
        currentIndex
      ] =
        true;

      renderQuestion();

      renderPalette();

      updateCounts();

      updateFooterState();

      updateTimer();

      startTimer();

      saveLocalState();

    }

  </script>

</body>

</html>