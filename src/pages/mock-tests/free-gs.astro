---
import Header from "../../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>JPSC GS Free Open Mock | Habitat IAS</title>

    <meta
      name="description"
      content="Attempt the free JPSC General Studies Open Mock Test by Habitat IAS. Login required. 100 questions, 200 marks and 120 minutes."
    />

    <meta
      name="keywords"
      content="JPSC free mock test, JPSC GS mock test, JPSC prelims free test, JPSC online mock test"
    />

    <link
      rel="canonical"
      href="https://habitatias.com/mock-tests/free-gs/"
    />
  </head>

  <body>
    <Header />

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="container hero-inner">

          <div class="eyebrow">
            🟢 FREE OPEN MOCK
          </div>

          <h1>
            JPSC General Studies
            <span>Open Mock Test</span>
          </h1>

          <p class="hero-description">
            Experience the Habitat IAS JPSC computer-based test interface
            through this completely free General Studies mock test.
          </p>

          <div class="hero-actions">

            <a
              href="/login?redirect=/mock-tests/21/"
              class="primary-btn"
            >
              Login & Attempt Free Test →
            </a>

            <a
              href="/mock-tests/"
              class="secondary-btn"
            >
              ← Back to Mock Tests
            </a>

          </div>

        </div>
      </section>


      <!-- TEST INFORMATION -->
      <section class="section">
        <div class="container">

          <div class="section-heading">

            <span class="section-label">
              JPSC PRELIMS
            </span>

            <h2>
              Free GS Open Mock
            </h2>

            <p>
              A standalone practice test designed to let aspirants
              experience the Habitat IAS mock-test environment before
              purchasing the Core 20-Test Series.
            </p>

          </div>


          <!-- TEST STATS -->
          <div class="stats-grid">

            <div class="stat-card">
              <strong>100</strong>
              <span>Questions</span>
            </div>

            <div class="stat-card">
              <strong>200</strong>
              <span>Total Marks</span>
            </div>

            <div class="stat-card">
              <strong>120</strong>
              <span>Minutes</span>
            </div>

            <div class="stat-card">
              <strong>+2 / 0</strong>
              <span>Marking</span>
            </div>

          </div>


          <!-- MAIN CARD -->
          <div class="test-layout">

            <div class="test-card">

              <div class="card-top">
                <span class="free-badge">
                  🟢 FREE
                </span>

                <span class="paper-badge">
                  GS PAPER
                </span>
              </div>


              <div class="test-icon">
                GS
              </div>


              <h3>
                JPSC General Studies Open Mock Test
              </h3>

              <p class="card-description">
                Test your preparation through a full computer-based
                General Studies practice paper covering the broad
                JPSC Prelims GS preparation area.
              </p>


              <div class="feature-list">

                <div>
                  <span class="check">✓</span>
                  100 objective-type questions
                </div>

                <div>
                  <span class="check">✓</span>
                  200 marks
                </div>

                <div>
                  <span class="check">✓</span>
                  120-minute examination
                </div>

                <div>
                  <span class="check">✓</span>
                  Computer-based test interface
                </div>

                <div>
                  <span class="check">✓</span>
                  Question navigation and palette
                </div>

                <div>
                  <span class="check">✓</span>
                  Performance/result analysis
                </div>

              </div>


              <div class="access-box">

                <div class="access-icon">
                  🔐
                </div>

                <div>

                  <strong>
                    Login Required
                  </strong>

                  <p>
                    This mock is free, but you must create an account
                    or log in before attempting the test.
                  </p>

                </div>

              </div>


              <a
                href="/login?redirect=/mock-tests/21/"
                class="attempt-btn"
              >
                Login & Attempt Free Mock →
              </a>

            </div>


            <!-- SIDE INFORMATION -->
            <aside class="side-card">

              <span class="side-label">
                IMPORTANT
              </span>

              <h3>
                This is a Free Open Mock
              </h3>

              <p>
                This test is provided separately so that aspirants can
                experience the Habitat IAS mock-test platform before
                purchasing the Core 20-Test Series.
              </p>


              <div class="separate-box">

                <strong>
                  Not part of Core 20
                </strong>

                <span>
                  This free mock does not consume or replace any of
                  the 20 paid Core Tests.
                </span>

              </div>


              <div class="side-links">

                <a href="/mock-tests/">
                  ← View All Mock Tests
                </a>

                <a href="/mock-tests/schedule/">
                  📅 View Test Schedule
                </a>

                <a href="/mock-tests-series/">
                  🔒 Explore Core 20 Series
                </a>

              </div>

            </aside>

          </div>

        </div>
      </section>


      <!-- BEFORE ATTEMPT -->
      <section class="instruction-section">

        <div class="container">

          <div class="instruction-card">

            <div>
              <span class="section-label">
                BEFORE YOU START
              </span>

              <h2>
                Ready to test your preparation?
              </h2>

              <p>
                Login to your Habitat IAS account and start the free
                GS Open Mock. The test will open in the dedicated
                computer-based examination interface.
              </p>
            </div>

            <a
              href="/login?redirect=/mock-tests/21/"
              class="instruction-btn"
            >
              Login & Start →
            </a>

          </div>

        </div>

      </section>

    </main>


    <style>

      :global(body) {
        margin: 0;
        font-family:
          Inter,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #f6f9fc;
        color: #172033;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }


      /* HERO */

      .hero {
        background:
          radial-gradient(
            circle at top right,
            rgba(35, 176, 111, 0.18),
            transparent 34%
          ),
          linear-gradient(
            135deg,
            #061d34 0%,
            #0b4168 58%,
            #126e61 100%
          );

        color: white;
        padding: 82px 0 78px;
      }

      .hero-inner {
        text-align: center;
        max-width: 850px;
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 1.5px;
      }

      .hero h1 {
        margin: 22px 0 0;
        font-size: clamp(38px, 6vw, 64px);
        line-height: 1.08;
        font-weight: 900;
      }

      .hero h1 span {
        display: block;
        color: #6ee7b7;
      }

      .hero-description {
        max-width: 720px;
        margin: 22px auto 0;
        color: rgba(255,255,255,0.82);
        font-size: 17px;
        line-height: 1.7;
      }

      .hero-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 30px;
      }

      .primary-btn,
      .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 21px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 850;
      }

      .primary-btn {
        background: white;
        color: #0b496c;
      }

      .secondary-btn {
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.08);
      }


      /* SECTION */

      .section {
        padding: 75px 0;
      }

      .section-heading {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 38px;
      }

      .section-label {
        display: inline-block;
        color: #1769aa;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.7px;
      }

      .section-heading h2 {
        margin: 9px 0 12px;
        font-size: clamp(30px, 4vw, 44px);
      }

      .section-heading p {
        margin: 0;
        color: #667386;
        line-height: 1.7;
      }


      /* STATS */

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 28px;
      }

      .stat-card {
        padding: 23px 15px;
        text-align: center;
        background: white;
        border: 1px solid #dfe7ef;
        border-radius: 16px;
      }

      .stat-card strong {
        display: block;
        color: #124c78;
        font-size: 27px;
        font-weight: 900;
      }

      .stat-card span {
        display: block;
        margin-top: 5px;
        color: #788496;
        font-size: 12px;
      }


      /* LAYOUT */

      .test-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.8fr);
        gap: 22px;
        align-items: start;
      }


      /* MAIN TEST CARD */

      .test-card {
        background: white;
        border: 1px solid #dce5ee;
        border-radius: 22px;
        padding: 32px;
        box-shadow: 0 15px 40px rgba(25,70,100,0.06);
      }

      .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .free-badge {
        color: #147a4a;
        background: #eaf8f0;
        border: 1px solid #cdebd9;
        padding: 7px 11px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1px;
      }

      .paper-badge {
        color: #1769aa;
        background: #edf5fb;
        border: 1px solid #d5e7f5;
        padding: 7px 11px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 1px;
      }

      .test-icon {
        width: 70px;
        height: 70px;
        margin: 28px 0 20px;
        border-radius: 17px;
        display: grid;
        place-items: center;
        background: #1769aa;
        color: white;
        font-size: 21px;
        font-weight: 900;
      }

      .test-card h3 {
        margin: 0;
        font-size: 27px;
        line-height: 1.25;
      }

      .card-description {
        color: #657286;
        line-height: 1.7;
        margin: 12px 0 25px;
      }


      /* FEATURES */

      .feature-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 11px;
        margin-bottom: 25px;
      }

      .feature-list div {
        padding: 11px;
        border-radius: 9px;
        background: #f6f9fc;
        color: #4e5d70;
        font-size: 12px;
      }

      .check {
        color: #168653;
        font-weight: 900;
        margin-right: 6px;
      }


      /* ACCESS */

      .access-box {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        border-radius: 13px;
        background: #fff8e9;
        border: 1px solid #f1dfb7;
        margin-bottom: 18px;
      }

      .access-icon {
        font-size: 24px;
      }

      .access-box strong {
        color: #755619;
        font-size: 13px;
      }

      .access-box p {
        margin: 4px 0 0;
        color: #806f4c;
        font-size: 11px;
        line-height: 1.5;
      }

      .attempt-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        padding: 15px;
        border-radius: 10px;
        background: #168653;
        color: white;
        font-size: 14px;
        font-weight: 850;
      }


      /* SIDE CARD */

      .side-card {
        background: white;
        border: 1px solid #dfe7ef;
        border-radius: 20px;
        padding: 26px;
      }

      .side-label {
        color: #168653;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.5px;
      }

      .side-card h3 {
        margin: 9px 0 10px;
        font-size: 22px;
      }

      .side-card > p {
        color: #667386;
        font-size: 13px;
        line-height: 1.7;
      }

      .separate-box {
        margin: 20px 0;
        padding: 15px;
        border-radius: 12px;
        background: #f3f8f5;
        border: 1px solid #dcece3;
      }

      .separate-box strong {
        display: block;
        color: #147a4a;
        font-size: 12px;
      }

      .separate-box span {
        display: block;
        margin-top: 5px;
        color: #64766b;
        font-size: 11px;
        line-height: 1.5;
      }

      .side-links {
        display: grid;
        gap: 9px;
      }

      .side-links a {
        padding: 11px 12px;
        border-radius: 9px;
        background: #f7f9fc;
        color: #1769aa;
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
      }


      /* BOTTOM CTA */

      .instruction-section {
        padding: 20px 0 75px;
        background: white;
      }

      .instruction-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 30px;
        border-radius: 20px;
        background: #f2f7fb;
        border: 1px solid #dce7ef;
      }

      .instruction-card h2 {
        margin: 8px 0;
        font-size: 27px;
      }

      .instruction-card p {
        margin: 0;
        max-width: 700px;
        color: #687486;
        line-height: 1.6;
      }

      .instruction-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 19px;
        border-radius: 10px;
        background: #1769aa;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 850;
      }


      /* RESPONSIVE */

      @media (max-width: 850px) {

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .test-layout {
          grid-template-columns: 1fr;
        }

        .instruction-card {
          flex-direction: column;
          align-items: flex-start;
        }

      }


      @media (max-width: 600px) {

        .hero {
          padding: 55px 0 50px;
        }

        .section {
          padding: 55px 0;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .feature-list {
          grid-template-columns: 1fr;
        }

        .test-card {
          padding: 22px;
        }

        .hero-actions {
          flex-direction: column;
        }

        .primary-btn,
        .secondary-btn {
          width: 100%;
        }

      }

    </style>

  </body>
</html>