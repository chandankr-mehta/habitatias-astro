  <!-- =====================================================
       PAYMENT JAVASCRIPT
  ====================================================== -->

  <script>

    /* =====================================================
       SUPABASE BROWSER CLIENT
       Use the project's existing client so the browser and
       the rest of Habitat IAS share the same Supabase session.
    ====================================================== */

    import { supabase } from "../../lib/supabase";

    document.addEventListener(
      "DOMContentLoaded",
      async () => {


        /* =================================================
           CONFIGURATION
        ================================================= */

        const TEST_NUMBER =
          Number(
            new URLSearchParams(window.location.search).get("test") || "1"
          );

        const PRODUCT_ID =
          "jpsc_prelims_20_test_series";

        const PRODUCT_NAME =
          "Habitat IAS — JPSC Prelims 20-Test Mock Test Series";

        const PRICE =
          499;


        /* =================================================
           ELEMENTS
        ================================================= */

        const form =
          document.getElementById(
            "checkoutForm"
          );

        const nameInput =
          document.getElementById(
            "name"
          );

        const emailInput =
          document.getElementById(
            "email"
          );

        const mobileInput =
          document.getElementById(
            "mobile"
          );

        const paymentButton =
          document.getElementById(
            "paymentButton"
          );

        const errorMessage =
          document.getElementById(
            "errorMessage"
          );

        const successMessage =
          document.getElementById(
            "successMessage"
          );

        const loginNotice =
          document.getElementById(
            "loginNotice"
          );

        const loginButton =
          document.getElementById(
            "loginButton"
          );


        /* =================================================
           ERROR DISPLAY
        ================================================= */

        function showError(
          message
        ) {

          if (!errorMessage) {
            return;
          }

          errorMessage.textContent =
            message;

          errorMessage.classList.add(
            "show"
          );
        }


        function clearError() {

          if (!errorMessage) {
            return;
          }

          errorMessage.textContent =
            "";

          errorMessage.classList.remove(
            "show"
          );
        }


        /* =================================================
           BUTTON STATE
        ================================================= */

        function setLoginRequired() {

          if (loginNotice) {

            loginNotice.classList.add(
              "show"
            );

          }

          if (paymentButton) {

            paymentButton.disabled =
              true;

            paymentButton.textContent =
              "Login Required";

          }

        }


        function setReady() {

          if (loginNotice) {

            loginNotice.classList.remove(
              "show"
            );

          }

          if (paymentButton) {

            paymentButton.disabled =
              false;

            paymentButton.textContent =
              `Continue to Secure Payment — ₹${PRICE}`;

          }

        }


        /* =================================================
           GET SUPABASE SESSION
        ================================================= */

        let accessToken =
          null;

        let currentUser =
          null;


        try {

          const {
            data:
              sessionData,
            error:
              sessionError
          } =
            await supabase.auth.getSession();


          if (sessionError) {

            console.error(
              "Session error:",
              sessionError
            );

            setLoginRequired();

          } else {

            const session =
              sessionData?.session;

            accessToken =
              session?.access_token ||
              null;

            currentUser =
              session?.user ||
              null;


            if (
              !accessToken ||
              !currentUser
            ) {

              setLoginRequired();

            } else {

              /*
               * Prefill the email from
               * the authenticated account.
               */

              if (
                currentUser.email &&
                emailInput
              ) {

                emailInput.value =
                  currentUser.email;

              }


              /*
               * Redirect back to this exact
               * purchase page after login.
               */

              if (loginButton) {

                loginButton.href =
                  `/login?redirect=${encodeURIComponent(
                    window.location.pathname +
                    window.location.search
                  )}`;

              }


              setReady();

            }

          }

        } catch (
          error
        ) {

          console.error(
            "Authentication check failed:",
            error
          );

          setLoginRequired();

        }


        /* =================================================
           AUTH STATE CHANGE
        ================================================= */

        supabase.auth.onAuthStateChange(
          async (
            event,
            session
          ) => {

            if (
              event === "SIGNED_IN" ||
              event === "TOKEN_REFRESHED"
            ) {

              accessToken =
                session?.access_token ||
                null;

              currentUser =
                session?.user ||
                null;


              if (
                currentUser?.email &&
                emailInput
              ) {

                emailInput.value =
                  currentUser.email;

              }


              if (
                accessToken &&
                currentUser
              ) {

                setReady();

              } else {

                setLoginRequired();

              }

            }


            if (
              event === "SIGNED_OUT"
            ) {

              accessToken =
                null;

              currentUser =
                null;

              setLoginRequired();

            }

          }
        );


        /* =================================================
           VALIDATE CUSTOMER
        ================================================= */

        function validateCustomer() {

          clearError();


          const name =
            nameInput.value.trim();


          const email =
            emailInput.value.trim();


          const mobile =
            mobileInput.value
              .replace(
                /\D/g,
                ""
              );


          if (
            name.length < 2
          ) {

            showError(
              "Please enter your full name."
            );

            nameInput.focus();

            return null;
          }


          const emailRegex =
            /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


          if (
            !emailRegex.test(
              email
            )
          ) {

            showError(
              "Please enter a valid email address."
            );

            emailInput.focus();

            return null;
          }


          if (
            !/^[6-9]\d{9}$/.test(
              mobile
            )
          ) {

            showError(
              "Please enter a valid 10-digit Indian mobile number."
            );

            mobileInput.focus();

            return null;
          }


          return {

            name,

            email,

            mobile

          };

        }


        /* =================================================
           CREATE SERVER-SIDE ORDER
        ================================================= */

        async function createOrder(
          customer
        ) {

          /*
           * Refresh the session before payment.
           */

          const {
            data:
              freshSessionData,
            error:
              freshSessionError
          } =
            await supabase.auth.getSession();


          if (
            freshSessionError
          ) {

            throw new Error(
              freshSessionError.message ||
              "Unable to verify your login session."
            );

          }


          const freshSession =
            freshSessionData?.session;


          const token =
            freshSession?.access_token;


          if (!token) {

            throw new Error(
              "Your login session has expired. Please login again."
            );

          }


          accessToken =
            token;


          currentUser =
            freshSession?.user ||
            currentUser;

          /* =================================================
             GLOBAL STUDENT NAME ON THIS PAGE
          ================================================= */

          const studentAccount =
            document.getElementById(
              "studentAccount"
            );

          if (
            studentAccount &&
            currentUser
          ) {
            const metadata =
              currentUser.user_metadata || {};

            const studentName =
              metadata.full_name ||
              metadata.name ||
              metadata.display_name ||
              currentUser.email?.split("@")[0] ||
              "Student";

            studentAccount.textContent =
              studentName;

            studentAccount.style.display =
              "inline-flex";
          }


          /*
           * Send only the information required
           * by the server.
           *
           * PRICE IS NOT SENT.
           *
           * The server decides ₹499.
           */

          const response =
            await fetch(
              "/api/mock-tests/create-order",
              {

                method:
                  "POST",

                credentials:
                  "same-origin",

                headers: {

                  "Content-Type":
                    "application/json",

                  "Accept":
                    "application/json",

                  "Authorization":
                    `Bearer ${token}`

                },

                body:
                  JSON.stringify({

                    testNumber:
                      TEST_NUMBER

                  })

              }
            );


          const responseText =
            await response.text();


          let data =
            null;


          try {

            data =
              JSON.parse(
                responseText
              );

          } catch {

            console.error(
              "Invalid create-order response:",
              responseText
            );

            throw new Error(
              `The server returned an invalid response (HTTP ${response.status}).`
            );

          }


          if (
            !response.ok
          ) {

            if (
              data?.code ===
              "LOGIN_REQUIRED"
            ) {

              throw new Error(
                "Please login before purchasing the mock test series."
              );

            }


            if (
              data?.code ===
              "ALREADY_PURCHASED"
            ) {

              throw new Error(
                "You already have access to the JPSC Mock Test Series."
              );

            }


            throw new Error(
              data?.error ||
              "Unable to create Razorpay order."
            );

          }


          if (
            !data?.success
          ) {

            throw new Error(
              data?.error ||
              "Unable to create payment order."
            );

          }


          if (
            !data?.order?.id
          ) {

            throw new Error(
              "Razorpay order ID was not returned by the server."
            );

          }


          return data;

        }


        /* =================================================
           OPEN RAZORPAY
        ================================================= */

        function openRazorpay(
          orderData,
          customer
        ) {


          if (
            typeof window.Razorpay ===
            "undefined"
          ) {

            throw new Error(
              "Razorpay Checkout could not be loaded. Please refresh the page and try again."
            );

          }


          const options = {

            key:
              orderData.keyId,

            amount:
              orderData.order.amount,

            currency:
              orderData.order.currency ||
              "INR",

            order_id:
              orderData.order.id,

            name:
              "Habitat IAS",

            description:
              PRODUCT_NAME,

            prefill: {

              name:
                customer.name,

              email:
                customer.email,

              contact:
                customer.mobile

            },

            notes: {

              product:
                PRODUCT_ID,

              product_name:
                PRODUCT_NAME,

              test_number:
                String(
                  TEST_NUMBER
                )

            },

            theme: {

              color:
                "#1557d6"

            },


            handler:
              async function (
                paymentResponse
              ) {

                await verifyPayment(
                  paymentResponse,
                  customer
                );

              },


            modal: {

              ondismiss:
                function () {

                  if (
                    paymentButton
                  ) {

                    paymentButton.disabled =
                      false;

                    paymentButton.textContent =
                      `Continue to Secure Payment — ₹${PRICE}`;

                  }

                }

            }

          };


          const razorpay =
            new window.Razorpay(
              options
            );


          /* =================================================
             PAYMENT FAILURE
          ================================================= */

          razorpay.on(
            "payment.failed",
            function (
              response
            ) {

              console.error(
                "Razorpay payment failed:",
                response
              );


              showError(
                response
                  ?.error
                  ?.description ||
                "Payment failed. Please try again."
              );


              if (
                paymentButton
              ) {

                paymentButton.disabled =
                  false;

                paymentButton.textContent =
                  `Continue to Secure Payment — ₹${PRICE}`;

              }

            }
          );


          /* =================================================
             OPEN CHECKOUT
          ================================================= */

          razorpay.open();

        }


        /* =================================================
           VERIFY PAYMENT
        ================================================= */

        async function verifyPayment(
          paymentResponse,
          customer
        ) {


          if (
            paymentButton
          ) {

            paymentButton.disabled =
              true;

            paymentButton.textContent =
              "Verifying Payment...";

          }


          clearError();


          try {


            /*
             * Get a fresh access token.
             */

            const {
              data:
                sessionData,
              error:
                sessionError
            } =
              await supabase.auth.getSession();


            if (
              sessionError
            ) {

              throw new Error(
                sessionError.message ||
                "Unable to verify your login session."
              );

            }


            const token =
              sessionData
                ?.session
                ?.access_token;


            if (!token) {

              throw new Error(
                "Your login session has expired. Please login again."
              );

            }


            /*
             * Send payment information
             * to server.
             *
             * The server MUST verify:
             *
             * 1. Razorpay signature
             * 2. Order ID
             * 3. Payment ID
             * 4. Payment amount
             * 5. Currency
             * 6. Payment status
             * 7. Authenticated user
             */

            const response =
              await fetch(
                "/api/mock-tests/verify-payment",
                {

                  method:
                    "POST",

                  credentials:
                    "same-origin",

                  headers: {

                    "Content-Type":
                      "application/json",

                    "Accept":
                      "application/json",

                    "Authorization":
                      `Bearer ${token}`

                  },

                  body:
                    JSON.stringify({

                      razorpay_payment_id:
                        paymentResponse
                          .razorpay_payment_id,

                      razorpay_order_id:
                        paymentResponse
                          .razorpay_order_id,

                      razorpay_signature:
                        paymentResponse
                          .razorpay_signature

                    })

                }
              );


            const responseText =
              await response.text();


            let data =
              null;


            try {

              data =
                JSON.parse(
                  responseText
                );

            } catch {

              throw new Error(
                "Payment verification returned an invalid server response."
              );

            }


            if (
              !response.ok
            ) {

              throw new Error(
                data?.error ||
                "Payment verification failed."
              );

            }


            if (
              !data?.success ||
              data?.verified !== true
            ) {

              throw new Error(
                data?.error ||
                "Payment could not be verified."
              );

            }


            /* =================================================
               SUCCESS
            ================================================= */

            if (
              successMessage
            ) {

              successMessage.classList.add(
                "show"
              );

            }


            if (
              paymentButton
            ) {

              paymentButton.textContent =
                "Payment Verified ✓";

              paymentButton.disabled =
                true;

            }


            /*
             * Redirect after a short delay.
             *
             * This gives the user time to see
             * the successful payment message.
             */

            window.setTimeout(
              () => {

                window.location.href =
                  "/mock-tests/";

              },
              1800
            );


          } catch (
            error
          ) {

            console.error(
              "Payment verification error:",
              error
            );


            showError(
              error instanceof Error
                ? error.message
                : "Payment verification failed. Please contact Habitat IAS support."
            );


            if (
              paymentButton
            ) {

              paymentButton.disabled =
                false;

              paymentButton.textContent =
                `Continue to Secure Payment — ₹${PRICE}`;

            }

          }

        }


        /* =================================================
           FORM SUBMISSION
        ================================================= */

        if (
          form
        ) {

          form.addEventListener(
            "submit",
            async function (
              event
            ) {

              event.preventDefault();


              /*
               * Prevent double-click.
               */

              if (
                paymentButton.disabled
              ) {

                return;

              }


              /*
               * Make sure user is authenticated.
               */

              if (
                !accessToken ||
                !currentUser
              ) {

                setLoginRequired();

                showError(
                  "Please login before purchasing the mock test series."
                );

                return;

              }


              const customer =
                validateCustomer();


              if (
                !customer
              ) {

                return;

              }


              /*
               * Lock button.
               */

              paymentButton.disabled =
                true;

              paymentButton.textContent =
                "Creating Secure Payment...";


              try {


                /* =========================================
                   STEP 1
                   CREATE SERVER-SIDE ORDER
                ========================================= */

                const orderData =
                  await createOrder(
                    customer
                  );


                console.log(
                  "Mock-test Razorpay order created:",
                  orderData
                );


                /* =========================================
                   STEP 2
                   OPEN RAZORPAY
                ========================================= */

                openRazorpay(
                  orderData,
                  customer
                );


              } catch (
                error
              ) {

                console.error(
                  "Payment initialization error:",
                  error
                );


                showError(
                  error instanceof Error
                    ? error.message
                    : "Unable to start payment. Please try again."
                );


                paymentButton.disabled =
                  false;

                paymentButton.textContent =
                  `Continue to Secure Payment — ₹${PRICE}`;

              }

            }
          );

        }

      }

    );

  </script>


