export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

if (!supabaseUrl || !supabaseAnonKey) {
  throw new Error("Supabase environment variables are missing.");
}

/*
=========================================================
HABITAT IAS
JPSC PRELIMS — 20 TEST MOCK TEST SERIES
PURCHASE / CHECKOUT PAGE
=========================================================

PRODUCT:
JPSC Prelims 20-Test Mock Test Series

PRICE:
₹499

INCLUDES:
• 20 Mock Tests
• 5 General Studies Tests
• 5 Jharkhand Tests
• 5 Paper-I Full Length Tests
• 5 Paper-II Full Length Tests
• 100 Questions / Test
• 200 Marks / Test
• CBT Interface
• Performance Analysis

IMPORTANT:
The browser NEVER decides the actual payment amount.

The server-side API decides:
₹499 = 49900 paise

PRODUCT ID:
jpsc_prelims_20_test_series
=========================================================
*/


/* =========================================================
   URL
========================================================= */

const requestedTest =
  Number(
    Astro.url.searchParams.get("test") || "1"
  );

const testNumber =
  Number.isInteger(requestedTest) &&
  requestedTest >= 1 &&
  requestedTest <= 20
    ? requestedTest
    : 1;


/* =========================================================
   PRODUCT
========================================================= */

const productName =
  "Habitat IAS — JPSC Prelims 20-Test Mock Test Series";

const productId =
  "jpsc_prelims_20_test_series";

const price =
  499;

const currency =
  "INR";

const totalTests =
  20;


/* =========================================================
   TEST GROUP
========================================================= */

let testGroup =
  "General Studies";

if (
  testNumber >= 6 &&
  testNumber <= 10
) {
  testGroup =
    "Jharkhand Specific";
}

if (
  testNumber >= 11 &&
  testNumber <= 15
) {
  testGroup =
    "Paper-I Full Length";
}

if (
  testNumber >= 16 &&
  testNumber <= 20
) {
  testGroup =
    "Paper-II Full Length";
}


/* =========================================================
   TEST NUMBER DISPLAY
========================================================= */

const testDisplay =
  String(testNumber).padStart(2, "0");

