      grid-template-columns:repeat(4,1fr);
      gap:11px;
      margin-bottom:17px;
    }

    .metric {
      padding:15px;
      background:#f8fafc;
      border:1px solid var(--border);
      border-radius:12px;
    }

    .metric-label {
      color:var(--gray);
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.5px;
