    .info-title {
      margin:0 0 12px;
      color:var(--navy);
      font-size:17px;
      font-weight:900;
    }

    .info-row {
      display:flex;
      justify-content:space-between;
      gap:15px;
      padding:10px 0;
      border-bottom:1px solid var(--border);
      font-size:13px;
    }

    .info-row:last-child {
      border-bottom:none;
    }

    .info-row span:first-child {
      color:var(--gray);
    }

    .info-row span:last-child {
      text-align:right;
      font-weight:800;
    }

    .analysis-card {
      padding:22px;
      margin-bottom:18px;
    }

    .section-title {
      margin:0;
      color:var(--navy);
      font-size:20px;
      font-weight:900;
    }

    .section-subtitle {
      margin:6px 0 17px;
      color:var(--gray);
      font-size:13px;
      line-height:1.5;
    }

