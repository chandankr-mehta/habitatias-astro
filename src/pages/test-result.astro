      font-weight:800;
    }

    .section-label {
      margin:0 0 8px;
      color:var(--gray);
      font-size:10px;
      font-weight:900;
      letter-spacing:.6px;
      text-transform:uppercase;
    }

    .options {
      display:grid;
      gap:8px;
      margin-bottom:17px;
    }

    .option {
      display:flex;
      align-items:flex-start;
      gap:10px;
      padding:10px 12px;
      border:1px solid #dfe6ef;
      border-radius:9px;
      background:#fff;
      color:#334155;
      font-size:13px;
      line-height:1.5;
    }

    .option-key {
      flex:0 0 27px;
      display:grid;
      place-items:center;
      width:27px;
      height:27px;
      border-radius:7px;
      background:#f1f5f9;
      color:#475569;
      font-size:11px;
      font-weight:900;
    }

    .option.correct-option {
      background:var(--green-bg);
      border-color:#86efac;
    }

    .option.correct-option .option-key {
      background:var(--green);
      color:#fff;
    }

    .option.selected-wrong-option {
      background:var(--red-bg);
      border-color:#fca5a5;
    }

    .option.selected-wrong-option .option-key {
      background:var(--red);
      color:#fff;
    }

    .answer-grid {
      display:grid;
      grid-template-columns:1fr 1fr 1fr;
      gap:9px;
      margin-bottom:15px;
    }

    .answer-box {
      padding:11px 12px;
      border:1px solid var(--border);
      border-radius:9px;
      background:#f8fafc;
    }

    .answer-box.selected-correct {
      background:var(--green-bg);
      border-color:#bbf7d0;
    }

    .answer-box.selected-wrong {
      background:var(--red-bg);
      border-color:#fecaca;
    }

    .answer-label {
      margin-bottom:4px;
      color:var(--gray);
      font-size:9px;
      font-weight:900;
      text-transform:uppercase;
    }

    .answer-value {
      color:#0f172a;
      font-size:12px;
      line-height:1.45;
      font-weight:800;
    }

    .explanation {
      padding:14px 15px;
      border:1px solid #bfdbfe;
      border-left:4px solid var(--blue);
      border-radius:10px;
      background:#eff6ff;
    }

    .explanation-title {
      margin-bottom:5px;
      color:#1e40af;
      font-size:10px;
      font-weight:900;
      text-transform:uppercase;
    }

    .explanation-text {
      color:#334155;
      font-size:13px;
      line-height:1.65;
    }

    .meta {
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      margin-top:14px;
      padding-top:12px;
      border-top:1px solid #eef2f7;
    }

    .chip {
      padding:5px 8px;
      border-radius:7px;
      background:#f1f5f9;
      color:var(--gray);
      font-size:9px;
      font-weight:800;
    }

    .empty-review {
      padding:40px 15px;
      text-align:center;
      color:var(--gray);
      background:#fff;
      border-radius:10px;
      font-weight:800;
    }

    .actions {
      display:flex;
      justify-content:flex-end;
      gap:10px;
      padding:20px;
    }

    .action-btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:11px 17px;
      border-radius:9px;
      text-decoration:none;
      font-size:12px;
      font-weight:900;
    }

    .action-primary {
      background:var(--blue);
      color:#fff;
    }

    .action-secondary {
      background:#fff;
      color:var(--navy);
      border:1px solid var(--border);
    }

    @media (max-width:900px) {

      .rank-section {
        grid-template-columns:1fr 1fr;
      }

      .rank-summary-inner {
        flex-direction:column;
        align-items:flex-start;
      }

      .summary-grid {
        grid-template-columns:1fr 1fr;
      }

      .metrics {
        grid-template-columns:1fr 1fr;
      }

    }

    @media (max-width:700px) {

      .page {
        padding:18px 12px 40px;
      }

      .header {
        padding:22px;
      }

      .header-top {
        align-items:flex-start;
        flex-direction:column;
      }

      .header-actions {
        justify-content:flex-start;
      }

      .summary-grid,
      .rank-section,
      .info-grid,
      .metrics {
        grid-template-columns:1fr;
      }

      .answer-grid {
        grid-template-columns:1fr;
      }

      .question-top {
        align-items:flex-start;
        flex-direction:column;
      }

      .actions {
        flex-direction:column;
      }

      .action-btn {
        width:100%;
      }

    }

  </style>

</head>

<body>

  <main class="page">

    <div class="container">

      <header class="header">

        <div class="header-top">

          <div>

            <div class="brand">
              Habitat IAS • JPSC Mock Test
            </div>

            <h1 id="resultTitle">
              Test Result
            </h1>

            <p>
              Detailed performance and question-wise analysis.
            </p>

          </div>

          <div class="header-actions">

            <a
              href="/results"
              class="header-btn"
            >
              ← All Results
            </a>

            <a
              href="/dashboard"
              class="header-btn"
            >
              Dashboard
            </a>

          </div>

        </div>

      </header>


      {
        pageError ? (

          <div class="error">
            {pageError}
          </div>

        ) : (

          <div
            id="resultContent"
            class="content"
            style="display:block;"
          >

            <!-- =================================================
                 SUMMARY
            ================================================= -->

            <section class="summary-grid">

              <div class="card score-card">

                <div class="label">
                  Score
                </div>

                <div
                  class="score"
                  id="scoreEl"
                >
                  {score}
                </div>

                <div
                  class="percentage"
                  id="percentageEl"
                >
                  {percentage.toFixed(2)}%
                </div>

                <div class="rule">
                  No negative marking • 2 marks for every correct answer
                </div>

              </div>


              <div class="card stat-card">

                <div class="label">
                  Correct
                </div>

                <div class="stat-number correct">
                  {correct}
                </div>

              </div>


              <div class="card stat-card">

                <div class="label">
                  Incorrect
                </div>

                <div class="stat-number incorrect">
                  {incorrect}
                </div>

              </div>


              <div class="card stat-card">

                <div class="label">
                  Unanswered
                </div>

                <div class="stat-number unanswered">
                  {unanswered}
                </div>

              </div>

            </section>


            <!-- =================================================
                 LIVE PERFORMANCE / BEST-ATTEMPT RANKING
            ================================================= -->

            <section class="rank-section">

              <div class="card rank-card rank-highlight">

                <div class="label">
                  Your Rank
                </div>

                <div class="rank-value">
                  #{testRank || "—"}
                </div>

                <div class="rank-subtitle">
                  Among {totalParticipants}
                  participants
                </div>

              </div>


              <div class="card rank-card">

                <div class="label">
                  Participants
                </div>

                <div class="rank-value">
                  {totalParticipants || 0}
                </div>

                <div class="rank-subtitle">
                  Unique students
                </div>

              </div>


              <div class="card rank-card">

                <div class="label">
                  Your Best Score
                </div>

                <div class="rank-value">
                  {currentBestScore}
                </div>

                <div class="rank-subtitle">
                  Highest submitted score
                </div>

              </div>


              <div class="card rank-card">

                <div class="label">
                  Top Score
                </div>

                <div class="rank-value">
                  {topScore || 0}
                </div>

                <div class="rank-subtitle">
                  Best score in this mock
                </div>

              </div>


              <div class="card rank-card">

                <div class="label">
                  Percentile
                </div>

                <div class="rank-value">
                  {percentile.toFixed(2)}%
                </div>

                <div class="rank-subtitle">
                  Based on your best score
                </div>

              </div>

            </section>


            <section class="card rank-summary-card">

              <div class="rank-summary-inner">

                <div>

                  <div class="label">
                    Average Best Score
                  </div>

                  <div class="rank-summary-value">
                    {averageBestScore.toFixed(1)}
                    / {maximumMarks}
                  </div>

                </div>

                <div class="rank-summary-text">

                  Ranking uses each student's
                  highest submitted score for
                  this mock test.

                  Retakes do not create
                  additional leaderboard positions.

                </div>

              </div>

            </section>


            <!-- =================================================
                 INFORMATION
            ================================================= -->

            <section class="info-grid">

              <div class="card info-card">

                <h2 class="info-title">
                  Attempt Information
                </h2>

                <div class="info-row">

                  <span>
                    Status
                  </span>

                  <span>
                    {attempt?.status || "submitted"}
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Time Taken
                  </span>

                  <span id="timeUsedEl">
                    —
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Submitted At
                  </span>

                  <span>
                    {attempt?.submitted_at
                      ? new Date(
                          attempt.submitted_at
                        ).toLocaleString(
                          "en-IN",
                          {
                            day:"2-digit",
                            month:"short",
                            year:"numeric",
                            hour:"2-digit",
                            minute:"2-digit"
                          }
                        )
                      : "—"}
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Attempt ID
                  </span>

                  <span>
                    {attempt?.id}
                  </span>

                </div>

              </div>


              <div class="card info-card">

                <h2 class="info-title">
                  Test Information
                </h2>

                <div class="info-row">

                  <span>
                    Test
                  </span>

                  <span>
                    {test?.title || "Mock Test"}
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Total Questions
                  </span>

                  <span>
                    {totalQuestions}
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Maximum Marks
                  </span>

                  <span>
                    {maximumMarks}
                  </span>

                </div>

                <div class="info-row">

                  <span>
                    Marks Per Question
                  </span>

                  <span>
                    2
                  </span>

                </div>

              </div>

            </section>


            <!-- =================================================
                 PERFORMANCE
            ================================================= -->

            <section class="card analysis-card">

              <h2 class="section-title">
                Performance Analysis
              </h2>

              <p class="section-subtitle">
                Understand your accuracy, attempt rate, time usage and score efficiency.
              </p>


              <div class="metrics">

                <div class="metric">

                  <div class="metric-label">
                    Accuracy
                  </div>

                  <div class="metric-value">
                    {accuracy.toFixed(1)}%
                  </div>

                </div>


                <div class="metric">

                  <div class="metric-label">
                    Attempt Rate
                  </div>

                  <div class="metric-value">
                    {attemptRate.toFixed(1)}%
                  </div>

                </div>


                <div class="metric">

                  <div class="metric-label">
                    Avg. Time / Question
                  </div>

                  <div
                    class="metric-value"
                    id="averageTimeEl"
                  >
                    —
                  </div>

                </div>


                <div class="metric">

                  <div class="metric-label">
                    Score Efficiency
                  </div>

                  <div class="metric-value">
                    {scoreEfficiency.toFixed(1)}%
                  </div>

                </div>

              </div>


              <div class="bars">

                <div>

                  <div class="bar-label">

                    <span>
                      Correct
                    </span>

                    <span>
                      {correct}
                      ({(
                        totalQuestions > 0
                          ? correct / totalQuestions * 100
                          : 0
                      ).toFixed(1)}%)
                    </span>

                  </div>

                  <div class="bar-track">

                    <div
                      class="bar-fill correct"
                      style={`width:${
                        totalQuestions > 0
                          ? correct / totalQuestions * 100
                          : 0
                      }%`}
                    ></div>

                  </div>

                </div>


                <div>

                  <div class="bar-label">

                    <span>
                      Incorrect
                    </span>

                    <span>
                      {incorrect}
                      ({(
                        totalQuestions > 0
                          ? incorrect / totalQuestions * 100
                          : 0
                      ).toFixed(1)}%)
                    </span>

                  </div>

                  <div class="bar-track">

                    <div
                      class="bar-fill incorrect"
                      style={`width:${
                        totalQuestions > 0
                          ? incorrect / totalQuestions * 100
                          : 0
                      }%`}
                    ></div>

                  </div>

                </div>


                <div>

                  <div class="bar-label">

                    <span>
                      Unanswered
                    </span>

                    <span>
                      {unanswered}
                      ({(
                        totalQuestions > 0
                          ? unanswered / totalQuestions * 100
                          : 0
                      ).toFixed(1)}%)
                    </span>

                  </div>

                  <div class="bar-track">

                    <div
                      class="bar-fill unanswered"
                      style={`width:${
                        totalQuestions > 0
                          ? unanswered / totalQuestions * 100
                          : 0
                      }%`}
                    ></div>

                  </div>

                </div>

              </div>


              <div class="analysis-note">

                {
                  accuracy >= 80
                    ? "Excellent accuracy. Focus on maintaining speed and continue reviewing difficult questions."
                    : accuracy >= 60
                      ? "Good foundation. Review incorrect answers carefully and revise the topics where mistakes are concentrated."
                      : accuracy > 0
                        ? "Accuracy needs improvement. Prioritize concept revision and analyze every incorrect answer before your next attempt."
                        : "No questions were answered. Review the syllabus and attempt the test again when ready."
                }

              </div>

            </section>


            <!-- =================================================
                 QUESTION REVIEW
            ================================================= -->

            <section class="card review-card">

              <div class="review-header">

                <h2 class="section-title">
                  Question-wise Review
                </h2>

                <p class="section-subtitle">
                  Every question from the test is shown. Unanswered questions are also retained.
                </p>

              </div>


              <div class="filters">

                <button
                  class="filter-btn active"
                  data-filter="all"
                >
                  All
                </button>

                <button
                  class="filter-btn"
                  data-filter="correct"
                >
                  ✓ Correct
                </button>

                <button
                  class="filter-btn"
                  data-filter="incorrect"
                >
                  ✕ Incorrect
                </button>

                <button
                  class="filter-btn"
                  data-filter="unanswered"
                >
                  ○ Unanswered
                </button>

              </div>


              <div
                id="reviewList"
                class="review-list"
              ></div>

            </section>


            <!-- =================================================
                 ACTIONS
            ================================================= -->

            <section class="card actions">

              <a
                href="/results"
                class="action-btn action-secondary"
              >
                ← Back to Results
              </a>

              <a
                href="/mock-tests"
                class="action-btn action-primary"
              >
                ← Back to Mock Tests
              </a>

            </section>

          </div>

        )
      }

    </div>

  </main>


  <!-- =======================================================
       SERVER DATA → CLIENT
  ======================================================== -->

  {
    !pageError && (

      <script
        type="application/json"
        id="resultData"
        set:html={JSON.stringify(clientResult)}
      ></script>

    )
  }


  <script>

    /* =====================================================
       CLIENT RESULT RENDERING
    ===================================================== */

    const resultDataElement =
      document.getElementById(
        "resultData"
      );

    if (!resultDataElement) {
      console.error(
        "[Habitat IAS] Result data element missing."
      );
    } else {

      let resultData;

      try {

        resultData =
          JSON.parse(
            resultDataElement.textContent || "{}"
          );

      } catch (error) {

        console.error(
          "[Habitat IAS] RESULT DATA PARSE ERROR:",
          error
        );

        resultData = null;
      }


      if (resultData) {

        const reviewAnswers =
          resultData.reviewAnswers || [];

        let currentFilter =
          "all";


        /* =================================================
           HELPERS
        ================================================= */

        function escapeHtml(value) {

          return String(
            value ?? ""
          )
            .replace(
              /&/g,
              "&amp;"
            )
            .replace(
              /</g,
              "&lt;"
            )
            .replace(
              />/g,
              "&gt;"
            )
            .replace(
              /"/g,
              "&quot;"
            )
            .replace(
              /'/g,
              "&#039;"
            );

        }


        function formatTime(
          seconds
        ) {

          const total =
            Math.max(
              0,
              Number(
                seconds || 0
              )
            );

          const hours =
            Math.floor(
              total / 3600
            );

          const minutes =
            Math.floor(
              (total % 3600) / 60
            );

          const secs =
            total % 60;


          if (hours > 0) {

            return (
              String(hours)
                .padStart(2, "0") +
              ":" +
              String(minutes)
                .padStart(2, "0") +
              ":" +
              String(secs)
                .padStart(2, "0")
            );

          }


          return (
            String(minutes)
              .padStart(2, "0") +
            ":" +
            String(secs)
              .padStart(2, "0")
          );

        }


        function getAnswerStatus(
          answer
        ) {

          if (
            !answer.selected_option
          ) {

            return "unanswered";
          }


          return answer.is_correct
            ? "correct"
            : "incorrect";

        }


        function getOptionText(
          question,
          option
        ) {

          if (!option) {
            return "Not Answered";
          }


          const key =
            String(option)
              .toLowerCase();


          if (key === "a") {
            return (
              "A. " +
              (question.option_a || "")
            );
          }


          if (key === "b") {
            return (
              "B. " +
              (question.option_b || "")
            );
          }


          if (key === "c") {
            return (
              "C. " +
              (question.option_c || "")
            );
          }


          if (key === "d") {
            return (
              "D. " +
              (question.option_d || "")
            );
          }


          return String(
            option
          ).toUpperCase();

        }


        /* =================================================
           TIME
        ================================================= */

        const timeUsedEl =
          document.getElementById(
            "timeUsedEl"
          );

        if (timeUsedEl) {

          timeUsedEl.textContent =
            formatTime(
              resultData.attempt
                ?.time_taken_seconds
            );

        }


        const averageTimeEl =
          document.getElementById(
            "averageTimeEl"
          );

        if (averageTimeEl) {

          averageTimeEl.textContent =
            formatTime(
              resultData.averageTime
            );

        }


        /* =================================================
           RENDER REVIEW
        ================================================= */

        function renderReview() {

          const reviewList =
            document.getElementById(
              "reviewList"
            );

          if (!reviewList) {
            return;
          }


          const filtered =
            reviewAnswers.filter(
              answer => {

                const status =
                  getAnswerStatus(
                    answer
                  );

                return (
                  currentFilter ===
                    "all" ||
                  status ===
                    currentFilter
                );

              }
            );


          if (
            filtered.length === 0
          ) {

            reviewList.innerHTML = `
              <div class="empty-review">
                No questions found in this category.
              </div>
            `;

            return;
          }


          reviewList.innerHTML =
            filtered
              .map(
                answer => {

                  const status =
                    getAnswerStatus(
                      answer
                    );


                  const selectedOption =
                    answer.selected_option
                      ? String(
                          answer.selected_option
                        ).toLowerCase()
                      : "";


                  const correctOption =
                    answer.correct_option
                      ? String(
                          answer.correct_option
                        ).toLowerCase()
                      : "";


                  const selectedText =
                    selectedOption
                      ? getOptionText(
                          answer,
                          selectedOption
                        )
                      : "Not Answered";


                  const correctText =
                    getOptionText(
                      answer,
                      correctOption
                    );


                  const selectedBoxClass =
                    status ===
                    "correct"
                      ? "selected-correct"
                      : status ===
                          "incorrect"
                        ? "selected-wrong"
                        : "";


                  function optionClass(
                    key
                  ) {

                    const isCorrect =
                      correctOption ===
                      key;

                    const isSelected =
                      selectedOption ===
                      key;


                    if (
                      isSelected &&
                      isCorrect
                    ) {

                      return "correct-option";
                    }


                    if (
                      isSelected &&
                      !isCorrect
                    ) {

                      return "selected-wrong-option";
                    }


                    if (isCorrect) {

                      return "correct-option";
                    }


                    return "";
                  }


                  const resultText =
                    status ===
                    "correct"
                      ? "✓ Correct — 2 marks"
                      : status ===
                          "incorrect"
                        ? "✕ Incorrect — 0 marks"
                        : "○ Not answered — 0 marks";


                  return `

                    <article class="question-card">

                      <div class="question-top">

                        <div class="question-number">

                          Question
                          ${escapeHtml(
                            answer.question_number
                          )}

                        </div>


                        <div
                          class="status-badge ${status}"
                        >

                          ${
                            status ===
                            "correct"
                              ? "✓ Correct"
                              : status ===
                                  "incorrect"
                                ? "✕ Incorrect"
                                : "○ Unanswered"
                          }

                        </div>

                      </div>


                      <div class="question-body">

                        <div class="section-label">
                          Question
                        </div>

                        <div class="question-text">

                          ${escapeHtml(
                            answer.question_text
                          )}

                        </div>


                        <div class="section-label">
                          Options
                        </div>


                        <div class="options">

                          <div
                            class="option ${optionClass("a")}"
                          >

                            <span class="option-key">
                              A
                            </span>

                            <span>
                              ${escapeHtml(
                                answer.option_a
                              )}
                            </span>

                          </div>


                          <div
                            class="option ${optionClass("b")}"
                          >

                            <span class="option-key">
                              B
                            </span>

                            <span>
                              ${escapeHtml(
                                answer.option_b
                              )}
                            </span>

                          </div>


                          <div
                            class="option ${optionClass("c")}"
                          >

                            <span class="option-key">
                              C
                            </span>

                            <span>
                              ${escapeHtml(
                                answer.option_c
                              )}
                            </span>

                          </div>


                          <div
                            class="option ${optionClass("d")}"
                          >

                            <span class="option-key">
                              D
                            </span>

                            <span>
                              ${escapeHtml(
                                answer.option_d
                              )}
                            </span>

                          </div>

                        </div>


                        <div class="answer-grid">

                          <div
                            class="answer-box ${selectedBoxClass}"
                          >

                            <div class="answer-label">
                              Your Answer
                            </div>

                            <div class="answer-value">
                              ${escapeHtml(
                                selectedText
                              )}
                            </div>

                          </div>


                          <div class="answer-box">

                            <div class="answer-label">
                              Correct Answer
                            </div>

                            <div class="answer-value">
                              ${escapeHtml(
                                correctText
                              )}
                            </div>

                          </div>


                          <div class="answer-box">

                            <div class="answer-label">
                              Result
                            </div>

                            <div class="answer-value">
                              ${escapeHtml(
                                resultText
                              )}
                            </div>

                          </div>

                        </div>


                        ${
                          answer.explanation
                            ? `

                              <div class="explanation">

                                <div class="explanation-title">
                                  Explanation
                                </div>

                                <div class="explanation-text">

                                  ${escapeHtml(
                                    answer.explanation
                                  )}

                                </div>

                              </div>

                            `
                            : ""
                        }


                        <div class="meta">

                          ${
                            answer.subject
                              ? `

                                <span class="chip">

                                  Subject:
                                  ${escapeHtml(
                                    answer.subject
                                  )}

                                </span>

                              `
                              : ""
                          }


                          ${
                            answer.topic
                              ? `

                                <span class="chip">

                                  Topic:
                                  ${escapeHtml(
                                    answer.topic
                                  )}

                                </span>

                              `
                              : ""
                          }


                          ${
                            answer.difficulty
                              ? `

                                <span class="chip">

                                  Difficulty:
                                  ${escapeHtml(
                                    answer.difficulty
                                  )}

                                </span>

                              `
                              : ""
                          }


                          <span class="chip">

                            Question ID:
                            ${escapeHtml(
                              answer.question_id
                            )}

                          </span>

                        </div>

                      </div>

                    </article>

                  `;

                }
              )
              .join("");

        }


        /* =================================================
           FILTER BUTTONS
        ================================================= */

        document
          .querySelectorAll(
            ".filter-btn"
          )
          .forEach(
            button => {

              button.addEventListener(
                "click",
                () => {

                  currentFilter =
                    button.dataset.filter ||
                    "all";


                  document
                    .querySelectorAll(
                      ".filter-btn"
                    )
                    .forEach(
                      btn =>
                        btn.classList.remove(
                          "active"
                        )
                    );


                  button.classList.add(
                    "active"
                  );


                  renderReview();

                }
              );

            }
          );


        /* =================================================
           INITIAL RENDER
        ================================================= */

        renderReview();


        console.log(
          "[Habitat IAS] TEST RESULT LOADED",
          {
            attemptId:
              resultData.attempt?.id,

            testId:
              resultData.test?.id,

            questionCount:
              reviewAnswers.length,

            correct:
              resultData.correct,

            incorrect:
              resultData.incorrect,

            unanswered:
              resultData.unanswered,

            score:
              resultData.score,

            maximumMarks:
              resultData.maximumMarks
          }
        );

      }

    }

  </script>

</body>

</html>