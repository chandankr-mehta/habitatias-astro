<!doctype html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Test Result | Habitat IAS
  </title>

  <style is:global>

    :root {
      --navy:#082b61;
      --blue:#2563eb;
      --blue-dark:#1d4ed8;
      --green:#15803d;
      --green-bg:#f0fdf4;
      --red:#dc2626;
      --red-bg:#fef2f2;
      --gray:#64748b;
      --gray-dark:#334155;
      --border:#e2e8f0;
      --bg:#f1f5f9;
      --white:#fff;
    }

    * {
      box-sizing:border-box;
    }

    html {
      scroll-behavior:smooth;
    }

    body {
      margin:0;
      font-family:Inter,system-ui,-apple-system,
        BlinkMacSystemFont,"Segoe UI",sans-serif;
      background:var(--bg);
      color:#0f172a;
    }

    button,
    a {
      font-family:inherit;
    }

    button {
      cursor:pointer;
    }

    .page {
      min-height:100vh;
      padding:28px 18px 60px;
    }

    .container {
      width:100%;
      max-width:1150px;
      margin:0 auto;
    }

    .header {
      background:var(--navy);
      color:#fff;
      border-radius:18px;
      padding:28px 30px;
      margin-bottom:20px;
      box-shadow:0 10px 30px rgba(15,23,42,.10);
    }

    .header-top {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
    }

    .brand {
      font-size:13px;
      font-weight:900;
      letter-spacing:1.2px;
      text-transform:uppercase;
      opacity:.85;
    }

    .header h1 {
      margin:8px 0 5px;
      font-size:32px;
      line-height:1.15;
    }

    .header p {
      margin:0;
      color:#dbeafe;
      font-size:14px;
    }

    .header-actions {
      display:flex;
      gap:9px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .header-btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:10px 14px;
      border-radius:9px;
      text-decoration:none;
      font-size:12px;
      font-weight:900;
      background:#fff;
      color:var(--navy);
    }

    .loading,
    .error {
      background:#fff;
      border-radius:16px;
      padding:45px 20px;
      text-align:center;
      font-weight:800;
      box-shadow:0 8px 25px rgba(15,23,42,.06);
    }

    .loading {
      color:var(--gray);
    }

    .error {
      color:var(--red);
    }

    .content {
      display:none;
    }

    .summary-grid {
      display:grid;
      grid-template-columns:1.25fr repeat(3,1fr);
      gap:14px;
      margin-bottom:18px;
    }

    .card {
