---
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

/* =========================================================
   HABITAT IAS — TEST RESULT
   SERVER-SIDE RESULT LOADING

   IMPORTANT:
   Questions are loaded using the server-side service-role
   client so RLS on mock_questions cannot break the result
   page.

   Security:
   - User must be authenticated.
   - Attempt must belong to the authenticated user.
   - Questions are loaded only for the attempt's test.
========================================================= */

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL;

const serviceRoleKey =
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

if (!supabaseUrl) {
  throw new Error(
    "PUBLIC_SUPABASE_URL is missing."
  );
}

if (!serviceRoleKey) {
  throw new Error(
    "SUPABASE_SERVICE_ROLE_KEY is missing."
  );
}

const supabaseAdmin =
  createClient(
    supabaseUrl,
    serviceRoleKey,
    {
      auth: {
        autoRefreshToken: false,
        persistSession: false,
      },
    }
  );


/* =========================================================
   GET ACCESS TOKEN

   The project already creates:
   habitat-access-token

   after successful login.
========================================================= */

function getAccessToken(): string | null {

  const cookieHeader =
    Astro.request.headers.get("cookie");

  if (!cookieHeader) {
    return null;
  }

  const parts =
    cookieHeader.split(";");

  for (const part of parts) {

    const separator =
      part.indexOf("=");

    if (separator === -1) {
      continue;
    }

    const name =
      part
        .slice(0, separator)
        .trim();

    const value =
      part
        .slice(separator + 1)
        .trim();

    if (
      name ===
      "habitat-access-token"
    ) {
      return value || null;
    }
  }

  return null;
}


/* =========================================================
   RESULT DATA
========================================================= */

let pageError = "";

let attempt: any = null;
let test: any = null;
let questions: any[] = [];
let answers: any[] = [];

const url =
  new URL(
    Astro.request.url
  );

const attemptId =
  url.searchParams.get(
    "attempt_id"
  );


/* =========================================================
   AUTHENTICATE USER
========================================================= */

const accessToken =
  getAccessToken();

let user: any = null;

if (!accessToken) {

  pageError =
    "Your login session has expired. Please login again.";

} else {

  const {
    data: userData,
    error: userError,
  } =
    await supabaseAdmin.auth.getUser(
      accessToken
    );

  if (
    userError ||
    !userData?.user
  ) {

    pageError =
      "Your login session has expired. Please login again.";

  } else {

    user =
      userData.user;
  }
}


/* =========================================================
   LOAD ATTEMPT
========================================================= */

if (
  !pageError &&
  !attemptId
) {

  pageError =
    "No test attempt was specified. Please open the result from the Results page.";

}


if (
  !pageError &&
  user &&
  attemptId
) {

  const {
    data,
    error
  } =
    await supabaseAdmin
      .from("mock_attempts")
      .select(`
        id,
        user_id,
        test_id,
        started_at,
        submitted_at,
        score,
        correct_count,
        incorrect_count,
        unanswered_count,
        time_taken_seconds,
        status
      `)
      .eq(
        "id",
        attemptId
      )
      .eq(
        "user_id",
        user.id
      )
      .maybeSingle();

  if (error) {

    console.error(
      "[Habitat IAS] ATTEMPT ERROR:",
      error
    );

    pageError =
      "Unable to load your test result.";

  } else if (!data) {

    pageError =
      "Test result not found or you do not have permission to view it.";

  } else {

    attempt =
      data;
  }
}


/* =========================================================
   LOAD TEST
========================================================= */

if (
  !pageError &&
  attempt
) {

  const {
    data,
    error
  } =
    await supabaseAdmin
      .from("mock_tests")
      .select(`
        id,
        test_number,
        title,
        question_count
      `)
      .eq(
        "id",
        attempt.test_id
      )
      .maybeSingle();

  if (error) {

    console.error(
      "[Habitat IAS] TEST ERROR:",
      error
    );

    pageError =
      "Unable to load the mock test.";

  } else {

    test =
      data;

    if (!test) {

      pageError =
        "The mock test associated with this attempt was not found.";
    }
  }
}


/* =========================================================
   LOAD ALL QUESTIONS

   IMPORTANT FIX:
   This uses supabaseAdmin on the SERVER.

   The normal browser Supabase client was causing the
   "Unable to load the questions for this test" error.
========================================================= */

if (
  !pageError &&
  attempt
) {

  const {
    data,
    error
  } =
    await supabaseAdmin
      .from("mock_questions")
      .select(`
        id,
        test_id,
        question_number,
        question_text,
        option_a,
        option_b,
        option_c,
        option_d,
        correct_option,
        explanation,
        subject,
        topic,
        difficulty,
        marks,
        negative_marks
      `)
      .eq(
        "test_id",
        attempt.test_id
      )
      .order(
        "question_number",
        {
          ascending: true
        }
      );

  if (error) {

    console.error(
      "[Habitat IAS] QUESTIONS ERROR:",
      error
    );

    pageError =
      "Unable to load the questions for this test.";

  } else {

    questions =
      data || [];
  }
}


/* =========================================================
   LOAD SUBMITTED ANSWERS
========================================================= */

if (
  !pageError &&
  attempt
) {

  const {
    data,
    error
  } =
    await supabaseAdmin
      .from("mock_answers")
      .select(`
        id,
        attempt_id,
        question_id,
        selected_option,
        is_correct,
        answered_at
      `)
      .eq(
        "attempt_id",
        attempt.id
      );

  if (error) {

    console.error(
      "[Habitat IAS] ANSWERS ERROR:",
      error
    );

    pageError =
      "Unable to load your submitted answers.";

  } else {

    answers =
      data || [];
  }
}


/* =========================================================
   BUILD QUESTION-WISE RESULT DATA
========================================================= */

let reviewAnswers: any[] = [];

if (
  !pageError
) {

  const answerMap =
    new Map();

  for (
    const answer of answers
  ) {

    answerMap.set(
      String(
        answer.question_id
      ),
      answer
    );
  }


  reviewAnswers =
    questions.map(
      (
        question,
        index
      ) => {

        const savedAnswer =
          answerMap.get(
            String(
              question.id
            )
          );

        return {

          question_id:
            question.id,

          question_number:
            question.question_number ||
            index + 1,

          question_text:
            question.question_text,

          option_a:
            question.option_a,

          option_b:
            question.option_b,

          option_c:
            question.option_c,

          option_d:
            question.option_d,

          correct_option:
            question.correct_option,

          explanation:
            question.explanation,

          subject:
            question.subject,

          topic:
            question.topic,

          difficulty:
            question.difficulty,

          marks:
            question.marks,

          negative_marks:
            question.negative_marks,

          selected_option:
            savedAnswer
              ? savedAnswer.selected_option
              : null,

          is_correct:
            savedAnswer
              ? Boolean(
                  savedAnswer.is_correct
                )
              : false,

          answered_at:
            savedAnswer
              ? savedAnswer.answered_at
              : null
        };
      }
    );
}


/* =========================================================
   SCORE

   NO NEGATIVE MARKING
   2 marks per correct answer.
========================================================= */

const correct =
  Number(
    attempt?.correct_count || 0
  );

const incorrect =
  Number(
    attempt?.incorrect_count || 0
  );

const unanswered =
  Number(
    attempt?.unanswered_count || 0
  );

const totalQuestions =
  reviewAnswers.length ||
  correct +
  incorrect +
  unanswered;

const maximumMarks =
  totalQuestions * 2;

const score =
  correct * 2;

const percentage =
  maximumMarks > 0
    ? (
        score /
        maximumMarks
      ) * 100
    : 0;

const attempted =
  correct +
  incorrect;

const accuracy =
  attempted > 0
    ? (
        correct /
        attempted
      ) * 100
    : 0;

const attemptRate =
  totalQuestions > 0
    ? (
        attempted /
        totalQuestions
      ) * 100
    : 0;

const scoreEfficiency =
  maximumMarks > 0
    ? (
        score /
        maximumMarks
      ) * 100
    : 0;

/* =========================================================
   LIVE BEST-ATTEMPT RANKING

   Ranking is calculated among UNIQUE students who have
   submitted the SAME mock test.

   If a student has multiple submissions, only that
   student's BEST score is used.
========================================================= */

let testRank = 0;
let totalParticipants = 0;
let topScore = 0;
let averageBestScore = 0;
let percentile = 0;
let currentBestScore = score;

if (
  !pageError &&
  attempt?.test_id &&
  attempt?.user_id
) {
  const {
    data: rankingAttempts,
    error: rankingError
  } = await supabaseAdmin
    .from("mock_attempts")
    .select(`
      user_id,
      score,
      status
    `)
    .eq(
      "test_id",
      attempt.test_id
    )
    .eq(
      "status",
      "submitted"
    );

  if (rankingError) {
    console.error(
      "[Habitat IAS] RANKING ERROR:",
      rankingError
    );
  } else {
    const bestScoresByStudent =
      new Map<string, number>();

    for (
      const row
      of rankingAttempts || []
    ) {
      const studentId =
        row.user_id;

      const studentScore =
        Number(
          row.score || 0
        );

      if (!studentId) {
        continue;
      }

      const previousBest =
        bestScoresByStudent.get(
          studentId
        );

      if (
        previousBest === undefined ||
        studentScore > previousBest
      ) {
        bestScoresByStudent.set(
          studentId,
          studentScore
        );
      }
    }

    const bestScores =
      Array.from(
        bestScoresByStudent.values()
      ).sort(
        (a, b) => b - a
      );

    totalParticipants =
      bestScores.length;

    topScore =
      bestScores.length > 0
        ? bestScores[0]
        : 0;

    averageBestScore =
      bestScores.length > 0
        ? bestScores.reduce(
            (sum, value) =>
              sum + value,
            0
          ) /
          bestScores.length
        : 0;

    const currentStudentBest =
      bestScoresByStudent.get(
        attempt.user_id
      ) ?? score;

    currentBestScore =
      currentStudentBest;

    const higherScores =
      bestScores.filter(
        value =>
          value >
          currentStudentBest
      ).length;

    testRank =
      totalParticipants > 0
        ? higherScores + 1
        : 1;

    const lowerScores =
      bestScores.filter(
        value =>
          value <
          currentStudentBest
      ).length;

    percentile =
      totalParticipants > 0
        ? (
            lowerScores /
            totalParticipants
          ) * 100
        : 0;
  }
}

const timeUsed =
  Number(
    attempt?.time_taken_seconds || 0
  );

const averageTime =
  totalQuestions > 0
    ? Math.round(
        timeUsed /
        totalQuestions
      )
    : 0;


/* =========================================================
   SAFE JSON FOR CLIENT
========================================================= */

const clientResult = {

  attempt: {
    id:
      attempt?.id ?? null,

    status:
      attempt?.status ?? "submitted",

    submitted_at:
      attempt?.submitted_at ?? null,

    time_taken_seconds:
      timeUsed,

    correct_count:
      correct,

    incorrect_count:
      incorrect,

    unanswered_count:
      unanswered
  },

  test: {
    id:
      test?.id ?? null,

    test_number:
      test?.test_number ?? null,

    title:
      test?.title ??
      "Mock Test",

    question_count:
      test?.question_count ??
      totalQuestions
  },

  score,
  maximumMarks,
  percentage,

  correct,
  incorrect,
  unanswered,

  totalQuestions,

  accuracy,
  attemptRate,
  averageTime,
  scoreEfficiency,

  testRank,
  totalParticipants,
  topScore,
  averageBestScore,
  percentile,
  currentBestScore,

  reviewAnswers
};


/* =========================================================
   REDIRECT IF SESSION INVALID
========================================================= */

if (
  pageError &&
  (
    pageError.includes(
      "session"
    ) ||
    pageError.includes(
      "login"
    )
  )
) {

  Astro.redirect(
    `/login?redirect=${encodeURIComponent(
      Astro.url.pathname +
      Astro.url.search
    )}`
  );
}

