    }

    .score {
      margin-top:7px;
      color:var(--navy);
      font-size:46px;
      font-weight:900;
      line-height:1;
    }

    .percentage {
      margin-top:8px;
      color:var(--blue);
      font-size:17px;
      font-weight:900;
