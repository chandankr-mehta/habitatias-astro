---
const email = "habitatiaspcs@gmail.com";
const mobile = "9625719269";

const youtube = "https://www.youtube.com/@habitatias";
const telegram = "https://t.me/Habitat_IAS";
const twitter = "https://x.com/Habitatias";
const bookLink = "https://linktr.ee/HabitatIAS";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Contact Habitat IAS for JPSC preparation, study resources, PYQs, mock tests and educational content."
    />

    <meta
      name="keywords"
      content="Habitat IAS contact, JPSC preparation, JPSC PYQ, Jharkhand PSC, JPSC study material"
    />

    <title>Contact | Habitat IAS</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family:
          Arial,
          Helvetica,
          sans-serif;

        background: #f5f7fb;

        color: #172033;

        line-height: 1.6;
      }

      a {
        text-decoration: none;
      }

      /* =========================
         HEADER
      ========================= */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;

        background: rgba(255, 255, 255, 0.97);

        border-bottom: 1px solid #e5e9f2;

        backdrop-filter: blur(10px);
      }

      .nav {
        max-width: 1280px;

        min-height: 82px;

        margin: 0 auto;

        padding: 14px 28px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 25px;
      }

      .logo {
        display: flex;

        align-items: center;

        gap: 12px;

        color: #1657d9;

        font-size: 25px;

        font-weight: 800;

        white-space: nowrap;
      }

      .logo-mark {
        width: 48px;
        height: 48px;

        border-radius: 13px;

        background: #1657d9;

        color: white;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 25px;

        font-weight: 800;
      }

      .nav-links {
        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 22px;

        flex-wrap: wrap;
      }

      .nav-links a {
        color: #44506a;

        font-size: 15px;

        font-weight: 700;

        transition: 0.2s ease;
      }

      .nav-links a:hover {
        color: #1657d9;
      }

      .nav-cta {
        background: #1657d9;

        color: white !important;

        padding: 13px 20px;

        border-radius: 10px;
      }

      /* =========================
         HERO
      ========================= */

      .hero {
        background:
          linear-gradient(
            135deg,
            #102f82,
            #1657d9,
            #2d72e8
          );

        color: white;

        padding: 80px 28px 105px;
      }

      .hero-inner {
        max-width: 950px;

        margin: 0 auto;

        text-align: center;
      }

      .eyebrow {
        display: inline-block;

        padding: 8px 17px;

        border-radius: 999px;

        border: 1px solid rgba(255, 255, 255, 0.35);

        background: rgba(255, 255, 255, 0.1);

        font-size: 13px;

        font-weight: 800;

        letter-spacing: 0.7px;

        margin-bottom: 20px;
      }

      .hero h1 {
        font-size: clamp(44px, 6vw, 72px);

        line-height: 1.02;

        font-weight: 900;

        margin-bottom: 20px;
      }

      .hero h1 span {
        color: #ffd43b;
      }

      .hero p {
        max-width: 720px;

        margin: 0 auto;

        font-size: 19px;

        color: rgba(255, 255, 255, 0.9);
      }

      /* =========================
         MAIN
      ========================= */

      .main {
        max-width: 1100px;

        margin: -65px auto 0;

        position: relative;

        z-index: 5;

        padding: 0 22px 80px;
      }

      /* =========================
         CONTACT CARD
      ========================= */

      .contact-card {
        background: white;

        border-radius: 22px;

        padding: 45px;

        box-shadow:
          0 20px 60px rgba(20, 42, 85, 0.12);

        margin-bottom: 30px;
      }

      .contact-heading {
        text-align: center;

        margin-bottom: 35px;
      }

      .contact-heading .label {
        color: #1657d9;

        font-size: 13px;

        font-weight: 900;

        letter-spacing: 1px;

        margin-bottom: 8px;
      }

      .contact-heading h2 {
        color: #14213d;

        font-size: 36px;

        line-height: 1.1;

        margin-bottom: 10px;
      }

      .contact-heading p {
        max-width: 680px;

        margin: 0 auto;

        color: #68748a;
      }

      /* =========================
         CONTACT GRID
      ========================= */

      .contact-grid {
        display: grid;

        grid-template-columns:
          repeat(2, 1fr);

        gap: 18px;
      }

      .contact-item {
        display: flex;

        align-items: center;

        gap: 16px;

        padding: 20px;

        border: 1px solid #e2e7f0;

        border-radius: 15px;

        background: #fafbfe;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .contact-item:hover {
        transform: translateY(-3px);

        border-color: #cbd9f5;

        box-shadow:
          0 10px 25px rgba(20, 42, 85, 0.08);
      }

      .contact-icon {
        width: 52px;
        height: 52px;

        flex: 0 0 52px;

        border-radius: 13px;

        display: flex;

        align-items: center;

        justify-content: center;
      }

      .contact-icon svg {
        width: 28px;
        height: 28px;

        display: block;
      }

      .email-icon {
        background: #eaf1ff;

        color: #1657d9;
      }

      .phone-icon {
        background: #eaf8ef;

        color: #18864b;
      }

      .youtube-icon {
        background: #fff0f0;

        color: #ff0000;
      }

      .telegram-icon {
        background: #e8f6ff;

        color: #229ed9;
      }

      .twitter-icon {
        background: #eef1f4;

        color: #111111;
      }

      .book-icon {
        background: #fff7df;

        color: #a66d00;
      }

      .contact-info {
        min-width: 0;
      }

      .contact-info .title {
        color: #6c778c;

        font-size: 12px;

        font-weight: 800;

        text-transform: uppercase;

        letter-spacing: 0.6px;

        margin-bottom: 3px;
      }

      .contact-info .value {
        color: #172033;

        font-size: 16px;

        font-weight: 800;

        overflow-wrap: anywhere;
      }

      .contact-info .value:hover {
        color: #1657d9;
      }

      /* =========================
         SOCIAL SECTION
      ========================= */

      .social-section {
        background: white;

        border-radius: 22px;

        padding: 40px;

        margin-bottom: 30px;

        box-shadow:
          0 15px 45px rgba(20, 42, 85, 0.08);

        text-align: center;
      }

      .social-section h2 {
        color: #14213d;

        font-size: 31px;

        margin-bottom: 8px;
      }

      .social-section p {
        color: #68748a;

        margin-bottom: 25px;
      }

      .social-links {
        display: flex;

        align-items: center;

        justify-content: center;

        gap: 14px;

        flex-wrap: wrap;
      }

      .social-link {
        display: inline-flex;

        align-items: center;

        gap: 9px;

        min-height: 46px;

        padding: 10px 17px;

        border-radius: 10px;

        font-size: 14px;

        font-weight: 800;

        border: 1px solid #e0e5ed;

        color: #39455c;

        background: white;

        transition: 0.2s ease;
      }

      .social-link svg {
        width: 20px;
        height: 20px;
      }

      .social-link.youtube:hover {
        color: #ff0000;

        border-color: #ff0000;
      }

      .social-link.telegram:hover {
        color: #229ed9;

        border-color: #229ed9;
      }

      .social-link.twitter:hover {
        color: #111111;

        border-color: #111111;
      }

      /* =========================
         CTA
      ========================= */

      .cta {
        background:
          linear-gradient(
            135deg,
            #102f82,
            #1657d9
          );

        color: white;

        border-radius: 22px;

        padding: 55px 35px;

        text-align: center;
      }

      .cta h2 {
        font-size: 34px;

        margin-bottom: 10px;
      }

      .cta p {
        max-width: 680px;

        margin: 0 auto 24px;

        color: rgba(255, 255, 255, 0.82);
      }

      .cta-button {
        display: inline-flex;

        align-items: center;

        justify-content: center;

        background: #ffd43b;

        color: #14213d;

        padding: 14px 25px;

        border-radius: 10px;

        font-size: 15px;

        font-weight: 900;

        transition: 0.2s ease;
      }

      .cta-button:hover {
        transform: translateY(-2px);

        box-shadow:
          0 10px 25px rgba(0, 0, 0, 0.18);
      }

      /* =========================
         FOOTER
      ========================= */

      .footer {
        background: #101a2d;

        color: white;

        padding: 50px 28px;
      }

      .footer-inner {
        max-width: 1180px;

        margin: 0 auto;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 30px;
      }

      .footer-brand {
        font-size: 23px;

        font-weight: 900;

        margin-bottom: 4px;
      }

      .footer small {
        color: #9da8bb;
      }

      .footer-links {
        display: flex;

        flex-wrap: wrap;

        gap: 20px;
      }

      .footer-links a {
        color: #d6dce8;

        font-size: 14px;

        font-weight: 600;
      }

      .footer-links a:hover {
        color: white;
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 900px) {

        .nav {
          flex-direction: column;

          padding: 16px 20px;
        }

        .nav-links {
          justify-content: center;

          gap: 14px 18px;
        }

        .contact-grid {
          grid-template-columns: 1fr;
        }

        .footer-inner {
          flex-direction: column;

          text-align: center;
        }

        .footer-links {
          justify-content: center;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 600px) {

        .hero {
          padding: 55px 20px 90px;
        }

        .main {
          padding-left: 14px;

          padding-right: 14px;
        }

        .contact-card,
        .social-section {
          padding: 25px 20px;
        }

        .contact-heading h2 {
          font-size: 29px;
        }

        .cta {
          padding: 40px 20px;
        }

        .cta h2 {
          font-size: 28px;
        }

        .nav-links a {
          font-size: 13px;
        }

        .contact-item {
          padding: 16px;
        }
      }
    </style>
  </head>

  <body>

    <!-- =========================
         HEADER
    ========================= -->

    <header class="site-header">

      <nav class="nav">

        <a href="/" class="logo">

          <span class="logo-mark">
            H
          </span>

          Habitat IAS

        </a>

        <div class="nav-links">

          <a href="/">
            Home
          </a>

          <a href="/notes/">
            Notes
          </a>

          <a href="/pyq/">
            JPSC PYQ
          </a>

          <a href="/book/">
            Book
          </a>

          <a href="/guidance/">
            Guidance
          </a>

          <a href="/trends/">
            Trends
          </a>

          <a href="/mock-tests/">
            Mock Tests
          </a>

          <a href="/jharkhand/">
            Jharkhand
          </a>

          <a href="/resources/">
            Resources
          </a>

          <a href="/contact/">
            Contact
          </a>

          <a
            href={bookLink}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-cta"
          >
            Get the Book
          </a>

        </div>

      </nav>

    </header>


    <!-- =========================
         HERO
    ========================= -->

    <section class="hero">

      <div class="hero-inner">

        <div class="eyebrow">
          HABITAT IAS • JPSC PREPARATION
        </div>

        <h1>
          Get in
          <span>Touch.</span>
        </h1>

        <p>
          Have a question about JPSC preparation, study resources,
          PYQs, mock tests or our book? Connect with Habitat IAS.
        </p>

      </div>

    </section>


    <!-- =========================
         MAIN
    ========================= -->

    <main class="main">


      <!-- CONTACT INFORMATION -->

      <section class="contact-card">

        <div class="contact-heading">

          <div class="label">
            CONTACT HABITAT IAS
          </div>

          <h2>
            We're Here to Help
          </h2>

          <p>
            Use the contact details below for queries, feedback,
            educational collaboration or support related to
            Habitat IAS resources.
          </p>

        </div>


        <div class="contact-grid">


          <!-- EMAIL -->

          <a
            href={`mailto:${email}`}
            class="contact-item"
          >

            <div class="contact-icon email-icon">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="2"
                ></rect>

                <polyline
                  points="3,7 12,13 21,7"
                ></polyline>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                Email
              </div>

              <div class="value">
                {email}
              </div>

            </div>

          </a>


          <!-- PHONE -->

          <a
            href={`tel:${mobile}`}
            class="contact-item"
          >

            <div class="contact-icon phone-icon">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2
                  19.79 19.79 0 0 1-8.63-3.07
                  19.5 19.5 0 0 1-6-6
                  A19.79 19.79 0 0 1 2.12 4.18
                  2 2 0 0 1 4.11 2h3
                  a2 2 0 0 1 2 1.72
                  12.84 12.84 0 0 0 .7 2.81
                  2 2 0 0 1-.45 2.11L8.09 9.91
                  a16 16 0 0 0 6 6l1.27-1.27
                  a2 2 0 0 1 2.11-.45
                  12.84 12.84 0 0 0 2.81.7
                  A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                Mobile
              </div>

              <div class="value">
                {mobile}
              </div>

            </div>

          </a>


          <!-- YOUTUBE -->

          <a
            href={youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >

            <div class="contact-icon youtube-icon">

              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M23.5 6.2a3 3 0 0 0-2.1-2.1
                  C19.5 3.5 12 3.5 12 3.5
                  s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2
                  31.7 31.7 0 0 0 0 12
                  a31.7 31.7 0 0 0 .5 5.8
                  3 3 0 0 0 2.1 2.1
                  c1.9.6 9.4.6 9.4.6
                  s7.5 0 9.4-.6
                  a3 3 0 0 0 2.1-2.1
                  A31.7 31.7 0 0 0 24 12
                  a31.7 31.7 0 0 0-.5-5.8z"
                ></path>

                <path
                  d="M9.6 15.5 15.8 12 9.6 8.5v7z"
                  fill="white"
                ></path>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                YouTube
              </div>

              <div class="value">
                @habitatias
              </div>

            </div>

          </a>


          <!-- TELEGRAM — REAL TELEGRAM LOGO -->

          <a
            href={telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >

            <div class="contact-icon telegram-icon">

              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M21.8 3.2 2.9 10.5
                  c-1.3.5-1.3 1.2-.2 1.5l4.8 1.5
                  1.8 5.8c.2.6.1.9.8.9
                  .5 0 .7-.2 1-.5l2.3-2.2
                  4.8 3.5c.9.5 1.6.3 1.8-.8
                  l3.1-14.7c.3-1.3-.5-1.9-1.3-1.3z
                  M8.3 13.2l10.8-6.8
                  c.5-.3.9-.1.5.2l-8.8 8
                  -.3 3.1-1.8-4.5-4.4-1.4z"
                ></path>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                Telegram
              </div>

              <div class="value">
                @Habitat_IAS
              </div>

            </div>

          </a>


          <!-- X / TWITTER -->

          <a
            href={twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >

            <div class="contact-icon twitter-icon">

              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M18.2 2H21l-6.1 7
                  L22 22h-5.5l-4.3-6.1L6.9 22H4.1
                  l6.5-7.5L2 2h5.6l3.9 5.6L18.2 2z
                  M17.2 20h1.5L6.9 3.9H5.3L17.2 20z"
                ></path>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                X / Twitter
              </div>

              <div class="value">
                @Habitatias
              </div>

            </div>

          </a>


          <!-- BOOK -->

          <a
            href={bookLink}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-item"
          >

            <div class="contact-icon book-icon">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M4 19.5A2.5 2.5 0 0 1
                  6.5 17H20"
                ></path>

                <path
                  d="M6.5 2H20v20H6.5
                  A2.5 2.5 0 0 1 4 19.5v-15
                  A2.5 2.5 0 0 1 6.5 2z"
                ></path>

                <path
                  d="M8 6h8"
                ></path>

                <path
                  d="M8 10h8"
                ></path>
              </svg>

            </div>

            <div class="contact-info">

              <div class="title">
                JPSC Book
              </div>

              <div class="value">
                JPSC Prelims Decoded
              </div>

            </div>

          </a>

        </div>

      </section>


      <!-- =========================
           SOCIAL MEDIA
      ========================= -->

      <section class="social-section">

        <h2>
          Follow Habitat IAS
        </h2>

        <p>
          Stay updated with JPSC preparation content,
          PYQs, current affairs and educational resources.
        </p>

        <div class="social-links">


          <!-- YOUTUBE -->

          <a
            href={youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link youtube"
          >

            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M23.5 6.2a3 3 0 0 0-2.1-2.1
                C19.5 3.5 12 3.5 12 3.5
                s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2
                31.7 31.7 0 0 0 0 12
                a31.7 31.7 0 0 0 .5 5.8
                3 3 0 0 0 2.1 2.1
                c1.9.6 9.4.6 9.4.6
                s7.5 0 9.4-.6
                a3 3 0 0 0 2.1-2.1
                A31.7 31.7 0 0 0 24 12
                a31.7 31.7 0 0 0-.5-5.8z"
              ></path>

              <path
                d="M9.6 15.5 15.8 12 9.6 8.5v7z"
                fill="white"
              ></path>
            </svg>

            YouTube

          </a>


          <!-- TELEGRAM REAL LOGO -->

          <a
            href={telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link telegram"
          >

            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M21.8 3.2 2.9 10.5
                c-1.3.5-1.3 1.2-.2 1.5l4.8 1.5
                1.8 5.8c.2.6.1.9.8.9
                .5 0 .7-.2 1-.5l2.3-2.2
                4.8 3.5c.9.5 1.6.3 1.8-.8
                l3.1-14.7c.3-1.3-.5-1.9-1.3-1.3z
                M8.3 13.2l10.8-6.8
                c.5-.3.9-.1.5.2l-8.8 8
                -.3 3.1-1.8-4.5-4.4-1.4z"
              ></path>
            </svg>

            Telegram

          </a>


          <!-- X -->

          <a
            href={twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link twitter"
          >

            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M18.2 2H21l-6.1 7
                L22 22h-5.5l-4.3-6.1L6.9 22H4.1
                l6.5-7.5L2 2h5.6l3.9 5.6L18.2 2z
                M17.2 20h1.5L6.9 3.9H5.3L17.2 20z"
              ></path>
            </svg>

            X / Twitter

          </a>

        </div>

      </section>


      <!-- =========================
           BOOK CTA
      ========================= -->

      <section class="cta">

        <h2>
          JPSC Prelims Decoded
        </h2>

        <p>
          Explore the topic-wise PYQ analysis, detailed explanations
          and exam trends designed for serious JPSC aspirants.
        </p>

        <a
          href={bookLink}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button"
        >
          Get the Book →
        </a>

      </section>

    </main>


    <!-- =========================
         FOOTER
