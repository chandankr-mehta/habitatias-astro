---
export const prerender = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Profile | Habitat IAS</title>

  <meta
    name="description"
    content="Manage your Habitat IAS student profile and account settings."
  />

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: #f4f7fb;
      color: #071a3a;
    }

    body {
      min-height: 100vh;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    /* =====================================================
       HEADER
    ===================================================== */

    .header {
      width: 100%;
      height: 76px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 32px;

      background: white;

      border-bottom:
        1px solid #e2e8f0;

      box-shadow:
        0 3px 18px rgba(15, 23, 42, 0.04);

      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;

      text-decoration: none;
      color: #071a3a;
    }

    .brand-logo {
      width: 44px;
      height: 44px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      background: #071a3a;

      color: white;

      font-size: 22px;
      font-weight: 900;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-size: 19px;
      font-weight: 900;
      line-height: 1.1;
    }

    .brand-subtitle {
      margin-top: 4px;

      color: #64748b;

      font-size: 9px;
      font-weight: 800;

      letter-spacing: 0.12em;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-button {
      min-height: 40px;

      padding: 0 15px;

      border:
        1px solid #dbe2ea;

      border-radius: 9px;

      background: white;

      color: #334155;

      font-size: 13px;
      font-weight: 800;
    }

    .header-button:hover {
      background: #f8fafc;
    }

    .header-button.primary {
      border-color: #2457d6;
      background: #2457d6;
      color: white;
    }

    .header-button.primary:hover {
      background: #1d4ed8;
    }

    /* =====================================================
       PAGE
    ===================================================== */

    .page {
      width: min(1050px, 100%);

      margin: 0 auto;

      padding:
        35px 24px 80px;
    }

    .page-heading {
      margin-bottom: 25px;
    }

    .kicker {
      color: #2457d6;

      font-size: 11px;
      font-weight: 900;

      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .page-heading h1 {
      margin: 7px 0 5px;

      color: #071a3a;

      font-size: 32px;
      line-height: 1.15;

      font-weight: 900;
    }

    .page-heading p {
      margin: 0;

      color: #64748b;

      font-size: 14px;
      line-height: 1.6;
    }

    /* =====================================================
       STATUS
    ===================================================== */

    .status {
      display: none;

      margin-bottom: 18px;

      padding: 13px 15px;

      border-radius: 10px;

      font-size: 13px;
      font-weight: 700;
      line-height: 1.5;
    }

    .status.visible {
      display: block;
    }

    .status.success {
      border: 1px solid #bbf7d0;
      background: #f0fdf4;
      color: #166534;
    }

    .status.error {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #991b1b;
    }

    /* =====================================================
       PROFILE GRID
    ===================================================== */

    .profile-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1.35fr)
        minmax(280px, 0.65fr);

      gap: 20px;
    }

    .card {
      background: white;

      border:
        1px solid #e2e8f0;

      border-radius: 18px;

      padding: 25px;

      box-shadow:
        0 6px 25px rgba(15, 23, 42, 0.045);
    }

    .card-title {
      margin: 0;

      color: #071a3a;

      font-size: 18px;
      font-weight: 900;
    }

    .card-description {
      margin: 6px 0 22px;

      color: #64748b;

      font-size: 13px;
      line-height: 1.55;
    }

    /* =====================================================
       PROFILE SUMMARY
    ===================================================== */

    .profile-summary {
      display: flex;
      align-items: center;

      gap: 15px;

      margin-bottom: 25px;

      padding-bottom: 22px;

      border-bottom:
        1px solid #eef2f7;
    }

    .avatar {
      width: 70px;
      height: 70px;

      flex: 0 0 70px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          #071a3a,
          #2457d6
        );

      color: white;

      font-size: 24px;
      font-weight: 900;
    }

    .profile-summary-text {
      min-width: 0;
    }

    .profile-name {
      margin: 0;

      color: #071a3a;

      font-size: 21px;
      font-weight: 900;

      word-break: break-word;
    }

    .profile-email {
      margin-top: 4px;

      color: #64748b;

      font-size: 13px;

      word-break: break-word;
    }

    /* =====================================================
       FORM
    ===================================================== */

    .field {
      margin-bottom: 17px;
    }

    .field-label {
      display: block;

      margin-bottom: 7px;

      color: #334155;

      font-size: 12px;
      font-weight: 850;
    }

    .field-input {
      width: 100%;

      min-height: 46px;

      padding:
        0 13px;

      border:
        1px solid #dbe2ea;

      border-radius: 9px;

      outline: none;

      background: white;

      color: #071a3a;

      font-size: 14px;

      transition:
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .field-input:focus {
      border-color: #2457d6;

      box-shadow:
        0 0 0 3px rgba(36, 87, 214, 0.10);
    }

    .field-input[readonly] {
      background: #f8fafc;
      color: #64748b;
    }

    .field-help {
      margin-top: 5px;

      color: #94a3b8;

      font-size: 11px;
      line-height: 1.45;
    }

    .save-button {
      width: 100%;

      min-height: 46px;

      border: 0;

      border-radius: 9px;

      background: #2457d6;

      color: white;

      font-size: 13px;
      font-weight: 900;
    }

    .save-button:hover {
      background: #1d4ed8;
    }

    .save-button:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    /* =====================================================
       SECURITY CARD
    ===================================================== */

    .security-card {
      margin-top: 20px;
    }

    .security-item {
      padding: 15px 0;

      border-bottom:
        1px solid #eef2f7;
    }

    .security-item:first-child {
      padding-top: 0;
    }

    .security-item:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .security-label {
      color: #334155;

      font-size: 12px;
      font-weight: 850;
    }

    .security-value {
      margin-top: 5px;

      color: #64748b;

      font-size: 12px;
      line-height: 1.5;
    }

    .password-button {
      width: 100%;

      min-height: 42px;

      margin-top: 13px;

      border:
        1px solid #dbe2ea;

      border-radius: 9px;

      background: white;

      color: #334155;

      font-size: 12px;
      font-weight: 850;
    }

    .password-button:hover {
      background: #f8fafc;
    }

    /* =====================================================
       ACCOUNT CARD
    ===================================================== */

    .account-row {
      display: flex;

      justify-content: space-between;
      gap: 15px;

      padding: 13px 0;

      border-bottom:
        1px solid #eef2f7;
    }

    .account-row:last-child {
      border-bottom: 0;
    }

    .account-label {
      color: #64748b;

      font-size: 12px;
    }

    .account-value {
      color: #071a3a;

      font-size: 12px;
      font-weight: 800;

      text-align: right;

      word-break: break-word;
    }

    /* =====================================================
       LOGOUT
    ===================================================== */

    .logout-button {
      width: 100%;

      min-height: 44px;

      margin-top: 20px;

      border:
        1px solid #fecaca;

      border-radius: 9px;

      background: #fff;

      color: #b91c1c;

      font-size: 13px;
      font-weight: 900;
    }

    .logout-button:hover {
      background: #fef2f2;
    }

    /* =====================================================
       LOADING
    ===================================================== */

    .loading {
      min-height: 300px;

      display: grid;
      place-items: center;

      color: #64748b;

      font-size: 13px;
      font-weight: 700;
    }

    .loading-spinner {
      width: 30px;
      height: 30px;

      margin: 0 auto 12px;

      border:
        3px solid #e2e8f0;

      border-top-color: #2457d6;

      border-radius: 50%;

      animation:
        spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 800px) {
      .header {
        height: auto;

        min-height: 70px;

        padding:
          12px 16px;
      }

      .header-actions {
        gap: 6px;
      }

      .header-button {
        padding: 0 10px;
        font-size: 11px;
      }

      .brand-name {
        font-size: 16px;
      }

      .brand-subtitle {
        font-size: 8px;
      }

      .brand-logo {
        width: 40px;
        height: 40px;
      }

      .page {
        padding:
          25px 15px 60px;
      }

      .page-heading h1 {
        font-size: 27px;
      }

      .profile-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .header {
        align-items: flex-start;
      }

      .header-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .header-button {
        min-height: 34px;
      }

      .profile-summary {
        align-items: flex-start;
      }

      .avatar {
        width: 58px;
        height: 58px;
        flex-basis: 58px;
        font-size: 20px;
      }

      .card {
        padding: 19px;
      }
    }
  </style>
</head>

<body>

  <!-- =====================================================
       HEADER
  ===================================================== -->

  <header class="header">

    <a
      href="/dashboard"
      class="brand"
      aria-label="Habitat IAS Dashboard"
    >
      <div class="brand-logo">
        H
      </div>

      <div class="brand-text">
        <span class="brand-name">
          Habitat IAS
        </span>

        <span class="brand-subtitle">
          CIVIL SERVICES PREPARATION
        </span>
      </div>
    </a>

    <div class="header-actions">

      <button
        id="dashboardButton"
        class="header-button"
        type="button"
      >
        Dashboard
      </button>

      <button
        id="logoutHeaderButton"
        class="header-button primary"
        type="button"
      >
        Logout
      </button>

    </div>

  </header>


  <!-- =====================================================
       MAIN
  ===================================================== -->

  <main class="page">

    <section class="page-heading">

      <div class="kicker">
        Student Account
      </div>

      <h1>
        My Profile
      </h1>

      <p>
        Manage your Habitat IAS account and personal information.
      </p>

    </section>


    <!-- STATUS -->

    <div
      id="status"
      class="status"
      role="alert"
      aria-live="polite"
    ></div>


    <!-- =====================================================
         LOADING
    ===================================================== -->

    <div id="loading" class="loading">

      <div>
        <div class="loading-spinner"></div>

        Loading your profile...
      </div>

    </div>


    <!-- =====================================================
         PROFILE CONTENT
    ===================================================== -->

    <div
      id="profileContent"
      class="profile-grid"
      style="display:none;"
    >

      <!-- =================================================
           LEFT COLUMN
      ================================================= -->

      <div>

        <!-- PROFILE INFORMATION -->

        <section class="card">

          <h2 class="card-title">
            Personal Information
          </h2>

          <p class="card-description">
            Update the name associated with your Habitat IAS student account.
          </p>


          <div class="profile-summary">

            <div
              id="avatar"
              class="avatar"
            >
              H
            </div>

            <div class="profile-summary-text">

              <h3
                id="summaryName"
                class="profile-name"
              >
                Student
              </h3>

              <div
                id="summaryEmail"
                class="profile-email"
              >
                Loading...
              </div>

            </div>

          </div>


          <!-- PROFILE FORM -->

          <form
            id="profileForm"
            novalidate
          >

            <div class="field">

              <label
                class="field-label"
                for="fullName"
              >
                Full Name
              </label>

              <input
                id="fullName"
                class="field-input"
                type="text"
                autocomplete="name"
                placeholder="Enter your full name"
              />

              <div class="field-help">
                This name will be displayed throughout your student account.
              </div>

            </div>


            <div class="field">

              <label
                class="field-label"
                for="email"
              >
                Email Address
              </label>

              <input
                id="email"
                class="field-input"
                type="email"
                readonly
              />

              <div class="field-help">
                Your login email is managed securely by Supabase Authentication.
              </div>

            </div>


            <button
              id="saveProfileButton"
              class="save-button"
              type="submit"
            >
              Save Changes
            </button>

          </form>

        </section>


        <!-- SECURITY -->

        <section class="card security-card">

          <h2 class="card-title">
            Security
          </h2>

          <p class="card-description">
            Manage your account password and authentication security.
          </p>


          <div class="security-item">

            <div class="security-label">
              Password
            </div>

            <div class="security-value">
              Your password is securely managed by Supabase Authentication.
            </div>

            <button
              id="changePasswordButton"
              class="password-button"
              type="button"
            >
              Change Password
            </button>

          </div>

        </section>

      </div>


      <!-- =================================================
           RIGHT COLUMN
      ================================================= -->

      <div>

        <section class="card">

          <h2 class="card-title">
            Account
          </h2>

          <p class="card-description">
            Your Habitat IAS account information.
          </p>


          <div class="account-row">

            <span class="account-label">
              Account Status
            </span>

            <span
              id="accountStatus"
              class="account-value"
            >
              Active
            </span>

          </div>


          <div class="account-row">

            <span class="account-label">
              Authentication
            </span>

            <span
              id="authProvider"
              class="account-value"
            >
              Email
            </span>

          </div>


          <div class="account-row">

            <span class="account-label">
              Account Created
            </span>

            <span
              id="createdAt"
              class="account-value"
            >
              —
            </span>

          </div>


          <div class="account-row">

            <span class="account-label">
              Last Sign In
            </span>

            <span
              id="lastSignIn"
              class="account-value"
            >
              —
            </span>

          </div>


          <button
            id="logoutButton"
            class="logout-button"
            type="button"
          >
            Sign Out
          </button>

        </section>

      </div>

    </div>

  </main>


  <!-- =====================================================
       SCRIPT
  ===================================================== -->

  <script>

    import {
      supabase
    } from "../lib/supabase";


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const loading =
      document.getElementById(
        "loading"
      );

    const profileContent =
      document.getElementById(
        "profileContent"
      );

    const status =
      document.getElementById(
        "status"
      );

    const avatar =
      document.getElementById(
        "avatar"
      );

    const summaryName =
      document.getElementById(
        "summaryName"
      );

    const summaryEmail =
      document.getElementById(
        "summaryEmail"
      );

    const fullName =
      document.getElementById(
        "fullName"
      );

    const email =
      document.getElementById(
        "email"
      );

    const profileForm =
      document.getElementById(
        "profileForm"
      );

    const saveProfileButton =
      document.getElementById(
        "saveProfileButton"
      );

    const createdAt =
      document.getElementById(
        "createdAt"
      );

    const lastSignIn =
      document.getElementById(
        "lastSignIn"
      );

    const accountStatus =
      document.getElementById(
        "accountStatus"
      );

    const authProvider =
      document.getElementById(
        "authProvider"
      );

    const dashboardButton =
      document.getElementById(
        "dashboardButton"
      );

    const logoutButton =
      document.getElementById(
        "logoutButton"
      );

    const logoutHeaderButton =
      document.getElementById(
        "logoutHeaderButton"
      );

    const changePasswordButton =
      document.getElementById(
        "changePasswordButton"
      );


    /* =====================================================
       STATUS
    ===================================================== */

    function showStatus(
      message,
      type = "success"
    ) {

      if (!status) {
        return;
      }

      status.textContent =
        message;

      status.className =
        `status visible ${type}`;

    }


    function clearStatus() {

      if (!status) {
        return;
      }

      status.textContent = "";

      status.className =
        "status";

    }


    /* =====================================================
       ESCAPE / INITIALS
    ===================================================== */

    function getInitials(
      name,
      fallbackEmail
    ) {

      const source =
        String(
          name ||
          fallbackEmail ||
          "Student"
        ).trim();

      const parts =
        source
          .split(/\s+/)
          .filter(Boolean);

      if (
        parts.length >= 2
      ) {

        return (
          parts[0][0] +
          parts[parts.length - 1][0]
        )
          .toUpperCase();

      }

      return source
        .substring(0, 2)
        .toUpperCase();

    }


    /* =====================================================
       DATE FORMAT
    ===================================================== */

    function formatDate(
      value
    ) {

      if (!value) {
        return "—";
      }

      try {

        return new Date(
          value
        ).toLocaleString(
          "en-IN",
          {
            day: "2-digit",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
          }
        );

      } catch {

        return "—";

      }

    }


    /* =====================================================
       LOAD USER
    ===================================================== */

    async function loadProfile() {

      try {

        const {
          data,
          error
        } =
          await supabase.auth
            .getUser();


        /*
         * -------------------------------------------------
         * AUTH ERROR
         * -------------------------------------------------
         */

        if (
          error ||
          !data ||
          !data.user
        ) {

          window.location.replace(
            "/login"
          );

          return;

        }


        const user =
          data.user;


        /*
         * -------------------------------------------------
         * USER METADATA
         * -------------------------------------------------
         */

        const metadata =
          user.user_metadata ||
          {};

        const name =
          metadata.full_name ||
          metadata.name ||
          metadata.display_name ||
          "";


        /*
         * -------------------------------------------------
         * DISPLAY PROFILE
         * -------------------------------------------------
         */

        if (fullName) {

          fullName.value =
            name;

        }


        if (email) {

          email.value =
            user.email ||
            "";

        }


        if (summaryName) {

          summaryName.textContent =
            name ||
            "Habitat IAS Student";

        }


        if (summaryEmail) {

          summaryEmail.textContent =
            user.email ||
            "";

        }


        if (avatar) {

          avatar.textContent =
            getInitials(
              name,
              user.email
            );

        }


        /*
         * -------------------------------------------------
         * ACCOUNT INFORMATION
         * -------------------------------------------------
         */

        if (createdAt) {

          createdAt.textContent =
            formatDate(
              user.created_at
            );

        }


        if (lastSignIn) {

          lastSignIn.textContent =
            formatDate(
              user.last_sign_in_at
            );

        }


        if (accountStatus) {

          accountStatus.textContent =
            user.aud ||
            "Active";

        }


        if (authProvider) {

          const provider =
            user.app_metadata
              ?.provider ||
            "email";

          authProvider.textContent =
            provider === "email"
              ? "Email"
              : provider;

        }


        /*
         * -------------------------------------------------
         * SHOW PAGE
         * -------------------------------------------------
         */

        if (loading) {

          loading.style.display =
            "none";

        }


        if (profileContent) {

          profileContent.style.display =
            "grid";

        }

      } catch (error) {

        console.error(
          "Profile loading error:",
          error
        );

        window.location.replace(
          "/login"
        );

      }

    }


    /* =====================================================
       SAVE PROFILE
    ===================================================== */

    profileForm?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();

        clearStatus();


        const name =
          fullName?.value
            ?.trim() ||
          "";


        /*
         * VALIDATION
         */

        if (!name) {

          showStatus(
            "Please enter your full name.",
            "error"
          );

          fullName?.focus();

          return;

        }


        if (name.length < 2) {

          showStatus(
            "Please enter a valid name.",
            "error"
          );

          fullName?.focus();

          return;

        }


        /*
         * LOADING
         */

        if (saveProfileButton) {

          saveProfileButton.disabled =
            true;

          saveProfileButton.textContent =
            "Saving...";

        }


        try {

          const {
            data,
            error
          } =
            await supabase.auth
              .updateUser({

                data: {

                  full_name:
                    name,

                  display_name:
                    name

                }

              });


          if (error) {

            console.error(
              "Profile update error:",
              error
            );

            showStatus(
              error.message ||
              "Unable to update your profile.",
              "error"
            );

            return;

          }


          /*
           * UPDATE UI
           */

          if (summaryName) {

            summaryName.textContent =
              name;

          }


          if (avatar) {

            avatar.textContent =
              getInitials(
                name,
                email?.value
              );

          }


          showStatus(
            "Your profile has been updated successfully.",
            "success"
          );


        } catch (error) {

          console.error(
            "Profile update failed:",
            error
          );

          showStatus(
            "Unable to update your profile. Please try again.",
            "error"
          );

        } finally {

          if (saveProfileButton) {

            saveProfileButton.disabled =
              false;

            saveProfileButton.textContent =
              "Save Changes";

          }

        }

      }
    );


    /* =====================================================
       DASHBOARD
    ===================================================== */

    dashboardButton?.addEventListener(
      "click",
      () => {

        window.location.href =
          "/dashboard";

      }
    );


    /* =====================================================
       CHANGE PASSWORD
    ===================================================== */

    changePasswordButton?.addEventListener(
      "click",
      () => {

        window.location.href =
          "/forgot-password";

      }
    );


    /* =====================================================
       LOGOUT
    ===================================================== */

    async function logout() {

      try {

        if (logoutButton) {

          logoutButton.disabled =
            true;

          logoutButton.textContent =
            "Signing out...";

        }

        if (logoutHeaderButton) {

          logoutHeaderButton.disabled =
            true;

          logoutHeaderButton.textContent =
            "Signing out...";

        }


        const {
          error
        } =
          await supabase.auth
            .signOut();


        if (error) {

          console.error(
            "Logout error:",
            error
          );

          showStatus(
            "Unable to sign out. Please try again.",
            "error"
          );

          return;

        }


        /*
         * SESSION REMOVED
         */

        window.location.replace(
          "/login"
        );


      } catch (error) {

        console.error(
          "Logout failed:",
          error
        );

        showStatus(
          "Unable to sign out. Please try again.",
          "error"
        );

      } finally {

        if (logoutButton) {

          logoutButton.disabled =
            false;

          logoutButton.textContent =
            "Sign Out";

        }

        if (logoutHeaderButton) {

          logoutHeaderButton.disabled =
            false;

          logoutHeaderButton.textContent =
            "Logout";

        }

      }

    }


    logoutButton?.addEventListener(
      "click",
      logout
    );

    logoutHeaderButton?.addEventListener(
      "click",
      logout
    );


    /* =====================================================
       INITIALIZE
    ===================================================== */

    loadProfile();

  </script>

</body>
</html>