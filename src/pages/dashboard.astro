  <!-- =====================================================
       SUPABASE + DASHBOARD LOGIC
  ====================================================== -->

  <script>

    import {
      supabase
    } from "../lib/supabase";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const loadingScreen =
      document.getElementById(
        "loadingScreen"
      );


    const welcomeName =
      document.getElementById(
        "welcomeName"
      );


    const topUserName =
      document.getElementById(
        "topUserName"
      );


    const topAvatar =
      document.getElementById(
        "topAvatar"
      );


    const logoutButton =
      document.getElementById(
        "logoutButton"
      );


    const mobileMenu =
      document.getElementById(
        "mobileMenu"
      );


    const sidebar =
      document.getElementById(
        "sidebar"
      );


    const attemptedCount =
      document.getElementById(
        "attemptedCount"
      );


    const averageScore =
      document.getElementById(
        "averageScore"
      );


    const bestScore =
      document.getElementById(
        "bestScore"
      );


    const activityContainer =
      document.getElementById(
        "activityContainer"
      );


    /* =====================================================
       FORMAT DATE
    ====================================================== */

    function formatDate(
      value
    ) {

      if (!value) {

        return "Recently";

      }


      const date =
        new Date(value);


      if (
        Number.isNaN(
          date.getTime()
        )
      ) {

        return "Recently";

      }


      return date.toLocaleDateString(
        "en-IN",
        {
          day: "2-digit",
          month: "short",
          year: "numeric"
        }
      );

    }


    /* =====================================================
       ESCAPE HTML
    ====================================================== */

    function escapeHtml(
      value
    ) {

      if (
        value === null ||
        value === undefined
      ) {

        return "";

      }


      return String(value)

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =====================================================
       SHOW EMPTY
    ====================================================== */

    function showEmptyActivity() {

      if (
        !activityContainer
      ) {

        return;

      }


      activityContainer.innerHTML = `

        <div class="empty">

          <div class="empty-icon">
            📋
          </div>

          <strong>
            No test attempts yet
          </strong>

          <p>
            Your completed tests and scores
            will appear here after you submit
            your first mock test.
          </p>

        </div>

      `;

    }


    /* =====================================================
       SHOW ERROR
    ====================================================== */

    function showActivityError(
      message
    ) {

      if (
        !activityContainer
      ) {

        return;

      }


      activityContainer.innerHTML = `

        <div class="empty">

          <div class="empty-icon">
            ⚠️
          </div>

          <strong>
            ${escapeHtml(message)}
          </strong>

          <p>
            Check your connection and refresh
            the dashboard.
          </p>

        </div>

      `;

    }


    /* =====================================================
       LOAD STUDENT
    ====================================================== */

    async function loadStudent() {

      try {


        /* -----------------------------------------------
           AUTHENTICATED USER
        ------------------------------------------------ */

        const {
          data,
          error
        } =
          await supabase.auth.getUser();


        if (
          error ||
          !data ||
          !data.user
        ) {

          window.location.href =
            "/login?redirect=/dashboard";

          return;

        }


        const user =
          data.user;


        /* -----------------------------------------------
           USER METADATA
        ------------------------------------------------ */

        const metadata =
          user.user_metadata || {};


        const fullName =
          metadata.full_name ||
          metadata.name ||
          user.email?.split("@")[0] ||
          "Student";


        const firstName =
          fullName
            .trim()
            .split(/\s+/)[0] ||
          "Student";


        /* -----------------------------------------------
           NAME
        ------------------------------------------------ */

        if (
          welcomeName
        ) {

          welcomeName.textContent =
            firstName;

        }


        if (
          topUserName
        ) {

          topUserName.textContent =
            fullName;

        }


        /* -----------------------------------------------
           INITIALS
        ------------------------------------------------ */

        const initials =
          fullName
            .trim()
            .split(/\s+/)
            .filter(Boolean)
            .slice(0, 2)
            .map(
              name =>
                name
                  .charAt(0)
                  .toUpperCase()
            )
            .join("");


        if (
          topAvatar
        ) {

          topAvatar.textContent =
            initials ||
            "S";

        }


        /* -----------------------------------------------
           LOAD ATTEMPTS
        ------------------------------------------------ */

        await loadAttempts(
          user.id
        );

      }

      catch (
        error
      ) {

        console.error(
          "Dashboard error:",
          error
        );

        showActivityError(
          "Unable to load dashboard data."
        );

      }

      finally {

        if (
          loadingScreen
        ) {

          loadingScreen.style.display =
            "none";

        }

      }

    }


    /* =====================================================
       LOAD ATTEMPTS
    ====================================================== */

    async function loadAttempts(
      userId
    ) {

      try {


        console.log(
          "Loading attempts for user:",
          userId
        );


        /* -----------------------------------------------
           QUERY ATTEMPTS
        ------------------------------------------------ */

        const {
          data: attempts,
          error
        } =
          await supabase

            .from(
              "test_attempts"
            )

            .select(
              `
                id,
                test_id,
                score,
                correct,
                wrong,
                skipped,
                total_questions,
                maximum_marks,
                percentage,
                time_taken_seconds,
                submitted_at,
                created_at
              `
            )

            .eq(
              "user_id",
              userId
            )

            .order(
              "submitted_at",
              {
                ascending: false
              }
            );


        /* -----------------------------------------------
           DATABASE ERROR
        ------------------------------------------------ */

        if (
          error
        ) {

          console.error(
            "test_attempts error:",
            error
          );


          showActivityError(
            "Unable to load test attempts."
          );


          return;

        }


        const safeAttempts =
          Array.isArray(
            attempts
          )
            ? attempts
            : [];


        console.log(
          "Attempts loaded:",
          safeAttempts
        );


        /* -----------------------------------------------
           NO ATTEMPTS
        ------------------------------------------------ */

        if (
          safeAttempts.length === 0
        ) {

          attemptedCount.textContent =
            "0";


          averageScore.textContent =
            "—";


          bestScore.textContent =
            "—";


          showEmptyActivity();


          return;

        }


        /* -----------------------------------------------
           ATTEMPTED
        ------------------------------------------------ */

        attemptedCount.textContent =
          String(
            safeAttempts.length
          );


        /* -----------------------------------------------
           PERCENTAGES
        ------------------------------------------------ */

        const percentages =
          safeAttempts

            .map(
              attempt =>
                Number(
                  attempt.percentage
                )
            )

            .filter(
              value =>
                Number.isFinite(
                  value
                )
            );


        /* -----------------------------------------------
           AVERAGE
        ------------------------------------------------ */

        const average =
          percentages.length

            ? percentages.reduce(
                (
                  total,
                  value
                ) =>
                  total + value,
                0
              ) /
              percentages.length

            : 0;


        /* -----------------------------------------------
           BEST
        ------------------------------------------------ */

        const best =
          percentages.length

            ? Math.max(
                ...percentages
              )

            : 0;


        averageScore.textContent =
          percentages.length
            ? `${average.toFixed(1)}%`
            : "—";


        bestScore.textContent =
          percentages.length
            ? `${best.toFixed(1)}%`
            : "—";


        /* -----------------------------------------------
           RECENT ACTIVITY
        ------------------------------------------------ */

        await renderActivity(
          safeAttempts
        );


      }

      catch (
        error
      ) {

        console.error(
          "Attempt loading error:",
          error
        );


        showActivityError(
          "Something went wrong while loading your results."
        );

      }

    }


    /* =====================================================
       RENDER RECENT ACTIVITY
    ====================================================== */

    async function renderActivity(
      attempts
    ) {

      if (
        !activityContainer
      ) {

        return;

      }


      /* -----------------------------------------------
         UNIQUE TEST IDS
        ------------------------------------------------ */

      const testIds =
        [
          ...new Set(
            attempts.map(
              attempt =>
                attempt.test_id
            )
          )
        ];


      let testsById =
        new Map();


      /* -----------------------------------------------
         LOAD TEST INFORMATION
        ------------------------------------------------ */

      if (
        testIds.length > 0
      ) {

        const {
          data: tests,
          error
        } =
          await supabase

            .from(
              "mock_tests"
            )

            .select(
              `
                id,
                test_number,
                title
              `
            )

            .in(
              "id",
              testIds
            );


        if (
          error
        ) {

          console.warn(
            "Test information error:",
            error
          );

        }

        else {

          (
            tests || []
          ).forEach(
            test => {

              testsById.set(
                test.id,
                test
              );

            }
          );

        }

      }


      /* -----------------------------------------------
         ONLY LAST FIVE
        ------------------------------------------------ */

      const recent =
        attempts.slice(
          0,
          5
        );


      let html =
        "";


      /* -----------------------------------------------
         EACH ATTEMPT
        ------------------------------------------------ */

      recent.forEach(
        attempt => {


          const test =
            testsById.get(
              attempt.test_id
            );


          const testTitle =
            test?.title ||

            (
              test?.test_number
                ? `Test ${test.test_number}`
                : `Mock Test`
            );


          const score =
            Number(
              attempt.score
            ) || 0;


          const maximum =
            Number(
              attempt.maximum_marks
            ) || 200;


          const correct =
            Number(
              attempt.correct
            ) || 0;


          const wrong =
            Number(
              attempt.wrong
            ) || 0;


          const skipped =
            Number(
              attempt.skipped
            ) || 0;


          const percentage =
            Number(
              attempt.percentage
            );


          const date =
            formatDate(
              attempt.submitted_at ||
              attempt.created_at
            );


          /* -------------------------------------------
             SCORE CLASS
          -------------------------------------------- */

          let scoreClass =
            "activity-score";


          if (
            Number.isFinite(
              percentage
            )
          ) {

            if (
              percentage >= 70
            ) {

              scoreClass +=
                " score-good";

            }

            else if (
              percentage >= 50
            ) {

              scoreClass +=
                " score-average";

            }

            else {

              scoreClass +=
                " score-low";

            }

          }


          /* -------------------------------------------
             ROW
          -------------------------------------------- */

          html += `

            <div class="activity-row">


              <div class="activity-main">


                <div class="activity-icon">
                  📝
                </div>


                <div class="activity-info">

                  <strong>
                    ${escapeHtml(
                      testTitle
                    )}
                  </strong>

                  <span>
                    Submitted ${date}
                  </span>

                </div>


              </div>


              <div class="activity-details">

                <span>
                  ✓ ${correct}
                </span>

                <span>
                  ✕ ${wrong}
                </span>

                <span>
                  ○ ${skipped}
                </span>

              </div>


              <div
                class="${scoreClass}"
              >

                <strong>
                  ${score}/${maximum}
                </strong>

                <span>
                  ${
                    Number.isFinite(
                      percentage
                    )
                      ? `${percentage.toFixed(1)}%`
                      : "—"
                  }
                </span>

              </div>


            </div>

          `;

        }
      );


      activityContainer.innerHTML =
        html;

    }


    /* =====================================================
       LOGOUT
    ====================================================== */

    logoutButton?.addEventListener(
      "click",
      async () => {


        logoutButton.disabled =
          true;


        logoutButton.textContent =
          "Signing out…";


        try {


          const {
            error
          } =
            await supabase.auth
              .signOut();


          if (
            error
          ) {

            console.error(
              "Logout error:",
              error
            );


            logoutButton.disabled =
              false;


            logoutButton.innerHTML =
              `
                <span class="nav-icon">
                  ↪
                </span>

                Sign Out
              `;


            return;

          }


          window.location.href =
            "/login";


        }

        catch (
          error
        ) {

          console.error(
            "Unexpected logout error:",
            error
          );


          window.location.href =
            "/login";

        }

      }
    );


    /* =====================================================
       MOBILE MENU
    ====================================================== */

    mobileMenu?.addEventListener(
      "click",
      () => {

        sidebar?.classList.toggle(
          "open"
        );

      }
    );


    /* =====================================================
       CLOSE MOBILE SIDEBAR
    ====================================================== */

    document
      .querySelectorAll(
        ".sidebar a"
      )
      .forEach(
        link => {

          link.addEventListener(
            "click",
            () => {

              sidebar?.classList.remove(
                "open"
              );

            }
          );

        }
      );


    /* =====================================================
       START
    ====================================================== */

    loadStudent();

  </script>


