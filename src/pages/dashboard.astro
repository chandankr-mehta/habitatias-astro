---
---
<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="theme-color"
    content="#0b4385"
  />

  <title>
    Student Dashboard | Habitat IAS
  </title>

  <style>

    /* =====================================================
       RESET
    ====================================================== */

    * {
      box-sizing: border-box;
    }


    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
    }


    body {

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        #f4f7fb;

      color:
        #122b4c;

      -webkit-font-smoothing:
        antialiased;

    }


    a {
      text-decoration: none;
      color: inherit;
    }


    button,
    input {
      font-family: inherit;
    }


    button {
      border: 0;
    }


    /* =====================================================
       LOADING SCREEN
    ====================================================== */

    .loading-screen {

      position: fixed;

      inset: 0;

      z-index: 9999;

      display: flex;

      align-items: center;

      justify-content: center;

      background:
        linear-gradient(
          135deg,
          #082f63,
          #0b4385,
          #1264c0
        );

    }


    .loading-box {

      display: flex;

      flex-direction: column;

      align-items: center;

      gap: 14px;

      color: white;

    }


    .loading-logo {

      width: 56px;
      height: 56px;

      display: grid;

      place-items: center;

      border-radius: 16px;

      background: white;

      color: #0b4385;

      font-size: 24px;

      font-weight: 950;

      box-shadow:
        0 12px 35px
        rgba(0,0,0,.18);

    }


    .loading-spinner {

      width: 24px;
      height: 24px;

      border:
        3px solid
        rgba(255,255,255,.25);

      border-top-color:
        white;

      border-radius: 50%;

      animation:
        spin .8s linear infinite;

    }


    @keyframes spin {

      to {
        transform: rotate(360deg);
      }

    }


    /* =====================================================
       APP
    ====================================================== */

    .app {

      min-height: 100vh;

      display: flex;

    }


    /* =====================================================
       SIDEBAR
    ====================================================== */

    .sidebar {

      width: 250px;

      min-height: 100vh;

      position: fixed;

      left: 0;
      top: 0;
      bottom: 0;

      padding:
        22px 15px;

      color: white;

      background:
        linear-gradient(
          180deg,
          #082f63 0%,
          #0a3d77 55%,
          #0c4c91 100%
        );

      z-index: 100;

      display: flex;

      flex-direction: column;

    }


    /* =====================================================
       BRAND
    ====================================================== */

    .brand {

      display: flex;

      align-items: center;

      gap: 11px;

      padding:
        3px 9px 24px;

      border-bottom:
        1px solid
        rgba(255,255,255,.10);

    }


    .brand-logo {

      width: 43px;
      height: 43px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        linear-gradient(
          145deg,
          #ffffff,
          #dbeafe
        );

      color:
        #0b4385;

      font-weight:
        950;

      font-size:
        19px;

    }


    .brand-text {

      display: flex;

      flex-direction: column;

    }


    .brand-text strong {

      font-size:
        16px;

      line-height:
        1;

    }


    .brand-text span {

      margin-top:
        5px;

      color:
        #bfdbfe;

      font-size:
        8px;

      font-weight:
        800;

      letter-spacing:
        1.1px;

    }


    /* =====================================================
       NAVIGATION
    ====================================================== */

    .nav-title {

      padding:
        25px 11px 10px;

      color:
        #8fb7e8;

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        1.2px;

      text-transform:
        uppercase;

    }


    .nav {

      display:
        grid;

      gap:
        5px;

    }


    .nav-link {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      padding:
        11px 12px;

      border-radius:
        10px;

      color:
        #dbeafe;

      font-size:
        12px;

      font-weight:
        700;

      transition:
        background .18s ease,
        color .18s ease,
        transform .18s ease;

    }


    .nav-link:hover {

      color:
        white;

      background:
        rgba(255,255,255,.08);

      transform:
        translateX(2px);

    }


    .nav-link.active {

      color:
        white;

      background:
        rgba(255,255,255,.13);

      box-shadow:
        inset 3px 0 0
        #60a5fa;

    }


    .nav-icon {

      width: 27px;
      height: 27px;

      flex: 0 0 27px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        7px;

      background:
        rgba(255,255,255,.07);

      font-size:
        13px;

    }


    /* =====================================================
       SIDEBAR BOTTOM
    ====================================================== */

    .sidebar-bottom {

      margin-top:
        auto;

      padding-top:
        15px;

      border-top:
        1px solid
        rgba(255,255,255,.10);

    }


    .logout {

      width: 100%;

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      padding:
        11px 12px;

      border-radius:
        10px;

      color:
        #dbeafe;

      background:
        transparent;

      cursor:
        pointer;

      font-size:
        12px;

      font-weight:
        700;

      text-align:
        left;

      transition:
        background .18s ease;

    }


    .logout:hover {

      background:
        rgba(255,255,255,.08);

      color:
        white;

    }


    /* =====================================================
       MAIN
    ====================================================== */

    .main {

      width:
        calc(100% - 250px);

      margin-left:
        250px;

      min-height:
        100vh;

      padding:
        25px 30px 50px;

    }


    /* =====================================================
       TOP BAR
    ====================================================== */

    .topbar {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        20px;

      margin-bottom:
        26px;

    }


    .breadcrumb {

      color:
        #8a9aae;

      font-size:
        10px;

      font-weight:
        700;

    }


    .breadcrumb strong {

      color:
        #244567;

    }


    .top-profile {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

    }


    .top-avatar {

      width:
        38px;

      height:
        38px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        50%;

      color:
        white;

      background:
        linear-gradient(
          135deg,
          #1264c0,
          #2563eb
        );

      font-size:
        13px;

      font-weight:
        900;

      box-shadow:
        0 5px 15px
        rgba(37,99,235,.20);

    }


    .top-user {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-end;

    }


    .top-user strong {

      color:
        #17385f;

      font-size:
        11px;

    }


    .top-user span {

      color:
        #8a9aae;

      font-size:
        9px;

    }


    .mobile-menu {

      display:
        none;

      width:
        40px;

      height:
        40px;

      border-radius:
        10px;

      background:
        white;

      color:
        #17385f;

      cursor:
        pointer;

      box-shadow:
        0 4px 14px
        rgba(20,50,90,.06);

    }


    /* =====================================================
       WELCOME HERO
    ====================================================== */

    .welcome {

      position:
        relative;

      overflow:
        hidden;

      padding:
        30px;

      border-radius:
        20px;

      color:
        white;

      background:
        radial-gradient(
          circle at 85% 20%,
          rgba(96,165,250,.35),
          transparent 35%
        ),
        radial-gradient(
          circle at 100% 100%,
          rgba(14,165,233,.28),
          transparent 38%
        ),
        linear-gradient(
          135deg,
          #082f63,
          #0b4385 55%,
          #1264c0
        );

      box-shadow:
        0 15px 40px
        rgba(8,47,99,.14);

    }


    .welcome::after {

      content:
        "";

      position:
        absolute;

      width:
        240px;

      height:
        240px;

      right:
        -90px;

      bottom:
        -120px;

      border:
        1px solid
        rgba(255,255,255,.12);

      border-radius:
        50%;

    }


    .welcome-content {

      position:
        relative;

      z-index:
        2;

      max-width:
        760px;

    }


    .welcome-label {

      display:
        inline-flex;

      padding:
        6px 10px;

      border-radius:
        999px;

      background:
        rgba(255,255,255,.12);

      border:
        1px solid
        rgba(255,255,255,.13);

      color:
        #dbeafe;

      font-size:
        9px;

      font-weight:
        900;

      letter-spacing:
        1px;

      text-transform:
        uppercase;

    }


    .welcome h1 {

      margin:
        13px 0 8px;

      font-size:
        clamp(25px, 3vw, 36px);

      line-height:
        1.1;

      letter-spacing:
        -.7px;

    }


    .welcome p {

      margin:
        0;

      max-width:
        680px;

      color:
        #dbeafe;

      font-size:
        12px;

      line-height:
        1.7;

    }


    /* =====================================================
       STATS
    ====================================================== */

    .stats {

      display:
        grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap:
        14px;

      margin-top:
        18px;

    }


    .stat {

      padding:
        18px;

      border:
        1px solid
        #e2e9f2;

      border-radius:
        16px;

      background:
        white;

      box-shadow:
        0 5px 20px
        rgba(20,50,90,.045);

      transition:
        transform .18s ease,
        box-shadow .18s ease;

    }


    .stat:hover {

      transform:
        translateY(-2px);

      box-shadow:
        0 12px 28px
        rgba(20,50,90,.08);

    }


    .stat-top {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

    }


    .stat-label {

      color:
        #7a8ba1;

      font-size:
        10px;

      font-weight:
        800;

    }


    .stat-icon {

      width:
        30px;

      height:
        30px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        9px;

      background:
        #edf4ff;

      font-size:
        13px;

    }


    .stat-value {

      margin-top:
        13px;

      color:
        #17385f;

      font-size:
        27px;

      font-weight:
        950;

      letter-spacing:
        -.6px;

    }


    .stat-sub {

      margin-top:
        4px;

      color:
        #9aa7b8;

      font-size:
        9px;

      font-weight:
        700;

    }


    /* =====================================================
       SECTION
    ====================================================== */

    .section {

      margin-top:
        28px;

    }


    .section-heading {

      display:
        flex;

      align-items:
        flex-end;

      justify-content:
        space-between;

      gap:
        15px;

      margin-bottom:
        12px;

    }


    .section-heading h2 {

      margin:
        0;

      color:
        #17385f;

      font-size:
        16px;

      font-weight:
        900;

    }


    .section-heading span {

      color:
        #8a9aae;

      font-size:
        9px;

      font-weight:
        700;

    }


    /* =====================================================
       TEST SERIES CARD
    ====================================================== */

    .series-card {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        20px;

      padding:
        20px;

      border:
        1px solid
        #dce7f3;

      border-radius:
        17px;

      background:
        linear-gradient(
          135deg,
          #ffffff,
          #f7fbff
        );

      box-shadow:
        0 8px 28px
        rgba(20,50,90,.05);

    }


    .series-info {

      display:
        flex;

      align-items:
        center;

      gap:
        14px;

      min-width:
        0;

    }


    .series-icon {

      width:
        48px;

      height:
        48px;

      flex:
        0 0 48px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        14px;

      background:
        linear-gradient(
          135deg,
          #e8f2ff,
          #dbeafe
        );

      font-size:
        20px;

    }


    .series-info h3 {

      margin:
        0 0 5px;

      color:
        #17385f;

      font-size:
        14px;

      font-weight:
        900;

    }


    .series-info p {

      margin:
        0;

      color:
        #8291a5;

      font-size:
        10px;

      line-height:
        1.6;

    }


    .series-button {

      flex:
        0 0 auto;

      padding:
        11px 16px;

      border-radius:
        10px;

      color:
        white;

      background:
        linear-gradient(
          135deg,
          #1264c0,
          #2563eb
        );

      font-size:
        10px;

      font-weight:
        850;

      box-shadow:
        0 6px 18px
        rgba(37,99,235,.18);

      transition:
        transform .18s ease;

    }


    .series-button:hover {

      transform:
        translateY(-1px);

    }


    /* =====================================================
       QUICK ACTIONS
    ====================================================== */

    .quick-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap:
        14px;

    }


    .quick-card {

      padding:
        20px;

      border:
        1px solid
        #e1e8f1;

      border-radius:
        16px;

      background:
        white;

      box-shadow:
        0 5px 20px
        rgba(20,50,90,.04);

      transition:
        transform .18s ease,
        box-shadow .18s ease,
        border-color .18s ease;

    }


    .quick-card:hover {

      transform:
        translateY(-3px);

      border-color:
        #c9d9ed;

      box-shadow:
        0 12px 28px
        rgba(20,50,90,.08);

    }


    .quick-icon {

      width:
        40px;

      height:
        40px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        #edf4ff;

      font-size:
        17px;

    }


    .quick-card h3 {

      margin:
        13px 0 5px;

      color:
        #17385f;

      font-size:
        13px;

      font-weight:
        900;

    }


    .quick-card p {

      margin:
        0;

      color:
        #8593a6;

      font-size:
        10px;

      line-height:
        1.65;

    }


    /* =====================================================
       ACTIVITY
    ====================================================== */

    .activity {

      display:
        flex;

      flex-direction:
        column;

      gap:
        9px;

    }


    .activity-row {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        18px;

      padding:
        15px 17px;

      border:
        1px solid
        #e2e9f2;

      border-radius:
        14px;

      background:
        white;

      transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;

    }


    .activity-row:hover {

      transform:
        translateY(-1px);

      border-color:
        #c9d8ea;

      box-shadow:
        0 8px 24px
        rgba(20,50,90,.06);

    }


    .activity-main {

      min-width:
        0;

      display:
        flex;

      align-items:
        center;

      gap:
        12px;

    }


    .activity-icon {

      width:
        40px;

      height:
        40px;

      flex:
        0 0 40px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        11px;

      background:
        #edf4ff;

      font-size:
        17px;

    }


    .activity-info {

      min-width:
        0;

      display:
        flex;

      flex-direction:
        column;

      gap:
        4px;

    }


    .activity-info strong {

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      color:
        #17385f;

      font-size:
        12px;

      font-weight:
        850;

    }


    .activity-info span {

      color:
        #8a9aae;

      font-size:
        9px;

      font-weight:
        700;

    }


    .activity-details {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

      color:
        #71829a;

      font-size:
        9px;

      font-weight:
        800;

      white-space:
        nowrap;

    }


    .activity-score {

      min-width:
        80px;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-end;

      gap:
        3px;

    }


    .activity-score strong {

      font-size:
        13px;

      font-weight:
        900;

    }


    .activity-score span {

      font-size:
        9px;

      font-weight:
        800;

    }


    .score-good strong,
    .score-good span {

      color:
        #15803d;

    }


    .score-average strong,
    .score-average span {

      color:
        #b45309;

    }


    .score-low strong,
    .score-low span {

      color:
        #dc2626;

    }


    /* =====================================================
       EMPTY STATE
    ====================================================== */

    .empty {

      padding:
        42px 25px;

      text-align:
        center;

      border:
        1px dashed
        #d8e2ee;

      border-radius:
        15px;

      background:
        rgba(255,255,255,.65);

    }


    .empty-icon {

      width:
        50px;

      height:
        50px;

      margin:
        0 auto 12px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        14px;

      background:
        #edf4ff;

      font-size:
        20px;

    }


    .empty strong {

      display:
        block;

      color:
        #294766;

      font-size:
        12px;

    }


    .empty p {

      max-width:
        430px;

      margin:
        7px auto 0;

      color:
        #8a9aae;

      font-size:
        10px;

      line-height:
        1.6;

    }


    /* =====================================================
       ERROR
    ====================================================== */

    .error-message {

      margin-top:
        12px;

      padding:
        12px 14px;

      border:
        1px solid
        #fecaca;

      border-radius:
        10px;

      color:
        #991b1b;

      background:
        #fef2f2;

      font-size:
        10px;

      font-weight:
        700;

    }


    /* =====================================================
       MOBILE
    ====================================================== */

    @media (
      max-width: 1000px
    ) {

      .stats {

        grid-template-columns:
          repeat(2, minmax(0,1fr));

      }


      .quick-grid {

        grid-template-columns:
          repeat(2, minmax(0,1fr));

      }

    }


    @media (
      max-width: 760px
    ) {

      .sidebar {

        transform:
          translateX(-100%);

        transition:
          transform .25s ease;

        box-shadow:
          10px 0 30px
          rgba(0,0,0,.15);

      }


      .sidebar.open {

        transform:
          translateX(0);

      }


      .main {

        width:
          100%;

        margin-left:
          0;

        padding:
          18px 16px 40px;

      }


      .mobile-menu {

        display:
          grid;

        place-items:
          center;

      }


      .topbar {

        margin-bottom:
          18px;

      }


      .breadcrumb {

        display:
          none;

      }


      .top-profile {

        margin-left:
          auto;

      }


      .welcome {

        padding:
          24px 20px;

      }


      .welcome h1 {

        font-size:
          26px;

      }


      .stats {

        grid-template-columns:
          repeat(2, minmax(0,1fr));

        gap:
          10px;

      }


      .stat {

        padding:
          15px;

      }


      .series-card {

        align-items:
          flex-start;

        flex-direction:
          column;

      }


      .series-button {

        width:
          100%;

        text-align:
          center;

      }


      .quick-grid {

        grid-template-columns:
          1fr;

      }


      .activity-row {

        align-items:
          flex-start;

        flex-wrap:
          wrap;

      }


      .activity-details {

        width:
          100%;

        padding-left:
          52px;

      }


      .activity-score {

        margin-left:
          auto;

      }

    }


    @media (
      max-width: 480px
    ) {

      .top-user {

        display:
          none;

      }


      .stats {

        grid-template-columns:
          1fr 1fr;

      }


      .stat-value {

        font-size:
          22px;

      }


      .welcome p {

        font-size:
          11px;

      }


      .series-info {

        align-items:
          flex-start;

      }


      .series-info h3 {

        font-size:
          13px;

      }


      .activity-details {

        gap:
          7px;

      }

    }

  </style>

</head>


<body>


  <!-- =====================================================
       LOADING
  ====================================================== -->

  <div
    class="loading-screen"
    id="loadingScreen"
  >

    <div class="loading-box">

      <div class="loading-logo">
        H
      </div>

      <div class="loading-spinner"></div>

      <strong>
        Loading Dashboard...
      </strong>

