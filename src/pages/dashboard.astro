---
---

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="theme-color"
    content="#0b4385"
  />

  <title>Student Dashboard | Habitat IAS</title>


  <style>

    /* =====================================================
       RESET
    ====================================================== */

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
    }

    body {

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        #f4f7fb;

      color: #122b4c;

      -webkit-font-smoothing: antialiased;
    }

    button,
    input {
      font-family: inherit;
    }

    a {
      text-decoration: none;
    }


    /* =====================================================
       APP
    ====================================================== */

    .app {

      min-height: 100vh;

      display: flex;
    }


    /* =====================================================
       SIDEBAR
    ====================================================== */

    .sidebar {

      width: 250px;

      min-height: 100vh;

      position: fixed;

      left: 0;
      top: 0;
      bottom: 0;

      padding: 22px 15px;

      color: white;

      background:
        linear-gradient(
          180deg,
          #082f63 0%,
          #0a3d77 55%,
          #0c4c91 100%
        );

      z-index: 20;

      display: flex;

      flex-direction: column;
    }


    .brand {

      display: flex;

      align-items: center;

      gap: 11px;

      padding:
        3px 9px 24px;

      border-bottom:
        1px solid
        rgba(255,255,255,.10);
    }


    .brand-logo {

      width: 43px;
      height: 43px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background:
        linear-gradient(
          145deg,
          #ffffff,
          #dbeafe
        );

      color: #0b4385;

      font-weight: 950;

      font-size: 19px;
    }


    .brand-text {

      display: flex;

      flex-direction: column;
    }


    .brand-text strong {

      font-size: 16px;

      line-height: 1;
    }


    .brand-text span {

      margin-top: 5px;

      color: #bfdbfe;

      font-size: 8px;

      font-weight: 800;

      letter-spacing: 1.1px;
    }


    /* =====================================================
       NAVIGATION
    ====================================================== */

    .nav-title {

      padding:
        25px 11px 10px;

      color: #8fb7e8;

      font-size: 9px;

      font-weight: 900;

      letter-spacing: 1.2px;

      text-transform: uppercase;
    }


    .nav {

      display: grid;

      gap: 5px;
    }


    .nav-link {

      display: flex;

      align-items: center;

      gap: 11px;

      padding:
        11px 12px;

      border-radius: 10px;

      color: #dbeafe;

      font-size: 12px;

      font-weight: 700;

      transition:
        background .18s ease,
        color .18s ease;
    }


    .nav-link:hover {

      color: white;

      background:
        rgba(255,255,255,.08);
    }


    .nav-link.active {

      color: white;

      background:
        rgba(255,255,255,.13);

      box-shadow:
        inset 3px 0 0 #60a5fa;
    }


    .nav-icon {

      width: 27px;
      height: 27px;

      display: grid;

      place-items: center;

      border-radius: 7px;

      background:
        rgba(255,255,255,.07);

      font-size: 13px;
    }


    /* =====================================================
       SIDEBAR BOTTOM
    ====================================================== */

    .sidebar-bottom {

      margin-top: auto;

      padding-top: 15px;

      border-top:
        1px solid
        rgba(255,255,255,.10);
    }


    .logout {

      width: 100%;

      border: 0;

      display: flex;

      align-items: center;

      gap: 11px;

      padding:
        11px 12px;

      border-radius: 10px;

      color: #dbeafe;

      background: transparent;

      cursor: pointer;

      font-size: 12px;

      font-weight: 700;

      text-align: left;
    }


    .logout:hover {

      background:
        rgba(255,255,255,.08);

      color: white;
    }


    /* =====================================================
       MAIN
    ====================================================== */

    .main {

      width: calc(100% - 250px);

      margin-left: 250px;

      min-height: 100vh;

      padding: 25px 30px 45px;
    }


    /* =====================================================
       TOP BAR
    ====================================================== */

    .topbar {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      margin-bottom: 26px;
    }


    .mobile-menu {

      display: none;

      width: 40px;
      height: 40px;

      border: 0;

      border-radius: 10px;

      background: white;

      color: #17385f;

      cursor: pointer;
    }


    .breadcrumb {

      color: #8a9aae;

      font-size: 10px;

      font-weight: 700;
    }


    .breadcrumb strong {

      color: #244567;
    }


    .top-profile {

      display: flex;

      align-items: center;

      gap: 10px;
    }


    .top-avatar {

      width: 38px;
      height: 38px;

      display: grid;

      place-items: center;

      border-radius: 50%;

      color: white;

      background:
        linear-gradient(
          135deg,
          #1264c0,
          #2563eb
        );

      font-size: 13px;

      font-weight: 900;
    }


    .top-user {

      display: flex;

      flex-direction: column;

      align-items: flex-end;
    }


    .top-user strong {

      color: #17385f;

      font-size: 11px;
    }


    .top-user span {

      color: #8a9aae;

      font-size: 9px;
    }


    /* =====================================================
       WELCOME HERO
    ====================================================== */

    .welcome {

      position: relative;

      overflow: hidden;

      padding: 28px 30px;

      border-radius: 18px;

      color: white;

      background:
        radial-gradient(
          circle at 85% 20%,
          rgba(96,165,250,.25),
          transparent 30%
        ),

        linear-gradient(
          135deg,
          #0a3a73,
          #1264b5
        );

      box-shadow:
        0 14px 35px
        rgba(18,75,135,.16);
    }


    .welcome::after {

      content: "";

      position: absolute;

      width: 250px;
      height: 250px;

      right: -100px;
      bottom: -170px;

      border-radius: 50%;

      border:
        1px solid
        rgba(255,255,255,.12);

      box-shadow:
        0 0 0 30px
        rgba(255,255,255,.025);
    }


    .welcome-content {

      position: relative;

      z-index: 2;

      max-width: 700px;
    }


    .welcome-label {

      color: #bfdbfe;

      font-size: 9px;

      font-weight: 900;

      letter-spacing: 1.3px;

      text-transform: uppercase;
    }


    .welcome h1 {

      margin:
        8px 0 8px;

      font-size:
        clamp(
          25px,
          3vw,
          34px
        );

      line-height: 1.1;

      letter-spacing: -1px;
    }


    .welcome p {

      margin: 0;

      color: #dbeafe;

      font-size: 12px;

      line-height: 1.7;
    }


    /* =====================================================
       STAT CARDS
    ====================================================== */

    .stats {

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 15px;

      margin-top: 18px;
    }


    .stat {

      padding: 19px;

      background: white;

      border:
        1px solid #e4ebf3;

      border-radius: 14px;

      box-shadow:
        0 5px 18px
        rgba(20,50,90,.035);
    }


    .stat-top {

      display: flex;

      align-items: center;

      justify-content: space-between;
    }


    .stat-icon {

      width: 34px;
      height: 34px;

      display: grid;

      place-items: center;

      border-radius: 9px;

      color: #2563eb;

      background: #eff6ff;

      font-size: 14px;
    }


    .stat-label {

      color: #8a9aae;

      font-size: 9px;

      font-weight: 800;

      text-transform: uppercase;

      letter-spacing: .6px;
    }


    .stat-value {

      margin-top: 12px;

      color: #17385f;

      font-size: 25px;

      font-weight: 900;

      letter-spacing: -.7px;
    }


    .stat-sub {

      margin-top: 3px;

      color: #9aa8b8;

      font-size: 9px;

      font-weight: 600;
    }


    /* =====================================================
       SECTION
    ====================================================== */

    .section {

      margin-top: 26px;
    }


    .section-heading {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      margin-bottom: 13px;
    }


    .section-heading h2 {

      margin: 0;

      color: #17385f;

      font-size: 17px;

      letter-spacing: -.3px;
    }


    .section-heading span {

      color: #8b9aab;

      font-size: 9px;

      font-weight: 700;
    }


    /* =====================================================
       TEST SERIES CARD
    ====================================================== */

    .series-card {

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 25px;

      padding: 21px;

      background: white;

      border:
        1px solid #e1e9f2;

      border-radius: 15px;

      box-shadow:
        0 5px 18px
        rgba(20,50,90,.035);
    }


    .series-info {

      display: flex;

      align-items: center;

      gap: 15px;
    }


    .series-icon {

      width: 53px;
      height: 53px;

      flex: 0 0 53px;

      display: grid;

      place-items: center;

      border-radius: 13px;

      color: white;

      background:
        linear-gradient(
          135deg,
          #0c4c91,
          #2563eb
        );

      font-size: 20px;

      box-shadow:
        0 8px 18px
        rgba(37,99,235,.17);
    }


    .series-info h3 {

      margin: 0;

      color: #17385f;

      font-size: 14px;
    }


    .series-info p {

      margin:
        5px 0 0;

      color: #8291a4;

      font-size: 10px;

      line-height: 1.5;
    }


    .series-button {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      min-width: 110px;

      padding:
        10px 15px;

      border-radius: 9px;

      color: white;

      background:
        #1264c0;

      font-size: 10px;

      font-weight: 900;

      transition:
        transform .18s ease,
        background .18s ease;
    }


    .series-button:hover {

      transform:
        translateY(-1px);

      background:
        #0b55a5;
    }


    /* =====================================================
       QUICK ACTIONS
    ====================================================== */

    .quick-grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 14px;
    }


    .quick-card {

      padding: 18px;

      background: white;

      border:
        1px solid #e2eaf3;

      border-radius: 14px;

      transition:
        transform .18s ease,
        box-shadow .18s ease;
    }


    .quick-card:hover {

      transform:
        translateY(-2px);

      box-shadow:
        0 10px 25px
        rgba(20,50,90,.07);
    }


    .quick-icon {

      width: 36px;
      height: 36px;

      display: grid;

      place-items: center;

      border-radius: 9px;

      color: #2563eb;

      background: #eff6ff;

      font-size: 15px;
    }


    .quick-card h3 {

      margin:
        13px 0 5px;

      color: #244567;

      font-size: 12px;
    }


    .quick-card p {

      margin: 0;

      color: #8b9aac;

      font-size: 9px;

      line-height: 1.55;
    }


    /* =====================================================
       RECENT ACTIVITY
    ====================================================== */

    .activity {

      overflow: hidden;

      background: white;

      border:
        1px solid #e2eaf3;

      border-radius: 14px;
    }


    .empty {

      padding: 38px 20px;

      text-align: center;
    }


    .empty-icon {

      width: 45px;
      height: 45px;

      margin:
        0 auto 10px;

      display: grid;

      place-items: center;

      border-radius: 12px;

      color: #5485bd;

      background: #eff6ff;

      font-size: 17px;
    }


    .empty strong {

      display: block;

      color: #526b88;

      font-size: 11px;
    }


    .empty p {

      margin:
        5px auto 0;

      max-width: 330px;

      color: #9aa8b8;

      font-size: 9px;

      line-height: 1.6;
    }


    /* =====================================================
       TEST HISTORY / PERFORMANCE
    ====================================================== */

    .view-all-results {
      color: #1264c0;
      font-size: 10px;
      font-weight: 900;
    }

    .view-all-results:hover {
      color: #0b55a5;
    }

    .activity {
      overflow: hidden;
      background: white;
      border:
        1px solid #e2eaf3;
      border-radius: 14px;
    }

    .activity-loading,
    .activity-empty {
      padding: 38px 20px;
      text-align: center;
      color: #8b9aac;
      font-size: 10px;
    }

    .activity-empty .empty-icon {
      margin-bottom: 10px;
    }

    .activity-empty strong {
      display: block;
      color: #526b88;
      font-size: 12px;
    }

    .activity-empty p {
      margin: 5px auto 0;
      max-width: 360px;
      color: #9aa8b8;
      font-size: 9px;
      line-height: 1.6;
    }

    .attempt-list {
      display: grid;
    }

    .attempt-row {
      display: grid;
      grid-template-columns:
        minmax(230px, 2.2fr)
        110px
        100px
        105px
        115px
        125px;
      align-items: center;
      gap: 12px;
      padding: 15px 17px;
      border-bottom:
        1px solid #edf1f6;
    }

    .attempt-row:last-child {
      border-bottom: 0;
    }

    .attempt-test {
      min-width: 0;
    }

    .attempt-test-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 34px;
      height: 22px;
      margin-right: 7px;
      padding: 0 7px;
      border-radius: 6px;
      color: #1557d6;
      background: #eff6ff;
      font-size: 9px;
      font-weight: 900;
    }

    .attempt-test-title {
      color: #17385f;
      font-size: 11px;
      font-weight: 850;
      line-height: 1.4;
    }

    .attempt-date {
      margin-top: 4px;
      color: #9aa8b8;
      font-size: 8px;
      font-weight: 650;
    }

    .attempt-cell {
      color: #526b88;
      font-size: 10px;
      font-weight: 750;
    }

    .attempt-cell strong {
      color: #17385f;
      font-size: 11px;
    }

    .score-good {
      color: #159447 !important;
    }

    .score-average {
      color: #d97706 !important;
    }

    .score-low {
      color: #c62828 !important;
    }

    .attempt-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 31px;
      padding: 7px 10px;
      border-radius: 8px;
      color: white;
      background: #1264c0;
      font-size: 9px;
      font-weight: 900;
    }

    .attempt-action:hover {
      background: #0b55a5;
    }

    .history-header {
      display: grid;
      grid-template-columns:
        minmax(230px, 2.2fr)
        110px
        100px
        105px
        115px
        125px;
      gap: 12px;
      padding: 10px 17px;
      color: #8a9aae;
      background: #f8fafc;
      border-bottom:
        1px solid #edf1f6;
      font-size: 8px;
      font-weight: 900;
      letter-spacing: .5px;
      text-transform: uppercase;
    }

    @media (max-width: 1100px) {
      .attempt-row,
      .history-header {
        grid-template-columns:
          minmax(220px, 2fr)
          90px
          90px
          95px
          105px;
      }

      .history-header > :nth-child(5),
      .attempt-row > :nth-child(5) {
        display: none;
      }
    }

    @media (max-width: 800px) {
      .attempt-row {
        grid-template-columns:
          1fr 90px 95px;
        gap: 10px;
      }

      .history-header {
        display: none;
      }

      .attempt-row > :nth-child(4),
      .attempt-row > :nth-child(5) {
        display: none;
      }

      .attempt-action {
        width: 100%;
      }
    }

    @media (max-width: 520px) {
      .attempt-row {
        grid-template-columns: 1fr;
      }

      .attempt-row > :nth-child(3),
      .attempt-row > :nth-child(4) {
        display: block;
      }

      .attempt-action {
        width: 100%;
      }
    }


    /* =====================================================
       DYNAMIC TEST HISTORY

       Runtime-generated rows use innerHTML, so these selectors
       are intentionally global.
    ====================================================== */

    :global(.activity) {
      overflow: hidden;
      width: 100%;
      background: #fff;
      border: 1px solid #e2eaf3;
      border-radius: 14px;
    }

    :global(.history-header) {
      display: grid;
      grid-template-columns:
        minmax(250px, 2.4fr)
        100px 100px 125px 100px 135px;
      align-items: center;
      gap: 12px;
      width: 100%;
      box-sizing: border-box;
      padding: 12px 16px;
      color: #8191a5;
      background: #f8fafc;
      border-bottom: 1px solid #e8eef5;
      font-size: 8px;
      font-weight: 900;
      letter-spacing: .5px;
      text-transform: uppercase;
    }

    :global(.attempt-list) {
      display: block;
      width: 100%;
    }

    :global(.attempt-row) {
      display: grid;
      grid-template-columns:
        minmax(250px, 2.4fr)
        100px 100px 125px 100px 135px;
      align-items: center;
      gap: 12px;
      width: 100%;
      min-height: 76px;
      box-sizing: border-box;
      padding: 14px 16px;
      background: #fff;
      border-bottom: 1px solid #edf1f6;
    }

    :global(.attempt-row:last-child) {
      border-bottom: 0;
    }

    :global(.attempt-test) {
      min-width: 0;
    }

    :global(.attempt-test > div:first-child) {
      display: flex;
      align-items: center;
      min-width: 0;
      gap: 7px;
    }

    :global(.attempt-test-number) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      min-width: 42px;
      height: 23px;
      box-sizing: border-box;
      padding: 0 7px;
      border-radius: 6px;
      color: #1557d6;
      background: #eff6ff;
      font-size: 8px;
      font-weight: 900;
    }

    :global(.attempt-test-title) {
      min-width: 0;
      overflow: hidden;
      color: #17385f;
      font-size: 10px;
      font-weight: 850;
      line-height: 1.4;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(.attempt-date) {
      margin-top: 5px;
      color: #9aa8b8;
      font-size: 8px;
      font-weight: 650;
    }

    :global(.attempt-cell) {
      color: #7b8da3;
      font-size: 8px;
      font-weight: 700;
      line-height: 1.55;
    }

    :global(.attempt-cell strong) {
      color: #17385f;
      font-size: 11px;
      font-weight: 900;
    }

    :global(.score-good) {
      color: #159447 !important;
    }

    :global(.score-average) {
      color: #d97706 !important;
    }

    :global(.score-low) {
      color: #c62828 !important;
    }

    :global(.attempt-action) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 32px;
      box-sizing: border-box;
      padding: 7px 9px;
      border-radius: 8px;
      color: #fff !important;
      background: #1264c0;
      font-size: 8px;
      font-weight: 900;
      text-decoration: none !important;
      white-space: nowrap;
    }

    :global(.attempt-action:hover) {
      background: #0b55a5;
    }

    :global(.activity-loading),
    :global(.activity-empty) {
      padding: 38px 20px;
      text-align: center;
      color: #8b9aac;
      font-size: 10px;
    }

    :global(.activity-empty strong) {
      display: block;
      margin-top: 7px;
      color: #526b88;
      font-size: 12px;
    }

    :global(.activity-empty p) {
      margin: 5px auto 0;
      max-width: 360px;
      color: #9aa8b8;
      font-size: 9px;
      line-height: 1.6;
    }

    @media (max-width: 1150px) {
      :global(.history-header),
      :global(.attempt-row) {
        grid-template-columns:
          minmax(210px, 2fr)
          85px 85px 110px 85px 120px;
      }
    }

    @media (max-width: 900px) {
      :global(.history-header) {
        display: none;
      }

      :global(.attempt-row) {
        grid-template-columns:
          minmax(220px, 1fr) 90px 120px;
        gap: 12px;
      }

      :global(.attempt-row > :nth-child(4)),
      :global(.attempt-row > :nth-child(5)) {
        display: none;
      }

      :global(.attempt-action) {
        width: auto;
        min-width: 110px;
      }
    }

    @media (max-width: 560px) {
      :global(.attempt-row) {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      :global(.attempt-row > :nth-child(3)),
      :global(.attempt-row > :nth-child(4)),
      :global(.attempt-row > :nth-child(5)) {
        display: block;
      }

      :global(.attempt-test-title) {
        white-space: normal;
      }

      :global(.attempt-action) {
        width: 100%;
      }
    }


    /* =====================================================
       LOADING
    ====================================================== */

    .loading-screen {

      position: fixed;

      inset: 0;

      z-index: 100;

      display: flex;

      align-items: center;

      justify-content: center;

      background: #f4f7fb;
    }


    .loader {

      width: 34px;
      height: 34px;

      border:
        3px solid #dbeafe;

      border-top-color:
        #2563eb;

      border-radius: 50%;

      animation:
        spin .8s linear infinite;
    }



    /* =====================================================
       PROGRESS REPORT
       ====================================================== */

    .progress-report {
      display: grid;
      gap: 15px;
    }

    .progress-overview {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .progress-mini {
      padding: 16px;
      background: #fff;
      border: 1px solid #e2eaf3;
      border-radius: 13px;
    }

    .progress-mini-label {
      color: #8a9aae;
      font-size: 8px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .6px;
    }

    .progress-mini-value {
      margin-top: 8px;
      color: #17385f;
      font-size: 20px;
      font-weight: 950;
    }

    .progress-mini-sub {
      margin-top: 3px;
      color: #9aa8b8;
      font-size: 8px;
      line-height: 1.45;
    }

    .progress-grid {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 15px;
    }

    .progress-card {
      padding: 20px;
      background: #fff;
      border: 1px solid #e2eaf3;
      border-radius: 14px;
      box-shadow: 0 5px 18px rgba(20,50,90,.035);
    }

    .progress-card h3 {
      margin: 0;
      color: #17385f;
      font-size: 13px;
    }

    .progress-card-sub {
      margin: 4px 0 16px;
      color: #8b9aac;
      font-size: 9px;
      line-height: 1.5;
    }

    .trend-chart {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      height: 190px;
      padding: 12px 4px 0;
      border-bottom: 1px solid #e7edf5;
      position: relative;
      overflow: hidden;
    }

    .trend-chart::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 36px;
      border-top: 1px dashed #edf2f7;
      box-shadow:
        0 38px 0 #edf2f7,
        0 76px 0 #edf2f7,
        0 114px 0 #edf2f7;
      pointer-events: none;
    }

    .trend-item {
      flex: 1;
      min-width: 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
    }

    .trend-bar-wrap {
      width: 100%;
      height: 145px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      position: relative;
    }

    .trend-bar {
      width: min(34px, 70%);
      min-height: 3px;
      border-radius: 7px 7px 2px 2px;
      background: linear-gradient(180deg, #3b82f6, #1264c0);
      transition: height .3s ease;
      position: relative;
      z-index: 2;
    }

    .trend-value {
      color: #17385f;
      font-size: 8px;
      font-weight: 900;
      white-space: nowrap;
    }

    .trend-label {
      color: #8b9aac;
      font-size: 7px;
      font-weight: 800;
      white-space: nowrap;
    }

    .progress-metrics {
      display: grid;
      gap: 13px;
    }

    .metric-row {
      display: grid;
      gap: 6px;
    }

    .metric-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      color: #526b88;
      font-size: 9px;
      font-weight: 800;
    }

    .metric-head strong {
      color: #17385f;
    }

    .metric-track {
      height: 8px;
      overflow: hidden;
      border-radius: 99px;
      background: #edf2f7;
    }

    .metric-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #2563eb, #1264c0);
    }

    .improvement-box {
      margin-top: 17px;
      padding: 13px;
      border-radius: 10px;
      background: #eff6ff;
      border: 1px solid #dbeafe;
    }

    .improvement-title {
      color: #174a86;
      font-size: 9px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .improvement-text {
      margin-top: 5px;
      color: #526b88;
      font-size: 9px;
      line-height: 1.55;
    }

    .progress-empty {
      padding: 30px 15px;
      text-align: center;
      color: #8b9aac;
      font-size: 10px;
    }

    @media (max-width: 1000px) {
      .progress-overview {
        grid-template-columns: repeat(2, 1fr);
      }

      .progress-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .progress-overview {
        grid-template-columns: 1fr 1fr;
        gap: 9px;
      }

      .progress-mini {
        padding: 13px;
      }

      .progress-mini-value {
        font-size: 18px;
      }

      .trend-chart {
        gap: 5px;
      }

      .trend-bar {
        width: 70%;
      }
    }


    @keyframes spin {

      to {
        transform: rotate(360deg);
      }

    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @media (max-width: 1000px) {

      .stats {

        grid-template-columns:
          repeat(2, 1fr);
      }

      .quick-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (max-width: 800px) {

      .sidebar {

        transform:
          translateX(-100%);

        transition:
          transform .25s ease;
      }


      .sidebar.open {

        transform:
          translateX(0);
      }


      .main {

        width: 100%;

        margin-left: 0;

        padding:
          18px;
      }


      .mobile-menu {

        display: grid;

        place-items: center;
      }


      .topbar {

        margin-bottom: 18px;
      }

    }


    @media (max-width: 600px) {

