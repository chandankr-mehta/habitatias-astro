    const metricCorrect =
      document.getElementById("metricCorrect");

    const metricCorrectBar =
      document.getElementById("metricCorrectBar");

    const metricAttemptRate =
      document.getElementById("metricAttemptRate");

    const metricAttemptRateBar =
      document.getElementById("metricAttemptRateBar");

    const metricAccuracy =
      document.getElementById("metricAccuracy");

    const metricAccuracyBar =
      document.getElementById("metricAccuracyBar");

    const metricScoreEfficiency =
      document.getElementById("metricScoreEfficiency");

    const metricScoreEfficiencyBar =
      document.getElementById("metricScoreEfficiencyBar");

    const progressInsight =
      document.getElementById("progressInsight");


    /* =====================================================
       GET INITIAL USER
    ====================================================== */

    async function loadStudent() {

      try {

        const {
          data,
          error
        } =
          await supabase.auth.getUser();


        if (
          error ||
          !data.user
        ) {

          window.location.href =
            "/login?redirect=/dashboard";

          return;

        }


        const user =
          data.user;


        /*
         * Supabase Auth metadata.
         *
         * This comes from the registration page:
         *
         * full_name
         * mobile
         */

        const metadata =
          user.user_metadata || {};


        const fullName =
          metadata.full_name ||
          user.email?.split("@")[0] ||
          "Student";


        /*
         * Use the first name in the
         * large welcome heading.
         */

        const firstName =
          fullName
            .trim()
            .split(/\s+/)[0] ||
          "Student";


        welcomeName.textContent =
          firstName;


        topUserName.textContent =
          fullName;


        /*
         * Generate initials.
         */

        const initials =
          fullName
            .trim()
            .split(/\s+/)
            .filter(Boolean)
            .slice(0, 2)
            .map(
              name =>
                name.charAt(0)
                  .toUpperCase()
            )
            .join("");


        topAvatar.textContent =
          initials ||
          "S";


        /* ---------------------------------------------
           LOAD TEST HISTORY
        --------------------------------------------- */

        await loadTestHistory(
          user.id
        );


      } catch (error) {

        console.error(
          "Unable to load student:",
          error
        );


        window.location.href =
          "/login?redirect=/dashboard";


        return;

      } finally {

        loadingScreen.style.display =
          "none";

      }

    }


    /* =====================================================
       LOAD TEST HISTORY + PERFORMANCE
    ====================================================== */

    function escapeHtml(value) {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    function formatDate(value) {

      if (!value) {
        return "Date unavailable";
      }

      const date =
        new Date(value);

      if (Number.isNaN(date.getTime())) {
        return "Date unavailable";
      }

      return date.toLocaleDateString(
        "en-IN",
        {
          day: "2-digit",
          month: "short",
          year: "numeric",
        }
      );

    }


    function formatTime(seconds) {

      const total =
        Math.max(
          0,
          Number(seconds || 0)
        );

      const minutes =
        Math.floor(total / 60);

      const secs =
        total % 60;

      return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(secs).padStart(2, "0")
      );

    }


    function getScoreClass(percentage) {

      if (percentage >= 60) {
        return "score-good";
      }

      if (percentage >= 40) {
        return "score-average";
      }

      return "score-low";

    }



    function renderProgressReport(performance) {

      if (!performance || performance.length === 0) {

        if (scoreTrend) {
          scoreTrend.innerHTML = `
            <div class="progress-empty">
              Complete a mock test to see your progress.
            </div>
          `;
        }

        return;
      }

      const chronological =
        [...performance].sort(
          (a, b) =>
            new Date(
              a.attempt.submitted_at || 0
            ).getTime()
            -
            new Date(
              b.attempt.submitted_at || 0
            ).getTime()
        );

      const first = chronological[0];
      const latest = chronological[chronological.length - 1];

      const totalCorrect =
        performance.reduce(
          (sum, item) => sum + item.correct,
          0
        );

      const totalIncorrect =
        performance.reduce(
          (sum, item) => sum + item.incorrect,
          0
        );

      const totalAttempted =
        totalCorrect + totalIncorrect;

      const totalQuestions =
        performance.reduce(
          (sum, item) => sum + item.totalQuestions,
          0
        );

      const totalTime =
        performance.reduce(
          (sum, item) =>
            sum +
            Number(
              item.attempt.time_taken_seconds || 0
            ),
          0
        );

      const overallAccuracy =
        totalAttempted > 0
          ? (totalCorrect / totalAttempted) * 100
          : 0;

      const attemptRate =
        totalQuestions > 0
          ? (totalAttempted / totalQuestions) * 100
          : 0;

      const averageTimePerQuestion =
        totalAttempted > 0
          ? totalTime / totalAttempted
          : 0;

      const improvement =
        latest.percentage - first.percentage;

      const improvementSign =
        improvement > 0 ? "+" : "";

      if (progressLatestScore) {
        progressLatestScore.textContent =
          `${latest.score.toFixed(0)}/${latest.maximumMarks}`;
      }

      if (progressLatestDate) {
        progressLatestDate.textContent =
          `Latest: ${formatDate(latest.attempt.submitted_at)}`;
      }

      if (progressAccuracy) {
        progressAccuracy.textContent =
          `${overallAccuracy.toFixed(1)}%`;
      }

      if (progressAvgTime) {
        progressAvgTime.textContent =
          formatTime(
            Math.round(averageTimePerQuestion)
          );
      }

      if (progressImprovement) {
        progressImprovement.textContent =
          `${improvementSign}${improvement.toFixed(1)}%`;

        progressImprovement.style.color =
          improvement > 0
            ? "#159447"
            : improvement < 0
              ? "#c62828"
              : "#17385f";
      }

      if (metricCorrect) {
        metricCorrect.textContent =
          `${totalCorrect}`;
      }

      if (metricAttemptRate) {
        metricAttemptRate.textContent =
          `${attemptRate.toFixed(1)}%`;
      }

      if (metricAccuracy) {
        metricAccuracy.textContent =
          `${overallAccuracy.toFixed(1)}%`;
      }

      const averageEfficiency =
        performance.reduce(
          (sum, item) => sum + item.percentage,
          0
        ) / performance.length;

      if (metricScoreEfficiency) {
        metricScoreEfficiency.textContent =
          `${averageEfficiency.toFixed(1)}%`;
      }

      if (metricCorrectBar) {
        const correctRate =
          totalAttempted > 0
            ? (totalCorrect / totalAttempted) * 100
            : 0;

        metricCorrectBar.style.width =
          `${Math.min(100, Math.max(0, correctRate))}%`;
      }

      if (metricAttemptRateBar) {
        metricAttemptRateBar.style.width =
          `${Math.min(100, Math.max(0, attemptRate))}%`;
      }

      if (metricAccuracyBar) {
        metricAccuracyBar.style.width =
          `${Math.min(100, Math.max(0, overallAccuracy))}%`;
      }

      if (metricScoreEfficiencyBar) {
        metricScoreEfficiencyBar.style.width =
          `${Math.min(100, Math.max(0, averageEfficiency))}%`;
      }

      const chartItems =
        chronological.slice(-8);

      /*
       * Scale the chart against the highest visible score rather than
       * against 100%. This keeps low scores such as 1%, 2%, 4% visible.
       */
      const chartMax =
        Math.max(
          10,
          ...chartItems.map(
            item => Number(item.percentage || 0)
          )
        );

      if (scoreTrend) {

        scoreTrend.innerHTML =
          chartItems
            .map(
              (item, index) => {

                const relativeHeight =
                  chartMax > 0
                    ? (Number(item.percentage || 0) / chartMax) * 100
                    : 0;

                const height =
                  item.percentage > 0
                    ? Math.max(
                        8,
                        Math.min(
                          100,
                          relativeHeight
                        )
                      )
                    : 3;

                const testNumber =
                  Number(
                    item.test?.test_number
                  );

                const label =
                  Number.isInteger(testNumber)
                    ? `T${testNumber}`
                    : `#${index + 1}`;

                return `
                  <div class="trend-item">

                    <div class="trend-value">
                      ${item.percentage.toFixed(1)}%
                    </div>

                    <div class="trend-bar-wrap">
                      <div
                        class="trend-bar"
                        style="height:${height}%"
                        title="${escapeHtml(item.percentage.toFixed(1))}%"
                      ></div>
                    </div>

                    <div class="trend-label">
                      ${escapeHtml(label)}
                    </div>

                  </div>
                `;
              }
            )
            .join("");
      }

      if (progressInsight) {

        if (performance.length === 1) {

          progressInsight.textContent =
            "This is your first recorded attempt. Use the next tests to establish a reliable performance trend.";

        } else if (improvement > 0) {

          progressInsight.textContent =
            `Your latest score is ${improvement.toFixed(1)} percentage points higher than your first recorded attempt. Keep reviewing incorrect questions and maintain the improvement.`;

        } else if (improvement < 0) {

          progressInsight.textContent =
            `Your latest score is ${Math.abs(improvement).toFixed(1)} percentage points below your first recorded attempt. Focus on revision and analyse incorrect answers before the next test.`;

        } else {

          progressInsight.textContent =
            "Your latest score is at the same level as your first recorded attempt. Focus on improving accuracy and reducing unanswered questions.";

        }
      }
    }


    async function loadTestHistory(userId) {

      if (!activityContainer) {
        return;
      }

      try {

        /* ---------------------------------------------
           LOAD COMPLETED ATTEMPTS FOR THIS STUDENT
        --------------------------------------------- */

        const {
          data: attempts,
          error: attemptsError,
        } =
          await supabase
            .from("mock_attempts")
            .select(`
              id,
              user_id,
              test_id,
              submitted_at,
              score,
              correct_count,
              incorrect_count,
              unanswered_count,
              time_taken_seconds,
              status
            `)
            .eq(
              "user_id",
              userId
            )
            .eq(
              "status",
              "submitted"
            )
            .order(
              "submitted_at",
              {
                ascending: false,
              }
            )
            .limit(50);


        if (attemptsError) {

          console.error(
            "Unable to load test history:",
            attemptsError
          );

          activityContainer.innerHTML = `
            <div class="activity-empty">
              <div class="empty-icon">⚠</div>
              <strong>Unable to load test history</strong>
              <p>
                Please refresh the dashboard and try again.
              </p>
            </div>
          `;

          return;

        }


        const safeAttempts =
          attempts || [];


        /* ---------------------------------------------
           UPDATE DASHBOARD STATISTICS
        --------------------------------------------- */

        const attemptedCount =
          document.getElementById(
            "attemptedCount"
          );

        const averageScore =
          document.getElementById(
            "averageScore"
          );

        const bestScore =
          document.getElementById(
            "bestScore"
          );


        attemptedCount.textContent =
          safeAttempts.length;


        if (safeAttempts.length === 0) {

          averageScore.textContent =
            "—";

          bestScore.textContent =
            "—";

        }


        /* ---------------------------------------------
           LOAD TEST INFORMATION
        --------------------------------------------- */

        const testIds =
          [
            ...new Set(
              safeAttempts
                .map(
                  attempt =>
                    attempt.test_id
                )
                .filter(Boolean)
            )
          ];


        let testsById =
          new Map();


        if (testIds.length > 0) {

          const {
            data: tests,
            error: testsError,
          } =
            await supabase
              .from("mock_tests")
              .select(`
                id,
                test_number,
                title,
                question_count
              `)
              .in(
                "id",
                testIds
              );


          if (testsError) {

            console.error(
              "Unable to load mock-test information:",
              testsError
            );

          } else {

            testsById =
              new Map(
                (tests || [])
                  .map(
                    test =>
                      [
                        String(test.id),
                        test
                      ]
                  )
              );

          }

        }


        /* ---------------------------------------------
           CALCULATE PERFORMANCE
        --------------------------------------------- */

        const performance =
          safeAttempts.map(
            attempt => {

              const test =
                testsById.get(
                  String(
                    attempt.test_id
                  )
                );


              const correct =
                Number(
                  attempt.correct_count || 0
                );


              const incorrect =
                Number(
                  attempt.incorrect_count || 0
                );


              const unanswered =
                Number(
                  attempt.unanswered_count || 0
                );


              const attempted =
                correct +
                incorrect;


              const totalQuestions =
                Math.max(
                  Number(
                    test?.question_count || 0
                  ),
                  attempted +
                    unanswered
                );


              const maximumMarks =
                totalQuestions *
                2;


              const score =
                Number(
                  attempt.score || 0
                );


              const percentage =
                maximumMarks > 0
                  ? (
                      score /
                      maximumMarks
                    ) *
                    100
                  : 0;


              return {
                attempt,
                test,
                correct,
                incorrect,
                unanswered,
                attempted,
                totalQuestions,
                maximumMarks,
                score,
                percentage,
              };

            }
          );


        if (performance.length > 0) {

          const average =
            performance.reduce(
              (
                total,
                item
              ) =>
                total +
                item.percentage,
              0
            ) /
            performance.length;


          const best =
            Math.max(
              ...performance.map(
                item =>
                  item.percentage
              )
            );


          averageScore.textContent =
            average.toFixed(1) +
            "%";


          bestScore.textContent =
            best.toFixed(1) +
            "%";

        }


        renderProgressReport(
          performance
        );


        /* ---------------------------------------------
           EMPTY STATE
        --------------------------------------------- */

        if (performance.length === 0) {

          activityContainer.innerHTML = `
            <div class="activity-empty">
              <div class="empty-icon">📋</div>

              <strong>
                No test attempts yet
              </strong>

              <p>
                Your completed tests and scores will
                appear here after you submit your first
                mock test.
              </p>
            </div>
          `;

          return;

        }


        /* ---------------------------------------------
           HISTORY TABLE
        --------------------------------------------- */

        const rows =
          performance
            .map(
              item => {

                const testNumber =
                  Number(
                    item.test?.test_number
                  );


                const displayNumber =
                  Number.isInteger(
                    testNumber
                  )
                    ? String(
                        testNumber
                      ).padStart(
                        2,
                        "0"
                      )
                    : "—";


                const title =
                  item.test?.title ||
                  "JPSC Mock Test";


                const scoreText =
                  item.maximumMarks > 0
                    ? `${item.score.toFixed(0)}/${item.maximumMarks}`
                    : `${item.score.toFixed(0)}`;


                const scoreClass =
                  getScoreClass(
                    item.percentage
                  );


                return `
                  <div class="attempt-row">

                    <div class="attempt-test">

                      <div>
                        <span class="attempt-test-number">
                          TEST ${escapeHtml(displayNumber)}
                        </span>

                        <span class="attempt-test-title">
                          ${escapeHtml(title)}
                        </span>
                      </div>

                      <div class="attempt-date">
                        Submitted ${escapeHtml(
                          formatDate(
                            item.attempt.submitted_at
                          )
                        )}
                      </div>

                    </div>


                    <div class="attempt-cell">

                      <strong class="${scoreClass}">
                        ${escapeHtml(scoreText)}
                      </strong>

                      <br />

                      ${item.percentage.toFixed(1)}%

                    </div>


                    <div class="attempt-cell">

                      <strong>
                        ${item.correct}
                      </strong>

                      / ${item.totalQuestions}

                      <br />

                      Attempted

                    </div>


                    <div class="attempt-cell">

                      <strong>
                        ${item.correct}
                      </strong>
                      ✓ &nbsp;
                      <strong>
                        ${item.incorrect}
                      </strong>
                      ✕
                      <br />
                      ${item.unanswered} unanswered

                    </div>


                    <div class="attempt-cell">

                      <strong>
                        ${formatTime(
                          item.attempt.time_taken_seconds
                        )}
                      </strong>

                      <br />

                      Time used

                    </div>


                    <div>

                      <a
                        class="attempt-action"
                        href="/results?attempt_id=${encodeURIComponent(
                          item.attempt.id
                        )}"
                      >
                        View Analysis →
                      </a>

                    </div>

                  </div>
                `;

              }
            )
            .join("");


        activityContainer.innerHTML = `

          <div class="history-header">

            <div>Test</div>
            <div>Score</div>
            <div>Attempted</div>
            <div>Response</div>
            <div>Time</div>
            <div>Analysis</div>

          </div>

          <div class="attempt-list">
            ${rows}
          </div>

        `;


      } catch (error) {

        console.error(
          "Unexpected test-history error:",
          error
        );

        activityContainer.innerHTML = `
          <div class="activity-empty">
            <div class="empty-icon">⚠</div>
            <strong>Unable to load test history</strong>
            <p>
              Please refresh the dashboard and try again.
            </p>
          </div>
        `;

      }

    }


    /* =====================================================
       LOGOUT
    ====================================================== */

    logoutButton?.addEventListener(
      "click",
      async () => {

        logoutButton.disabled =
          true;

        logoutButton.textContent =
          "Signing out…";


        try {

          const {
            error
          } =
            await supabase.auth.signOut();


          if (error) {

            console.error(
              "Logout error:",
              error
            );

            logoutButton.disabled =
              false;

            logoutButton.innerHTML =
              `
                <span class="nav-icon">
                  ↪
                </span>
                Sign Out
              `;

            return;

          }


          window.location.href =
            "/login";


        } catch (error) {

          console.error(
            "Unexpected logout error:",
            error
          );


          window.location.href =
            "/login";

        }

      }
    );


    /* =====================================================
       MOBILE SIDEBAR
    ====================================================== */

    mobileMenu?.addEventListener(
      "click",
      () => {

        sidebar.classList.toggle(
          "open"
        );

      }
    );


    /* =====================================================
       CLOSE SIDEBAR AFTER LINK
    ====================================================== */

    document
      .querySelectorAll(
        ".sidebar a"
      )
      .forEach(
        link => {

          link.addEventListener(
            "click",
            () => {

              sidebar.classList.remove(
                "open"
              );

            }
          );

        }
      );


    /* =====================================================
       START
    ====================================================== */

    loadStudent();

  </script>

