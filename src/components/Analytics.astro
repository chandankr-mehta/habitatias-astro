---
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

{GA_ID && (
  <>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
    ></script>

    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      window.gtag = gtag;

      gtag("js", new Date());

      gtag("config", GA_ID);
    </script>
  </>
)}