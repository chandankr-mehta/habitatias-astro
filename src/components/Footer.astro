---
const year = new Date().getFullYear();

const jpscLinks = [
  { label: "JPSC PYQ", href: "/pyq/" },
  { label: "JPSC Notes", href: "/notes/" },
  { label: "JPSC Trends", href: "/trends/" },
  { label: "JPSC Mock Tests", href: "/mock-tests/" },
  { label: "Jharkhand Special", href: "/jharkhand/" },
];

const upscLinks = [
  { label: "UPSC Overview", href: "/upsc/" },
  { label: "UPSC Syllabus", href: "/upsc/" },
  { label: "UPSC Prelims", href: "/upsc/" },
  { label: "UPSC Mains", href: "/upsc/" },
  { label: "UPSC PYQs", href: "/upsc/" },
  { label: "UPSC Strategy", href: "/upsc/" },
];

const resourceLinks = [
  { label: "Guidance", href: "/guidance/" },
  { label: "Resources", href: "/resources/" },
  { label: "JPSC Book", href: "/book/" },
  { label: "Contact", href: "/contact/" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms & Conditions", href: "/terms-and-conditions/" },
  { label: "Refund Policy", href: "/refund-policy/" },
];
---

<footer class="site-footer">

  <!-- =====================================================
       FOOTER MAIN
  ====================================================== -->

  <div class="footer-main">

    <div class="footer-container">


      <!-- =================================================
           BRAND COLUMN
      ================================================== -->

      <div class="footer-brand-column">

        <a
          href="/"
          class="footer-brand"
          aria-label="Habitat IAS Home"
        >

          <span class="footer-brand-mark">
            H
          </span>

          <span class="footer-brand-name">
            Habitat IAS
          </span>

        </a>


        <p class="footer-description">
          Exam-oriented preparation for JPSC and UPSC aspirants,
          built around previous year questions, structured notes,
          trend analysis, mock tests and focused study resources.
        </p>


        <a
          href="/book/"
          class="footer-book-button"
        >
          Get the JPSC Book
          <span>→</span>
        </a>


        <!-- SOCIAL MEDIA -->

        <div class="footer-social-section">

          <span class="social-title">
            Follow Habitat IAS
          </span>


          <div class="social-links">


            <!-- YOUTUBE -->

            <a
              href="https://www.youtube.com/@habitatias"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Habitat IAS YouTube"
            >

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.9V8.1l6.5 3.9-6.5 3.9Z"
                />
              </svg>

            </a>


            <!-- TELEGRAM -->

            <a
              href="https://t.me/Habitat_IAS"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Habitat IAS Telegram"
            >

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M21.9 3.2 2.8 10.6c-1.3.5-1.3 1.2-.2 1.5l4.9 1.5 1.9 5.9c.2.5.1.7.6.7.4 0 .6-.2.8-.4l2.4-2.3 5 3.7c.9.5 1.6.3 1.8-.8l3.1-15.7c.3-1.4-.5-2-1.2-1.5ZM8.3 13.3l10.9-6.9c.5-.3.9-.1.5.2l-8.9 8-.3 3.2-1.7-4.5-1.7-.5c-.4-.1-.4-.4.1-.5Z"
                />
              </svg>

            </a>


            <!-- X -->

            <a
              href="https://x.com/Habitatias"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Habitat IAS on X"
            >

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.2-8.2L2.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.9h1.7L8.3 3.9H6.5l11.3 16Z"
                />
              </svg>

            </a>


            <!-- EMAIL -->

            <a
              href="mailto:habitatiaspcs@gmail.com"
              class="social-link"
              aria-label="Email Habitat IAS"
            >

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2.5 4h19A2.5 2.5 0 0 1 24 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-19A2.5 2.5 0 0 1 0 17.5v-11A2.5 2.5 0 0 1 2.5 4Zm-.2 3.1 9.1 6.2c.4.3.9.3 1.3 0l9.1-6.2V6.5c0-.2-.2-.4-.4-.4H2.5c-.1 0-.2.1-.2.4v.6Zm19.6 2.4-8 5.5a3.3 3.3 0 0 1-3.8 0l-8-5.5v8c0 .2.2.4.4.4h19a.4.4 0 0 0 .4-.4v-8Z"
                />
              </svg>

            </a>

          </div>

        </div>

      </div>


      <!-- =================================================
           JPSC COLUMN
      ================================================== -->

      <div class="footer-column">

        <h2>
          JPSC
        </h2>

        <div class="footer-links">

          {jpscLinks.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))}

        </div>

      </div>


      <!-- =================================================
           UPSC COLUMN
      ================================================== -->

      <div class="footer-column">

        <h2>
          UPSC
        </h2>

        <div class="footer-links">

          {upscLinks.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))}

        </div>

      </div>


      <!-- =================================================
           RESOURCES COLUMN
      ================================================== -->

      <div class="footer-column">

        <h2>
          Resources
        </h2>

        <div class="footer-links">

          {resourceLinks.map((item) => (
            <a href={item.href}>
              {item.label}
            </a>
          ))}

        </div>

      </div>


      <!-- =================================================
           CONTACT COLUMN
      ================================================== -->

      <div class="footer-column contact-column">

        <h2>
          Contact
        </h2>


        <p class="contact-intro">
          For queries related to courses, books, resources
          and preparation.
        </p>


        <a
          href="mailto:habitatiaspcs@gmail.com"
          class="contact-item"
        >

          <span class="contact-icon">
            @
          </span>

          <span>
            habitatiaspcs@gmail.com
          </span>

        </a>


        <a
          href="tel:+919625719269"
          class="contact-item"
        >

          <span class="contact-icon">
            ☎
          </span>

          <span>
            +91 96257 19269
          </span>

        </a>

      </div>

    </div>

  </div>


  <!-- =====================================================
       FOOTER CTA
  ====================================================== -->

  <div class="footer-cta">

    <div class="footer-container footer-cta-inner">

      <div class="footer-cta-content">

        <span>
          JPSC PRELIMS DECODED
        </span>

        <h2>
          Understand the exam.
          Prepare with purpose.
        </h2>

        <p>
          Explore topic-wise PYQs, detailed explanations and
          trend-based analysis for JPSC Prelims.
        </p>

      </div>


      <div class="footer-cta-action">

        <a href="/book/">
          Explore the Book →
        </a>

      </div>

    </div>

  </div>


  <!-- =====================================================
       FOOTER BOTTOM
  ====================================================== -->

  <div class="footer-bottom">

    <div class="footer-container footer-bottom-inner">


      <div class="footer-copyright">

        © {year}
        <strong>
          Habitat IAS
        </strong>
        . All rights reserved.

      </div>


      <div class="footer-legal">

        {legalLinks.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))}

      </div>

    </div>

  </div>

</footer>


<style>

  /* =========================================================
     BASE
  ========================================================= */

  .site-footer {
    width: 100%;

    color: #dbe7fa;

    background: #0b2a63;
  }


  .footer-container {
    width: min(
      1240px,
      calc(100% - 48px)
    );

    margin: 0 auto;
  }


  /* =========================================================
     MAIN FOOTER
  ========================================================= */

  .footer-main {
    padding:
      58px 0
      48px;
  }


  .footer-main
  .footer-container {

    display: grid;

    grid-template-columns:
      1.7fr
      1fr
      1fr
      1fr
      1.25fr;

    gap: 38px;
  }


  /* =========================================================
     BRAND
  ========================================================= */

  .footer-brand {
    display: inline-flex;

    align-items: center;

    gap: 11px;

    color: #ffffff;

    font-size: 25px;

    font-weight: 900;

    letter-spacing: -0.5px;

    text-decoration: none;
  }


  .footer-brand-mark {
    width: 46px;
    height: 46px;

    display: grid;

    place-items: center;

    border-radius: 11px;

    color: #1657d9;

    background: #ffffff;

    font-family:
      Georgia,
      serif;

    font-size: 24px;

    font-weight: 900;
  }


  .footer-description {
    max-width: 340px;

    margin:
      18px 0
      22px;

    color: #b8c9e5;

    font-size: 13px;

    line-height: 1.7;
  }


  /* =========================================================
     BOOK BUTTON
  ========================================================= */

  .footer-book-button {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    min-height: 43px;

    padding:
      9px 17px;

    border-radius: 8px;

    color: #102b60;

    background: #ffd43b;

    font-size: 13px;

    font-weight: 850;

    text-decoration: none;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }


  .footer-book-button:hover {
    transform:
      translateY(-2px);

    background: #ffdc5b;
  }


  .footer-book-button span {
    font-size: 16px;
  }


  /* =========================================================
     SOCIAL
  ========================================================= */

  .footer-social-section {
    margin-top: 23px;
  }


  .social-title {
    display: block;

    margin-bottom: 10px;

    color: #8fa8d0;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1px;

    text-transform: uppercase;
  }


  .social-links {
    display: flex;

    align-items: center;

    gap: 8px;
  }


  .social-link {
    width: 35px;
    height: 35px;

    display: grid;

    place-items: center;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.18
      );

    border-radius: 8px;

    color: #ffffff;

    background:
      rgba(
        255,
        255,
        255,
        0.05
      );

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }


  .social-link:hover {
    transform:
      translateY(-2px);

    background:
      rgba(
        255,
        255,
        255,
        0.13
      );
  }


  .social-link svg {
    width: 17px;
    height: 17px;

    fill: currentColor;
  }


  /* =========================================================
     FOOTER COLUMNS
  ========================================================= */

  .footer-column h2 {
    margin:
      2px 0
      18px;

    color: #ffffff;

    font-size: 15px;

    font-weight: 850;
  }


  .footer-links {
    display: flex;

    flex-direction: column;

    gap: 10px;
  }


  .footer-links a {
    width: fit-content;

    color: #b8c9e5;

    font-size: 13px;

    font-weight: 550;

    line-height: 1.4;

    text-decoration: none;

    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }


  .footer-links a:hover {
    color: #ffffff;

    transform:
      translateX(2px);
  }


  /* =========================================================
     CONTACT
  ========================================================= */

  .contact-intro {
    max-width: 230px;

    margin:
      0 0
      15px;

    color: #aebfdd;

    font-size: 12px;

    line-height: 1.6;
  }


  .contact-item {
    display: flex;

    align-items: flex-start;

    gap: 9px;

    margin-bottom: 11px;

    color: #dbe7fa;

    font-size: 12px;

    line-height: 1.5;

    text-decoration: none;

    overflow-wrap: anywhere;
  }


  .contact-item:hover {
    color: #ffffff;
  }


  .contact-icon {
    width: 20px;

    flex-shrink: 0;

    color: #ffd43b;

    font-weight: 900;

    text-align: center;
  }


  /* =========================================================
     CTA
  ========================================================= */

  .footer-cta {
    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );

    border-bottom:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );

    background:
      linear-gradient(
        105deg,
        #123d91,
        #1657d9
      );
  }


  .footer-cta-inner {
    min-height: 150px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;
  }


  .footer-cta-content > span {
    color: #ffd43b;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 1.4px;
  }


  .footer-cta-content h2 {
    margin:
      7px 0
      5px;

    color: #ffffff;

    font-size: 27px;

    line-height: 1.15;

    letter-spacing: -0.6px;
  }


  .footer-cta-content p {
    margin: 0;

    color: #d2e0f7;

    font-size: 12px;

    line-height: 1.5;
  }


  .footer-cta-action a {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 44px;

    padding:
      9px 18px;

    border-radius: 8px;

    color: #102b60;

    background: #ffd43b;

    font-size: 13px;

    font-weight: 850;

    white-space: nowrap;

    text-decoration: none;

    transition:
      transform 0.2s ease;
  }


  .footer-cta-action a:hover {
    transform:
      translateY(-2px);
  }


  /* =========================================================
     BOTTOM
  ========================================================= */

  .footer-bottom {
    background: #081f4b;
  }


  .footer-bottom-inner {
    min-height: 60px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
  }


  .footer-copyright {
    color: #8299bf;

    font-size: 11px;
  }


  .footer-copyright strong {
    color: #a9bcdb;
  }


  .footer-legal {
    display: flex;

    align-items: center;

    gap: 18px;

    flex-wrap: wrap;
  }


  .footer-legal a {
    color: #8299bf;

    font-size: 11px;

    text-decoration: none;
  }


  .footer-legal a:hover {
    color: #ffffff;

    text-decoration: underline;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media (max-width: 1000px) {

    .footer-main
    .footer-container {

      grid-template-columns:
        1.5fr
        1fr
        1fr;

      gap: 30px;
    }


    .contact-column {
      grid-column: 2 / -1;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 700px) {

    .footer-container {
      width:
        calc(100% - 32px);
    }


    .footer-main {
      padding:
        42px 0
        34px;
    }


    .footer-main
    .footer-container {

      grid-template-columns:
        repeat(2, 1fr);

      gap:
        30px 22px;
    }


    .footer-brand-column {
      grid-column:
        1 / -1;
    }


    .contact-column {
      grid-column: auto;
    }


    .footer-description {
      max-width: 100%;
    }


    .footer-cta-inner {
      min-height: auto;

      padding:
        30px 0;

      flex-direction: column;

      align-items: flex-start;

      gap: 18px;
    }


    .footer-cta-content h2 {
      font-size: 23px;
    }


    .footer-cta-action {
      width: 100%;
    }


    .footer-cta-action a {
      width: 100%;
    }


    .footer-bottom-inner {
      min-height: auto;

      padding:
        17px 0;

      flex-direction: column;

      align-items: flex-start;

      gap: 10px;
    }


    .footer-legal {
      gap:
        7px 14px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media (max-width: 420px) {

    .footer-container {
      width:
        calc(100% - 24px);
    }


    .footer-main {
      padding:
        35px 0
        28px;
    }


    .footer-main
    .footer-container {

      gap:
        25px 16px;
    }


    .footer-brand {
      font-size: 22px;
    }


    .footer-brand-mark {
      width: 40px;
      height: 40px;

      font-size: 21px;
    }


    .footer-description {
      margin:
        12px 0
        17px;

      font-size: 12px;
    }


    .footer-column h2 {
      margin-bottom: 13px;

      font-size: 13px;
    }


    .footer-links {
      gap: 8px;
    }


    .footer-links a {
      font-size: 12px;
    }


    .contact-intro {
      font-size: 11px;
    }


    .contact-item {
      font-size: 11px;
    }


    .footer-cta-content h2 {
      font-size: 21px;
    }


    .footer-cta-content p {
      font-size: 11px;
    }


    .footer-copyright {
      font-size: 10px;
    }


    .footer-legal a {
      font-size: 10px;
    }

  }

</style>