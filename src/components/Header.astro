    .mobile-student-account-info {
      min-width: 0;

      display: grid;
      gap: 3px;
    }

    .mobile-student-account-info strong {
      color: #172b4d;

      font-size: 14px;
      font-weight: 850;

      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mobile-student-account-info span {
      color: #71809a;

      font-size: 11px;
      font-weight: 600;

      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mobile-account-link,
    .mobile-account-logout {
      width: 100%;

      display: flex;
      align-items: center;

      min-height: 44px;

      padding: 9px 10px;

      border: 0;
      border-radius: 9px;

      background: transparent;

      color: #40516f;

      font-family: inherit;
      font-size: 14px;
      font-weight: 700;

      text-decoration: none;
      text-align: left;

      box-sizing: border-box;
      cursor: pointer;
    }

    .mobile-account-link:hover {
      background: #eef4ff;
      color: #1657d9;
    }

    .mobile-account-logout {
      color: #b42318;
    }

    .mobile-account-logout:hover {
      background: #fff1f0;
    }


    /* MOBILE BOOK BUTTON */

    .mobile-book-button {
      display: flex;

      align-items: center;
      justify-content: center;

      min-height: 48px;

      margin-top: 14px;

      border-radius: 10px;

      background: #1657d9;
      color: #ffffff;

      font-size: 15px;
      font-weight: 800;

      text-decoration: none;
    }

  }


  /* =========================================================
     VERY SMALL PHONES
  ========================================================= */

  @media (max-width: 420px) {

    .header-container {
      min-height: 60px;

      padding:
        7px 12px;
    }


    .brand-mark {
      width: 38px;
      height: 38px;

      border-radius: 9px;

      font-size: 19px;
    }


    .brand-name {
      font-size: 19px;
    }


    .mobile-menu-button {
      width: 44px;
      height: 44px;

      border-radius: 10px;
    }


    .mobile-menu-button span {
      width: 20px;
    }


    .mobile-navigation.is-open {
      max-height: calc(100vh - 60px);
    }

  }

</style>


<script>
  import { createClient } from "@supabase/supabase-js";


  /* =========================================================
     SUPABASE BROWSER CLIENT

     IMPORTANT:
     Only the PUBLIC anon key is used here.
     Never put SUPABASE_SERVICE_ROLE_KEY in this component.
  ========================================================= */

  const SUPABASE_URL =
    import.meta.env.PUBLIC_SUPABASE_URL;

  const SUPABASE_ANON_KEY =
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY;


  const supabase =
    SUPABASE_URL &&
    SUPABASE_ANON_KEY
      ? createClient(
          SUPABASE_URL,
          SUPABASE_ANON_KEY,
          {
            auth: {
              persistSession: true,
              autoRefreshToken: true,
              detectSessionInUrl: true,
            },
          }
        )
      : null;


  /* =========================================================
     ACCOUNT ELEMENTS
  ========================================================= */

  const studentDashboardButton =
    document.querySelector(
      "#student-dashboard-button"
    );

  const mobileDashboardLink =
    document.querySelector(
      "#mobile-dashboard-link"
    );

  const studentAccount =
    document.querySelector(
      "#student-account"
    );

  const studentAccountButton =
    document.querySelector(
      "#student-account-button"
    );

  const studentAccountMenu =
    document.querySelector(
      "#student-account-menu"
    );

  const studentAccountName =
    document.querySelector(
      "#student-account-name"
    );

  const studentAccountUserName =
    document.querySelector(
      "#student-account-user-name"
    );

  const studentAccountUserEmail =
    document.querySelector(
      "#student-account-user-email"
    );

  const studentAccountLogout =
    document.querySelector(
      "#student-account-logout"
    );

  const mobileStudentAccount =
    document.querySelector(
      "#mobile-student-account"
    );

  const mobileStudentAccountName =
    document.querySelector(
      "#mobile-student-account-name"
    );

  const mobileStudentAccountEmail =
    document.querySelector(
      "#mobile-student-account-email"
    );

  const mobileAccountLogout =
    document.querySelector(
      "#mobile-account-logout"
    );


  /* =========================================================
     LOGIN LINK HELPER
  ========================================================= */

  function goToLogin() {

    const currentPath =
      window.location.pathname +
      window.location.search;

    const redirect =
      encodeURIComponent(
        currentPath
      );

    window.location.href =
      `/login/?redirect=${redirect}`;
  }


  /* =========================================================
     DISPLAY NAME
  ========================================================= */

  function getStudentName(
    user
  ) {

    if (!user) {
      return "Student";
    }


    const metadata =
      user.user_metadata ||
      {};


    const name =
      metadata.full_name ||
      metadata.fullName ||
      metadata.name ||
      metadata.display_name ||
      metadata.displayName;


    if (
      typeof name === "string" &&
      name.trim()
    ) {
      return name.trim();
    }


    if (
      typeof user.email === "string" &&
      user.email.trim()
    ) {

      const emailName =
        user.email
          .split("@")[0]
          .replace(/[._-]+/g, " ")
          .trim();


      if (emailName) {

        return emailName
          .replace(/\b\w/g, (letter) =>
            letter.toUpperCase()
          );
      }
    }


    return "Student";
  }


  /* =========================================================
     SHORT HEADER NAME
  ========================================================= */

  function getShortName(
    name
  ) {

    if (
      !name ||
      name === "Student"
    ) {
      return "Student";
    }


    const words =
      name
        .trim()
        .split(/\s+/);


    if (words.length <= 2) {
      return name;
    }


    return `${words[0]} ${words[1]}`;
  }


  /* =========================================================
     RENDER LOGGED-OUT STATE
  ========================================================= */

  function renderLoggedOut() {

    if (studentDashboardButton) {
      studentDashboardButton.hidden = false;
      studentDashboardButton.href =
        "/login/?redirect=%2Fdashboard%2F";
    }

    if (mobileDashboardLink) {
      mobileDashboardLink.hidden = false;
    }

    if (studentAccount) {

      studentAccount.hidden =
        true;
    }


    if (mobileStudentAccount) {

      mobileStudentAccount.hidden =
        true;
    }
  }


  /* =========================================================
     RENDER LOGGED-IN STATE
  ========================================================= */

  function renderLoggedIn(
    user
  ) {

    if (studentDashboardButton) {
      studentDashboardButton.hidden = false;
      studentDashboardButton.href =
        "/dashboard/";
    }

    if (mobileDashboardLink) {
      mobileDashboardLink.hidden = true;
    }

    const fullName =
      getStudentName(
        user
      );

    const shortName =
      getShortName(
        fullName
      );

    const email =
      user?.email ||
      "Student account";


    if (studentAccount) {

      studentAccount.hidden =
        false;
    }


    if (studentAccountName) {

      studentAccountName.textContent =
        shortName;
    }


    if (studentAccountUserName) {

      studentAccountUserName.textContent =
        fullName;
    }


    if (studentAccountUserEmail) {

      studentAccountUserEmail.textContent =
        email;
    }


    if (mobileStudentAccount) {

      mobileStudentAccount.hidden =
        false;
    }


    if (mobileStudentAccountName) {

      mobileStudentAccountName.textContent =
        fullName;
    }


    if (mobileStudentAccountEmail) {

      mobileStudentAccountEmail.textContent =
        email;
    }
  }


  /* =========================================================
     CLOSE ACCOUNT MENU
  ========================================================= */

  function closeAccountMenu() {

    if (
      !studentAccount ||
      !studentAccountButton ||
      !studentAccountMenu
    ) {
      return;
    }


    studentAccount.classList.remove(
      "is-open"
    );


    studentAccountButton.setAttribute(
      "aria-expanded",
      "false"
    );


    studentAccountMenu.hidden =
      true;
  }


  /* =========================================================
     TOGGLE ACCOUNT MENU
  ========================================================= */

  if (
    studentAccountButton &&
    studentAccountMenu &&
    studentAccount
  ) {

    studentAccountButton.addEventListener(
      "click",
      (event) => {

        event.stopPropagation();


        const isOpen =
          studentAccount.classList.toggle(
            "is-open"
          );


        studentAccountButton.setAttribute(
          "aria-expanded",
          String(isOpen)
        );


        studentAccountMenu.hidden =
          !isOpen;
      }
    );


    studentAccountMenu.addEventListener(
      "click",
      (event) => {

        event.stopPropagation();
      }
    );


    document.addEventListener(
      "click",
      () => {

        closeAccountMenu();
      }
    );
  }


  /* =========================================================
     SERVER SESSION SYNC

     Keeps the secure HttpOnly Astro cookie aligned with
     the current Supabase browser session.
  ========================================================= */

  async function syncServerSession(
    session
  ) {

    const token =
      session?.access_token;

    if (!token) {
      return false;
    }

    try {
      const response =
        await fetch(
          "/api/auth/session",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            credentials: "same-origin",
            body: JSON.stringify({
              accessToken: token,
            }),
          }
        );

      const result =
        await response.json()
          .catch(() => ({}));

      if (
        !response.ok ||
        result?.success !== true
      ) {
        console.error(
          "[HEADER] Server session sync failed:",
          result
        );
        return false;
      }

      return true;

    } catch (error) {
      console.error(
        "[HEADER] Server session sync error:",
        error
      );
      return false;
    }
  }


  /* =========================================================
     CLEAR SERVER SESSION
  ========================================================= */

  async function clearServerSession() {
    try {
      await fetch(
        "/api/auth/session",
        {
          method: "DELETE",
          credentials: "same-origin",
          cache: "no-store",
        }
      );
    } catch (error) {
      console.error(
        "[HEADER] Server logout sync failed:",
        error
      );
    }
  }


  /* =========================================================
     LOGOUT
  ========================================================= */

  async function logoutStudent() {

    if (!supabase) {

      console.error(
        "[HEADER] Supabase browser client is not configured."
      );

      return;
    }


    if (studentAccountLogout) {

      studentAccountLogout.disabled =
        true;

      studentAccountLogout.textContent =
        "Logging out...";
    }


    if (mobileAccountLogout) {

      mobileAccountLogout.disabled =
        true;

      mobileAccountLogout.textContent =
        "Logging out...";
    }


    const {
      error
    } =
      await supabase.auth.signOut();


    if (error) {

      console.error(
        "[HEADER] Logout failed:",
        error
      );


      if (studentAccountLogout) {

        studentAccountLogout.disabled =
          false;

        studentAccountLogout.textContent =
          "Logout";
      }


      if (mobileAccountLogout) {

        mobileAccountLogout.disabled =
          false;

        mobileAccountLogout.textContent =
          "Logout";
      }


      return;
    }


    await clearServerSession();


    closeAccountMenu();


    window.location.href =
      "/";
  }


  if (studentAccountLogout) {

    studentAccountLogout.addEventListener(
      "click",
      logoutStudent
    );
  }


  if (mobileAccountLogout) {

    mobileAccountLogout.addEventListener(
      "click",
      logoutStudent
    );
  }


  /* =========================================================
     AUTH STATE

     This runs:
       - when the page first loads
       - after login
       - after logout
       - when the session refreshes
       - when another tab changes auth state
  ========================================================= */

  async function loadCurrentStudent() {

    if (!supabase) {

      console.error(
        "[HEADER] Supabase browser configuration is missing."
      );

      renderLoggedOut();

      return;
    }


    const {
      data,
      error
    } =
      await supabase.auth.getSession();


    if (error) {

      console.error(
        "[HEADER] Unable to read session:",
        error
      );

      renderLoggedOut();

      return;
    }


    if (data?.session?.user) {

      await syncServerSession(
        data.session
      );

      renderLoggedIn(
        data.session.user
      );

    } else {

      renderLoggedOut();
    }
  }


  if (supabase) {

    supabase.auth.onAuthStateChange(
      (
        event,
        session
      ) => {

        if (
          session?.user
        ) {

          void syncServerSession(
            session
          );

          renderLoggedIn(
            session.user
          );

        } else {

          renderLoggedOut();
        }
      }
    );

  }


  loadCurrentStudent();


  /* =========================================================
     MOBILE MENU
  ========================================================= */

  const mobileMenuButton =
    document.querySelector(
      ".mobile-menu-button"
    );

  const mobileNavigation =
    document.querySelector(
      "#mobile-navigation"
    );


  if (
    mobileMenuButton &&
    mobileNavigation
  ) {

    mobileMenuButton.addEventListener(
      "click",
      () => {

        const isOpen =
          mobileNavigation.classList.toggle(
            "is-open"
          );


        mobileMenuButton.setAttribute(
          "aria-expanded",
          String(isOpen)
        );


        mobileNavigation.setAttribute(
          "aria-hidden",
          String(!isOpen)
        );


        /* Animate hamburger */

        const bars =
          mobileMenuButton.querySelectorAll(
            "span"
          );


        if (isOpen) {

          bars[0].style.transform =
            "translateY(7px) rotate(45deg)";

          bars[1].style.opacity =
            "0";

          bars[2].style.transform =
            "translateY(-7px) rotate(-45deg)";


          mobileMenuButton.setAttribute(
            "aria-label",
            "Close navigation menu"
          );

        } else {

          bars[0].style.transform =
            "";

          bars[1].style.opacity =
            "";

          bars[2].style.transform =
            "";


          mobileMenuButton.setAttribute(
            "aria-label",
            "Open navigation menu"
          );
        }
      }
    );


    /* =======================================================
       CLOSE MOBILE MENU AFTER CLICKING A LINK
    ======================================================== */

    mobileNavigation
      .querySelectorAll("a")
      .forEach(
        (link) => {

          link.addEventListener(
            "click",
            () => {

              mobileNavigation.classList.remove(
                "is-open"
              );


              mobileMenuButton.setAttribute(
                "aria-expanded",
                "false"
              );


              mobileNavigation.setAttribute(
                "aria-hidden",
                "true"
              );


              const bars =
                mobileMenuButton.querySelectorAll(
                  "span"
                );


              bars[0].style.transform =
                "";

              bars[1].style.opacity =
                "";

              bars[2].style.transform =
                "";


              mobileMenuButton.setAttribute(
                "aria-label",
                "Open navigation menu"
              );
            }
          );
        }
      );
  }


  /* =========================================================
     MOBILE JPSC / UPSC DROPDOWNS
  ========================================================= */

  document
    .querySelectorAll(
      ".mobile-dropdown-button"
    )
    .forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const parent =
              button.closest(
                ".mobile-dropdown"
              );


            if (!parent) {
              return;
            }


            const isOpen =
              parent.classList.toggle(
                "is-open"
              );


            button.setAttribute(
              "aria-expanded",
              String(isOpen)
            );
          }
        );
      }
    );
</script>